<div x-data="{
            openSlide: false, 
            slideContentPartialName: null, 
            documents: {{ stringify documents }},
            selectedDocumentIndex: {{ stringify selectedDocumentIndex }},
            selectedDocument: {{ stringify selectedDocument }},
            user_language: '{{session.user.language}}'.split('-')[0],
            sizes: {{ stringify sizes}},
            getTaxRates: async function() {
                let countries = [];
                if (this.selectedDocument.config.buyer.country) {
                    countries.push(this.selectedDocument.config.buyer.country);
                }

                if (this.selectedDocument.config.seller.country) {
                    countries.push(this.selectedDocument.config.seller.country);
                }
                if (countries.length === 0) {
                    countries.push({{session.user.country}});
                }

                try {
                    const data = await fetchUrl('/taxRates', 'POST', { countries });
                    this.taxRates = data;
                } catch (error) {
                    console.error('Error getting tax rates', error);
                }
            },
            taxRates: [],
            newDocumentButton: async function() {
                try {
                    const data = await fetchUrl('/document/newAjax', 'POST');
                    this.documents.unshift(data);
                    this.selectedDocumentIndex = 0;
                    this.selectedDocument = data;
                    updateNewUrl(data.slug);
                    if (window.innerWidth < 640) $dispatch('updatenavbutton', {value: 'back'});
                } catch (error) { 
                    console.error('Error creating new document', error); 
                }
            },
            showCol2: function() {
                this.$refs.col1.style.transform = 'translateX(-100%)'; 
                this.$refs.col2.style.transform = 'translateX(-100%)';
            },
            showCol1: function() {
                this.$refs.col1.style.transform = 'translateX(0)';
                this.$refs.col2.style.transform = 'translateX(0)';
            },
            toggleTab: function(tabRef) {
                // Hide all tabs and remove highlight
                document.getElementById('col21').classList.add('hidden');
                this.$refs.tabForm.classList.remove('text-indigo-700', 'bg-indigo-100');
                document.getElementById('col22').classList.add('hidden');
                this.$refs.tabPreview.classList.remove('text-indigo-700', 'bg-indigo-100');

                // Show selected tab and add highlight
                if (tabRef === 'tabForm') {
                    document.getElementById('col21').classList.remove('hidden');
                    this.$refs.tabForm.classList.add('text-indigo-700', 'bg-indigo-100');
                } else if (tabRef === 'tabPreview') {
                    document.getElementById('col22').classList.remove('hidden');
                    this.$refs.tabPreview.classList.add('text-indigo-700', 'bg-indigo-100');
                } 
            },
            formatUnixTimestamp: function(timestamp, format) {
                if (!timestamp) {
                    return '';
                }
                var date;
                if (typeof timestamp === 'string' && timestamp.includes('-')) {
                    // ISO 8601 string
                    date = dayjs(timestamp);
                } else {
                    // Unix timestamp
                    date = dayjs.unix(Number(timestamp));
                }
                return date.format(format);
            }
     }"
     x-init="
        {{!-- window.addEventListener('popstate', () => { // catch back gesture and tap on back button on smartphones
            if navState === 'back') {
                showCol1();
            } 
         }); --}}
        if (selectedDocument) {getTaxRates();}        
        $watch('selectedDocument', (value, oldValue) => {
            console.log('selectedDocument changed', value);
            var document = { ...value };
            document.autosave_updated_at = new Date();
            localStorage.setItem('autosave#document#' + value.slug, JSON.stringify(document));
        });
        $watch('navState', () => { 
            if (navState === 'back') {
                showCol2();
            } else {
                showCol1();
            }
        });
        if (selectedDocumentIndex >= 0) { {{!-- Only if selectedDocumentIndex is not null --}}
          {{!-- documents[selectedDocumentIndex] = selectedDocument; --}}
          (async () => {

            {{!-- const response = await fetch(`/document/editAjax/${documents[selectedDocumentIndex].slug}`); Get the document from MongoDB --}}
            {{!-- const data = await response.json(); --}}

            documents[selectedDocumentIndex] = deepMergeObjects(documents[selectedDocumentIndex], selectedDocument);
            selectedDocument = documents[selectedDocumentIndex];

            updateNewUrl(selectedDocument.slug); {{!-- update the url with to document/edit + slug --}}
            {{!-- selectedDocument =  documents[selectedDocumentIndex]; set the selectedDocument --}}
            {{!-- documents = updateDocumentsWithLS(documents); override documents with not already saved updates from local storage, if any --}}
          })();
        }"
