
<div class="flex flex-1 overflow-y-hidden sm:flex-row 2xl:container 2xl:m-auto" 
     x-data="{ 
      currentColumn: 1, 
      openSlide: false, 
      slideContentPartialName: null, 
      selectedDocument: {{#if selectedDocument}}{{ stringify selectedDocument }}{{else}}null{{/if}}, 
      documents: {{ stringify documents }},
    }" 
     x-init="
          $watch('currentColumn', value => {
            if (value > 1) {
              navState = 'back'
            } else {
              navState = 'menu'
            }
          });
          $watch('navState', value => {
            if (value == 'menu') {
              currentColumn = 1
            }
          });
          if (selectedDocument) {
            documents = updateDocumentsWithLS(documents);
            updateNewUrl(selectedDocument.slug);
          }
          runAutoSave();
        ">
  <div class="flex-1 overflow-y-auto sm:w-96 md:flex-none md:w-[320px] text-white" x-bind:class="{ 'hidden sm:block': currentColumn >= 2 }">
    <div class="flex flex-col">

      <button type="button" class="inline-flex items-center gap-x-2 my-2 rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
        @click.prevent="fetchUrl('/document/newAjax', 'POST' )
            .then(data => {
              let newDocument = JSON.parse(data);
              documents = [newDocument, ...documents];
              selectedDocument = newDocument;
              currentColumn = 2.1;
              updateNewUrl(newDocument.slug);
            })
            .catch(error => {
              console.error('Error creating new document', error);
            });">
        <svg class="-ml-0.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
  <path fill-rule="evenodd" d="M9 9V6a1 1 0 012 0v3h3a1 1 0 010 2h-3v3a1 1 0 01-2 0V11H6a1 1 0 010-2h3z" clip-rule="evenodd" />
</svg>


        New Invoice / Quote / ...
      </button>

      <div class="relative mt-1 flex items-center"
          x-data="{
              searchDocumentTerm: '',
              searchDocument: function() {
                  fetchUrl('/documents/search?q=' + encodeURIComponent(this.searchDocumentTerm.trim() || '*'), 'GET' )
                    .then(data => {
                      console.log(data);
                      documents = JSON.parse(data);
                    })
                    .catch(error => {
                      console.error('Error searching for documents', error);
                    });
              }
            }"
          x-init="
            $watch('searchDocumentTerm', () => { searchDocument() });
          "
      >
        <input x-model.debounce.200ms="searchDocumentTerm" x-on:keydown.enter.prevent="searchDocument()" type="text" class="block w-full rounded-md border-0 py-1.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" placeholder="Filter by buyers's name, VAT number, address, ... " autocomplete="off">
      </div>

    </div>

    
    
    <ul role="list" class="divide-y divide-gray-200 px-1" x-data="{ 
          editDocument: function(slug) {
            fetchUrl(`/document/editAjax/${slug}`)
              .then(data => {
                this.selectedDocument = deepMergeObjects(this.selectedDocument, JSON.parse(data));
                history.pushState(null, null, `/document/edit/${slug}${window.location.search}`);
              })
              .catch(error => {
                console.error('Error editing document', error);
              });
          }
        }"
    >
      <template x-if="documents.length === 0">
        <li class="py-2 text-gray-500">No documents found.</li>
      </template>

      <template x-for="(document, index) in documents" :key="index">
        <li @click.prevent="currentColumn = 2.1; selectedDocument = document; editDocument(document.slug);" class="flex flex-col py-2">
            <div class="flex-auto">
                <p class="text-sm font-semibold leading-5 text-gray-900 py-2">
                    <span class="inline-flex items-center rounded bg-blue-100 px-2 py-0.5 text-xs font-medium text-blue-800">F</span> <a href="#" class="hover:underline" spellcheck="false" x-text="document?.config?.buyer?.name"></a>
                </p>
                <div class="mt-1 flex flex-row flex-wrap items-center gap-x-2 text-xs leading-5 text-gray-500">
                    <p><a href="#" class="hover:underline" spellcheck="false"><span class="inline-flex items-center rounded-full bg-red-100 px-1.5 py-0.5 text-xs font-medium text-red-700">€ 145 589.45</span></a></p>
                    <svg viewBox="0 0 2 2" class="h-0.5 w-0.5 fill-current"><circle cx="1" cy="1" r="1"></circle></svg>
                    <p><time datetime="2023-01-23T22:34Z">08/09/2023</time></p>
                    <svg viewBox="0 0 2 2" class="h-0.5 w-0.5 fill-current"><circle cx="1" cy="1" r="1"></circle></svg>
                    <p><time datetime="2023-01-23T22:34Z"><em>#</em> 2023 056</time></p>
                </div>
            </div>
            <dl class="flex-auto">
                <div class="flex -space-x-0.5">
                    <ul class="flex flex-row flex-wrap gap-x-2">
                      <li><span class="inline-flex items-center rounded bg-blue-100 px-2 py-0.5 text-xs font-medium text-pink-800">Denis</span></li>
                      <li><span class="inline-flex items-center rounded bg-blue-100 px-2 py-0.5 text-xs font-medium text-red-800">BE</span></li>
                      <li><span class="inline-flex items-center rounded bg-blue-100 px-2 py-0.5 text-xs font-medium text-red-800">Formation planifiée</span></li>
                      <li><span class="inline-flex items-center rounded bg-blue-100 px-2 py-0.5 text-xs font-medium text-green-800">Gros client</span></li>
                    </ul>
                </div>
            </dl>
        </li>
      </template>

    </ul>

  </div>
  <div class="flex-1 sm:flex sm:flex-col overflow-y-hidden lg:flex-row" 
       x-bind:class="currentColumn > 2 ? 'flex flex-col' : 'hidden'"
       x-init="
          if (selectedDocument) {
            indexOfSelectedDocument = documents.findIndex(obj => obj.slug === selectedDocument.slug);
            documents[indexOfSelectedDocument] = deepMergeObjects(selectedDocument,documents[indexOfSelectedDocument]);
            selectedDocument =  documents[indexOfSelectedDocument];
          }
          
       "
    >
    <div class="lg:hidden">
      <div class="border-b border-gray-200">
        <nav class="-mb-px flex flex-1" aria-label="Tabs">
          <!-- Current: "border-indigo-500 text-indigo-600", Default: "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300" -->
          <a @click.prevent="currentColumn = 2.1" class="flex-grow border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 group inline-flex items-center py-4 px-1 border-b-2 font-medium text-sm">
            <!-- Current: "text-indigo-500", Default: "text-gray-400 group-hover:text-gray-500" -->
            <svg class="text-gray-400 group-hover:text-gray-500 -ml-0.5 mr-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M10 8a3 3 0 100-6 3 3 0 000 6zM3.465 14.493a1.23 1.23 0 00.41 1.412A9.957 9.957 0 0010 18c2.31 0 4.438-.784 6.131-2.1.43-.333.604-.903.408-1.41a7.002 7.002 0 00-13.074.003z" />
            </svg>
            <span>Form</span>
          </a>

          <a @click="currentColumn = 2.2" class="flex-grow border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 group inline-flex items-center py-4 px-1 border-b-2 font-medium text-sm">
            <svg class="text-gray-400 group-hover:text-gray-500 -ml-0.5 mr-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M4 16.5v-13h-.25a.75.75 0 010-1.5h12.5a.75.75 0 010 1.5H16v13h.25a.75.75 0 010 1.5h-3.5a.75.75 0 01-.75-.75v-2.5a.75.75 0 00-.75-.75h-2.5a.75.75 0 00-.75.75v2.5a.75.75 0 01-.75.75h-3.5a.75.75 0 010-1.5H4zm3-11a.5.5 0 01.5-.5h1a.5.5 0 01.5.5v1a.5.5 0 01-.5.5h-1a.5.5 0 01-.5-.5v-1zM7.5 9a.5.5 0 00-.5.5v1a.5.5 0 00.5.5h1a.5.5 0 00.5-.5v-1a.5.5 0 00-.5-.5h-1zM11 5.5a.5.5 0 01.5-.5h1a.5.5 0 01.5.5v1a.5.5 0 01-.5.5h-1a.5.5 0 01-.5-.5v-1zm.5 3.5a.5.5 0 00-.5.5v1a.5.5 0 00.5.5h1a.5.5 0 00.5-.5v-1a.5.5 0 00-.5-.5h-1z" clip-rule="evenodd" />
            </svg>
            <span>Preview</span>
          </a>

        </nav>
      </div>
    </div> 
    <div class="overflow-y-auto flex flex-col px-2 sm:flex sm:flex-col sm:grow lg:w-72 lg:grow-0 xl:w-80  h-26 text-black" x-bind:class="currentColumn <= 2.1 ? 'flex flex-col' : 'hidden sm:hidden'">
      
      <template x-if="selectedDocument">
        {{> documents/edit_form selectedDocument=selectedDocument openSlide = openSlide}}
      </template>

      <template  x-if="! selectedDocument">
        <p>Please select a document</p>
      </template>

    </div>
    <div class="overflow-y-auto sm:grow lg:block lg:grow h-26 text-white" x-bind:class="currentColumn === 2.2 ? 'flex flex-col sm:flex sm:flex-col' : 'hidden'">
      
      <template x-if="selectedDocument">
        {{> documents/preview selectedDocument=selectedDocument}}
      </template>

      <template  x-if="! selectedDocument">
        <p>Nothing to preview, Please select a document</p>
      </template>
      
    </div>
  </div>
  {{> documents/slide }}
</div>
