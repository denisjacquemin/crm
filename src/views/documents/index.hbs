
{{!-- TODO - Main container --}}
<div class="flex flex-col flex-grow overflow-hidden sm:flex-row xl:m-0 3xl:container 3xl:m-auto" 
     x-data="{ 
        currentColumn: 1,
        openSlide: false, 
        slideContentPartialName: null, 
        selectedDocument: {{#if selectedDocument}}{{ stringify selectedDocument }}{{else}}null{{/if}}, 
        documents: {{ stringify documents }},
      }" 
     x-init="
          $watch('currentColumn', value => {
            if (value > 1) {
              navState = 'back'
            } else {
              navState = 'menu'
            }
          });
          $watch('navState', value => {
            if (value == 'menu') {  
              currentColumn = 1
            }
          });
          if (selectedDocument) {
            documents = updateDocumentsWithLS(documents);
            updateNewUrl(selectedDocument.slug);
          }
          runAutoSave();
        ">
  {{!-- TODO - col1 --}}
  <div class="flex flex-col flex-grow overflow-hidden mx-2 sm:mx-0 sm:flex sm:flex-none sm:flex-col sm:border-r sm:border-grey-200 sm:w-72 md:w-88"
       :class="{
                'hidden': currentColumn >= 2,
                'flex': currentColumn < 2
              }">
       {{!-- x-show="currentColumn < 2 || window.innerWidth >= 640"> --}}
      <div class="flex-none sm:mx-2">
        <button type="button" class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
          @click.prevent="fetchUrl('/document/newAjax', 'POST' )
              .then(data => {
                let newDocument = JSON.parse(data);
                documents = [newDocument, ...documents];
                selectedDocument = newDocument;
                currentColumn = 2.1;
                updateNewUrl(newDocument.slug);
              })
              .catch(error => {
                console.error('Error creating new document', error);
              });">
          <svg class="-ml-0.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M9 9V6a1 1 0 012 0v3h3a1 1 0 010 2h-3v3a1 1 0 01-2 0V11H6a1 1 0 010-2h3z" clip-rule="evenodd" />
          </svg>
          New Invoice / Quote / ...
        </button>
      </div>
      <div class="flex-none mt-1 mb-2 sm:mx-2 flex items-center"
          x-data="{
              searchDocumentTerm: '',
              sortBy: 'created_at:asc',
              searchDocument: function() {
                const sortByParam = this.sortBy ? '&sort=' + encodeURIComponent(this.sortBy) : '';
                fetchUrl('/documents/search?q=' + encodeURIComponent(this.searchDocumentTerm.trim() || '*') + sortByParam, 'GET')
                  .then(data => {
                    documents = JSON.parse(data);
                  })
                  .catch(error => {
                    console.error('Error searching for documents', error);
                  });
              }
            }"
          x-init="
            $watch('searchDocumentTerm', () => { searchDocument() });
          "
      >
        <input x-model.debounce.200ms="searchDocumentTerm" x-on:keydown.enter.prevent="searchDocument()" type="text" class="block w-full rounded-md border-0 py-1.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm leading-6" placeholder="Filter by buyers's name, VAT number, address, ... " autocomplete="off">

        <div x-data="Components.menu({ open: false })" x-init="init()" @keydown.escape.stop="open = false; focusButton()" @click.away="onClickAway($event)" 
             class="relative inline-block text-left pl-3 pr-3 pt-3 pb-2">
            
            <div>
              <button type="button" class="-m-2 inline-flex items-center justify-center rounded-md p-2 text-gray-400" id="menu-button" x-ref="button" @click="onButtonClick()" @keyup.space.prevent="onButtonEnter()" @keydown.enter.prevent="onButtonEnter()" aria-expanded="true" aria-haspopup="true" x-bind:aria-expanded="open.toString()" @keydown.arrow-up.prevent="onArrowUp()" @keydown.arrow-down.prevent="onArrowDown()">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h14.25M3 9h9.75M3 13.5h9.75m4.5-4.5v12m0 0l-3.75-3.75M17.25 21L21 17.25" />
                </svg>
              </button>
            </div>

            
            <div x-show="open" x-transition:enter="transition ease-out duration-100" x-transition:enter-start="transform opacity-0 scale-95" x-transition:enter-end="transform opacity-100 scale-100" x-transition:leave="transition ease-in duration-75" x-transition:leave-start="transform opacity-100 scale-100" x-transition:leave-end="transform opacity-0 scale-95" 
                 class="absolute right-0 z-10 mt-2 w-56 origin-top-right divide-y divide-gray-100 rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none" x-ref="menu-items" x-description="Dropdown menu, show/hide based on menu state." x-bind:aria-activedescendant="activeDescendant" role="menu" aria-orientation="vertical" aria-labelledby="menu-button" tabindex="-1" @keydown.arrow-up.prevent="onArrowUp()" @keydown.arrow-down.prevent="onArrowDown()" @keydown.tab="open = false" @keydown.enter.prevent="open = false; focusButton()" @keyup.space.prevent="open = false; focusButton()">
              <div class="px-4 py-3" role="none">
                <p class="text-sm" role="none">Sort by</p>
              </div>
              <ul class="py-1" role="none" x-data="{ menuItems: [
                    { label: 'Latest first', sortValue: 'created_at:asc' },
                    { label: 'Oldest first', sortValue: 'created_at:desc' },
                    { label: 'Last updated first', sortValue: 'updated_at:asc' },
                    { label: 'Older updated first', sortValue: 'updated_at:desc' }
                ] }">
                <!-- Template for each menu item -->
                <template x-for="(item, index) in menuItems" :key="index">
                    <li class="relative">
                        <a x-text="item.label" href="#" class="text-gray-700 block px-4 py-2 text-sm"
                            :class="{
                                'bg-indigo-600 text-white': sortBy === item.sortValue,
                                'text-gray-700': sortBy !== item.sortValue
                            }"
                            role="menuitem" tabindex="-1" :id="`menu-item-${index}`"
                            @mouseenter="onMouseEnter($event)" @mousemove="onMouseMove($event, index)" @mouseleave="onMouseLeave($event)"
                            @click.prevent="sortBy = item.sortValue; open = false; searchDocument(); focusButton()">
                        </a>
                        <span x-show="sortBy === item.sortValue" class="absolute inset-y-0 right-0 flex items-center pr-4 text-white">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-5 w-5">
                                <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"></path>
                            </svg>
                        </span>
                    </li>
                </template>
              </ul>
            </div>
            
        </div>


      </div>

    

    
    
    <ul role="list" class="flex-grow overflow-y-scroll divide-y pl-1 pr-4 sm:ml-2 sm:pl-0 divide-gray-200" x-data="{ 
          editDocument: function(slug) {
            fetchUrl(`/document/editAjax/${slug}`)
              .then(data => {
                this.selectedDocument = deepMergeObjects(this.selectedDocument, JSON.parse(data));
                history.pushState(null, null, `/document/edit/${slug}${window.location.search}`);
              })
              .catch(error => {
                console.error('Error editing document', error);
              });
          }
        }"
    >
