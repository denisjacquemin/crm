  </div>
  {{!-- TODO - container col2 et col3 --}}
  <div class="hidden overflow-hidden mx-2 sm:flex sm:flex-col sm:flex-grow 2lg:flex-row" 
       :class="{
                'flex flex-col sm:flex-grow': currentColumn >= 2,
                'hidden sm:flex sm:flex-col sm:flex-grow': currentColumn < 2
              }"
       {{!-- x-show="currentColumn > 2 || window.innerWidth >= 640" --}}
       x-init="
          if (selectedDocument) {
            indexOfSelectedDocument = documents.findIndex(obj => obj.slug === selectedDocument.slug);
            documents[indexOfSelectedDocument] = deepMergeObjects(selectedDocument,documents[indexOfSelectedDocument]);
            selectedDocument =  documents[indexOfSelectedDocument];
          }
          
       "
    >
    {{!-- TODO - tabs --}}
    <div class="2lg:hidden">
      <div class="border-b border-gray-200">
        <nav class="flex" aria-label="Tabs">
          <!-- Current: "bg-gray-100 text-gray-700", Default: "text-gray-500 hover:text-gray-700" -->
          <a href="#" @click.prevent="currentColumn = 2.1" class="flex-grow text-center text-gray-500 rounded-md m-2 px-3 py-2 text-md font-medium"
             :class="{
                'bg-indigo-100 text-indigo-700': currentColumn <= 2.1,
                'bg-gray-100 hover:text-gray-700': currentColumn > 2.1
              }">Form</a>
          <div class="border border-gray-200 my-1"></div>
          <a href="#" @click="currentColumn = 2.2" class="flex-grow text-center rounded-md m-2 px-3 py-2 text-md font-medium"
             :class="{
                'bg-indigo-100 text-indigo-700': currentColumn === 2.2,
                'bg-gray-100 hover:text-gray-700': currentColumn !== 2.2
              }">Preview</a>
        </nav>

      </div>
    </div> 
    {{!-- TODO - col2 --}}
    <div class="overflow-y-auto text-black pl-1 pr-4 2lg:flex-initial 2lg:w-96 " 
         :class="{
           'flex flex-col sm:flex sm:flex-col sm:grow': currentColumn === 2 || currentColumn === 2.1,
           'hidden sm:flex sm:flex-col sm:grow': currentColumn < 2 || currentColumn > 2.1,
           'sm:hidden': currentColumn === 2.2
         }">
               
               {{!-- x-show="currentColumn === 2 || currentColumn === 2.1> --}}
      <template x-if="selectedDocument">
        {{> documents/edit_form selectedDocument=selectedDocument openSlide = openSlide}}
      </template>

      <template  x-if="! selectedDocument">
        <p>Please select a document</p>
      </template>

    </div>
    {{!-- TODO - col3 --}}
    <div id="cont" 
              class="overflow-auto px-4"
              :class="{
                'flex flex-col flex-grow': currentColumn === 2.2,
                'hidden 2lg:block xl:flex-grow': currentColumn !== 2.2
              }" 
              x-init="
                isVisible = currentColumn === 2.2 || window.innerWidth >= 1124;
                if (isVisible) {
                  onShown();
                };
                $watch('isVisible', value => {
                  console.log('value is ', value);
                  if (value) {
                    console.log('calling onShown', value);
                    onShown();
                  }
                });
                $watch('currentColumn', value => {
                  if (value == 2.2) {
                    console.log('before: isVisible = true');
                    isVisible = true;
                    console.log('after: isVisible = true');
                  } else {
                    isVisible = false;
                  }
                });
              "
              x-data="{
                  isVisible: false,
                  scale: 1,
                  template_name: selectedDocument?.config?.template_name || 'template1',
                  onShown() { 
                    this.fitToScreen();
                  },
                  zoomOut() {
                    this.scale = Math.max(this.scale - 0.1, 0.3);
                    this.updateScale();
                  },
                  zoomIn() {
                    this.scale = Math.min(this.scale + 0.1, 0.7);
                    this.updateScale();
                  },
                
                  fitToScreen() {
                    // wait 3 seconds before executing the code
                    setTimeout(() => {
                      const pageContainer = this.$refs.pageContainer;
                      const page = this.$refs.page;
                      const pageWidth = page.offsetWidth;
                      const pageContainerWidth = pageContainer.offsetWidth;
                      console.log('pageWidth', pageWidth);
                      console.log('pageContainerWidth', pageContainerWidth);
                      if (pageContainerWidth < pageWidth) {
                        this.scale = Math.min(Math.max((pageContainerWidth / pageWidth), 0.2), 4);
                        console.log('scale', this.scale);
                        this.updateScale();
                      }
                    }, 1);
                  },
                  updateScale() {
                    this.$refs.page.style.transform = `scale(${this.scale})`;
                  },
                }">

      
      <div class="buttons-container absolute bottom-5 mx-auto flex z-50 ">
            <button @click="zoomOut" class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded">Zoom Out</button>
            <button @click="fitToScreen" class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded ml-2">Fit to Screen</button>
            <button @click="zoomIn" class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded ml-2">Zoom In</button>
      </div>
      <page x-ref="pageContainer" class="mr-2 ">
        <div id="page-content"
             x-ref="page" 
             style="width: 210mm; height: 296mm" 
             class="sheet padding-10mm bg-red-100 text-black transform-origin-top-left xl:mx-auto">
             
              <template x-if="template_name === 'template1'">
                {{> 'documents/templates/template1' selectedDocument=selectedDocument}}
              </template>
              <template x-if="template_name === 'template2'">
                {{> 'documents/templates/template2' selectedDocument=selectedDocument}}
              </template>
              <template x-if="template_name === 'template3'">
                {{> 'documents/templates/template3' selectedDocument=selectedDocument}}
              </template>
        </div>
      </page>


      <template  x-if="! selectedDocument">
        <p>Nothing to preview, Please select a document</p>
      </template>
      
    </div>
  </div>
  {{!-- {{> documents/slide }} --}}
</div>
