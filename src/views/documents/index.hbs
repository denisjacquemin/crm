
{{!-- TODO - Main container --}}
<div class="flex flex-col flex-grow overflow-hidden sm:flex-row xl:m-0 3xl:container 3xl:m-auto" 
     x-data="{ 
        currentColumn: 1,
        openSlide: false, 
        slideContentPartialName: null, 
        documents: {{ stringify documents }},
        selectedDocumentIndex: {{ stringify selectedDocumentIndex }},
        selectedDocument: null,
        newDocumentButton: async function() {
          try {
            const csrfToken = document.querySelector('meta[name=csrf-token]').getAttribute('content');
            const response = await fetch('/document/newAjax', { 
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken
              }
            });              
            const newDocument = await response.json();
            console.log('data from newAjax', newDocument);
            this.documents.unshift(newDocument);
            this.selectedDocumentIndex = 0;
            this.selectedDocument = newDocument;
            this.currentColumn = 2.1;
            this.updateNewUrl(newDocument.slug);
          } catch (error) { 
            console.error('Error creating new document', error); 
          }
        },
      }" 
    x-init="
        if (selectedDocumentIndex >= 0) { {{!-- Only if selectedDocumentIndex is not null --}}
          (async () => {
            console.log('documents', documents);
            console.log('selectedDocumentIndex', selectedDocumentIndex);
            const response = await fetch(`/document/editAjax/${documents[selectedDocumentIndex].slug}`); {{!-- Get the document from MongoDB --}}
            const data = await response.json();
            documents[selectedDocumentIndex] = deepMergeObjects(documents[selectedDocumentIndex], data);  {{!-- merge the document in documents with the on from MongoDB  --}}
            updateNewUrl(documents[selectedDocumentIndex].slug); {{!-- update the url with to document/edit + slug --}}
            selectedDocument =  documents[selectedDocumentIndex]; {{!-- set the selectedDocument --}}
            documents = updateDocumentsWithLS(documents); {{!-- override documents with not already saved updates from local storage, if any --}}
          })();
        }  
        runAutoSave(); {{!-- listen for change and save them serverside--}}
        $watch('currentColumn', value => {
          if (value > 1) {
            navState = 'back'
          } else {
            navState = 'menu'
          }
        });
        $watch('navState', value => {
          if (value == 'menu') {  
            currentColumn = 1
          }
        });
        $watch('selectedDocument', (value, oldValue) => {
          {{!-- console.log('selectedDocument changed', value, oldValue); --}}
          var documentsFromLS = JSON.parse(localStorage.getItem('documents')) || {};
          documentsFromLS[value.slug] = { ...value };  

          {{!-- Don't set/update the updated_at date if this is a new document, to know that check the slug, if value.slug is different from oldValue.slug it's a new one  --}}
          if (oldValue && value.slug === oldValue.slug) {
            documentsFromLS[value.slug].selectedDocument_updated_at = new Date();
            localStorage.setItem('documents', JSON.stringify(documentsFromLS));
          }
          
        });
      ">
  {{!-- TODO - col1 --}}
  <div
    class="flex flex-col flex-grow overflow-hidden mx-2 sm:mx-0 sm:flex sm:flex-none sm:flex-col sm:border-r sm:border-grey-200 sm:w-72 md:w-88"
    :class="{
                'hidden': currentColumn >= 2,
                'flex': currentColumn < 2
    }">
    {{!-- x-show="currentColumn < 2 || window.innerWidth>= 640"> --}}
    <div class="flex-none sm:mx-2">
      <div x-text="selectedDocument?.slug"></div>
      <div x-text="selectedDocumentIndex"></div>
      <input type="hidden" name="currentSlug" x-bind:value="selectedDocument?.slug">
      <button type="button" id="newDocumentButton"
        class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
        @click.prevent="newDocumentButton"
        >      
        <svg class="-ml-0.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M9 9V6a1 1 0 012 0v3h3a1 1 0 010 2h-3v3a1 1 0 01-2 0V11H6a1 1 0 010-2h3z"
            clip-rule="evenodd" />
        </svg>
        New Invoice / Quote / ...
      </button>
    </div>
    <div class="flex-none mt-1 mb-2 sm:mx-2 flex items-center" 
         x-data="{
            searchDocumentTerm: '',
            sortBy: 'createdAt:asc',
            searchDocument: function() {
              const sortByParam = this.sortBy ? '&sort=' + encodeURIComponent(this.sortBy) : '';
              fetchUrl('/documents/search?q=' + encodeURIComponent(this.searchDocumentTerm.trim() || '*') + sortByParam, 'GET')
                .then(data => {
                  documents = JSON.parse(data);
                })
                .catch(error => {
                  console.error('Error searching for documents', error);
                });
            }
         }" 
         x-init="
          $watch('searchDocumentTerm', () => { searchDocument() });
         ">
      <input x-model.debounce.200ms="searchDocumentTerm" x-on:keydown.enter.prevent="searchDocument()" type="text"
        class="block w-full rounded-md border-0 py-1.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm leading-6"
        placeholder="Filter by buyers's name, VAT number, address, ... " autocomplete="off">

      <div x-data="Components.menu({ open: false })" 
           x-init="init()"
           @keydown.escape.stop="open = false; focusButton()" @click.away="onClickAway($event)"
           class="relative inline-block text-left pl-3 pr-3 pt-3 pb-2">

        <div>
          <button type="button" class="-m-2 inline-flex items-center justify-center rounded-md p-2 text-gray-400"
            id="menu-button" x-ref="button" @click="onButtonClick()" @keyup.space.prevent="onButtonEnter()"
            @keydown.enter.prevent="onButtonEnter()" aria-expanded="true" aria-haspopup="true"
            x-bind:aria-expanded="open.toString()" @keydown.arrow-up.prevent="onArrowUp()"
            @keydown.arrow-down.prevent="onArrowDown()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
              stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M3 4.5h14.25M3 9h9.75M3 13.5h9.75m4.5-4.5v12m0 0l-3.75-3.75M17.25 21L21 17.25" />
            </svg>
          </button>
        </div>

        <div x-show="open" x-transition:enter="transition ease-out duration-100"
          x-transition:enter-start="transform opacity-0 scale-95"
          x-transition:enter-end="transform opacity-100 scale-100" x-transition:leave="transition ease-in duration-75"
          x-transition:leave-start="transform opacity-100 scale-100"
          x-transition:leave-end="transform opacity-0 scale-95"
          class="absolute right-0 z-10 mt-2 w-56 origin-top-right divide-y divide-gray-100 rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none"
          x-ref="menu-items" x-description="Dropdown menu, show/hide based on menu state."
          x-bind:aria-activedescendant="activeDescendant" role="menu" aria-orientation="vertical"
          aria-labelledby="menu-button" tabindex="-1" @keydown.arrow-up.prevent="onArrowUp()"
          @keydown.arrow-down.prevent="onArrowDown()" @keydown.tab="open = false"
          @keydown.enter.prevent="open = false; focusButton()" @keyup.space.prevent="open = false; focusButton()">
          <div class="px-4 py-3" role="none">
            <p class="text-sm" role="none">Sort by</p>
          </div>
          <ul class="py-1" role="none" x-data="{ menuItems: [
                  { label: 'Latest first', sortValue: 'createdAt:asc' },
                  { label: 'Oldest first', sortValue: 'createdAt:desc' },
                  { label: 'Last updated first', sortValue: 'updatedAt:asc' },
                  { label: 'Older updated first', sortValue: 'updatedAt:desc' }
              ] }">
            <!-- Template for each menu item -->
            <template x-for="(item, index) in menuItems" :key="index">
              <li class="relative">
                <a x-text="item.label" href="#" class="text-gray-700 block px-4 py-2 text-sm" :class="{
                              'bg-indigo-600 text-white': sortBy === item.sortValue,
                              'text-gray-700': sortBy !== item.sortValue
                          }" role="menuitem" tabindex="-1" :id="`menu-item-${index}`"
                  @mouseenter="onMouseEnter($event)" @mousemove="onMouseMove($event, index)"
                  @mouseleave="onMouseLeave($event)"
                  @click.prevent="sortBy = item.sortValue; open = false; searchDocument(); focusButton()">
                </a>
                <span x-show="sortBy === item.sortValue"
                  class="absolute inset-y-0 right-0 flex items-center pr-4 text-white">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
                    class="h-5 w-5">
                    <path fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                      clip-rule="evenodd"></path>
                  </svg>
                </span>
              </li>
            </template>
          </ul>
        </div>

      </div>
    </div>





    <div role="list" class="flex-grow overflow-y-scroll pl-1 pr-4 sm:ml-2 sm:pl-0" 
        x-data="{ editDocument: async function(index) {
                      try {
                        selectedDocumentIndex = index;
                        const response = await fetch(`/document/editAjax/${documents[selectedDocumentIndex].slug}`);
                        const data = await response.json()
                        documents[selectedDocumentIndex] = deepMergeObjects(documents[selectedDocumentIndex], data);  
                        updateNewUrl(documents[selectedDocumentIndex].slug);  {{!-- update the url with to document/edit + slug --}}
                        selectedDocument = documents[selectedDocumentIndex];

                      } catch (error) { console.error('Error editing document', error); }
                  }
        }">
      <template x-if="documents.length === 0">
        <div class="py-2 text-gray-500">No documents found.</div>
      </template>

      <template x-for="(document, index) in documents" :key="index">
          <div @click.prevent="currentColumn = 2.1; editDocument(index);"
            :data-slug="document.slug" 
            class="mb-5 p-2 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-70 hover:shadow-md hover:shadow-gray-200">
            {{!-- <p class="truncate text-lg font-medium text-gray-900"><span x-text="document.slug"></span> - <span x-text="document?.config?.buyer?.name"></span></p> --}}
            <div class="flex justify-between space-x-3">
              <div class="min-w-0 flex-1">
                <a href="#" class="block focus:outline-none" spellcheck="false">
                  <p class="truncate text-sm text-gray-600"><time datetime="2021-01-27T16:35"
                      class="flex-shrink-0 whitespace-nowrap ">08/09/2023</time></p>
                </a>
              </div>
              <span class="flex-shrink-0 whitespace-nowrap text-sm text-gray-600">#2023045</span>
            </div>
            <div class="mt-1">
              <ul class="text-sm text-gray-500">
                <li class="truncate">Primaire - Licence standard Sdui - Contrat d'un an jusque décembre</li>
                <li>Remise Konecto école primaire</li>
              </ul>
              <p class="line-clamp-2 text-sm text-gray-600">
                test
              </p>
            </div>
            <div class="mt-1">
              <span
                class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Facture</span>
              <span
                class="inline-flex items-center rounded-md bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/10">Denis
                Jacquemin</span>
              <span
                class="inline-flex items-center rounded-md bg-yellow-50 px-2 py-1 text-xs font-medium text-yellow-800 ring-1 ring-inset ring-yellow-600/20">Segec</span>
              <span
                class="inline-flex items-center rounded-md bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">To
                Renew Q3-2023</span>
              <span
                class="inline-flex items-center rounded-md bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">Badge</span>
              <span
                class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700 ring-1 ring-inset ring-indigo-700/10">Badge</span>
              <span
                class="inline-flex items-center rounded-md bg-purple-50 px-2 py-1 text-xs font-medium text-purple-700 ring-1 ring-inset ring-purple-700/10">Badge</span>
              <span
                class="inline-flex items-center rounded-md bg-pink-50 px-2 py-1 text-xs font-medium text-pink-700 ring-1 ring-inset ring-pink-700/10">Badge</span>
            </div>
          </div>
      </template>
    </div>

  </div>
  {{!-- TODO - container col2 et col3 --}}
  <div class="hidden overflow-hidden mx-2 sm:flex sm:flex-col sm:flex-grow 2lg:flex-row" :class="{
                'flex flex-col sm:flex-grow': currentColumn >= 2,
                'hidden sm:flex sm:flex-col sm:flex-grow': currentColumn < 2
              }" {{!-- x-show="currentColumn > 2 || window.innerWidth >= 640" --}} 
       x-init="
          if (selectedDocument) {
            indexOfSelectedDocument = documents.findIndex(obj => obj.slug === selectedDocument.slug);
            documents[indexOfSelectedDocument] = deepMergeObjects(selectedDocument,documents[indexOfSelectedDocument]);
            selectedDocument =  documents[indexOfSelectedDocument];
          }
       ">
    {{!-- TODO - tabs --}}
    <div class="2lg:hidden">
      <div class="border-b border-gray-200">
        <nav class="flex" aria-label="Tabs">
          <!-- Current: "bg-gray-100 text-gray-700", Default: "text-gray-500 hover:text-gray-700" -->
          <a href="#" @click.prevent="currentColumn = 2.1"
            class="flex-grow text-center text-gray-500 rounded-md m-2 px-3 py-2 text-md font-medium" :class="{
                'bg-indigo-100 text-indigo-700': currentColumn <= 2.1,
                'bg-gray-100 hover:text-gray-700': currentColumn > 2.1
              }">Form</a>
          <div class="border border-gray-200 my-1"></div>
          <a href="#" @click="currentColumn = 2.2"
            class="flex-grow text-center rounded-md m-2 px-3 py-2 text-md font-medium" :class="{
                'bg-indigo-100 text-indigo-700': currentColumn === 2.2,
                'bg-gray-100 hover:text-gray-700': currentColumn !== 2.2
              }">Preview</a>
        </nav>
      </div>
    </div>
    {{!-- TODO - col2 --}}
    <div class="overflow-y-auto text-black pl-1 pr-4 2lg:flex-initial 2lg:w-96 2lg:border-r 2lg:border-grey-200" :class="{
           'flex flex-col sm:flex sm:flex-col sm:grow': currentColumn === 2 || currentColumn === 2.1,
           'hidden sm:flex sm:flex-col sm:grow': currentColumn < 2 || currentColumn > 2.1,
           'sm:hidden': currentColumn === 2.2
         }">

      {{!-- x-show="currentColumn === 2 || currentColumn === 2.1> --}}
      <template x-if="selectedDocument">
        {{> documents/edit_form }}
      </template>

      <template x-if="! selectedDocument">
        <p>Please select a document</p>
      </template>

    </div>
    {{!-- TODO - col3 --}}
    <div id="cont" class="overflow-auto px-4" :class="{
                'flex flex-col flex-grow': currentColumn === 2.2,
                'hidden 2lg:block xl:flex-grow': currentColumn !== 2.2
              }" x-init="

                isVisible = currentColumn === 2.2 || window.innerWidth >= 1124;
                if (isVisible) {
                  onShown();
                };
                $watch('isVisible', value => {
                  console.log('value is ', value);
                  if (value) {
                    console.log('calling onShown', value);
                    onShown();
                  }
                });
                $watch('currentColumn', value => {
                  if (value == 2.2) {
                    console.log('before: isVisible = true');
                    isVisible = true;
                    console.log('after: isVisible = true');
                  } else {
                    isVisible = false;
                  }
                });
              " x-data="{
                  isVisible: false,
                  scale: 1,
                  template_name: 'documents`templates' + selectedDocument?.config?.template_name || 'template1',
                  onShown() { 
                    this.fitToScreen();
                  },
                  zoomOut() {
                    this.scale = Math.max(this.scale - 0.1, 0.3);
                    this.updateScale();
                  },
                  zoomIn() {
                    this.scale = Math.min(this.scale + 0.1, 0.7);
                    this.updateScale();
                  },
                  fitToScreen() {
                    // wait 1 millisecond before executing the code
                    setTimeout(() => { 
                      const pageContainer = this.$refs.pageContainer;
                      if (!pageContainer.querySelector('#pageone')) {
                        return;
                      } 
                      const page = pageContainer.querySelector('#pageone');
                      const pageWidth = page.offsetWidth;
                      const pageContainerWidth = pageContainer.offsetWidth;
                      console.log('pageWidth', pageWidth);
                      console.log('pageContainerWidth', pageContainerWidth);
                      this.scale = Math.min(Math.max((pageContainerWidth / pageWidth), 0.2), 4);
                      if (this.scale < 1) {
                        this.scale = Math.min(Math.max((pageContainerWidth / pageWidth), 0.2), 4);
                        console.log('scale', this.scale);
                        this.updateScale();
                      }
                    }, 1);
                  },
                  updateScale() {
                    const pages = document.querySelectorAll('.page');
                    console.log('pages', pages);
                    pages.forEach(page => {
                      page.style.transform = `scale(${this.scale})`;
                    });
                  },
                }">


      <div class="buttons-container absolute bottom-5 mx-auto flex z-50 ">
        <button @click="zoomOut" class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded">Zoom Out</button>
        <button @click="fitToScreen" class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded ml-2">Fit to
          Screen</button>
        <button @click="zoomIn" class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded ml-2">Zoom In</button>
        <a class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded ml-2"
          href="/document/{{ selectedDocument.slug }}.pdf">jsPdf</a>
      </div>
      <div x-ref="pageContainer" class="mr-2" id="pages">
        <div id="preview" x-html="await window.loadPreview(selectedDocument?.slug);"></div>
        <template x-if="! selectedDocument">
          <p>Nothing to preview, Please select a document</p>
        </template>
      </div>
    </div>
  </div>
  {{> documents/slide }}
</div>