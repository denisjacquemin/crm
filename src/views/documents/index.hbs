<div x-data="{
            slideContentPartialName: null, 
            documents: {{ stringify documents }},
            selectedDocumentIndex: {{ stringify selectedDocumentIndex }},
            selectedDocument: null,
            newDocumentButton: async function() {
                try {
                    const csrfToken = document.querySelector('meta[name=csrf-token]').getAttribute('content');
                    const response = await fetch('/document/newAjax', { 
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    }
                    });              
                    const newDocument = await response.json();
                    console.log('data from newAjax', newDocument);
                    this.documents.unshift(newDocument);
                    this.selectedDocumentIndex = 0;
                    this.selectedDocument = newDocument;
                    this.currentColumn = 2.1;
                    this.updateNewUrl(newDocument.slug);
                    this.showCol2();
                } catch (error) { 
                    console.error('Error creating new document', error); 
                }
            },
            showCol2: function() {
                this.$refs.col1.classList.remove('translate-x-0');
                this.$refs.col1.classList.add('-translate-x-full');
                this.$refs.col2.classList.remove('translate-x-0');
                this.$refs.col2.classList.add('-translate-x-full');
            },
            showCol1: function() {
                this.$refs.col1.classList.remove('-translate-x-full');
                this.$refs.col1.classList.add('translate-x-0');
                this.$refs.col2.classList.remove('-translate-x-full');
                this.$refs.col2.classList.add('translate-x-0');
            },
            toggleTab: function(tabRef) {
                // Hide all tabs and remove highlight
                document.getElementById('col21').classList.add('hidden');
                this.$refs.tabForm.classList.remove('text-indigo-700', 'bg-indigo-100');
                document.getElementById('col22').classList.add('hidden');
                this.$refs.tabPreview.classList.remove('text-indigo-700', 'bg-indigo-100');

                // Show selected tab and add highlight
                if (tabRef === 'tabForm') {
                    document.getElementById('col21').classList.remove('hidden');
                    this.$refs.tabForm.classList.add('text-indigo-700', 'bg-indigo-100');
                } else if (tabRef === 'tabPreview') {
                    document.getElementById('col22').classList.remove('hidden');
                    this.$refs.tabPreview.classList.add('text-indigo-700', 'bg-indigo-100');
                } 
            },
            formatUnixTimestamp: function(timestamp, format) {
                if (!timestamp) {
                    return '';
                }
                var date;
                if (typeof timestamp === 'string' && timestamp.includes('-')) {
                    // ISO 8601 string
                    date = dayjs(timestamp);
                } else {
                    // Unix timestamp
                    date = dayjs.unix(Number(timestamp));
                }
                return date.format(format);
            }
     }"
     x-init="
        $watch('navState', () => { 
            console.log('navState changed to ' + navState);
            if (navState === 'back') {
                showCol2();
            } else {
                showCol1();
            }
        }
     );"
     class="flex-1 overflow-hidden 2xl:container 2xl:m-auto">
    <div class="w-[200%] sm:w-full flex flex-nowrap h-full">
        <div x-ref="col1" class="w-full sm:max-w-[300px] md:max-w-[360px] flex flex-col overflow-y-hidden transition-transform duration-500 ease-in-out sm:transform sm:translate-x-0">
            <div x-ref="actionBar" class="flex items-center justify-center">
                <button type="button" id="newDocumentButton"
                    class="mx-3 sm:mx-2 inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
                    @click.prevent="newDocumentButton">      
                    <svg class="-ml-0.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M9 9V6a1 1 0 012 0v3h3a1 1 0 010 2h-3v3a1 1 0 01-2 0V11H6a1 1 0 010-2h3z" clip-rule="evenodd" />
                    </svg>
                    New Invoice / Quote / ...
                </button>
            </div>
            <div class="pl-3 sm:mx-2 flex items-center shadow-md" 
                    x-data="{
                        searchDocumentTerm: '',
                        sortBy: 'createdAt:asc',
                        searchDocument: function() {
                        const sortByParam = this.sortBy ? '&sort=' + encodeURIComponent(this.sortBy) : '';
                        fetchUrl('/documents/search?q=' + encodeURIComponent(this.searchDocumentTerm.trim() || '*') + sortByParam, 'GET')
                            .then(data => {
                            documents = JSON.parse(data);
                            })
                            .catch(error => {
                            console.error('Error searching for documents', error);
                            });
                        }
                    }" 
                    x-init="
                        $watch('searchDocumentTerm', () => { searchDocument() });
                    ">
                <input x-model.debounce.200ms="searchDocumentTerm" x-on:keydown.enter.prevent="searchDocument()" type="text"
                    class="block w-full rounded-md border-0 py-1.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm leading-6"
                    placeholder="Filter by buyers's name, VAT number, address, ... " autocomplete="off">

                <div x-data="Components.menu({ open: false })" 
                    x-init="init()"
                    @keydown.escape.stop="open = false; focusButton()" @click.away="onClickAway($event)"
                    class="relative inline-block text-left pl-3 pr-3 pt-3 pb-2">

                    <div>
                        <button type="button" class="-m-2 inline-flex items-center justify-center rounded-md p-2 text-gray-400"
                            id="menu-button" x-ref="button" @click="onButtonClick()" @keyup.space.prevent="onButtonEnter()"
                            @keydown.enter.prevent="onButtonEnter()" aria-expanded="true" aria-haspopup="true"
                            x-bind:aria-expanded="open.toString()" @keydown.arrow-up.prevent="onArrowUp()"
                            @keydown.arrow-down.prevent="onArrowDown()">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M3 4.5h14.25M3 9h9.75M3 13.5h9.75m4.5-4.5v12m0 0l-3.75-3.75M17.25 21L21 17.25" />
                            </svg>
                        </button>
                    </div>

                    <div x-show="open" x-transition:enter="transition ease-out duration-100"
                        x-transition:enter-start="transform opacity-0 scale-95"
                        x-transition:enter-end="transform opacity-100 scale-100" x-transition:leave="transition ease-in duration-75"
                        x-transition:leave-start="transform opacity-100 scale-100"
                        x-transition:leave-end="transform opacity-0 scale-95"
                        class="absolute right-0 z-10 mt-2 w-56 origin-top-right divide-y divide-gray-100 rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none"
                        x-ref="menu-items" x-description="Dropdown menu, show/hide based on menu state."
                        x-bind:aria-activedescendant="activeDescendant" role="menu" aria-orientation="vertical"
                        aria-labelledby="menu-button" tabindex="-1" @keydown.arrow-up.prevent="onArrowUp()"
                        @keydown.arrow-down.prevent="onArrowDown()" @keydown.tab="open = false"
                        @keydown.enter.prevent="open = false; focusButton()" @keyup.space.prevent="open = false; focusButton()">
                        <div class="px-4 py-3" role="none">
                            <p class="text-sm" role="none">Sort by</p>
                        </div>
                        <ul class="py-1" role="none" x-data="{ menuItems: [
                                { label: 'Latest first', sortValue: 'createdAt:asc' },
                                { label: 'Oldest first', sortValue: 'createdAt:desc' },
                                { label: 'Last updated first', sortValue: 'updatedAt:asc' },
                                { label: 'Older updated first', sortValue: 'updatedAt:desc' }
                            ] }">
                            <!-- Template for each menu item -->
                            <template x-for="(item, index) in menuItems" :key="index">
                            <li class="relative">
                                <a x-text="item.label" href="#" class="text-gray-700 block px-4 py-2 text-sm" :class="{
                                            'bg-indigo-600 text-white': sortBy === item.sortValue,
                                            'text-gray-700': sortBy !== item.sortValue
                                        }" role="menuitem" tabindex="-1" :id="`menu-item-${index}`"
                                @mouseenter="onMouseEnter($event)" @mousemove="onMouseMove($event, index)"
                                @mouseleave="onMouseLeave($event)"
                                @click.prevent="sortBy = item.sortValue; open = false; searchDocument(); focusButton()">
                                </a>
                                <span x-show="sortBy === item.sortValue"
                                class="absolute inset-y-0 right-0 flex items-center pr-4 text-white">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
                                    class="h-5 w-5">
                                    <path fill-rule="evenodd"
                                    d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                                    clip-rule="evenodd"></path>
                                </svg>
                                </span>
                            </li>
                            </template>
                        </ul>
                    </div>

                </div>
            </div>
            <div x-ref="documentsList" class="flex-1 overflow-y-scroll"
            x-data="{ 
                    editDocument: async function(index) {
                    try {
                        selectedDocumentIndex = index;
                        const response = await fetch(`/document/editAjax/${documents[selectedDocumentIndex].slug}`);
                        const data = await response.json()
                        documents[selectedDocumentIndex] = deepMergeObjects(documents[selectedDocumentIndex], data);  
                        updateNewUrl(documents[selectedDocumentIndex].slug);  {{!-- update the url with to document/edit + slug --}}
                        selectedDocument = documents[selectedDocumentIndex];
                        showCol2();
                    } catch (error) { console.error('Error editing document', error); }
                    }
                }">
                <template x-if="documents.length === 0">
                    <div class="py-2 text-gray-500">No documents found.</div>
                </template>

                <template x-if="documents.length > 0">
                    <ul role="list" class="divide-y divide-gray-100">
                        <template x-for="(document  , index) in documents" :key="index">
                            <li class="relative py-5 hover:bg-gray-100 cursor-pointer" role="listitem"
                                @click.prevent="if (window.innerWidth < 640) $dispatch('updatenavbutton', {value: 'back'}); editDocument(index);"
                                :data-slug="document.slug"
                                
                            >
                            <div class="px-4">
                                <div class="mx-auto flex max-w-4xl justify-between gap-x-6">
                                    <div class="flex flex-1 min-w-0 gap-x-4">
                                        <div class="min-w-0 flex-auto">
                                            <div x-text="document?.config?.buyer?.name" 
                                                 class="text-sm font-semibold leading-6 text-gray-900 line-clamp-2"
                                                 :class="{
                                                    'text-indigo-700': selectedDocumentIndex === index,
                                                    'text-gray-900': selectedDocumentIndex !== index
                                                 }">
                                            </div>
                                            <div class="mt-1 flex text-xs leading-5 text-gray-500">
                                                <div x-text="document?.config?.invoice_number" class="relative truncate w-1/3 text-left"></div>
                                                <div x-text="formatUnixTimestamp(document?.config?.invoice_date, 'MM/DD/YYYY')" class="relative truncate w-1/3 text-center"></div>
                                                <div x-text="document?.config?.amounts?.total" class="relative truncate w-1/3 text-right"></div>
                                            </div>
                                            <div x-text="document?.config?.items && document?.config?.items[0]?.description" class="text-sm font-semibold leading-6 text-gray-900 line-clamp-2"></div>
                                        </div>
                                    </div>
                                    <div class="flex shrink-0 items-center gap-x-4">
                                        <svg :class="{
                                                    'text-indigo-700 font-medium': selectedDocumentIndex === index,
                                                    'text-gray-400 font-normal': selectedDocumentIndex !== index
                                                 }"
                                                class="h-5 w-5 flex-none " viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                        </svg>
                                    </div>
                                </div>
                            </div>
                            </li>
                        </template>
                    </ul> 
                </template>
               
            </div>
        </div>
        <div x-ref="col2" class="w-full sm:border-l sm:border-gray-200 md:flex-1 flex flex-col overflow-hidden transition-transform duration-500 ease-in-out sm:transform sm:translate-x-0">
            <div x-ref="col2Tabs" class="px-4 2xl:hidden">
                <div class="border-b border-gray-200">
                    <nav class="flex" aria-label="Tabs">
                    <!-- Current: "bg-gray-100 text-gray-700", Default: "text-gray-500 hover:text-gray-700" -->
                    <div x-ref="tabForm" @click="toggleTab('tabForm')"
                        class="cursor-pointer text-indigo-700 bg-indigo-100 m-2 flex-grow text-center rounded-md px-3 py-2 text-md font-medium">Form</div>
                    <div class="border border-gray-200 my-1"></div>
                    <div x-ref="tabPreview" @click="toggleTab('tabPreview');$dispatch('tabpreviewshown');"
                        class="cursor-pointer m-2 flex-grow text-center rounded-md px-3 py-2 text-md font-medium">Preview</div>
                    </nav>
                </div>
            </div>
            <div class="flex-1 flex overflow-hidden">
                <div id="col21" class="flex-1 w-full overflow-y-scroll p-4 2xl:w-auto 2xl:min-w-[350px] 2xl:max-w-[350px]">
                    <template x-if="selectedDocument">
                        {{> documents/edit_form }}
                    </template>
                    <template x-if="! selectedDocument">
                        <p>Please select a document</p>
                    </template>
                </div>
                <div id="col22" 
                     class="hidden w-full 2xl:flex-1 2xl:block 2xl:w-auto"
                     @tabpreviewshown.window="fitToScreen()"
                     x-init="
                          $watch('selectedDocument.slug', () => { 
                            loadPreview(selectedDocument.slug).then(data => {
                                previewData = data;
                            });
                          });
                     "
                     x-data="{
                        scale: 1,
                        template_name: 'documents`templates' + selectedDocument?.config?.template_name || 'template1',
                        onShown() { 
                            this.fitToScreen();
                        },
                        zoomOut() {
                            this.scale = Math.max(this.scale - 0.1, 0.3);
                            this.updateScale();
                        },
                        zoomIn() {
                            this.scale = Math.min(this.scale + 0.1, 0.7);
                            this.updateScale();
                        },
                        fitToScreen() {
                            setTimeout(() => {
                                // wait 1 millisecond before executing the code
                                const pageContainer = this.$refs.pageContainer;
                                if (!pageContainer.querySelector('#pageone')) {
                                    return;
                                } 
                                const page = pageContainer.querySelector('#pageone');
                                const pageWidth = page.offsetWidth;
                                console.log('pageWidth', pageWidth);
                                const pageContainerWidth = pageContainer.offsetWidth - 60 ;
                                
                                console.log('pageContainerWidth', pageContainerWidth);
                                this.scale = Math.min(Math.max((pageContainerWidth  / pageWidth), 0.2), 4);
                                if (this.scale < 1) {
                                    this.scale = Math.min(Math.max((pageContainerWidth / pageWidth), 0.2), 4);
                                    console.log('scale', this.scale);
                                    this.updateScale();
                                }
                            }, 1);
                        },
                        updateScale() {
                            const pages = document.querySelectorAll('.page');
                            console.log('pages', pages);
                            pages.forEach(page => {
                                page.style.transform = `scale(${this.scale})`;
                            });
                        },
                        previewData: '',
                        loadPreview: async function(slug) {
                            let data = '';
                            if (slug !== undefined) {
                                try {
                                    const response = await fetch('/document/preview/' + slug + '?nl=true');
                                    data = await response.text();
                                } catch (error) {
                                    console.error(error);
                                }
                            }
                            return data;
                        }
                    }">
                    <div class="buttons-container absolute bottom-5 mx-auto flex z-50 ">
                        <button @click="zoomOut" class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded">Zoom Out</button>
                        <button @click="fitToScreen" class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded ml-2">Fit to
                        Screen</button>
                        <button @click="zoomIn" class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded ml-2">Zoom In</button>
                        <a class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded ml-2"
                        href="/document/{{ selectedDocument.slug }}.pdf">jsPdf</a>
                    </div>
                    <div x-ref="pageContainer" class="mr-2" id="pages">
                        <div id="preview" x-html="previewData"></div>
                            <template x-if="! selectedDocument">
                                <p>Nothing to preview, Please select a document</p>
                            </template>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>  
</div>