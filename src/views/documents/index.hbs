                    }">
                    <template x-if="! selectedDocument">
                        <div class="relative block p-4 w-full h-full text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                            <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto h-12 w-12 text-gray-400">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                                </svg>
                                <span class="mt-2 block text-md font-semibold text-gray-500">{{t 'documents.views.index.nothing_to_preview' }}</span>
                            </div>
                        </div>
                    </template>
                    <template x-if="selectedDocument">
                        <div x-init="loadPreview(selectedDocument.slug).then(data => {
                                previewData = data;
                             });
                             $watch('selectedDocument.slug', () => { 
                                loadPreview(selectedDocument.slug).then(data => {
                                    previewData = data;
                                });
                             });" 
                            x-ref="pageContainer" class="h-full overflow-auto flex flex-col" id="pages">

                            <div class="toolbar gap-x-4 z-50 sticky flex-1 top-0 w-full flex justify-center bg-gray-700 py-2 text-white"
                                
                                x-data="{
                                    printDiv(divId) {
                                        // Get the HTML of div
                                        var divElements = document.getElementById(divId).innerHTML;

                                        // Create a new invisible iframe
                                        var iframe = document.createElement('iframe');
                                        iframe.style.visibility = 'hidden';
                                        iframe.style.position = 'fixed';
                                        iframe.style.right = '0';
                                        iframe.style.bottom = '0';

                                        document.body.appendChild(iframe);

                                        // Write the div content and CSS into it
                                        iframe.contentDocument.write('<html><head><title></title><style>');
                                        iframe.contentDocument.write('body { margin: 0; padding:0; }'); // Add margin:0 to body
                                        iframe.contentDocument.write('</style></head><body>');
                                        iframe.contentDocument.write(divElements);
                                        iframe.contentDocument.write('</body></html>');
                                        iframe.contentDocument.close();

                                        // Print it
                                        iframe.contentWindow.print();

                                        // Remove the iframe when done
                                        iframe.parentNode.removeChild(iframe);
                                    }
                                }"
                                x-init="
                                document.addEventListener('keydown', function(event) {
                                    if ((event.metaKey || event.ctrlKey) && event.key === 'p') {
                                        event.preventDefault();
                                        printDiv('printme');
                                    }
                                });">
                                <a x-bind:href="'/document/' + selectedDocument.slug + '.pdf'" class="cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 ">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                                    </svg>
                                </a>
                                <a @click="printDiv('printme')" class="cursor-pointer">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6.72 13.829c-.24.03-.48.062-.72.096m.72-.096a42.415 42.415 0 0 1 10.56 0m-10.56 0L6.34 18m10.94-4.171c.24.03.48.062.72.096m-.72-.096L17.66 18m0 0 .229 2.523a1.125 1.125 0 0 1-1.12 1.227H7.231c-.662 0-1.18-.568-1.12-1.227L6.34 18m11.318 0h1.091A2.25 2.25 0 0 0 21 15.75V9.456c0-1.081-.768-2.015-1.837-2.175a48.055 48.055 0 0 0-1.913-.247M6.34 18H5.25A2.25 2.25 0 0 1 3 15.75V9.456c0-1.081.768-2.015 1.837-2.175a48.041 48.041 0 0 1 1.913-.247m10.5 0a48.536 48.536 0 0 0-10.5 0m10.5 0V3.375c0-.621-.504-1.125-1.125-1.125h-8.25c-.621 0-1.125.504-1.125 1.125v3.659M18 10.5h.008v.008H18V10.5Zm-3 0h.008v.008H15V10.5Z" />
                                    </svg>

                                </a>
                            </div>
                            <div id="preview" x-html="previewData" style="margin:0 auto"></div>
                            <div class="buttons-container absolute bottom-5 mx-auto flex z-50 ">
                                <button @click="zoomOut" class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded">Zoom Out</button>
                                <button @click="fitToScreen" class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded ml-2">Fit to
                                Screen</button>
                                <button @click="zoomIn" class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded ml-2">Zoom In</button>
                                <a class="text-black bg-gray-200 bg-opacity-70 px-4 py-2 rounded ml-2"target="_blank" x-bind:href="'/document/' + selectedDocument.slug + '.pdf'">jsPdf</a>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
            
        </div>
    </div> 
    {{> documents/slide }}
</div>