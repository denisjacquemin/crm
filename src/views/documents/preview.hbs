<div class="text-center"
    x-data="{
        doc_lang: '{{doc_lang}}',
    }"
    x-init="
        if (typeof selectedDocument === 'undefined') {
            {{!-- When generating pdf, selectedDocument doesn't exist yet --}}
            $data.selectedDocument = {{stringify document}};
        }
    "
>
    {{> (concat 'documents/templates/' template_name)}}

</div>