<div class="text-center"
     @tabpreviewshown.window="initPinchZoom()"
     x-data="{
        scale: 1.0,
        initPinchZoom() {
            console.log('initPinchZoom');
                    
            const pages = document.querySelectorAll('.page');
            pages.forEach(page => {
                new PinchZoom(page);
            });
        }   
     }"
     x-init="
        if (typeof selectedDocument === 'undefined') {
            {{!-- When generating pdf, selectedDocument doesn't exist yet --}}
            $data.selectedDocument = {{stringify document}};
        }

        
     "
>
    {{> (concat 'documents/templates/' template_name)}}

</div>