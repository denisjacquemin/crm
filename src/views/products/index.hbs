<div class="flex w-[200%] h-full overflow-hidden sm:w-full"
     x-data="{
        showProductForm: function() {
            this.$refs.productsList.style.transform = 'translateX(-100%)'; 
            this.$refs.productForm.style.transform = 'translateX(-100%)';
        },
        showProductsList: function() {
            this.$refs.productsList.style.transform = 'translateX(0)';
            this.$refs.productForm.style.transform = 'translateX(0)';
        },
        newProduct: async function() {
            try {
                const data = await fetchUrl('/products/newAjax', 'POST');
                this.selectedProduct = data;
                await this.searchProduct();
                const theProducts = this.products;
                const theSelectedProduct = this.selectedProduct;
                const index = theProducts.findIndex((product) => product.slug === theSelectedProduct.slug);                console.log('index', index, this.products, this.selectedProduct);
                if (index >= 0 ) this.products[index] = this.selectedProduct;
                if (window.innerWidth < 640) this.showProductForm();
            } catch (error) { 
                console.error('Error creating new product', error); 
            }
        },
        editProduct: async function(index) {
            try {
                const data = await fetchUrl(`/products/editAjax/${this.products[index].slug}`, 'GET');
                this.selectedProduct = data.product;
                this.products[index] = this.selectedProduct;
                if (window.innerWidth < 640) this.showProductForm();
            } catch (error) { console.error('Error editing product', error); }
        },
        deleteProduct: async function(slug) {
            try {
                const data = await fetchUrl(`/products/deleteAjax/${slug}`, 'DELETE');
                this.selectedProduct = { custom_vat_rate: { is_custom: false, value: '', label: '' } };
                localStorage.removeItem(`autosave#product#${slug}`); // if exist of course
                this.searchProduct();
                if (window.innerWidth < 640) this.showProductsList();
            } catch (error) { 
                console.log('Error deleting document', error); 
            }
        },
        selectedCountry: '{{defaultCountry}}',
        searchProductTerm: '',
        sortBy: 'createdAtdesc',
        searchProduct: async function() {
            const sortByParam = this.sortBy ? '&sort=' + encodeURIComponent(this.sortBy) : '';
            await fetchUrl('/products/search?q=' + encodeURIComponent(this.searchProductTerm.trim() || '*') + sortByParam, 'GET')
                .then(data => {
                    this.products = data;
                })
                .catch(error => {
                    console.error('Error searching for products', error);
                });
        },
        products: {{ stringify products }},
        selectedProduct: { custom_vat_rate: { is_custom: false, value: '', label: '' } },
     }"
     x-init="
       $watch('selectedProduct', (value, oldValue) => {
          var product = { ...value };
          if (Object.keys(product).length !== 0) {
            if (product.custom_vat_rate.is_custom || product.vat === '') {
                product.vat = null;
            } else {
                product.custom_vat_rate.value = '';
                product.custom_vat_rate.label = '';
            }
            if (product.slug) {
                product.autosave_updated_at = new Date();
                localStorage.setItem('autosave#product#' + value.slug, JSON.stringify(product));
            }
          }
        });
     ">
    <div x-ref="productsList"
         class="flex w-[50%] flex-col h-full sm:max-w-[330px] lg:max-w-[380px] transition-transform duration-500 ease-in-out">
        {{!-- <a href="#" @click.prevent="showProductForm">Show Form</a> --}}
        <div class="w-full px-2 sm:pr-2 flex items-center">
            <button type="button" id="newDocumentButton"
                class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
                @click.prevent="newProduct">      
                <svg class="-ml-0.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M9 9V6a1 1 0 012 0v3h3a1 1 0 010 2h-3v3a1 1 0 01-2 0V11H6a1 1 0 010-2h3z" clip-rule="evenodd" />
                </svg>
                {{t 'products.views.index.create_new_product' }}
            </button>
        </div>
        <div class="w-full px-2 sm:pr-2 flex items-center shadow-md sm:shadow-none" 
            x-init="
                $watch('searchProductTerm', () => { searchProduct() });
            ">
            <input x-model.debounce.200ms="searchProductTerm" x-on:keydown.enter.prevent="searchProduct()" type="text"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm leading-6"
                placeholder="{{t 'products.views.index.search_placeholder' }}" autocomplete="off">

            <div x-data="Components.menu({ open: false })" 
                x-init="init()"
                @keydown.escape.stop="open = false; focusButton()" @click.away="onClickAway($event)"
                class="relative inline-block text-left pl-3 pr-3 pt-3 pb-2">

                <div>
                    <button type="button" class="-m-2 inline-flex items-center justify-center rounded-md p-2 text-gray-400"
                        id="menu-button" x-ref="button" @click="onButtonClick()" @keyup.space.prevent="onButtonEnter()"
                        @keydown.enter.prevent="onButtonEnter()" aria-expanded="true" aria-haspopup="true"
                        x-bind:aria-expanded="open.toString()" @keydown.arrow-up.prevent="onArrowUp()"
                        @keydown.arrow-down.prevent="onArrowDown()">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                        stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M3 4.5h14.25M3 9h9.75M3 13.5h9.75m4.5-4.5v12m0 0l-3.75-3.75M17.25 21L21 17.25" />
                        </svg>
                    </button>
                </div>

                <div x-show="open" x-transition:enter="transition ease-out duration-100"
                    x-transition:enter-start="transform opacity-0 scale-95"
                    x-transition:enter-end="transform opacity-100 scale-100" x-transition:leave="transition ease-in duration-75"
                    x-transition:leave-start="transform opacity-100 scale-100"
                    x-transition:leave-end="transform opacity-0 scale-95"
                    class="absolute right-0 z-10 mt-2 w-60 origin-top-right divide-y divide-gray-100 rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none"
                    x-ref="menu-items" x-description="Dropdown menu, show/hide based on menu state."
                    x-bind:aria-activedescendant="activeDescendant" role="menu" aria-orientation="vertical"
                    aria-labelledby="menu-button" tabindex="-1" @keydown.arrow-up.prevent="onArrowUp()"
                    @keydown.arrow-down.prevent="onArrowDown()" @keydown.tab="open = false"
                    @keydown.enter.prevent="open = false; focusButton()" @keyup.space.prevent="open = false; focusButton()">
                    <div class="px-4 py-3" role="none">
                        <p class="text-sm" role="none">{{t 'products.views.index.sort_by' }}</p>
                    </div>
                    <ul class="py-1" role="none" x-data="{ menuItems: [
                            { label: '{{t 'products.views.index.creation_date' }}', sortValue: 'createdAtdesc' },
                            { label: '{{t 'products.views.index.name' }}', sortValue: 'nameasc' },
                        ] }">
                        <!-- Template for each menu item -->
                        <template x-for="(item, index) in menuItems" :key="index">
                            <li class="relative">
                                <a x-text="item.label" href="#" class="text-gray-700 block px-4 py-2 text-sm" :class="{
                                            'bg-indigo-600 text-white': sortBy === item.sortValue,
                                            'text-gray-700': sortBy !== item.sortValue
                                        }" role="menuitem" tabindex="-1" :id="`menu-item-${index}`"
                                @mouseenter="onMouseEnter($event)" @mousemove="onMouseMove($event, index)"
                                @mouseleave="onMouseLeave($event)"
                                @click.prevent="sortBy = item.sortValue; open = false; searchProduct(); focusButton()">
                                </a>
                                <span x-show="sortBy === item.sortValue"
                                    class="absolute inset-y-0 right-0 flex items-center pr-4 text-white">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
                                        class="h-5 w-5">
                                        <path fill-rule="evenodd"
                                        d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                                        clip-rule="evenodd"></path>
                                    </svg>
                                </span>
                            </li>
                        </template>
                    </ul>
                </div>

            </div>
        </div>
        <div class="flex-1 w-full overflow-y-scroll">
            <template x-if="products.length === 0">
                <div class="relative block w-full h-full p-2 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto h-12 w-12 text-gray-400">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                        </svg>
                        <span class="mt-2 block text-md font-semibold text-gray-500">{{t 'products.views.index.no_product_found' }}</span>
                    </div>
                </div>
            </template>

            <template x-if="products.length > 0">
                <ul role="list" class="divide-y divide-gray-100">
                    <template x-for="(product, index) in products" :key="index">
                        <li class="relative py-2 hover:bg-gray-100 cursor-pointer" role="listitem"
                            @click.prevent="editProduct(index);"
                            :data-slug="product.slug"
                            
                        >
                        <div class="px-4">
                            <div class="mx-auto flex max-w-4xl justify-between gap-x-6">
                                <div class="flex flex-1 min-w-0">
                                    <div class="min-w-0 flex-auto">
                                        <div >
                                            <span x-text="product?.name" 
                                                class="text-sm font-semibold leading-6 text-gray-900 line-clamp-2"
                                                :class="{
                                                'text-indigo-700': selectedProduct.slug === product.slug,
                                                'text-gray-900': selectedProduct.slug !== product.slug
                                                }"></span>
                                            <span class="text-xs text-indigo-600" x-text="product?.reference"></span>
                                        </div>
                                        <div class="mt-1 flex text-xs leading-5 text-gray-500">
                                            <div x-text="product?.description" class="relative truncate w-full text-left h-5"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex shrink-0 items-center gap-x-4">
                                    <svg :class="{
                                                'text-indigo-700 font-medium': selectedProduct.slug === product.slug,
                                                'text-gray-400 font-normal': selectedProduct.slug !== product.slug
                                                }"
                                            class="h-5 w-5 flex-none " viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                        </li>
                    </template>
                </ul> 
            </template>
        </div>
    </div>
    <div x-ref="productForm"
         class="pb-5 w-[50%] h-full border-l border-gray-200 flex flex-col sm:flex-1 transition-transform duration-500 ease-in-out">
        <div x-cloak x-show="!selectedProduct.slug" class="relative block w-full h-full p-5 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
            <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto h-12 w-12 text-gray-400">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                </svg>
                <span class="mt-2 block text-md font-semibold text-gray-500">{{t 'products.views.index.no_product_selected' }}</span>
            </div>
        </div>
        
        <div x-cloak x-show="selectedProduct.slug" class="flex flex-col h-full">
            <div class="w-full py-2 mb-3 sm:pr-2 text-right flex shadow-md sm:shadow-none">
                <div class="w-1/2 text-left sm:hidden">
                    <button @click.prevent="if (window.innerWidth < 640) showProductsList();"
                        href="#" class="px-3.5 py-2.5 text-sm font-semibold text-gray-600 hover:text-gray-400">      
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                        </svg>
                    </button>
                </div>
                <div class="w-1/2 text-right my-auto sm:w-full">
                    <a href="#"
                        class="underline px-3.5 py-2.5 text-sm font-semibold text-red-600 hover:text-red-400"
                            @click.prevent="if (confirm('{{t 'products.views.index.delete_confirm' }}')) deleteProduct(selectedProduct.slug)">      
                        {{t 'products.views.index.delete' }}
                    </a>
                </div>
            </div>
            
            <div class="px-4 flex-1 flex flex-col gap-y-4 overflow-y-scroll">
                <div>
                    <label for="name" class="block text-sm font-medium leading-6 text-gray-900">{{t 'products.views.index.name_label' }}</label>
                    <input type="text" x-model="selectedProduct.name" autocomplete="off"
                        placeholder="{{t 'products.views.index.name_placeholder' }}" id="name"
                        class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                </div>
                <div>
                    <label for="description" class="block text-sm font-medium leading-6 text-gray-900">{{t 'products.views.index.description_label' }}</label>
                    <textarea x-model="selectedProduct.description" autocomplete="off" rows="2"
                        placeholder="{{t 'products.views.index.description_placeholder' }}" id="description"
                        class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </textarea>
                </div>
                <div>
                    <label for="reference" class="block text-sm font-medium leading-6 text-gray-900">{{t 'products.views.index.reference_label' }}</label>
                    <input type="text" x-model="selectedProduct.reference" autocomplete="off"
                        placeholder="{{t 'products.views.index.reference_placeholder' }}" id="reference"
                        class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                </div>
                <div>
                    <label for="vat" class="block text-sm font-medium leading-6 text-gray-900">{{t 'products.views.index.vat_label' }}</label>
                    <select x-show="!selectedProduct?.custom_vat_rate?.is_custom" x-model="selectedProduct.vat" id="vat" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                        <!-- Empty value option -->
                        <option value="" selected></option> 
                        <optgroup :label="'{{t 'documents.views.index.items_modal.standard_taxrates' }}' + ' (' + countries[current_company_country].name + ')'">
                            <template x-for="(rate, index) in countries[current_company_country].taxrates" :key="index">
                                <option :value="rate._id" 
                                        :selected="selectedProduct.vat === rate._id || default_taxrate === rate._id"
                                        x-text="`${rate.label}`"></option>
                            </template>
                        </optgroup>
                        <optgroup x-show="custom_taxrates.length > 0" label="{{ t 'documents.views.index.items_modal.custom_taxrates' }}">
                            <template x-for="(rate, index) in custom_taxrates" :key="index">
                                <option :value="rate._id" 
                                        :selected="selectedProduct.vat === rate._id || default_taxrate === rate._id"
                                        x-text="`${rate.label} (${rate.value}%)`"></option>
                            </template>
                        </optgroup>
                    </select>
                    <div class="flex gap-x-2" x-show="selectedProduct?.custom_vat_rate?.is_custom">
                        <div class="w-20 relative rounded-md shadow-sm">
                            <input type="text" x-model="selectedProduct.custom_vat_rate.value"
                                   class="text-right block w-full rounded-md border-0 py-1.5 pr-7 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"  >
                            <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2">
                                <span class="text-gray-500 sm:text-sm">%</span>
                            </div>
                        </div>
                        <input type="text" x-model="selectedProduct.custom_vat_rate.label" placeholder="{{t 'documents.views.index.items_modal.vat_rate_label' }}"
                            class="flex-1 block w-full rounded-md border-0 py-1.5 pr-12 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" >
                    </div>
                    <div class="mt-1 flex justify-end align-middle">
                        {{!-- value="session.signup.company.without_vat" --}}
                        <input x-model="selectedProduct.custom_vat_rate.is_custom" @change="selectedProduct.vat = ''"
                            type="checkbox" id="custom_vat_rate" name="custom_vat_rate" class="h-4 w-4 mt-1 mr-1 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
                        <label for="custom_vat_rate" class="text-sm font-medium leading-6 text-gray-900">Custom VAT Rate</label>
                    </div>
                </div>
                <div>
                    <label for="unit_price" class="block text-sm font-medium leading-6 text-gray-900">{{t 'products.views.index.unit_price_label' }}</label>
                    <input type="text" x-model="selectedProduct.unit_price" autocomplete="off"
                        placeholder="{{t 'products.views.index.unit_price_placeholder' }}" id="unit_price"
                        class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                </div>              
            </div>
        </div>
    </div>
</div>