<!DOCTYPE html>
<html class="h-full bg-gray-50">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Milo</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <script src="/js/tailwindcss/components.js" defer></script>
    <script src="/js/vendor/alpine/alpine.3.10.5.min.js" defer></script>
    {{#each scripts}}
    <script src="{{script}}" defer></script>
    {{/each}}
    <script defer src="/js/helpers.js"></script>
</head>

<body class="h-full bg-gray-50">
    <div class="mx-auto max-w-7xl relative">
      <div class="absolute top-0 right-0 w-1/2 sm:w-1/3 md:w-1/4">

        {{> language_dropdown }}
      </div>
    </div>
    
    {{#if messages}} 
      {{messages}} 
    {{/if}} 
    
    {{> header }} 
    
    {{{body}}}

</body>

</html>