<!DOCTYPE html>
<html>

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

        <title>Milo</title>
        <meta name="csrf-token" content="{{csrfToken}}">
        <link rel="stylesheet" href="/public/css/styles.css" />
        <script type="text/javascript" src="/public/app.bundle.js"></script>
    </head>

    <body class="" 
          @updatenavbutton="navState = $event.detail.value"
          x-data="{ 
            navState: 'menu',
            companies: [],
            openSettingsModal: false,
            async loadModalContent(url, callback, focusInputId) {
                const text = await fetchUrl(url, 'GET');
                if (!text) return;
                this.$refs.modalContent.innerHTML = text;
                this.openSettingsModal = true;
                if (focusInputId) {
                    this.$nextTick(() => {
                        const inputElement = this.$refs.modalContent.querySelector(`#${focusInputId}`);
                        if (inputElement) {
                            inputElement.focus();
                        }
                    });
                }
                if (callback) callback();
            },
            async loadCompanies() {
                fetchUrl('/companies/currentusercompanies')
                    .then(data => { 
                        this.companies = data })
            },
          }"
          @loadcompanies="loadCompanies()"
          >
        
        <div class="h-screen flex flex-col">
        {{!-- <div x-text="navState" class="absolute top-0 right-0 z-50 text-red-600"></div> --}}
            {{> nav }}
            {{{body}}}

        </div>
        {{> notifications2 }}
        {{> settings_modal }}
    </body>

</html>