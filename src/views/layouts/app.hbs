<!DOCTYPE html>
<html>

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

        <title>Milo</title>
        <meta name="csrf-token" content="{{csrfToken}}">
        <link rel="stylesheet" href="/public/css/styles.css" />
        <script type="text/javascript" src="/public/app.bundle.js"></script>
        {{!-- <script type="text/javascript" src="/public/js/vendor/alpine/alpine.3.13.2.min.js" defer></script> --}}
    </head>

    <body class="" 
          @updatenavbutton="navState = $event.detail.value"
          x-data="{ 
            navState: 'menu',
            openSettingsModal: false,
            async loadModalContent(url, callback, anchor, focusInputId) {
                const text = await fetchUrl(url, 'GET');
                this.$refs.modalContent.innerHTML = text;
                this.openSettingsModal = true;
                if (anchor) {
                    this.$nextTick(() => {
                        const targetElement = this.$refs.modalContent.querySelector(`#${anchor}`);
                        if (targetElement) {
                            targetElement.scrollIntoView();
                        }
                    });
                }
                if (focusInputId) {
                    this.$nextTick(() => {
                        const inputElement = this.$refs.modalContent.querySelector(`#${focusInputId}`);
                        if (inputElement) {
                            inputElement.focus();
                        }
                    });
                }
                if (callback) callback();
            }
          }">
        
        <div class="h-screen flex flex-col">
        {{!-- <div x-text="navState" class="absolute top-0 right-0 z-50 text-red-600"></div> --}}
            {{> nav }}
            {{{body}}}

        </div>
        {{> notifications2 }}
        {{> settings_modal }}
    </body>

</html>