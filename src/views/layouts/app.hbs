<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <meta name="google" content="notranslate" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Milo</title>
    <meta name="csrf-token" content="{{csrfToken}}" />
    <link rel="stylesheet" href="/public/css/styles.css" />
    <script type="text/javascript" src="/public/app.bundle.js"></script>
    <script src="/public/static-data.js"></script>
    <script src="/public/session-checker.js"></script>
  </head>

  <body
    @updatenavbutton="navState = $event.detail.value"
    x-data="{ 
            navState: 'menu',   
            modalSize: null,
            modalTitle: null,
            modalDescription: null,
            companies: [],
            companyFiles: [],
            current_company: {{ stringify session.current_company }},
            defaultCurrency: {{ stringify defaultCurrency }},
            default_taxrate: '{{ default_taxrate}}', 
            custom_taxrates: {{ stringify session.current_company.taxrates }},
            openSettingsModal: false,
            closeModal: function() {
                this.openSettingsModal = false;
            },
            async openConfirmModal(title, message, confirmCallback) {
                this.$refs.confirmModal.open(title, message, confirmCallback);
            },
            async loadModalContent(url, options = {}) {
                const {
                    callback = null,
                    focusInputId = null,
                    size = 'medium',
                    title = '',
                    description = ''
                } = options;

                const text = await fetchUrl(url, 'GET');
                if (!text || text === 'unauthorized') return;
                
                this.modalSize = size;
                this.modalTitle = title;
                this.modalDescription = description;

                this.$refs.modalContent.innerHTML = text;
                this.openSettingsModal = true;
                
                if (focusInputId) {
                    this.$nextTick(() => {
                        const inputElement = this.$refs.modalContent.querySelector(`#${focusInputId}`);
                        if (inputElement) {
                            inputElement.focus();
                        }
                    });
                }
                if (callback) callback();
            },
            async loadCompanies() {
                const data = await fetchUrl('/companies/currentusercompanies')
                this.companies = data;
            },
            async loadCompanyFiles() {
                const data = await fetchUrl('/files/company')
                this.companyFiles = data;
            }
          }"
    @loadcompanies="loadCompanies()"
    @loadcompanyfiles="loadCompanyFiles()"
    x-init="
            Object.assign($data, window.staticData);
            frequentlySelectedCurrencies = countries[current_company.country].currencies;
            dayjs.locale('{{session.user.language}}');
          "
  >
    <div x-data="tooltip">
      {{> tooltip}}

      <div class="h-screen flex flex-col">{{> nav }} {{{body}}}</div>
      {{> modal }} {{> notifications2 }} {{!-- {{> confirm_modal }} --}}
    </div>
  </body>
</html>
