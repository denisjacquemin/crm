<!DOCTYPE html>
<html>

    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

        <title>Milo</title>
        <meta name="csrf-token" content="{{csrfToken}}">
        <link rel="stylesheet" href="/public/css/styles.css" />
        <script type="text/javascript" src="/public/app.bundle.js"></script>
    </head>

    <body @updatenavbutton="navState = $event.detail.value" `
          x-data="{ 
            navState: 'menu',   
            modalSize: null,
            companies: [],
            companyFiles: [],
            default_taxrate: '{{ default_taxrate}}',
            countries: {{ stringify countries }},
            custom_taxrates: {{ stringify session.current_company.taxrates }},
            frequentlySelectedCountries: {{ stringify frequentlySelectedCountries }},
            current_company_country: '{{ session.current_company.country }}',
            defaultCurrency: {{ stringify defaultCurrency }},
            frequentlySelectedCurrencies: {{ stringify frequentlySelectedCurrencies }},
            currencies: {{ stringify currencies }},
            openSettingsModal: false,
            closeModal: function() {
                this.openSettingsModal = false;
            },
            async openConfirmModal(title, message, confirmCallback) {
                this.$refs.confirmModal.open(title, message, confirmCallback);
            },
            async loadModalContent(url, callback, focusInputId, size = 'medium') {
                
                
                const text = await fetchUrl(url, 'GET');
                if (!text) return;
                this.modalSize = size;

                this.$refs.modalContent.innerHTML = text;
                this.openSettingsModal = true;
                if (focusInputId) {
                    this.$nextTick(() => {
                        const inputElement = this.$refs.modalContent.querySelector(`#${focusInputId}`);
                        if (inputElement) {
                            inputElement.focus();
                        }
                    });
                }
                if (callback) callback();
            },
            async loadCompanies() {
                const data = await fetchUrl('/companies/currentusercompanies')
                this.companies = data;
            },
            async loadCompanyFiles() {
                const data = await fetchUrl('/files/company')
                this.companyFiles = data;
            }
          }"
          @loadcompanies="loadCompanies()"
          @loadcompanyfiles="loadCompanyFiles()"
          x-init="dayjs.locale('{{session.user.language}}');"
        >
        
        <div class="h-screen flex flex-col">
        {{!-- <div x-text="navState" class="absolute top-0 right-0 z-50 text-red-600"></div> --}}
            {{> nav }}
            {{{body}}}
        </div>
        {{> modal }}
        {{> notifications2 }}
        {{!-- {{> confirm_modal }} --}}
    </body>

</html>