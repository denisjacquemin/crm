<div x-data="{
        currentTab: {{currentTab}},
        selectedId: null,
        init() {
            // Set the currentTab tab on the page on page load.
            this.$nextTick(() => this.select(this.$id('tab', this.currentTab)))
        },
        select(id) {
            console.log('select', id);
            console.trace();
            this.selectedId = id
        },
        isSelected(id) {
            return this.selectedId === id
        },
        whichChild(el, parent) {
            return Array.from(parent.children).indexOf(el) + 1
        }
     }"
     x-id="['tab']"
    class="h-full w-full flex flex-1 flex-col pt-2 sm:flex-row sm:gap-x-4 md:gap-x-8">
    <div class="px-2 pb-2 flex-none shadow-md z-10 sm:hidden">
        <label for="tabs" class="sr-only">Select a tab</label>
        <!-- Use an "onChange" listener to redirect the user to the selected tab URL. -->
        <select @change="select($event.target.value)" x-model="selectedId"
            id="tabs" name="tabs" class=" block w-full rounded-md border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">
            <option :value="$id('tab', 1)">{{t 'settings.views.tabs.myaccount' }}</option>
            <option :value="$id('tab', 2)">{{t 'settings.views.tabs.sellers' }}</option>
            <option :value="$id('tab', 3)">{{t 'settings.views.tabs.invoices' }}</option>
        </select>
    </div>
    <div class="hidden">
        <ul x-ref="tablist"
                @keydown.right.prevent.stop="$focus.wrap().next()"
                @keydown.home.prevent.stop="$focus.first()"
                @keydown.page-up.prevent.stop="$focus.first()"
                @keydown.left.prevent.stop="$focus.wrap().prev()"
                @keydown.end.prevent.stop="$focus.last()"
                @keydown.page-down.prevent.stop="$focus.last()"  
                role="tablist" 
                class="flex space-x-4 py-2 px-2" aria-label="Tabs">
            <li>
                <a role="tab" :id="$id('tab', whichChild($el.parentElement, $refs.tablist))" 
                @click.prevent="select($el.id)"
                @focus.prevent="select($el.id)"
                :tabindex="isSelected($el.id)? 0: -1"
                :class="isSelected($el.id)? 'bg-indigo-100 text-indigo-700': 'text-gray-500 hover:text-gray-700'"
                :aria-selected="isSelected($el.id)"
                href="#" class="rounded-md px-3 py-2 text-sm font-medium">{{t 'settings.views.tabs.myaccount' }}</a>
            </li>
            <li>
            <a role="tab" :id="$id('tab', whichChild($el.parentElement, $refs.tablist))" 
            @click.prevent="select($el.id)"
            @focus.prevent="select($el.id)"
            :tabindex="isSelected($el.id)? 0: -1"
            :class="isSelected($el.id)? 'bg-indigo-100 text-indigo-700': 'text-gray-500 hover:text-gray-700'"
            :aria-selected="isSelected($el.id)"
            href="#" class="rounded-md px-3 py-2 text-sm font-medium">{{t 'settings.views.tabs.sellers' }}</a>
            </li>
            <li>
                <a role="tab" :id="$id('tab', whichChild($el.parentElement, $refs.tablist))" 
                @click.prevent="select($el.id)"
                @focus.prevent="select($el.id)"
                :tabindex="isSelected($el.id)? 0: -1"
                :class="isSelected($el.id)? 'bg-indigo-100 text-indigo-700': 'text-gray-500 hover:text-gray-700'"
                :aria-selected="isSelected($el.id)"
                href="#" class="rounded-md px-3 py-2 text-sm font-medium" aria-current="page">{{t 'settings.views.tabs.invoices' }}</a>
            </li>
        </ul>
    </div>
    <div class="hidden sm:block sm:w-1/3">
        <nav class="flex flex-1 flex-col" aria-label="Sidebar">
            <ul x-ref="tablist"
                @keydown.right.prevent.stop="$focus.wrap().next()"
                @keydown.down.prevent.stop="$focus.wrap().next()"
                @keydown.home.prevent.stop="$focus.first()"
                @keydown.page-up.prevent.stop="$focus.first()"
                @keydown.left.prevent.stop="$focus.wrap().prev()"
                @keydown.up.prevent.stop="$focus.wrap().prev()"
                @keydown.end.prevent.stop="$focus.last()"
                @keydown.page-down.prevent.stop="$focus.last()"  
                role="tablist" class="-mx-2 space-y-1">
                <li class="pl-2">
                <!-- Current: "bg-gray-50 text-indigo-600", Default: "text-gray-700 hover:text-indigo-600 hover:bg-gray-50" -->
                <a  role="tab" href="#" 
                    :id="$id('tab', whichChild($el.parentElement, $refs.tablist))" 
                    @click.prevent="select($el.id)"
                    @focus.prevent="select($el.id)"
                    :tabindex="isSelected($el.id)? 0: -1"
                    :class="isSelected($el.id)? 'bg-gray-100 text-indigo-600': 'text-gray-700 hover:text-indigo-600 hover:bg-gray-50'"
                    :aria-selected="isSelected($el.id)"
                    class="group flex gap-x-3 rounded-md p-2 text-sm leading-6 font-semibold">
                    <svg class="h-6 w-6 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-user"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="10" r="3"/><path d="M7 20.662V19a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v1.662"/></svg>
                    {{t 'settings.views.tabs.myaccount' }}
                </a>
                </li>
                <li class="pl-2">
                <a role="tab" href="#" 
                    :id="$id('tab', whichChild($el.parentElement, $refs.tablist))" 
                    @click.prevent="select($el.id)"
                    @focus.prevent="select($el.id)"
                    :tabindex="isSelected($el.id)? 0: -1"
                    :class="isSelected($el.id)? 'bg-gray-100 text-indigo-600': 'text-gray-700 hover:text-indigo-600 hover:bg-gray-50'"
                    :aria-selected="isSelected($el.id)"
                    class="group flex gap-x-3 rounded-md p-2 text-sm leading-6 font-semibold">
                    <svg class="h-6 w-6 shrink-0 size-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M17 18h1"/><path d="M12 18h1"/><path d="M7 18h1"/></svg>
                    {{t 'settings.views.tabs.sellers' }}
                </a>
                </li>
                <li class="pl-2">
                <a role="tab" href="#" 
                    :id="$id('tab', whichChild($el.parentElement, $refs.tablist))" 
                    @click.prevent="select($el.id)"
                    @focus.prevent="select($el.id)"
                    :tabindex="isSelected($el.id)? 0: -1"
                    :class="isSelected($el.id)? 'bg-gray-100 text-indigo-600': 'text-gray-700 hover:text-indigo-600 hover:bg-gray-50'"
                    :aria-selected="isSelected($el.id)"
                    class="group flex gap-x-3 rounded-md p-2 text-sm leading-6 font-semibold">                    
                    <svg class="h-6 w-6 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-spreadsheet"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M8 13h2"/><path d="M14 13h2"/><path d="M8 17h2"/><path d="M14 17h2"/></svg>

                    {{t 'settings.views.tabs.invoices' }}
                </a>
                </li>
                <li class="pl-2">
                <a role="tab" href="#" 
                    :id="$id('tab', whichChild($el.parentElement, $refs.tablist))" 
                    @click.prevent="select($el.id)"
                    @focus.prevent="select($el.id)"
                    :tabindex="isSelected($el.id)? 0: -1"
                    :class="isSelected($el.id)? 'bg-gray-100 text-indigo-600': 'text-gray-700 hover:text-indigo-600 hover:bg-gray-50'"
                    :aria-selected="isSelected($el.id)"
                    class="group flex gap-x-3 rounded-md p-2 text-sm leading-6 font-semibold">
                    <svg class="h-6 w-6 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 7.756a4.5 4.5 0 1 0 0 8.488M7.5 10.5h5.25m-5.25 3h5.25M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                    </svg>

                    Calendar
                </a>
                </li>
                
            </ul>
            </nav>

    </div>
    <div role="tabpanels" class="flex-grow flex flex-col overflow-hidden sm:py-0 sm:pr-0 sm:flex-auto sm:w-2/3 ">
        <section x-show="isSelected($id('tab', whichChild($el, $el.parentElement)))"
                :aria-labelledby="$id('tab', whichChild($el, $el.parentElement))"
                role="tabpanel" aria-labelledby="$id('tab', whichChild($el, $el.parentElement))"
                class="overflow-y-scroll"
        >
            <div class="h-full">{{> settings/myaccount }}</div>
        </section>
        <section x-show="isSelected($id('tab', whichChild($el, $el.parentElement)))"
                 :aria-labelledby="$id('tab', whichChild($el, $el.parentElement))"
                 role="tabpanel" aria-labelledby="$id('tab', whichChild($el, $el.parentElement))"
                 class="flex flex-col h-full"                 
        >{{> settings/sellers }}</section>
        <section x-show="isSelected($id('tab', whichChild($el, $el.parentElement)))"
                 :aria-labelledby="$id('tab', whichChild($el, $el.parentElement))"
                 role="tabpanel" aria-labelledby="$id('tab', whichChild($el, $el.parentElement))"
                 class="overflow-y-scroll"
        ><div class="h-full">{{> settings/invoices }}</div></section>
    </div>
</div>