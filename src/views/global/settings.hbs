<div x-data="{
        currentTab: {{currentTab}},
        selectedId: null,
        init() {
            // Set the currentTab tab on the page on page load.
            this.$nextTick(() => this.select(this.$id('tab', this.currentTab)))
        },
        select(id) {
            this.selectedId = id
        },
        isSelected(id) {
            return this.selectedId === id
        },
        whichChild(el, parent) {
            return Array.from(parent.children).indexOf(el) + 1
        }
     }" x-id="['tab']" class="h-full w-full flex flex-1 flex-col pt-2 sm:flex-row sm:gap-x-4 md:gap-x-8">
    <div class="px-2 pb-2 flex-none shadow-md z-10 sm:hidden">
        <label for="tabs" class="sr-only">{{t 'settings.views.tabs.select_tab' }}</label>
        <!-- Use an "onChange" listener to redirect the user to the selected tab URL. -->
        <select @change="select($event.target.value)" x-model="selectedId" id="tabs" name="tabs"
            class=" block w-full rounded-md border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">
            <option :value="$id('tab', 1)">{{t 'settings.views.tabs.myaccount' }}</option>
            <option :value="$id('tab', 2)">{{t 'settings.views.tabs.sellers' }}</option>
            <option :value="$id('tab', 3)">{{t 'settings.views.tabs.invoices' }}</option>
            <option :value="$id('tab', 4)">{{t 'settings.views.tabs.credit_notes' }}</option>
            <option :value="$id('tab', 5)">{{t 'settings.views.tabs.quotes' }}</option>
            <option :value="$id('tab', 6)">{{t 'settings.views.tabs.files' }}</option>
            <option :value="$id('tab', 7)">{{t 'settings.views.tabs.vat' }}</option>
            <option :value="$id('tab', 8)">{{t 'settings.views.tabs.emails' }}</option>

        </select>
    </div>
