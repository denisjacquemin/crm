<div class="z-20 relative flex min-h-full flex-col justify-start sm:justify-center py-12 sm:px-6 lg:px-8">
  <div class="mx-2 mb-3 sm:mx-auto sm:w-full sm:max-w-md">
    {{!-- <img class="mx-auto h-12 w-auto" src="" alt="Your Company"> --}}
    <h2 class="sm:mt-6 text-center text-2xl sm:text-3xl font-bold tracking-tight text-gray-900">{{t 'users.views.forgotpassword.reset_your_password' }}</h2>
    <p class="mt-2 text-center text-sm text-gray-600">
        <a href="/users/signup-1" class="font-medium text-indigo-600 hover:text-indigo-500">{{t 'users.views.forgotpassword.no_account_yet' }}</a>
        </br>{{t 'users.views.forgotpassword.or' }}</br>
        <a href="/users/signin" class="font-medium text-indigo-600 hover:text-indigo-500">{{t 'users.views.forgotpassword.already_have_an_account' }}</a>
    </p>
  </div>   
  <div class="sm:mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="z-20 bg-white pt-2 pb-10 sm:py-8 px-4 shadow sm:rounded-lg sm:px-10">  
      <p class="mt-5 mb-2 text-center text-sm text-gray-600">{{t 'users.views.forgotpassword.instructions' }}</p>   
      <form class="space-y-6" id="signinForm" action="/users/forgotpassword" method="POST">
        {{> csrf }}
        <div>
          <label for="email" class="block text-sm font-medium text-gray-700">{{t 'users.views.forgotpassword.email' }}</label>
          <div class="mt-1">
            <input id="email" name="email" value="{{ email }}" autofocus="" type="text" autocomplete="email" class="block w-full appearance-none rounded-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
          </div>
        </div>


        <div>
            <button type="submit" data-disabled-text="{{t 'common.loading_button' }}" class="inline-flex items-center gap-x-2 w-full rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
              </svg>
              {{t 'users.views.forgotpassword.send_an_email' }}
            </button>
        </div>
      </form>
    </div>
  </div>
</div>