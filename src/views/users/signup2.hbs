<div class="z-20 relative flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8" 
     x-data="{
      company: {},
      user: {{ stringify session.signup.user }},
      without_vat: {{#if session.signup.company.without_vat}}{{session.signup.company.without_vat}}{{else}}false{{/if}},
     }" x-init="company = {{stringify session.signup.company}}">

  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <h2 class="mt-6 text-center text-2xl sm:text-3xl font-bold tracking-tight text-gray-900">{{t
      'users.views.signup2.create_company' }}</h2>
    <p class="mt-2 text-center text-sm text-gray-600">
      {{t 'users.views.signup2.or' }}
      <a href="/users/signin" class="font-medium text-indigo-600 hover:text-indigo-500">{{t
        'users.views.signup2.already_have_an_account' }}</a>
    </p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
      <form class="space-y-6" action="/users/signup-2" method="POST">
        {{> csrf }}
        <div>
          <label for="name">{{t 'users.views.signup2.name' }}</label>
          <div class="mt-1">
            <input id="name" name="name" :value="company.name" type="text"
              class="block w-full appearance-none rounded-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
          </div>
        </div>

        <div>
          <label for="address">{{t 'users.views.signup2.address' }}</label>
          <div class="mt-1">
            <input id="address" name="address1" :value="company.address1" type="text"
              class="block w-full appearance-none rounded-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
            <input id="address" name="address2" :value="company.address2" type="text"
              class="block w-full mt-2 appearance-none rounded-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">

          </div>
        </div>

        <div>
          <label for="zip">{{t 'users.views.signup2.zip' }}</label>
          <div class="mt-1">
            <input id="zip" name="zip" :value="company.zip" type="text"
              class="block w-full appearance-none rounded-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
          </div>
        </div>

        <div>
          <label for="city">{{t 'users.views.signup2.city' }}</label>
          <div class="mt-1">
            <input id="city" name="city" :value="company.city" type="text"
              class="block w-full appearance-none rounded-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
          </div>
        </div>

        <div>
          <label for="country">{{t 'users.views.signup2.country' }}</label>
          <div class="mt-1">
            <select x-model="company.country" id="country" name="country"
              class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
              <optgroup label="{{t 'users.views.signup2.frequently_selected_countries' }}">
                <template x-for="(countryCode, index) in frequentlySelectedCountries" :key="index">
                  <option :value="countryCode" x-text="countries[countryCode].name"
                    :selected="countryCode === company.country"></option>
                </template>

              </optgroup>
              <optgroup label="{{t 'users.views.signup2.all_countries' }}">
                <template x-for="(country, code) in countries" :key="code">
                  <option :value="code" x-text="country.name"
                    :selected="code === company.country && !frequentlySelectedCountries.includes(code)">
                  </option>
                </template>
              </optgroup>
            </select>
          </div>
        </div>

        <div>        
          <label for="language">{{t 'users.views.signup2.language' }}</label>
          <div class="mt-1">
            <select id="language" name="language"
              class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
              <optgroup label="{{t 'users.views.signup2.frequently_selected_languages' }}">
                <template x-for="lang in frequentlySelectedLanguages" :key="lang.code_dnt">
                  <option :value="lang.code_dnt" x-text="lang.name" :selected="lang.code_dnt === company.language">
                  </option>
                </template>
              </optgroup>
              <optgroup label="{{t 'users.views.signup2.all_languages' }}">
                <template x-for="lang in all_languages" :key="lang.code_dnt">
                  <option :value="lang.code_dnt" x-text="lang.name" :selected="(lang.code_dnt === company.language) && !frequentlySelectedLanguages.some(l => l.code_dnt === lang.code_dnt)">
                  </option>
                </template>
              </optgroup>
            </select>
          </div>
        </div>

        <div>
          <label for="vat_number">{{t 'users.views.signup2.vat_number' }}</label>
          <div class="mt-1">
            <input x-bind:disabled="without_vat" id="vat_number" name="vat_number"
              :value="company.vat_number" type="text"
              class="block w-full appearance-none rounded-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm disabled:cursor-not-allowed disabled:bg-gray-50 disabled:text-gray-500 disabled:ring-gray-200">
            <div class="mt-1">
              {{!-- value="session.signup.company.without_vat" --}}
              <input x-model="without_vat" type="checkbox" id="without_vat" name="without_vat"
                class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
              <label for="without_vat" class="text-sm font-medium leading-6 text-gray-900">{{t
                'users.views.signup2.without_vat' }}</label>
            </div>
          </div>
        </div>
        
        <template x-if="company_form_settings[company.country]?.registration_number?.display ?? company_form_settings.default?.registration_number?.display">
          <div>
            <label x-text="company_form_settings[company.country].registration_number.label" for="registration_number"></label>
            <div class="mt-1">
              <input id="registration_number" name="registration_number"
                :value="company.registration_number" type="text"
                class="block w-full appearance-none rounded-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
            </div>
          </div>
        </template>

<div class="bg-gray-100 -mx-10 px-10 py-4 gap-y-5 flex flex-col">
  <div>
    <label for="contact_title" class="block text-sm font-medium text-gray-700">{{t 'users.views.signup2.contact_title' }}</label>
    <select id="contact_title" name="contact_title" autocomplete="honorific-prefix" 
            x-model="company.contact_title"
            class="mt-1 block w-full rounded-md border border-gray-300 bg-white py-2 px-3 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
      <option value="mr" :selected="company.contact_title === 'mr' || user.title === 'mr'">{{t 'users.views.signup1.mr' }}</option>
      <option value="mrs" :selected="company.contact_title === 'mrs' || user.title === 'mrs'">{{t 'users.views.signup1.mrs' }}</option>
      <option value="ms" :selected="company.contact_title === 'ms' || user.title === 'ms'">{{t 'users.views.signup1.ms' }}</option>
      <option value="dr" :selected="company.contact_title === 'dr' || user.title === 'dr'">{{t 'users.views.signup1.dr' }}</option>
    </select>
  </div>

  <div class="col-span-6 sm:col-span-2.5">
    <label for="contact_firstname" class="block text-sm font-medium text-gray-700">{{t 'users.views.signup2.contact_firstname' }}</label>
    <input id="contact_firstname" name="contact_firstname" type="text" autocomplete="given-name" 
           x-model="company.contact_firstname"
           class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
  </div>

  <div class="col-span-6 sm:col-span-2.5">
    <label for="contact_lastname" class="block text-sm font-medium text-gray-700">{{t 'users.views.signup2.contact_lastname' }}</label>
    <input id="contact_lastname" name="contact_lastname" type="text" autocomplete="family-name" 
           x-model="company.contact_lastname"
           class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
  </div>
</div>

        <div>
          <label for="phone">{{t 'users.views.signup2.phone' }}</label>
          <div class="mt-1">
            <input id="phone" name="phone" :value="company.phone" type="text"
              class="block w-full appearance-none rounded-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
          </div>
        </div>

        <div>
          <label for="email">{{t 'users.views.signup2.email' }}</label>
          <div class="mt-1">
            <input id="email" name="email" :value="company.email" type="text"
              class="block w-full appearance-none rounded-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
          </div>
        </div>

        <div>
          <label for="website">{{t 'users.views.signup2.website' }}</label>
          <div class="mt-1 flex rounded-md shadow-sm">
            <span
              class="inline-flex items-center rounded-l-md border border-r-0 border-gray-300 bg-gray-50 px-3 text-gray-500 sm:text-sm">https://</span>
            <input id="website" name="website" :value="company.website" type="text"
              class="block w-full appearance-none rounded-r-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
          </div>
        </div>

        <div>
          <button type="submit" data-disabled-text="{{t 'common.loading_button' }}"
            class="flex w-full justify-center rounded-md border border-transparent bg-indigo-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">{{t
            'users.views.signup2.sign_up' }}</button>
        </div>

      </form>
    </div>
  </div>
</div>

