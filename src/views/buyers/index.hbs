<div class="flex w-[200%] h-full overflow-hidden sm:w-full"
     x-data="{
        showClientForm: function() {
            this.$refs.clientsList.style.transform = 'translateX(-100%)'; 
            this.$refs.clientForm.style.transform = 'translateX(-100%)';
        },
        showClientsList: function() {
            console.log('showClientsList');
            this.$refs.clientsList.style.transform = 'translateX(0)';
            this.$refs.clientForm.style.transform = 'translateX(0)';
        },
        newBuyer: async function() {
            try {
                const data = await fetchUrl('/buyers/newAjax', 'POST');
                this.selectedBuyer = data;
                await this.searchClient();
                const theBuyers = this.buyers;
                const theSelectedBuyer = this.selectedBuyer;
                const index = theBuyers.findIndex((buyer) => buyer.slug === theSelectedBuyer.slug);                console.log('index', index, this.buyers, this.selectedBuyer);
                if (index >= 0 ) this.buyers[index] = this.selectedBuyer;
                if (window.innerWidth < 640) this.showClientForm();
            } catch (error) { 
                console.error('Error creating new buyer', error); 
            }
        },
        editBuyer: async function(index) {
            try {
                const data = await fetchUrl(`/buyers/editAjax/${this.buyers[index].slug}`, 'GET');
                this.selectedBuyer = data;
                this.buyers[index] = this.selectedBuyer;
                if (window.innerWidth < 640) this.showClientForm();
            } catch (error) { console.error('Error editing buyer', error); }
        },
        deleteBuyer: async function(slug) {
            try {
                const data = await fetchUrl(`/buyers/deleteAjax/${slug}`, 'DELETE');
                this.selectedBuyer = {};
                localStorage.removeItem(`autosave#buyer#${slug}`); // if exist of course
                this.searchClient();
                if (window.innerWidth < 640) this.showClientsList();
            } catch (error) { 
                console.log('Error deleting document', error); 
            }
        },
        company_registration_number_label: '',
        company_registration_number_label_translations: {{ stringify company_registration_number_label_translations }},
        updateCompanyRegistrationNumberLabel: function(country_code) {
            var countries = ['BE', 'FR', 'CA', 'NL', 'LU', 'DE', 'IT', 'ES', 'US', 'IE', 'AT', 'CH', 'PL', 'PT', 'SE', 'DK', 'NO', 'FI', 'HU', 'RO', 'BG', 'GR', 'CZ', 'SK', 'SI', 'HR', 'RS', 'BA', 'ME', 'AL', 'MK', 'XK', 'TR', 'RU', 'BY', 'UA', 'MD', 'LV', 'LT', 'EE', 'CY', 'MT', 'LI', 'IS', 'FO', 'GL', 'SJ', 'AX', 'DZ', 'MA', 'TN'];
            if (countries.includes(country_code)) {
                this.company_registration_number_label = this.company_registration_number_label_translations.find(function (element) {
                    return element.country_code == country_code;
                }).label 
            } else {
                this.company_registration_number_label = '{{t 'users.views.signup2.company_registration_number' }}';
            }
        },
        searchClientTerm: '',
        sortBy: 'createdAtdesc',
        searchClient: async function() {
            const sortByParam = this.sortBy ? '&sort=' + encodeURIComponent(this.sortBy) : '';
            await fetchUrl('/buyers/search?q=' + encodeURIComponent(this.searchClientTerm.trim() || '*') + sortByParam, 'GET')
                .then(data => {
                    this.buyers = data;
                })
                .catch(error => {
                    console.error('Error searching for clients', error);
                });
        },
        buyers: {{ stringify buyers }},
        selectedBuyer: {},
        defaultCountry: '{{ defaultCountry }}',
        selectedCountry: null,
     }"
     x-init="
       selectedCountry = defaultCountry || frequentlySelectedCountries[0].value;
       $watch('selectedBuyer', (value, oldValue) => {
          console.log('selectedBuyer', value);
          var buyer = { ...value };
          if (buyer.slug) {
            buyer.autosave_updated_at = new Date();
            localStorage.setItem('autosave#buyer#' + value.slug, JSON.stringify(buyer));
          }
          selectedCountry = buyer.country;
          updateCompanyRegistrationNumberLabel(selectedCountry);
        });
     ">
    <div x-ref="clientsList"
         class="flex w-[50%] flex-col h-full sm:max-w-[330px] lg:max-w-[380px] transition-transform duration-500 ease-in-out">
        {{!-- <a href="#" @click.prevent="showClientForm">Show Form</a> --}}
        <div class="w-full px-2 sm:pr-2 flex items-center">
            <button type="button" id="newDocumentButton"
                class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
                @click.prevent="newBuyer">      
                <svg class="-ml-0.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M9 9V6a1 1 0 012 0v3h3a1 1 0 010 2h-3v3a1 1 0 01-2 0V11H6a1 1 0 010-2h3z" clip-rule="evenodd" />
                </svg>
                {{t 'buyers.views.index.create_new_client' }}
            </button>
        </div>
        <div class="w-full px-2 sm:pr-2 flex items-center shadow-md sm:shadow-none" 
            x-init="
                $watch('searchClientTerm', () => { searchClient() });
            ">
            <input x-model.debounce.200ms="searchClientTerm" x-on:keydown.enter.prevent="searchClient()" type="text"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm leading-6"
                placeholder="{{t 'buyers.views.index.search_placeholder' }}Filter by name, address, zip... " autocomplete="off">

            <div x-data="Components.menu({ open: false })" 
                x-init="init()"
                @keydown.escape.stop="open = false; focusButton()" @click.away="onClickAway($event)"
                class="relative inline-block text-left pl-3 pr-3 pt-3 pb-2">

                <div>
                    <button type="button" class="-m-2 inline-flex items-center justify-center rounded-md p-2 text-gray-400"
                        id="menu-button" x-ref="button" @click="onButtonClick()" @keyup.space.prevent="onButtonEnter()"
                        @keydown.enter.prevent="onButtonEnter()" aria-expanded="true" aria-haspopup="true"
                        x-bind:aria-expanded="open.toString()" @keydown.arrow-up.prevent="onArrowUp()"
                        @keydown.arrow-down.prevent="onArrowDown()">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                        stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M3 4.5h14.25M3 9h9.75M3 13.5h9.75m4.5-4.5v12m0 0l-3.75-3.75M17.25 21L21 17.25" />
                        </svg>
                    </button>
                </div>

                <div x-show="open" x-transition:enter="transition ease-out duration-100"
                    x-transition:enter-start="transform opacity-0 scale-95"
                    x-transition:enter-end="transform opacity-100 scale-100" x-transition:leave="transition ease-in duration-75"
                    x-transition:leave-start="transform opacity-100 scale-100"
                    x-transition:leave-end="transform opacity-0 scale-95"
                    class="absolute right-0 z-10 mt-2 w-60 origin-top-right divide-y divide-gray-100 rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none"
                    x-ref="menu-items" x-description="Dropdown menu, show/hide based on menu state."
                    x-bind:aria-activedescendant="activeDescendant" role="menu" aria-orientation="vertical"
                    aria-labelledby="menu-button" tabindex="-1" @keydown.arrow-up.prevent="onArrowUp()"
                    @keydown.arrow-down.prevent="onArrowDown()" @keydown.tab="open = false"
                    @keydown.enter.prevent="open = false; focusButton()" @keyup.space.prevent="open = false; focusButton()">
                    <div class="px-4 py-3" role="none">
                        <p class="text-sm" role="none">{{t 'buyers.views.index.sort_by' }}</p>
                    </div>
                    <ul class="py-1" role="none" x-data="{ menuItems: [
                            { label: '{{t 'buyers.views.index.creation_date' }}', sortValue: 'createdAtdesc' },
                            { label: '{{t 'buyers.views.index.name' }}', sortValue: 'nameasc' },
                        ] }">
                        <!-- Template for each menu item -->
                        <template x-for="(item, index) in menuItems" :key="index">
                            <li class="relative">
                                <a x-text="item.label" href="#" class="text-gray-700 block px-4 py-2 text-sm" :class="{
                                            'bg-indigo-600 text-white': sortBy === item.sortValue,
                                            'text-gray-700': sortBy !== item.sortValue
                                        }" role="menuitem" tabindex="-1" :id="`menu-item-${index}`"
                                @mouseenter="onMouseEnter($event)" @mousemove="onMouseMove($event, index)"
                                @mouseleave="onMouseLeave($event)"
                                @click.prevent="sortBy = item.sortValue; open = false; searchClient(); focusButton()">
                                </a>
                                <span x-show="sortBy === item.sortValue"
                                    class="absolute inset-y-0 right-0 flex items-center pr-4 text-white">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
                                        class="h-5 w-5">
                                        <path fill-rule="evenodd"
                                        d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                                        clip-rule="evenodd"></path>
                                    </svg>
                                </span>
                            </li>
                        </template>
                    </ul>
                </div>

            </div>
        </div>
        <div x-ref="buyersList" class="flex-1 w-full overflow-y-scroll">
            <template x-if="buyers.length === 0">
                <div class="relative block w-full h-full p-2 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto h-12 w-12 text-gray-400">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                        </svg>
                        <span class="mt-2 block text-md font-semibold text-gray-500">{{t 'buyers.views.index.no_client_found' }}</span>
                    </div>
                </div>
            </template>

            <template x-if="buyers.length > 0">
                <ul role="list" class="divide-y divide-gray-100">
                    <template x-for="(buyer, index) in buyers" :key="index">
                        <li class="relative py-5 hover:bg-gray-100 cursor-pointer" role="listitem"
                            @click.prevent="editBuyer(index);"
                            :data-slug="buyer.slug"
                            
                        >
                        <div class="px-4">
                            <div class="mx-auto flex max-w-4xl justify-between gap-x-6">
                                <div class="flex flex-1 min-w-0 gap-x-4">
                                    <div class="min-w-0 flex-auto">
                                        <div x-text="buyer?.name" 
                                                class="text-sm font-semibold leading-6 text-gray-900 line-clamp-2"
                                                :class="{
                                                'text-indigo-700': selectedBuyer.slug === buyer.slug,
                                                'text-gray-900': selectedBuyer.slug !== buyer.slug
                                                }">
                                        </div>
                                        <div class="mt-1 flex text-xs leading-5 text-gray-500"
                                             x-data="() => ({
                                                get address1() { return buyer.address1 },
                                                get address2() { return buyer.address2 },
                                                get city() { return buyer.city },
                                                get country() { return buyer.country },
                                                get zip() { return buyer.zip },
                                             })"
                                        >
                                            <div x-text="window.formatAddress(address1, address2, zip, city, country)" class="relative truncate w-full text-left h-5"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex shrink-0 items-center gap-x-4">
                                    <svg :class="{
                                                'text-indigo-700 font-medium': selectedBuyer.slug === buyer.slug,
                                                'text-gray-400 font-normal': selectedBuyer.slug !== buyer.slug
                                                }"
                                            class="h-5 w-5 flex-none " viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                        </li>
                    </template>
                </ul> 
            </template>
        </div>
    </div>
    <div x-ref="clientForm"
         class="pb-5 w-[50%] h-full border-l border-gray-200 flex flex-col sm:flex-1 transition-transform duration-500 ease-in-out">
        <div x-cloak x-show="Object.keys(selectedBuyer).length === 0" class="relative block w-full h-full p-5 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
            <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto h-12 w-12 text-gray-400">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                </svg>
                <span class="mt-2 block text-md font-semibold text-gray-500">{{t 'buyers.views.index.no_client_selected' }}</span>
            </div>
        </div>
        
        <div x-cloak x-show="Object.keys(selectedBuyer).length !== 0" class="flex flex-col h-full">
            <div class="w-full py-2 mb-3 sm:pr-2 text-right flex shadow-md sm:shadow-none">
                <div class="w-1/2 text-left sm:hidden">
                    <button @click.prevent="if (window.innerWidth < 640) showClientsList();"
                        href="#" class="px-3.5 py-2.5 text-sm font-semibold text-gray-600 hover:text-gray-400">      
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                        </svg>
                    </button>
                </div>
                <div class="w-1/2 text-right my-auto sm:w-full">
                    <a href="#"
                        class="underline px-3.5 py-2.5 text-sm font-semibold text-red-600 hover:text-red-400"
                            @click.prevent="if (confirm('{{t 'buyers.views.index.delete_confirm' }}')) deleteBuyer(selectedBuyer.slug)">      
                        {{t 'buyers.views.index.delete' }}
                    </a>
                </div>
            </div>
            
            <div class="px-4 flex-1 grid gap-y-5 overflow-y-scroll">
                <div>
                    <label for="country" class="block text-sm font-medium leading-6 text-gray-900">{{t 'buyers.views.index.country' }}</label>
                    <div class="mt-2">
                        <select x-on:change="selectedBuyer.country = $event.target.value;"  id="country" 
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                            <optgroup label="{{t 'users.views.signup2.frequently_selected_countries' }}">
                                <template x-for="(countryCode, index) in Object.keys(frequentlySelectedCountries)" :key="index">
                                    <option 
                                        x-bind:selected="countryCode === selectedCountry" 
                                        :value="countryCode" 
                                        x-text="frequentlySelectedCountries[countryCode].name">
                                    </option>
                                </template>
                            </optgroup>
                            <optgroup label="{{t 'users.views.signup2.all_countries' }}">
                                <template x-for="(countryCode, index) in Object.keys(countries)" :key="index">
                                    <option 
                                        x-bind:selected="countryCode === selectedCountry && !Object.keys(frequentlySelectedCountries).includes(selectedCountry)" 
                                        :value="countryCode" 
                                        x-text="countries[countryCode].name">
                                    </option>
                                </template>
                            </optgroup>
                        </select>
                    </div>
                </div>
                <div>
                    <label for="vat" class="block text-sm font-medium leading-6 text-gray-900">{{t 'buyers.views.index.vat_number' }}</label>
                    <div class="mt-2">
                        <input x-bind:disabled="selectedBuyer.without_vat"
                            type="text" x-model="selectedBuyer.vat_number" autocomplete="off"
                            placeholder="{{t 'buyers.views.index.vat_number' }}" id="vat"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 disabled:cursor-not-allowed disabled:bg-gray-50 disabled:text-gray-500 disabled:ring-gray-200">
                        <div class="mt-1">
                            <input x-model="selectedBuyer.without_vat" 
                                type="checkbox" id="without_vat" name="without_vat" class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
                            <label for="without_vat" class="text-sm font-medium leading-6 text-gray-900">{{t 'buyers.views.index.without_vat' }}</label>
                        </div>
                    </div>
                </div>
                <div>
                    <label for="bce" class="block text-sm font-medium leading-6 text-gray-900" x-text="company_registration_number_label"></label>
                    <div class="mt-2">
                        <input id="company_registration_number" type="text" x-model="selectedBuyer.company_registration_number" autocomplete="off"
                            placeholder="Company number" id="bce"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>
                
                <div>
                    <label for="name" class="block text-sm font-medium leading-6 text-gray-900">{{t 'buyers.views.index.name_label' }}</label>
                    <div class="mt-2">
                        <input type="text" x-model="selectedBuyer.name" autocomplete="off"
                            placeholder="{{t 'buyers.views.index.name_placeholder' }}" id="name"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>
                <div class="bg-gray-100 p-2 grid gap-y-5">
                    <div class="text-md font-semibold text-gray-900">{{t 'buyers.views.index.invoicing_address' }}</div>
                    <div>
                        <label for="attention" class="block text-sm font-medium leading-6 text-gray-900">{{t 'buyers.views.index.attention' }}</label>
                        <div class="mt-2">
                            <input type="text" x-model="selectedBuyer.attention" autocomplete="off"
                                placeholder="{{t 'buyers.views.index.attention_placeholder' }}" id="attention"
                                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                        </div>
                    </div>
                    <div>
                        <label for="address1" class="block text-sm font-medium leading-6 text-gray-900">{{t 'buyers.views.index.address_label' }}</label>
                        <div class="mt-2">
                            <input type="text" x-model="selectedBuyer.address1" autocomplete="off"
                                placeholder="{{t 'buyers.views.index.address_placeholder' }}" id="address1"
                                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                            <input type="text" x-model="selectedBuyer.address2" autocomplete="off"
                                id="address2"
                                class="block w-full mt-2 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">

                        </div>
                    </div>
                    <div>
                        <label for="zip" class="block text-sm font-medium leading-6 text-gray-900">{{t 'buyers.views.index.zip_label' }}</label>
                        <div class="mt-2">
                            <input type="text" x-model="selectedBuyer.zip" autocomplete="off"
                                placeholder="{{t 'buyers.views.index.zip_placeholder' }}" id="zip"
                                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                        </div>
                    </div>
                    <div>
                        <label for="city" class="block text-sm font-medium leading-6 text-gray-900">{{t 'buyers.views.index.city_label' }}</label>
                        <div class="mt-2">
                            <input type="text" x-model="selectedBuyer.city" autocomplete="off"
                                placeholder="{{t 'buyers.views.index.city_placeholder' }}" id="city"
                                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                        </div>
                    </div>
                    <div>
                        <label for="state" class="block text-sm font-medium leading-6 text-gray-900">{{t 'buyers.views.index.state_label' }}</label>
                        <div class="mt-2">
                            <input type="text" x-model="selectedBuyer.state" autocomplete="off"
                                placeholder="{{t 'buyers.views.index.state_placeholder' }}" id="State"
                                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                        </div>
                    </div>
                </div>
                <div class="bg-gray-100 p-2 grid gap-y-5"
                     x-data="{ showDeliveryInfos: false }"
                >
                    <div class="text-md mb-2 font-semibold text-gray-900">{{t 'buyers.views.index.delivery_address' }}</div>
                    <div class="flex items-center">
                        <button id="showDeliveryInfos" type="button" class="bg-gray-200 relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2" role="switch" aria-checked="false"
                                @click="showDeliveryInfos = !showDeliveryInfos" :aria-checked="showDeliveryInfos.toString()" x-state:showDeliveryInfos="Enabled" x-state:off="Not Enabled" :class="{ 'bg-indigo-600': !(showDeliveryInfos), 'bg-gray-200': showDeliveryInfos }"
                        >
                            <span class="sr-only">Use setting</span>
                            <!-- Enabled: "translate-x-5", Not Enabled: "translate-x-0" -->
                            <span class="pointer-events-none relative inline-block h-5 w-5 translate-x-0 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
