                                <span class="absolute inset-0 flex h-full w-full items-center justify-center opacity-0 transition-opacity duration-100 ease-out" aria-hidden="true"
                                      x-state:on="Enabled" x-state:off="Not Enabled" :class="{ 'opacity-100 duration-200 ease-in': !(showDeliveryInfos), 'opacity-0 duration-100 ease-out': showDeliveryInfos }"
