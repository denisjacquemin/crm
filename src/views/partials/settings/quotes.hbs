<div class="flex flex-1 w-full flex-col gap-y-8 sm:gap-y-14 p-4" x-data="{
        selectedCurrencyValue: {},
        get selectedCurrency() {
            return JSON.stringify(this.selectedCurrencyValue);
        },
        set selectedCurrency(value) {
            this.selectedCurrencyValue = JSON.parse(value);
        }
     }" x-init="
        selectedCurrencyValue = defaultCurrency || frequentlySelectedCurrencies[0];
        $watch('selectedCurrency', value => console.log('watcher: ', selectedCurrency))
     ">
    <div class="sm:flex sm:items-start">
        <div
            class="hidden sm:flex mx-auto h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
            <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round"
                    d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>
        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
            <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">
                {{t 'settings.views.quotes.warning_title' }} {{session.current_company.name}} {{#if
                session.current_company.internal_name}} ({{session.current_company.internal_name}}) {{/if}}
            </h3>
            <div class="mt-2">
                <p class="text-sm text-gray-500">{{t 'settings.views.quotes.warning_text' }}</p>
            </div>
        </div>
    </div>

    <div x-data="{ 
        quote_prefix: '{{ quotePrefix }}',
        current_sequence: '{{ session.current_company.settings.current_quote_sequence }}',
        sequence_increment: {{ session.current_company.settings.quote.sequence_increment }},
        reset_yearly: {{ session.current_company.settings.quote.reset_yearly }},
        get nextNumberPreview() {
          if (!this.current_sequence) {
            return '{{t " settings.views.quotes.set_sequence_to_preview"}}'; } const year=new Date().getFullYear();
        const currentNum=parseInt(this.current_sequence); const increment=parseInt(this.sequence_increment) || 1; const
        nextNum=currentNum + increment; const paddedNum=String(nextNum).padStart(5, '0' ); const
        prefixWithYear=this.quote_prefix .replace('YYYY', year.toString()) .replace('YY', year.toString().slice(-2));
        return this.reset_yearly ? `${prefixWithYear}${paddedNum}` : `${prefixWithYear}${paddedNum}`; } }"
        class="flex flex-col gap-y-4">
        <label class="text-base font-semibold leading-7 text-gray-900">
            {{t 'settings.views.quotes.numbering_settings'}}
        </label>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-4">
            <div>
                <div class="flex items-center gap-x-1">
                    <label for="quote_prefix" class="block text-sm font-medium leading-6 text-gray-900">
                        {{t 'settings.views.quotes.quote_prefix'}}
                    </label>
                    {{> tooltip_icon message=(t 'settings.views.quotes.quote_prefix_help')}}
                </div>
                <div class="mt-2">
                    <input type="text" id="quote_prefix" x-model="quote_prefix"
                        class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                </div>
            </div>

            <div class="space-y-1">
                <div>
                    <div class="flex items-center gap-x-1">
                        <label for="current_sequence" class="block text-sm font-medium leading-6 text-gray-900">
                            {{t 'settings.views.quotes.current_sequence'}}
                        </label>
                        {{> tooltip_icon message=(t 'settings.views.quotes.sequence_combined_help')}}
                    </div>
                    <div class="mt-2">
                        <input type="number" id="current_sequence" x-model="current_sequence" min="1"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                    </div>
                </div>

                <div class="relative flex items-start">
                    <div class="flex h-6 items-center">
                        <input type="checkbox" id="reset_yearly" x-model="reset_yearly"
                            class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" />
                    </div>
                    <div class="ml-3 text-sm leading-6">
                        <label for="reset_yearly" class="font-medium text-gray-900">
                            {{t 'settings.views.quotes.reset_yearly'}}
                        </label>
                    </div>
                </div>
            </div>

            <div>
                <div class="flex items-center gap-x-1">
                    <label for="sequence_increment" class="block text-sm font-medium leading-6 text-gray-900">
                        {{t 'settings.views.quotes.sequence_increment'}}
                    </label>
                    {{> tooltip_icon message=(t 'settings.views.quotes.sequence_increment_help')}}
                </div>
                <div class="mt-2">
                    <input type="number" id="sequence_increment" x-model="sequence_increment" min="1"
                        class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6" />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium leading-6 text-gray-900">
                    {{t 'settings.views.quotes.next_number_preview'}}
                </label>
                <div class="mt-2 p-2 bg-gray-50 rounded-md h-[38px] flex items-center">
                    <p class="text-sm text-gray-700" x-text="nextNumberPreview"></p>
                </div>
            </div>
        </div>

        <button type="button"
            class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            @click="fetchUrl('/company/quotenumbering', 'PATCH', { 
        quote_prefix: quote_prefix,
        current_sequence: current_sequence,
        sequence_increment: sequence_increment || 1,
        reset_yearly: reset_yearly
      })">
            {{t 'settings.views.quotes.update_numbering_settings'}}
        </button>
    </div>

    <div x-data="{
        show_delivery_date: {{ session.current_company.settings.quote.show_delivery_date }},
        show_contact_person: {{ session.current_company.settings.quote.show_contact_person }},
        show_seller_email: {{ session.current_company.settings.quote.show_seller_email }},
        show_seller_website: {{ session.current_company.settings.quote.show_seller_website }},
        show_seller_phone: {{ session.current_company.settings.quote.show_seller_phone }},
        show_iban: {{ session.current_company.settings.quote.show_iban }}
    }" class="flex flex-col gap-y-4">
        <label for="show_delivery_date" class="text-base font-semibold leading-7 text-gray-900">
            {{t 'settings.views.quotes.show_hide_fields' }}
        </label>
        <div class="">
            <p class="m-0 mb-2 text-sm">{{t 'settings.views.quotes.show_hide_help' }}</p>
            <div class="space-y-3">
                <div class="relative flex items-start">
                    <div class="flex h-6 items-center">
                        <input type="checkbox" id="show_delivery_date_checkbox" x-model="show_delivery_date"
                            :checked="show_delivery_date === true || show_delivery_date === 'true'"
                            class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" />
                    </div>
                    <div class="ml-3 text-sm leading-6">
                        <label for="show_delivery_date_checkbox" class="font-medium text-gray-900">
                            {{t 'settings.views.quotes.show_delivery_date' }}
                        </label>
                    </div>
                </div>

                <div class="relative flex items-start">
                    <div class="flex h-6 items-center">
                        <input type="checkbox" id="show_contact_person_checkbox" x-model="show_contact_person"
                            :checked="show_contact_person === true || show_contact_person === 'true'"
                            class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" />
                    </div>
                    <div class="ml-3 text-sm leading-6">
                        <label for="show_contact_person_checkbox" class="font-medium text-gray-900">
                            {{t 'settings.views.quotes.show_contact_person' }}
                        </label>
                    </div>
                </div>

                <div class="relative flex items-start">
                    <div class="flex h-6 items-center">
                        <input type="checkbox" id="show_seller_email_checkbox" x-model="show_seller_email"
                            :checked="show_seller_email === true || show_seller_email === 'true'"
                            class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" />
                    </div>
                    <div class="ml-3 text-sm leading-6">
                        <label for="show_seller_email_checkbox" class="font-medium text-gray-900">
                            {{t 'settings.views.quotes.show_seller_email' }}
                        </label>
                    </div>
                </div>

                <div class="relative flex items-start">
                    <div class="flex h-6 items-center">
                        <input type="checkbox" id="show_seller_website_checkbox" x-model="show_seller_website"
                            :checked="show_seller_website === true || show_seller_website === 'true'"
                            class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" />
                    </div>
                    <div class="ml-3 text-sm leading-6">
                        <label for="show_seller_website_checkbox" class="font-medium text-gray-900">
                            {{t 'settings.views.quotes.show_seller_website' }}
                        </label>
                    </div>
                </div>

                <div class="relative flex items-start">
                    <div class="flex h-6 items-center">
                        <input type="checkbox" id="show_seller_phone_checkbox" x-model="show_seller_phone"
                            :checked="show_seller_phone === true || show_seller_phone === 'true'"
                            class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" />
                    </div>
                    <div class="ml-3 text-sm leading-6">
                        <label for="show_seller_phone_checkbox" class="font-medium text-gray-900">
                            {{t 'settings.views.quotes.show_seller_phone' }}
                        </label>
                    </div>
                </div>

                <div class="relative flex items-start">
                    <div class="flex h-6 items-center">
                        <input type="checkbox" id="show_iban_checkbox" x-model="show_iban"
                            :checked="show_iban === true || show_iban === 'true'"
                            class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" />
                    </div>
                    <div class="ml-3 text-sm leading-6">
                        <label for="show_iban_checkbox" class="font-medium text-gray-900">
                            {{t 'settings.views.quotes.show_iban' }}
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <button type="button"
            class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            @click="fetchUrl('/company/showhidefields?document_type=quote', 'PATCH', { 
                    show_delivery_date: show_delivery_date,
                    show_contact_person: show_contact_person,
                    show_seller_email: show_seller_email,
                    show_seller_website: show_seller_website,
                    show_seller_phone: show_seller_phone,
                    show_iban: show_iban
                })">
            {{t 'settings.views.quotes.show_hide_fields' }}
        </button>
    </div>

    <div x-data="{default_notes_on_quote: {{ stringify session.current_company.settings.quote.default_notes }} }"
        class="flex flex-col gap-y-4">
        <label for="default_notes_on_quote" class="text-base font-semibold leading-7 text-gray-900">
            {{t 'settings.views.quotes.default_notes_on_quote' }}
        </label>
        <div class="">
            <p class="m-0 mb-2 text-sm">{{t 'settings.views.quotes.default_notes_on_quote_help' }}</p>
            <label for="default_notes_on_quote" class="block text-sm font-medium leading-6 text-gray-900">
                {{t 'settings.views.quotes.default_notes_on_quote' }}
            </label>
            <textarea x-model="default_notes_on_quote" rows="4" id="default_notes_on_quote"
                class="w-full block flex-1 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"></textarea>
        </div>

        <button type="button"
            class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            @click="fetchUrl('/company/defaultnotesonquote', 'PATCH', { default_notes_on_quote: default_notes_on_quote })">
            {{t 'settings.views.quotes.update_default_notes_on_quote_button' }}
        </button>
    </div>

    <div x-data="{
        show_approval: {{ session.current_company.settings.quote.show_approval }}, 
        approval_label: '{{ session.current_company.settings.quote.approval_label }}' || '{{t 'documents.controller.approval_label'}}'
      }" class="flex flex-col gap-y-4">
        <!-- Header row with label and checkbox -->
        <div class="flex justify-between items-center">
            <label class="text-base font-semibold leading-7 text-gray-900">
                {{t 'settings.views.quotes.approval_box' }}
            </label>
            <div class="relative flex items-center gap-x-2">
                <label for="show_approval_q" class="text-sm font-medium text-gray-900">
                    {{t 'settings.views.quotes.show_approval_box'}}
                </label>
                <div class="flex h-6 items-center">
                    <input id="show_approval_q" name="show_approval" type="checkbox" x-model="show_approval"
                        class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
                </div>
            </div>
        </div>

        <!-- Input for Approval Label -->
        <div>
            <label for="approval_label" class="block text-sm font-medium leading-6 text-gray-900">
                {{t 'settings.views.quotes.approval_label'}}
            </label>
            <div class="mt-2">
                <input type="text" name="approval_label" id="approval_label" x-model="approval_label"
                    :disabled="!show_approval"
                    class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 disabled:cursor-not-allowed disabled:bg-gray-50 disabled:text-gray-500 disabled:ring-gray-200">
            </div>
        </div>

        <!-- Save Button -->
        <button type="button"
            class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            @click="fetchUrl('/company/approvalbox', 'PATCH', { show_approval: show_approval, approval_label: approval_label, document_type: 'quote' })">
            {{t 'settings.views.quotes.update_approval_box_button' }}
        </button>
    </div>

</div>