<div class="flex flex-1 w-full flex-col gap-y-14 p-4">
    {{!-- <div x-data="{ languages: {{stringify languages}}, language: '{{ session.user.language }}' }" class="flex flex-col gap-y-4">
        <label for="myaccount_language" class="text-base font-semibold leading-7 text-gray-900">{{t 'settings.views.myaccount.my_language' }}</label>
        <div class="">
            <label for="myaccount_language" class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.myaccount.choose_my_language' }}</label>
            <select id="language_select" x-model="language" class="block w-full mb-3 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                <template x-for="(lang, index) in languages" :key="index">
                    <option :value="lang.code_dnt" x-text="lang.name"></option>
                </template>
            </select>
            
        </div>
        <button type="button"
                class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
                @click="fetchUrl('/user/changelanguage', 'PATCH', { language: language })">      
                {{t 'settings.views.myaccount.language_update_button' }}
        </button>
    </div> --}}
    {{#if oauthRegistered}}
        <p class="text-sm sm:mt-5" x-html="'{{t 'settings.views.myaccount.oauth_registered' }}'"></p>
    {{/if}}
    {{#unless oauthRegistered}}
        <div x-data="{ email: '{{ accountEmail }}' }" class="flex flex-col gap-y-4">
            
            <label for="myaccount_email" class="text-base font-semibold leading-7 text-gray-900">{{t 'settings.views.myaccount.email' }}</label>
            <div class="">
                <p class="m-0 mb-2 text-sm">{{t 'settings.views.myaccount.email_help' }}</p>
                <label for="myaccount_email" class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.myaccount.email' }}</label>
                <input type="text" x-model="email" autocomplete="off" id="myaccount_email"
                    placeholder="{{t 'settings.views.myaccount.email_placeholder' }}"
                    class="block w-full mb-3 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
            </div>
            <button type="button"
                    class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
                    @click="fetchUrl('/user/resetemail', 'PATCH', { email: email })">      
                    {{t 'settings.views.myaccount.email_update_button' }}
            </button>
        </div>
        <div x-data="{ current_password: '', new_password: '', new_confirmation_password: '' }" class="flex flex-col gap-y-4">
            <label for="myaccount_current_password" class="text-base font-semibold leading-7 text-gray-900">{{t 'settings.views.myaccount.change_password' }}</label>
            <div>
                <p class="m-0 mb-2 text-sm">{{t 'settings.views.myaccount.change_password_help' }}</p>
                <label for="myaccount_current_password" class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.myaccount.current_password' }}</label>
                <input type="text" x-model="current_password" autocomplete="off" id="myaccount_current_password"
                    placeholder="{{t 'settings.views.myaccount.current_password' }}"
                    class="block w-full mb-3 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                
                <label for="myaccount_new_password" class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.myaccount.new_password' }}</label>
                <div class="relative" x-data="{ show: false }">
                    <input type="password" x-model="new_password" autocomplete="off" id="myaccount_new_password"
                        :type="show ? 'text' : 'password'"
                        placeholder="{{t 'settings.views.myaccount.new_password' }}"
                        class="block w-full mb-3 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    <span class="text-gray-400 absolute inset-y-0 right-0 flex items-center pr-3 cursor-pointer" @click="show = !show" aria-label="{{t 'common.toggle_password_visbility' }}" :aria-pressed="show">
                        <template x-if="show">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </template>
                        <template x-if="!show">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                            </svg>
                        </template>
                    </span>
                </div>
                <label for="myaccount_confirm_new_password" class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.myaccount.confirm_new_password' }}</label>
                <div class="relative" x-data="{ show: false }">
                    <input type="text" x-model="new_confirmation_password" autocomplete="off" id="myaccount_confirm_new_password"
                        :type="show ? 'text' : 'password'"
                        placeholder="{{t 'settings.views.myaccount.confirm_new_password' }}"
                        class="block w-full mb-3 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    <span class="text-gray-400 absolute inset-y-0 right-0 flex items-center pr-3 cursor-pointer" @click="show = !show" aria-label="{{t 'common.toggle_password_visbility' }}" :aria-pressed="show">
                        <template x-if="show">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </template>
                        <template x-if="!show">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                            </svg>
                        </template>
                    </span>
                </div>
            </div>
            <button type="button"
                    class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
                    @click="fetchUrl('/user/resetpasswordfromsettings', 'PATCH', { currentPassword: current_password, newPassword: new_password, confirmPassword: new_confirmation_password })">      
                    {{t 'settings.views.myaccount.change_password_button' }}
            </button>
        </div>
    {{/unless}}
</div>