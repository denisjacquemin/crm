<div class="w-[200%] flex-1 h-full overflow-hidden flex"
     x-data="{
        {{!-- files: {{ stringify files }}, --}}
        sizes: {{ stringify sizes}},
        document_types: {{ stringify document_types }},
        selectedDocumentTypes: [],
        selectedFile: {},
        editFile: async function(index) {
            try {
                const data = await fetchUrl(`/files/editAjax/${this.companyFiles[index].slug}`, 'GET');
                this.selectedFile = data;
                this.companyFiles[index] = this.selectedFile;
                this.showFileForm();
            } catch (error) { console.error('Error editing file', error); }
        },
        newFile: async function(){
            try {
                const data = await fetchUrl('/file/newAjax', 'POST');
                this.selectedFile = data;
                this.companyFiles.push(this.selectedFile);
                this.showFileForm();
            } catch (error) { 
                console.error('Error creating new file', error); 
            }
        },
        deleteFile: async function(slug) {
            try {
                const data = await fetchUrl(`/files/deleteAjax/${slug}`, 'DELETE');
                this.companyFiles = this.companyFiles.filter(file => file.slug !== slug);
                this.selectedFile = {};
                this.showFileList();
            } catch (error) { 
                console.log('Error deleting document', error); 
            }
        },
        submitUploadForm: async function(event) {
            event.preventDefault();
            const fileInput = event.target;
            let file;
            if (event.type === 'drop') {
                file = event.dataTransfer.files[0];
            } else {
                file = event.target.files[0];
            }            
            var formData = new FormData();
            formData.append('file', file);

            if (this.selectedFile && this.selectedFile._id) {
                formData.append('file_id', this.selectedFile._id);
            }
            
            const data = await fetchUrl('/file/upload', 'POST', formData);
            this.selectedFile.filename = file.name;
            this.selectedFile.size = file.size;
            this.selectedFile.type = file.type;
            this.selectedFile.key = data.data.key;

            document.getElementById('file-name').focus();
        },
        showFileForm: function() {
            this.$refs.filesList.style.transform = 'translateX(-100%)'; 
            this.$refs.fileForm.style.transform = 'translateX(-100%)';
        },
        showFileList: function() {
            this.$refs.filesList.style.transform = 'translateX(0)';
            this.$refs.fileForm.style.transform = 'translateX(0)';
        },
        toggleAttachedDocumentType: function(key, checked) {
            if (checked) {
                this.selectedFile.default_attached_document_types.push(key);
            } else {
                this.selectedFile.default_attached_document_types = this.selectedFile.default_attached_document_types.filter(type => type !== key);
            }
        }
     }"
     x-init="
        $dispatch('loadcompanyfiles');
        $watch('selectedFile', (value, oldValue) => {
            var file = { ...value };
            if (file.slug) {
                file.autosave_updated_at = new Date();
                localStorage.setItem('autosave#file#' + value.slug, JSON.stringify(file));
            }
        });
     "
>
    <div x-ref="filesList" class="flex flex-col flex-1 w-[50%] transition-transform duration-500 ease-in-out">
        
        <div class="sm:flex sm:items-start p-2 sm:p-4">
            <div
                class="hidden sm:flex mx-auto h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-blue-100 sm:mx-0 sm:h-10 sm:w-10">
                <svg class="h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
            </div>
            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">{{t
                    'settings.views.files.files_for_all_docs' }}
                </h3>
                <div class="mt-2">
                    <p class="text-sm text-gray-500">{{t 'settings.views.files.files_for_all_docs_help' }}</p>
                </div>
            </div>
        </div>
        
        
        <div class="flex-none w-full flex items-center p-2">
            <button type="button" id="newFileButton"
                class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
                @click.prevent="newFile">      
                <svg class="-ml-0.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M9 9V6a1 1 0 012 0v3h3a1 1 0 010 2h-3v3a1 1 0 01-2 0V11H6a1 1 0 010-2h3z" clip-rule="evenodd" />
                </svg>
                {{t 'settings.views.files.create_file_button' }}
            </button>
        </div>
        <div class="flex-grow overflow-y-auto flex flex-1 w-full">
            <template x-if="companyFiles.length === 0">
                <div class="relative block w-full h-full p-2 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto h-12 w-12 text-gray-400">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                        </svg>
                        <span class="mt-2 block text-md font-semibold text-gray-500">{{t 'settings.views.files.no_file_found' }}</span>
                    </div>
                </div>
            </template>
            <template x-if="companyFiles.length > 0">
                <ul role="list" class="w-full divide-y divide-gray-100">
                    <template x-for="(file, index) in companyFiles" :key="index">
                        <li class="relative py-5 hover:bg-gray-100 cursor-pointer" role="listitem"
                            @click.prevent="editFile(index);"
                            :data-slug="file.slug"
                            
                        >
                        <div class="px-4">
                            <div class="mx-auto flex max-w-4xl justify-between gap-x-6">
                                <div class="flex flex-1 min-w-0 gap-x-4">
                                    <div class="min-w-0 flex-auto">
                                        <div x-text="file?.internal_name?.trim() ? `${file.name} (${file.internal_name})` : file?.name"                                                
                                             class="text-sm font-semibold leading-6 text-gray-900 line-clamp-2"
                                                :class="{
                                                'text-indigo-700': selectedFile.slug === file.slug,
                                                'text-gray-900': selectedFile.slug !== file.slug
                                                }">
                                        </div>
                                        <div class="mt-1 flex text-xs leading-5 text-gray-500">
                                            <span x-show="!file.filename" @click.prevent="editFile(index);" class="relative truncate w-full text-left h-5" x-text="'{{t 'documents.views.index.files_modal.no_file_uploaded_yet' }}'"></span>
                                            <span x-show="file.filename" x-text="file.filename" class="relative truncate font-medium text-left h-5"></span>
                                            <span x-show="file.filename" class="ml-2 flex-shrink-0" x-text="formatBytes(file.size, sizes)"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex shrink-0 items-center gap-x-4">
                                    <svg :class="{
                                                'text-indigo-700 font-medium': selectedFile.slug === file.slug,
                                                'text-gray-400 font-normal': selectedFile.slug !== file.slug
                                                }"
                                            class="h-5 w-5 flex-none " viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                        </li>
                    </template>
                </ul> 
            </template>
        </div>
    </div>
    <div x-ref="fileForm" class="w-[50%] h-full border-l border-gray-200 flex flex-col transition-transform duration-500 ease-in-out">
        <div x-cloak x-show="Object.keys(selectedFile).length === 0" class="relative block w-full h-full p-5 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
            <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto h-12 w-12 text-gray-400">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                </svg>
                <span class="mt-2 block text-md font-semibold text-gray-500">{{t 'settings.views.files.no_file_selected' }}</span>
            </div>
        </div>

        <div x-cloak x-show="Object.keys(selectedFile).length !== 0" class="flex flex-col h-full pb-5">
            <div class="w-full py-2 mb-3 sm:pr-2 text-right flex shadow-md sm:shadow-none">
                <div class="w-1/2 text-left">
                    <button @click.prevent="showFileList();"
                        href="#" class="px-3.5 py-2.5 text-sm font-semibold text-gray-600 hover:text-gray-400">      
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                        </svg>
                    </button>
                </div>
                <div class="w-1/2 text-right my-auto sm:w-full">
                    <a href="#"
                        class="underline px-3.5 py-2.5 text-sm font-semibold text-red-600 hover:text-red-400"
                            @click.prevent="if (confirm('{{t 'settings.views.files.delete_confirm' }}')) deleteFile(selectedFile.slug) ">      
                        {{t 'settings.views.files.delete' }}
                    </a>
                </div>
            </div>

            <div class="px-4 flex-1 flex flex-col gap-y-5 overflow-y-auto">
                    <div x-data="{ isDragging: false, handleDrop(event) { submitUploadForm(event); this.isDragging = false; } }" 
                        x-on:drop.prevent="handleDrop" 
                        x-on:dragover.prevent 
                        x-on:dragenter="isDragging = true" 
                        x-on:dragleave="isDragging = false"
                        class="flex items-center justify-center w-full">
                        <label :class="{'dark:hover:bg-gray-600': isDragging}" for="dropzone-file" 
                                class="py-[20px] flex flex-col items-center justify-center w-full h-48 border-2 border-gray-300 border-dashed rounded-lg cursor-pointer bg-gray-100 hover:bg-gray-200">
                            <div class="flex flex-col items-center justify-center pt-5 pb-6">
                                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mb-5 text-gray-500 lucide lucide-cloud-upload"><path d="M12 13v8"/><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="m8 17 4-4 4 4"/></svg>
                                <p x-show="!selectedFile.filename" class="mb-2 text-sm text-gray-600">{{t 'settings.views.files.no_file_uploaded_yet' }}</p>
                                <p x-show="selectedFile.filename" class="text-center mx-4 mb-2 text-base text-gray-500 highlight px-2"><span x-text="selectedFile.filename"></span> (<span x-text="formatBytes(selectedFile.size, sizes)"></span> - <span x-text="selectedFile.type"></span>)</p>
                                <p class="mb-2 text-sm text-gray-500"><span class="font-semibold">{{t 'settings.views.files.click_to_upload' }}</span> or drag and drop</p>
                                <p class="text-xs text-gray-500">{{t 'settings.views.files.allowed_file_types' }}</p>
                            </div>
                            <input x-on:change="submitUploadForm"
                                id="dropzone-file" type="file" class="hidden"/> 
                        </label>
                    </div> 
                
                <div>
                    <label for="file-name" class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.files.name' }}</label>
                    <div class="mt-1">
                        <input type="text" x-model="selectedFile.name" autocomplete="off"
                            id="file-name"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>
                <div>
                    <label for="internal_name" class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.files.internal_name' }}</label>
                    <div class="mt-1">
                        <input type="text" x-model="selectedFile.internal_name" autocomplete="off"
                            placeholder="{{t 'settings.views.files.internal_name_placeholder' }}"
                            id="internal_name"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.files.selected_by_default' }}</label>
                    <span x-show="!selectedFile.filename" class="text-sm leading-6 text-gray-900 highlight">{{t 'settings.views.files.upload_before_selecting' }}</span>
                    <div class="mt-1">
                        <template x-for="(label, key) in document_types" :key="key">
                            <div class="relative flex items-start">
                                <div class="flex h-6 items-center">
                                    <input 
                                            :disabled="!selectedFile.filename"
                                            :value="key" 
                                            :id="key" 
                                            type="checkbox"
                                            :checked="selectedFile?.default_attached_document_types?.includes(key)"
                                            @change="toggleAttachedDocumentType(key, $event.target.checked)"
                                            class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
                                </div>
                                <div class="ml-3 text-sm leading-6">
                                    <label x-text="label" :for="key" class="font-medium text-gray-900"></label>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>
        </div> 
    </div>
</div>