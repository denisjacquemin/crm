<div class="flex flex-1 w-full flex-col gap-y-8 sm:gap-y-14 p-4"
     x-data="{
        frequentlySelectedCurrencies: {{ stringify frequentlySelectedCurrencies }},
        defaultCurrency: '{{ defaultCurrency }}',
        selectedCurrency: null,
        currencies: {{ stringify currencies }},
     }"
     x-init="
        selectedCurrency = defaultCurrency || frequentlySelectedCurrencies[0].value;
     "
>
    <div class="sm:flex sm:items-start">
        <div class="hidden sm:flex mx-auto h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
            <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>
        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
        <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">{{t 'settings.views.invoices.warning_title' }} {{session.current_company.name}}
            {{#if session.current_company.internal_name}}
                ({{session.current_company.internal_name}})
            {{/if}}
        </h3>
        <div class="mt-2">
            <p class="text-sm text-gray-500">{{t 'settings.views.invoices.warning_text' }}</p>
        </div>
        </div>
    </div>

    <div x-data="{ default_invoice_due_date_terms_type: '{{ session.current_company.settings.default_invoice_due_date_terms_type }}' }" class="flex flex-col gap-y-4"> 
        <label for="invoices_default_invoice_due_date_terms_type" class="text-base font-semibold leading-7 text-gray-900">{{t 'settings.views.invoices.invoices_default_invoice_due_date_terms_type' }}</label>
        <div class="">
            <p class="m-0 mb-2 text-sm">{{t 'settings.views.invoices.invoices_default_invoice_due_date_terms_type_help' }}</p>
            <label for="invoices_default_invoice_due_date_terms_type" class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.invoices.invoices_default_invoice_due_date_terms_type' }}</label>
            <select x-model="default_invoice_due_date_terms_type"
                id="invoices_default_invoice_due_date_terms_type"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                <option value="custom">{{t 'documents.views.edit_form.custom' }}</option>
                <option value="+15">{{t 'documents.views.edit_form.15' }}</option>
                <option value="+30">{{t 'documents.views.edit_form.30' }}</option>
                <option value="dueonreceipt">{{t 'documents.views.edit_form.due_on_receipt' }}</option>
            </select>
        </div>
        
        <button type="button" id="newDocumentButton"
                class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
                @click="fetchUrl('/company/defaultinvoiceduedatetermstype', 'PATCH', { default_invoice_due_date_terms_type: default_invoice_due_date_terms_type })">      
                {{t 'settings.views.invoices.invoices_default_invoice_due_date_terms_type_button' }}
        </button>
    </div>

    <div class="flex flex-col gap-y-4"> 
        <label for="default_currency" class="text-base font-semibold leading-7 text-gray-900">{{t 'settings.views.invoices.default_currency' }}</label>
        <div class="">
            <p class="m-0 mb-2 text-sm">{{t 'settings.views.invoices.default_currency_help' }}</p>
            <label for="default_currency" class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.invoices.default_currency' }}</label>
            <select x-model="default_currency"
                id="default_currency"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    <optgroup label="{{t 'settings.views.invoices.frequently_selected_currencies' }}">
                        <template x-for="(currency, index) in frequentlySelectedCurrencies" :key="index">
                            <option x-bind:selected="currency.label === selectedCurrency" :value="currency" x-text="`${currency.name} (${currency.symbol})`"></option>
                        </template>
                    </optgroup>
                    <optgroup label="{{t 'settings.views.invoices.all_currencies' }}">
                        <template x-for="(currency, index) in currencies" :key="index">
                            <option x-bind:selected="currency.label === selectedCurrency && !frequentlySelectedCurrencies.some(c => c.label === selectedCurrency)" :value="currency" x-text="`${currency.name} (${currency.symbol})`"></option>
                        </template>
                    </optgroup>
                </select>
            </select>
        </div>
        
        <button type="button" id="newDocumentButton"
                class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
                @click="fetchUrl('/company/defaultcurrency', 'PATCH', { default_currency: default_currency })">      
                {{t 'settings.views.invoices.update_default_currency' }}
        </button>
    </div>

    <div x-data="{show_delivery_date: '{{ session.current_company.settings.show_delivery_date }}' }" class="flex flex-col gap-y-4"> 
        <label for="show_delivery_date" class="text-base font-semibold leading-7 text-gray-900">{{t 'settings.views.invoices.show_delivery_date' }}</label>
        <div class="">
            <p class="m-0 mb-2 text-sm">{{t 'settings.views.invoices.show_delivery_date_help' }}</p>
            <label for="show_delivery_date" class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.invoices.show_delivery_date' }}</label>
            <select x-model="show_delivery_date"
                id="show_delivery_date"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    <option value="true">{{t 'settings.views.invoices.yes_show_delivery_date' }}</option>
                    <option value="false">{{t 'settings.views.invoices.no_show_delivery_date' }}</option>
                </select>
            </select>
        </div>
        
        <button type="button" id="newDocumentButton"
                class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
                @click="fetchUrl('/company/showdeliverydate', 'PATCH', { show_delivery_date: show_delivery_date })">      
                {{t 'settings.views.invoices.show_delivery_date_button' }}
        </button>
    </div>

    <div x-data="{default_notes_on_invoice: '{{ session.current_company.settings.default_notes_on_invoice }}' }" class="flex flex-col gap-y-4"> 
        <label for="default_notes_on_invoice" class="text-base font-semibold leading-7 text-gray-900">{{t 'settings.views.invoices.default_notes_on_invoice' }}</label>
        <div class="">
            <p class="m-0 mb-2 text-sm">{{t 'settings.views.invoices.default_notes_on_invoice_help' }}</p>
            <label for="default_notes_on_invoice" class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.invoices.default_notes_on_invoice' }}</label>
            <textarea x-model="default_notes_on_invoice" rows="4" id="default_notes_on_invoice"
                    class="w-full block flex-1 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
            ></textarea>
        </div>
        
        <button type="button"
                class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
                @click="fetchUrl('/company/defaultnotesoninvoice', 'PATCH', { default_notes_on_invoice: default_notes_on_invoice })">      
                {{t 'settings.views.invoices.update_default_notes_on_invoice_button' }}
        </button>
    </div>
</div>