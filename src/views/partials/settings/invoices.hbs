<div
  class="flex flex-1 w-full flex-col gap-y-8 sm:gap-y-14 p-4"
  x-data="{
        selectedCurrencyValue: {},
        get selectedCurrency() {
            return JSON.stringify(this.selectedCurrencyValue);
        },
        set selectedCurrency(value) {
            this.selectedCurrencyValue = JSON.parse(value);
        }
     }"
  x-init="
        selectedCurrencyValue = defaultCurrency || frequentlySelectedCurrencies[0];
        $watch('selectedCurrency', value => console.log('watcher: ', selectedCurrency))
     "
>
  <div class="sm:flex sm:items-start">
    <div
      class="hidden sm:flex mx-auto h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10"
    >
      <svg
        class="h-6 w-6 text-red-600"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"
        />
      </svg>
    </div>
    <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
      <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">
        {{t 'settings.views.invoices.warning_title' }} {{session.current_company.name}} {{#if
        session.current_company.internal_name}} ({{session.current_company.internal_name}}) {{/if}}
      </h3>
      <div class="mt-2">
        <p class="text-sm text-gray-500">{{t 'settings.views.invoices.warning_text' }}</p>
      </div>
    </div>
  </div>

  <div
    x-data="{ 
        invoice_prefix: '{{ invoicePrefix }}',
        current_sequence: '{{ session.current_company.settings.current_invoice_sequence }}',
        sequence_increment: {{ session.current_company.settings.invoice.sequence_increment }},
        reset_yearly: {{ session.current_company.settings.invoice.reset_yearly }},
        get nextNumberPreview() {
          if (!this.current_sequence) {
            return '{{t "settings.views.invoices.set_sequence_to_preview"}}';
          }
          const year = new Date().getFullYear();
          const currentNum = parseInt(this.current_sequence);
          const increment = parseInt(this.sequence_increment) || 1;
          const nextNum = currentNum + increment;
          const paddedNum = String(nextNum).padStart(5, '0');
          const prefixWithYear = this.invoice_prefix
            .replace('YYYY', year.toString())
            .replace('YY', year.toString().slice(-2));
          return this.reset_yearly ? 
            `${prefixWithYear}${paddedNum}` :
            `${prefixWithYear}${paddedNum}`;
        }
    }"
    class="flex flex-col gap-y-4"
  >
    <label class="text-base font-semibold leading-7 text-gray-900">
      {{t 'settings.views.invoices.numbering_settings'}}
    </label>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-4">
      <div>
        <div class="flex items-center gap-x-1">
          <label for="invoice_prefix" class="block text-sm font-medium leading-6 text-gray-900">
            {{t 'settings.views.invoices.invoice_prefix'}}
          </label>
          {{> tooltip_icon message=(t 'settings.views.invoices.invoice_prefix_help')}}
        </div>
        <div class="mt-2">
          <input
            type="text"
            id="invoice_prefix"
            x-model="invoice_prefix"
            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
          />
        </div>
      </div>

      <div class="space-y-1">
        <div>
          <div class="flex items-center gap-x-1">
            <label for="current_sequence" class="block text-sm font-medium leading-6 text-gray-900">
              {{t 'settings.views.invoices.current_sequence'}}
            </label>
            {{> tooltip_icon message=(t 'settings.views.invoices.sequence_combined_help')}}
          </div>
          <div class="mt-2">
            <input
              type="number"
              id="current_sequence"
              x-model="current_sequence"
              min="1"
              class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
            />
          </div>
        </div>

        <div class="relative flex items-start">
          <div class="flex h-6 items-center">
            <input
              type="checkbox"
              id="reset_yearly"
              x-model="reset_yearly"
              class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
            />
          </div>
          <div class="ml-3 text-sm leading-6">
            <label for="reset_yearly" class="font-medium text-gray-900">
              {{t 'settings.views.invoices.reset_yearly'}}
            </label>
          </div>
        </div>
      </div>

      <div>
        <div class="flex items-center gap-x-1">
          <label for="sequence_increment" class="block text-sm font-medium leading-6 text-gray-900">
            {{t 'settings.views.invoices.sequence_increment'}}
          </label>
          {{> tooltip_icon message=(t 'settings.views.invoices.sequence_increment_help')}}
        </div>
        <div class="mt-2">
          <input
            type="number"
            id="sequence_increment"
            x-model="sequence_increment"
            min="1"
            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
          />
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium leading-6 text-gray-900">
          {{t 'settings.views.invoices.next_number_preview'}}
        </label>
        <div class="mt-2 p-2 bg-gray-50 rounded-md h-[38px] flex items-center">
          <p class="text-sm text-gray-700" x-text="nextNumberPreview"></p>
        </div>
      </div>
    </div>

    <button
      type="button"
      class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
      @click="fetchUrl('/company/invoicenumbering', 'PATCH', { 
        invoice_prefix: invoice_prefix,
        current_sequence: current_sequence,
        sequence_increment: sequence_increment || 1,
        reset_yearly: reset_yearly
      })"
    >
      {{t 'settings.views.invoices.update_numbering_settings'}}
    </button>
  </div>

  <div
    x-data="{ default_invoice_due_date_terms_type: '{{ session.current_company.settings.invoice.default_due_date_terms_type }}' }"
    class="flex flex-col gap-y-4"
  >
    <label
      for="invoices_default_invoice_due_date_terms_type"
      class="text-base font-semibold leading-7 text-gray-900"
    >
      {{t 'settings.views.invoices.invoices_default_invoice_due_date_terms_type' }}
    </label>
    <div class="">
      <p class="m-0 mb-2 text-sm">
        {{t 'settings.views.invoices.invoices_default_invoice_due_date_terms_type_help' }}
      </p>
      <label
        for="invoices_default_invoice_due_date_terms_type"
        class="block text-sm font-medium leading-6 text-gray-900"
      >
        {{t 'settings.views.invoices.invoices_default_invoice_due_date_terms_type' }}
      </label>
      <select
        x-model="default_invoice_due_date_terms_type"
        id="invoices_default_invoice_due_date_terms_type"
        class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
      >
        <option value="custom">{{t 'documents.views.edit_form.custom' }}</option>
        <option value="+15">{{t 'documents.views.edit_form.15' }}</option>
        <option value="+30">{{t 'documents.views.edit_form.30' }}</option>
        <option value="dueonreceipt">{{t 'documents.views.edit_form.due_on_receipt' }}</option>
      </select>
    </div>

    <button
      type="button"
      class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
      @click="fetchUrl('/company/defaultinvoiceduedatetermstype', 'PATCH', { default_invoice_due_date_terms_type: default_invoice_due_date_terms_type })"
    >
      {{t 'settings.views.invoices.invoices_default_invoice_due_date_terms_type_button' }}
    </button>
  </div>
  <div
    x-data="{
        show_invoice_due_date: {{ session.current_company.settings.invoice.show_invoice_due_date }},
        show_delivery_date: {{ session.current_company.settings.invoice.show_delivery_date }},
        show_contact_person: {{ session.current_company.settings.invoice.show_contact_person }},
        show_seller_email: {{ session.current_company.settings.invoice.show_seller_email }},
        show_seller_website: {{ session.current_company.settings.invoice.show_seller_website }},
        show_seller_phone: {{ session.current_company.settings.invoice.show_seller_phone }},
        show_iban: {{ session.current_company.settings.invoice.show_iban }}
    }"
    class="flex flex-col gap-y-4"
  >
    <label for="show_delivery_date" class="text-base font-semibold leading-7 text-gray-900">
      {{t 'settings.views.invoices.show_hide_fields' }}
    </label>
    <div class="">
      <p class="m-0 mb-2 text-sm">{{t 'settings.views.invoices.show_hide_help' }}</p>
      <div class="space-y-3">
        <div class="relative flex items-start">
          <div class="flex h-6 items-center">
            <input
              type="checkbox"
              id="show_due_date_checkbox"
              x-model="show_invoice_due_date"
              :checked="show_invoice_due_date === true || show_invoice_due_date === 'true'"
              class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
            />
          </div>
          <div class="ml-3 text-sm leading-6">
            <label for="show_due_date_checkbox" class="font-medium text-gray-900">
              {{t 'settings.views.invoices.show_due_date' }}
            </label>
          </div>
        </div>
        <div class="relative flex items-start">
          <div class="flex h-6 items-center">
            <input
              type="checkbox"
              id="show_delivery_date_checkbox"
              x-model="show_delivery_date"
              :checked="show_delivery_date === true || show_delivery_date === 'true'"
              class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
            />
          </div>
          <div class="ml-3 text-sm leading-6">
            <label for="show_delivery_date_checkbox" class="font-medium text-gray-900">
              {{t 'settings.views.invoices.show_delivery_date' }}
            </label>
          </div>
        </div>

        <div class="relative flex items-start">
          <div class="flex h-6 items-center">
            <input
              type="checkbox"
              id="show_contact_person_checkbox"
              x-model="show_contact_person"
              :checked="show_contact_person === true || show_contact_person === 'true'"
              class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
            />
          </div>
          <div class="ml-3 text-sm leading-6">
            <label for="show_contact_person_checkbox" class="font-medium text-gray-900">
              {{t 'settings.views.invoices.show_contact_person' }}
            </label>
          </div>
        </div>

        <div class="relative flex items-start">
          <div class="flex h-6 items-center">
            <input
              type="checkbox"
              id="show_seller_email_checkbox"
              x-model="show_seller_email"
              :checked="show_seller_email === true || show_seller_email === 'true'"
              class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
            />
          </div>
          <div class="ml-3 text-sm leading-6">
            <label for="show_seller_email_checkbox" class="font-medium text-gray-900">
              {{t 'settings.views.invoices.show_seller_email' }}
            </label>
          </div>
        </div>

        <div class="relative flex items-start">
          <div class="flex h-6 items-center">
            <input
              type="checkbox"
              id="show_seller_website_checkbox"
              x-model="show_seller_website"
              :checked="show_seller_website === true || show_seller_website === 'true'"
              class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
            />
          </div>
          <div class="ml-3 text-sm leading-6">
            <label for="show_seller_website_checkbox" class="font-medium text-gray-900">
              {{t 'settings.views.invoices.show_seller_website' }}
            </label>
          </div>
        </div>

        <div class="relative flex items-start">
          <div class="flex h-6 items-center">
            <input
              type="checkbox"
              id="show_seller_phone_checkbox"
              x-model="show_seller_phone"
              :checked="show_seller_phone === true || show_seller_phone === 'true'"
              class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
            />
          </div>
          <div class="ml-3 text-sm leading-6">
            <label for="show_seller_phone_checkbox" class="font-medium text-gray-900">
              {{t 'settings.views.invoices.show_seller_phone' }}
            </label>
          </div>
        </div>

        <div class="relative flex items-start">
          <div class="flex h-6 items-center">
            <input
              type="checkbox"
              id="show_iban_checkbox"
              x-model="show_iban"
              :checked="show_iban === true || show_iban === 'true'"
              class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
            />
          </div>
          <div class="ml-3 text-sm leading-6">
            <label for="show_iban_checkbox" class="font-medium text-gray-900">
              {{t 'settings.views.invoices.show_iban' }}
            </label>
          </div>
        </div>
      </div>
    </div>

    <button
      type="button"
      class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
      @click="fetchUrl('/company/showhidefields?document_type=invoice', 'PATCH', { 
                    show_delivery_date: show_delivery_date,
                    show_contact_person: show_contact_person,
                    show_seller_email: show_seller_email,
                    show_seller_website: show_seller_website,
                    show_seller_phone: show_seller_phone,
                    show_iban: show_iban
                })"
    >
      {{t 'settings.views.invoices.show_hide_fields' }}
    </button>
  </div>

  <div
    x-data="{default_notes_on_invoice: '{{ session.current_company.settings.invoice.default_notes }}' }"
    class="flex flex-col gap-y-4"
  >
    <label for="default_notes_on_invoice" class="text-base font-semibold leading-7 text-gray-900">
      {{t 'settings.views.invoices.default_notes_on_invoice' }}
    </label>
    <div class="">
      <p class="m-0 mb-2 text-sm">{{t 'settings.views.invoices.default_notes_on_invoice_help' }}</p>
      <label
        for="default_notes_on_invoice"
        class="block text-sm font-medium leading-6 text-gray-900"
      >
        {{t 'settings.views.invoices.default_notes_on_invoice' }}
      </label>
      <textarea
        x-model="default_notes_on_invoice"
        rows="4"
        id="default_notes_on_invoice"
        class="w-full block flex-1 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
      ></textarea>
    </div>

    <button
      type="button"
      class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
      @click="fetchUrl('/company/defaultnotesoninvoice', 'PATCH', { default_notes_on_invoice: default_notes_on_invoice })"
    >
      {{t 'settings.views.invoices.update_default_notes_on_invoice_button' }}
    </button>
  </div>
</div>
