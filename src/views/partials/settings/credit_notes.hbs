<div class="flex flex-1 w-full flex-col gap-y-8 sm:gap-y-14 p-4">

    <div class="sm:flex sm:items-start">
        <div
            class="hidden sm:flex mx-auto h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
            <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round"
                    d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
        </div>
        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
            <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">{{t
                'settings.views.invoices.warning_title' }} {{session.current_company.name}}
                {{#if session.current_company.internal_name}}
                ({{session.current_company.internal_name}})
                {{/if}}
            </h3>
            <div class="mt-2">
                <p class="text-sm text-gray-500">{{t 'settings.views.invoices.warning_text' }}</p>
            </div>
        </div>
    </div>

    <div x-data="{show_target_invoice: '{{ session.current_company.settings.show_target_invoice }}' }"
        class="flex flex-col gap-y-4">
        <label for="show_target_invoice" class="text-base font-semibold leading-7 text-gray-900">{{t
            'settings.views.credit_notes.show_target_invoice' }}</label>
        <div class="">
            <p class="m-0 mb-2 text-sm">{{t 'settings.views.credit_notes.show_target_invoice_help' }}</p>
            <label for="show_target_invoice" class="block text-sm font-medium leading-6 text-gray-900">{{t
                'settings.views.credit_notes.show_target_invoice' }}</label>
            <select x-model="show_target_invoice" id="show_target_invoice"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                <option value="true">{{t 'settings.views.credit_notes.yes_show_target_invoice' }}</option>
                <option value="false">{{t 'settings.views.credit_notes.no_show_target_invoice' }}</option>
            </select>
            </select>
        </div>

        <button type="button"
            class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            @click="fetchUrl('/company/showtargetinvoice', 'PATCH', { show_target_invoice: show_target_invoice })">
            {{t 'settings.views.credit_notes.show_target_invoice_button' }}
        </button>
    </div>

    <div x-data="{default_notes_on_credit_notes: '{{ session.current_company.settings.default_notes_on_credit_notes }}' }"
        class="flex flex-col gap-y-4">
        <label for="default_notes_on_credit_notes" class="text-base font-semibold leading-7 text-gray-900">{{t
            'settings.views.credit_notes.default_notes_on_credit_notes' }}</label>
        <div class="">
            <p class="m-0 mb-2 text-sm">{{t 'settings.views.credit_notes.default_notes_on_credit_notes_help' }}</p>
            <label for="default_notes_on_credit_notes" class="block text-sm font-medium leading-6 text-gray-900">{{t
                'settings.views.credit_notes.default_notes_on_credit_notes' }}</label>
            <textarea x-model="default_notes_on_credit_notes" rows="4" id="default_notes_on_credit_notes"
                class="w-full block flex-1 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"></textarea>
        </div>

        <button type="button"
            class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            @click="fetchUrl('/company/defaultnotesoncreditnotes', 'PATCH', { default_notes_on_credit_notes: default_notes_on_credit_notes })">
            {{t 'settings.views.credit_notes.update_default_notes_on_credit_notes_button' }}
        </button>
    </div>
</div>