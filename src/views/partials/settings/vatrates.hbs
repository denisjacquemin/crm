<div class="flex flex-1 w-full flex-col gap-y-8 sm:gap-y-14 p-4"
     x-data="{
        current_country: '',
        default_taxrates: [],
        taxrates: [],
        savedStates: {},
        addEmptyTaxrate: function() {
            this.taxrates.push({value: '0', label: 'rate label', isDirty: true})
        },
        saveRate: async function(taxrate, index) {
            const data = await fetchUrl('/company/savetaxrate', 'PATCH', { 
                taxrate: JSON.stringify(taxrate) 
            });
            
            // Update the original taxrate object with the new _id
            taxrate._id = data.taxrate._id;
            taxrate.isDirty = false;
            
            // Show saved indicator
            this.savedStates[index] = true;
            setTimeout(() => {
                this.savedStates[index] = false;
            }, 2000);
            
            // Update or add to custom_taxrates
            const index_in_custom_taxrates = this.custom_taxrates.findIndex(rate => rate._id === taxrate._id);
            if (index_in_custom_taxrates !== -1) {
                this.custom_taxrates[index_in_custom_taxrates] = data.taxrate;
            } else {
                this.custom_taxrates.push(data.taxrate);
            }
        },
        markAsDirty: function(taxrate) {
            taxrate.isDirty = true;
        },
        deleteRate: function(taxrate) {
            console.log(taxrate);
            if (taxrate._id) {
                fetchUrl('/company/deletetaxrate', 'DELETE', { 
                    taxrate: JSON.stringify(taxrate) 
                });
            }
            this.taxrates = this.taxrates.filter(rate => rate !== taxrate);
            if (taxrate._id) {
                this.custom_taxrates = this.custom_taxrates.filter(rate => rate._id !== taxrate._id);
            }
        }
    }"
        
     x-init="taxrates = {{ stringify session.current_company.taxrates }}"
     x-intersect="
        default_taxrates = countries[current_company.country].taxrates;
        current_country = countries[current_company.country].name;
     "
>
    <div class="sm:flex sm:items-start p-2 sm:p-4">
        <div
            class="hidden sm:flex mx-auto h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-blue-100 sm:mx-0 sm:h-10 sm:w-10">
            <svg class="h-6 w-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
        </div>
        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
            <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">{{t
                'settings.views.vatrates.vatrates_settings' }}
            </h3>
            <div class="mt-2">
                <p class="text-sm text-gray-500">{{t 'settings.views.vatrates.vatrates_settings_help' }}</p>
            </div>
        </div>
    </div>

    <div class="flex flex-col gap-y-4"
         x-data="{ default_taxrate_selected: default_taxrate }">
        <label for="custom_vatrates" class="text-base font-semibold leading-7 text-gray-900">{{t
            'settings.views.vatrates.default_vatrates_selected' }}</label>
        <p class="text-sm text-gray-500">{{t 'settings.views.vatrates.default_vatrates_selected_help' country=(countries.[session.current_company.country].name) }}</p>
        <select x-model="default_taxrate_selected" id="vat" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
            <!-- Empty value option -->
            <optgroup :label="'{{t 'documents.views.index.items_modal.standard_taxrates' }}' + ' (' + countries[current_company.country].name + ')'">
                <template x-for="(rate, index) in countries[current_company.country].taxrates" :key="index">
                    <option :value="rate._id" 
                            :selected="default_taxrate === rate._id"
                            x-text="`${rate.label}`"></option>
                </template>
            </optgroup>
            <optgroup x-show="custom_taxrates.length > 0" label="{{ t 'documents.views.index.items_modal.custom_taxrates' }}">
                <template x-for="(rate, index) in custom_taxrates" :key="index">
                    <option :value="rate._id" 
                            :selected="default_taxrate === rate._id"
                            x-text="`${rate.label} (${rate.value}%)`"></option>
                </template>
            </optgroup>
        </select>

        <button type="button"
                class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
                @click="fetchUrl('/company/defaulttaxrate', 'PATCH', { default_taxrate: default_taxrate_selected }); default_taxrate = default_taxrate_selected;">      
                {{t 'settings.views.vatrates.set_default_vatrate_button' }}
        </button>
    </div>

    <div class="flex flex-col gap-y-4">
        <label for="custom_vatrates" class="text-base font-semibold leading-7 text-gray-900">{{t
            'settings.views.vatrates.custom_vatrates' }}</label>
        <p class="text-sm text-gray-500">{{t 'settings.views.vatrates.custom_vatrates_help' }}</p>

        <div class="space-y-3">
            <!-- Empty state - replaced with default form -->
            <template x-if="taxrates?.length === 0">
                <div class="flex gap-x-4">
                    <div class="w-14">
                        <label for="taxrate_value-0" class="block text-sm font-medium leading-6 text-gray-900">
                            {{t 'settings.views.vatrates.value' }}
                        </label>
                        <div class="mt-1">
                            <input type="text"
                                @input="taxrates[0] = { value: $event.target.value, label: taxrates[0]?.label || '' }"
                                value="0"
                                id="taxrate_value-0"
                                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                        </div>
                    </div>

                    <div class="flex-1">
                        <label for="taxrate_label-0" class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.vatrates.label' }}</label>
                        <div class="mt-1 flex items-center gap-x-4">
                            <input type="text"
                                @input="taxrates[0] = { value: taxrates[0]?.value || '0', label: $event.target.value }"
                                value="rate label"
                                id="taxrate_label-0"
                                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">

                            <!-- Actions -->
                            <div class="flex items-center gap-x-2">
                                <button type="button"
                                    @click.prevent="saveRate(taxrates[0])"
                                    class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                                    {{t 'settings.views.vatrates.save_button' }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </template>

            <!-- VAT rates list - existing rates -->
            <template x-for="(taxrate, index) in taxrates" :key="index">
                <div class="flex gap-x-4" :class="{ 'bg-yellow-50': taxrate.isDirty }">
                    <div class="w-14">
                        <label :for="'taxrate_value-' + index" class="block text-sm font-medium leading-6 text-gray-900">
                            {{t 'settings.views.vatrates.value' }}
                        </label>
                        <div class="mt-1">
                            <input type="text"
                                @input="taxrate.value = $event.target.value; markAsDirty(taxrate)"
                                :value="taxrate.value"
                                :id="'taxrate_value-' + index"
                                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                        </div>
                    </div>

                    <div class="flex-1">
                        <label :for="'taxrate_label-' + index" class="block text-sm font-medium leading-6 text-gray-900">{{t 'settings.views.vatrates.label' }}</label>
                        <div class="mt-1 flex items-center gap-x-4">
                            <input type="text"
                                @input="taxrate.label = $event.target.value; markAsDirty(taxrate)"
                                :value="taxrate.label"
                                :id="'taxrate_label-' + index"
                                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">

                            <!-- Actions -->
                            <div class="flex items-center gap-x-2">
                                <button type="button"
                                    @click.prevent="saveRate(taxrate, index)"
                                    :class="{ 'opacity-50 cursor-not-allowed': !taxrate.isDirty }"
                                    :disabled="!taxrate.isDirty"
                                    class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                                    {{t 'settings.views.vatrates.save_button' }}
                                </button>

                                <!-- Saved indicator -->
                                <span x-show="savedStates[index]"
                                      x-transition:enter="transition ease-out duration-300"
                                      x-transition:enter-start="opacity-0"
                                      x-transition:enter-end="opacity-100"
                                      x-transition:leave="transition ease-in duration-200"
                                      x-transition:leave-start="opacity-100"
                                      x-transition:leave-end="opacity-0"
                                      class="text-green-600 flex items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-1" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                    </svg>
                                    Saved
                                </span>

                                <!-- Delete button -->
                                <div class="flex items-center">
                                    <button @click.prevent="deleteRate(taxrate)"
                                            type="button"
                                            class="text-gray-400 hover:text-gray-500">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </template>

            <!-- Add VAT rate link -->
            <button @click.prevent="addEmptyTaxrate" 
                    type="button"
                    class="mt-2 text-sm text-indigo-600 hover:text-indigo-500 inline-flex items-center">
                <svg class="h-4 w-4 mr-1" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
                </svg>
                {{t 'settings.views.vatrates.add_custom_taxrate' }}
            </button>
        </div>
    </div>
    <div class="flex flex-col gap-y-4">
        <label for="custom_vatrates" class="text-base font-semibold leading-7 text-gray-900">{{t
            'settings.views.vatrates.default_vatrates' }}</label>
        <p class="text-sm text-gray-500">{{t 'settings.views.vatrates.default_vatrates_help' country=(countries.[session.current_company.country].name) }}</p>
        <p class="text-sm text-gray-500">{{t 'settings.views.vatrates.country_selected_is' }}: <span class="font-bold" x-text="current_country"></span> </p>
        <ul class="list-disc text-sm ml-5">
            <template x-for="(taxrate, index) in default_taxrates" :key="index">
                <li x-text="`${taxrate.label}`"></li>
            </template>
        </ul>
    </div>
</div>
