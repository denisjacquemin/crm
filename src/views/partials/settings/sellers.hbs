<div class="w-[200%] flex-1 h-full overflow-hidden flex sm:w-full"
    x-data="{
        sellers: {{ stringify sellers }},
        selectedSeller: {},
        editSeller: async function(index) {
            try {
                const data = await fetchUrl(`/companies/editAjax/${this.sellers[index].slug}`, 'GET');
                this.selectedSeller = data;
                this.sellers[index] = this.selectedSeller;
                if (window.innerWidth < 640) this.showCompanyForm();
            } catch (error) { console.error('Error editing company', error); }
        },
        newSeller: async function(){
            try {
                const data = await fetchUrl('/company/newAjax', 'POST');
                this.selectedSeller = data;
                this.sellers.push(this.selectedSeller);
                if (window.innerWidth < 640) this.showCompanyForm();
            } catch (error) { 
                console.error('Error creating new seller', error); 
            }
        },
        showCompanyForm: function() {
            this.$refs.companiesList.style.transform = 'translateX(-100%)'; 
            this.$refs.companyForm.style.transform = 'translateX(-100%)';
        },
        showCompanyList: function() {
            this.$refs.companiesList.style.transform = 'translateX(0)';
            this.$refs.companyForm.style.transform = 'translateX(0)';
        },
        frequentlySelectedCountries: {{ stringify frequentlySelectedCountries }},
        defaultCountry: '{{ defaultCountry }}',
        selectedCountry: null,
        countries: {{ stringify countries }},
        company_registration_number_label_translations: {{ stringify company_registration_number_label_translations }},
        updateCompanyRegistrationNumberLabel: function(country_code) {
            var countries = ['BE', 'FR', 'CA', 'NL', 'LU', 'DE', 'IT', 'ES', 'US', 'IE', 'AT', 'CH', 'PL', 'PT', 'SE', 'DK', 'NO', 'FI', 'HU', 'RO', 'BG', 'GR', 'CZ', 'SK', 'SI', 'HR', 'RS', 'BA', 'ME', 'AL', 'MK', 'XK', 'TR', 'RU', 'BY', 'UA', 'MD', 'LV', 'LT', 'EE', 'CY', 'MT', 'LI', 'IS', 'FO', 'GL', 'SJ', 'AX', 'DZ', 'MA', 'TN'];
            if (countries.includes(country_code)) {
                this.company_registration_number_label = this.company_registration_number_label_translations.find(function (element) {
                    return element.country_code == country_code;
                }).label 
            } else {
                this.company_registration_number_label = '{{t 'users.views.signup2.company_registration_number' }}';
            }
        },
        without_vat: {{#if selectedSeller.without_vat}}{{selectedSeller.without_vat}}{{else}}false{{/if}},


    }"
    x-init="
      selectedCountry = '{{ session.signup.company.country }}' || defaultCountry || frequentlySelectedCountries[0].value;
      updateCompanyRegistrationNumberLabel(selectedCountry);
      $watch('selectedCountry', (value, oldValue) => {
        console.log('selectedCountry changed', value, oldValue);
      });
      $watch('selectedSeller', (value, oldValue) => {
        console.log('selectedSeller changed', value, oldValue);
        var company = { ...value };
        if (company.slug) {
            company.autosave_updated_at = new Date();
            localStorage.setItem('autosave#company#' + value.slug, JSON.stringify(company));
        }
      });
    ">
    <div x-ref="companiesList" class="flex flex-col flex-1 w-[50%] transition-transform duration-500 ease-in-out">
        <div class="flex-none w-full flex items-center p-2">
            <button type="button" id="newDocumentButton"
                class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
                @click.prevent="newSeller">      
                <svg class="-ml-0.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M9 9V6a1 1 0 012 0v3h3a1 1 0 010 2h-3v3a1 1 0 01-2 0V11H6a1 1 0 010-2h3z" clip-rule="evenodd" />
                </svg>
                {{t 'settings.views.sellers.create_seller_button' }}
            </button>
        </div>
        <div class="flex-grow overflow-y-scroll flex flex-1 w-full">
            <template x-if="sellers.length === 0">
                <div class="relative block w-full h-full p-2 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto h-12 w-12 text-gray-400">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                        </svg>
                        <span class="mt-2 block text-md font-semibold text-gray-500">{{t 'settings.views.sellers.no_seller_found' }}</span>
                    </div>
                </div>
            </template>

            <template x-if="sellers.length > 0">
                <ul role="list" class="w-full divide-y divide-gray-100">
                    <template x-for="(seller, index) in sellers" :key="index">
                        <li class="relative py-5 hover:bg-gray-100 cursor-pointer" role="listitem"
                            @click.prevent="editSeller(index);"
                            :data-slug="seller.slug"
                            
                        >
                        <div class="px-4">
                            <div class="mx-auto flex max-w-4xl justify-between gap-x-6">
                                <div class="flex flex-1 min-w-0 gap-x-4">
                                    <div class="min-w-0 flex-auto">
                                        <div x-text="seller?.name" 
                                                class="text-sm font-semibold leading-6 text-gray-900 line-clamp-2"
                                                :class="{
                                                'text-indigo-700': selectedSeller.slug === seller.slug,
                                                'text-gray-900': selectedSeller.slug !== seller.slug
                                                }">
                                        </div>
                                        <div class="mt-1 flex text-xs leading-5 text-gray-500"
                                            x-data="() => ({
                                                get address1() { return seller.address1 },
                                                get address2() { return seller.address2 },
                                                get city() { return seller.city },
                                                get country() { return seller.country },
                                                get zip() { return seller.zip },
                                            })"
                                        >
                                            <div x-text="window.formatAddress(address1, address2, zip, city, country)" class="relative truncate w-full text-left h-5"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex shrink-0 items-center gap-x-4">
                                    <svg :class="{
                                                'text-indigo-700 font-medium': selectedSeller.slug === seller.slug,
                                                'text-gray-400 font-normal': selectedSeller.slug !== seller.slug
                                                }"
                                            class="h-5 w-5 flex-none " viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                        <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                        </li>
                    </template>
                </ul> 
            </template>
        </div>
    </div>
    <div x-ref="companyForm"
         class="w-[50%] h-full border-l border-gray-200 flex flex-col sm:flex-1 transition-transform duration-500 ease-in-out">
         <div x-cloak x-show="Object.keys(selectedSeller).length === 0" class="relative block w-full h-full p-5 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
            <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto h-12 w-12 text-gray-400">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                </svg>
                <span class="mt-2 block text-md font-semibold text-gray-500">{{t 'settings.views.sellers.no_seller_selected' }}</span>
            </div>
        </div>

        <div x-cloak x-show="Object.keys(selectedSeller).length !== 0" class="flex flex-col h-full pb-5">
            <div class="w-full py-2 mb-3 sm:pr-2 text-right flex shadow-md sm:shadow-none">
                <div class="w-1/2 text-left sm:hidden">
                    <button @click.prevent="if (window.innerWidth < 640) showCompanyList();"
                        href="#" class="px-3.5 py-2.5 text-sm font-semibold text-gray-600 hover:text-gray-400">      
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                        </svg>
                    </button>
                </div>
                <div class="w-1/2 text-right my-auto sm:w-full">
                    <a href="#"
                        class="underline px-3.5 py-2.5 text-sm font-semibold text-red-600 hover:text-red-400"
                            @click.prevent="deleteBuyer(selectedSeller.slug)">      
                        Delete
                    </a>
                </div>
            </div>

            <div class="px-4 flex-1 flex flex-col gap-y-5 overflow-y-scroll">
                <div>
                    <label for="name" class="block text-sm font-medium leading-6 text-gray-900">{{t 'users.views.signup2.name' }}</label>
                    <div class="mt-1">
                        <input type="text" x-model="selectedSeller.name" autocomplete="off"
                            id="name"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>
                <div>
                    <label for="address" class="block text-sm font-medium leading-6 text-gray-900">{{t 'users.views.signup2.address' }}</label>
                    <div class="mt-1">
                        <input type="text" x-model="selectedSeller.address1" autocomplete="off"
                            id="address"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                        <input type="text" x-model="selectedSeller.address2" autocomplete="off"
                            class="mt-1 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>
                <div>
                    <label for="zip" class="block text-sm font-medium leading-6 text-gray-900">{{t 'users.views.signup2.zip' }}</label>
                    <div class="mt-1">
                        <input type="text" x-model="selectedSeller.zip" autocomplete="off"
                            id="zip"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>
                <div>
                    <label for="city" class="block text-sm font-medium leading-6 text-gray-900">{{t 'users.views.signup2.city' }}</label>
                    <div class="mt-1">
                        <input type="text" x-model="selectedSeller.city" autocomplete="off"
                            id="city"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>
                <div>
                    <label for="country" class="block text-sm font-medium leading-6 text-gray-900">{{t 'users.views.signup2.country' }}</label>
                    <div class="mt-1">
                        <select x-on:change="selectedSeller.country = $event.target.value; selectedSeller = {...selectedSeller}; updateCompanyRegistrationNumberLabel($event.target.value)"
                                id="country" name="country"
                                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                            <optgroup label="{{t 'users.views.signup2.frequently_selected_countries' }}">
                                <template x-for="(country, index) in frequentlySelectedCountries" :key="index">
                                <option x-bind:selected="country.value === selectedCountry" :value="country.value" x-text="country.name"></option>
                                </template>
                            </optgroup>
                            <optgroup label="{{t 'users.views.signup2.all_countries' }}">
                                <template x-for="(country, index) in countries" :key="index">
                                <option x-bind:selected="country.value === selectedCountry && !frequentlySelectedCountries.some(c => c.value === selectedCountry)" :value="country.value" x-text="country.name"></option>
                                </template>
                            </optgroup>
                        </select>                   
                    </div>
                </div>
                <div>
                    <label for="vat_number" class="block text-sm font-medium leading-6 text-gray-900">{{t 'users.views.signup2.vat_number' }}</label>
                    <div class="mt-1">
                        <input x-bind:disabled="selectedSeller.without_vat" 
                            type="text" x-model="selectedSeller.vat_number" autocomplete="off"
                            id="vat_number"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6 disabled:cursor-not-allowed disabled:bg-gray-50 disabled:text-gray-500 disabled:ring-gray-200">
                        <div class="mt-1">
                            {{!-- value="session.signup.company.without_vat" --}}
                            <input x-model="selectedSeller.without_vat"
                                type="checkbox" id="without_vat" name="without_vat" class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
                            <label for="without_vat" class="text-sm font-medium leading-6 text-gray-900">{{t 'users.views.signup2.without_vat' }}</label>
                        </div>
                    </div>
                </div>
                <div>
                    <label x-text="company_registration_number_label" for="company_registration_number" class="block text-sm font-medium leading-6 text-gray-900"></label>
                    <div class="mt-1">
                        <input type="text" x-model="selectedSeller.company_registration_number" autocomplete="off"
                            id="company_registration_number"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>
                <div>
                    <label for="contact_name" class="block text-sm font-medium leading-6 text-gray-900">{{t 'users.views.signup2.contact_name' }}</label>
                    <div class="mt-1">
                        <input type="text" x-model="selectedSeller.contact_name" autocomplete="off"
                            id="contact_name" 
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>
                <div>
                    <label for="phone" class="block text-sm font-medium leading-6 text-gray-900">{{t 'users.views.signup2.phone' }}</label>
                    <div class="mt-1">
                        <input type="text" x-model="selectedSeller.phone" autocomplete="off"
                            id="phone" 
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>
                <div>
                    <label for="email" class="block text-sm font-medium leading-6 text-gray-900">{{t 'users.views.signup2.email' }}</label>
                    <div class="mt-1">
                        <input type="text" x-model="selectedSeller.email" autocomplete="off"
                            id="email" 
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>
                <div>
                    <label for="website" class="block text-sm font-medium leading-6 text-gray-900">{{t 'users.views.signup2.website' }}</label>
                    <div class="mt-1">
                        <div class="mt-1 flex rounded-md shadow-sm">
                            <span class="inline-flex items-center rounded-l-md border border-r-0 border-gray-300 bg-gray-50 px-3 text-gray-500 sm:text-sm">https://</span>
                            <input id="website" x-model="selectedSeller.website" name="website" value="{{ session.signup.company.website }}" type="text" class="block w-full appearance-none rounded-r-md border border-gray-300 px-3 py-2 placeholder-gray-400 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500 sm:text-sm">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div> 
</div>