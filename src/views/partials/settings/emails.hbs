<div class="flex flex-1 w-full flex-col gap-y-8 p-4">
    <div x-data="{send_cc_to: current_company.settings.send_cc_to }" class="flex flex-col gap-y-4">
        <label for="send_cc_to" class="text-base font-semibold leading-7 text-gray-900">{{t
            'settings.views.emails.send_cc_to' }}</label>
        <div class="">
            <p class="m-0 mb-2 text-sm">{{t 'settings.views.emails.send_cc_to_help' }}</p>
            <label for="send_bcc_tosend_cc_to" class="block text-sm font-medium leading-6 text-gray-900">{{t
                'settings.views.emails.send_cc_to' }}</label>
            <input x-model="send_cc_to" id="send_cc_to"
                placeholder="{{t 'settings.views.emails.send_cc_to_placeholder' }}" type="text"
                class="w-full block rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
        </div>

        <button type="button"
            class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            @click="fetchUrl('/company/send_cc_to', 'PATCH', { send_cc_to: send_cc_to }); current_company.settings.send_cc_to = send_cc_to">
            {{t 'settings.views.emails.send_cc_to_button' }}
        </button>
    </div>

    <div x-data="{send_bcc_to: current_company.settings.send_bcc_to }" class="flex flex-col gap-y-4">
        <label for="send_bcc_to" class="text-base font-semibold leading-7 text-gray-900">{{t
            'settings.views.emails.send_bcc_to' }}</label>
        <div class="">
            <p class="m-0 mb-2 text-sm">{{t 'settings.views.emails.send_bcc_to_help' }}</p>
            <label for="send_bcc_to" class="block text-sm font-medium leading-6 text-gray-900">{{t
                'settings.views.emails.send_bcc_to' }}</label>
            <input x-model="send_bcc_to" id="send_bcc_to"
                placeholder="{{t 'settings.views.emails.send_bcc_to_placeholder' }}" type="text"
                class="w-full block rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">

        </div>

        <button type="button"
            class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            @click="fetchUrl('/company/send_bcc_to', 'PATCH', { send_bcc_to: send_bcc_to }); current_company.settings.send_bcc_to = send_bcc_to">
            {{t 'settings.views.emails.send_bcc_to_button' }}
        </button>
    </div>

    <div x-data="{
            email_subject_templates: {{ stringify session.current_company.settings.email_subject_templates }}, 
            email_message_templates: {{ stringify session.current_company.settings.email_message_templates }},
            selectedLanguage: '{{ session.user.language }}',
        }" x-init="
            $watch('selectedLanguage', (newVal, oldVal) => {
                $refs.editor.innerHTML = email_message_templates[selectedLanguage]
            });
        " class="flex flex-col gap-y-4">
        <label for="send_bcc_to" class="text-base font-semibold leading-7 text-gray-900">{{t
            'settings.views.emails.email_templates' }}</label>
        <p class="m-0 mb-2 text-sm">{{t 'settings.views.emails.email_template_help' }} <span
                class="cursor-pointer text-indigo-600 hover:text-indigo-500" @click="$refs.templateTable.classList.toggle('hidden')">{{t
                'settings.views.emails.link_email_template_help' }}</span></p>
        <table x-ref="templateTable" class="hidden divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col"
                        class="px-2 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        {x}
                    </th>
                    <th scope="col"
                        class="px-2 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                        Description
                    </th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <tr>
                    <td class="px-2 sm:px-6 py-2 whitespace-nowrap text-sm font-medium text-gray-900">
                        {1}
                    </td>
                    <td class="px-2 sm:px-6 py-2 text-sm text-gray-500">
                        {{ t 'settings.views.emails.email_template_type' }}
                    </td>
                </tr>
                <tr>
                    <td class="px-2 sm:px-6 py-2 whitespace-nowrap text-sm font-medium text-gray-900">
                        {2}
                    </td>
                    <td class="px-2 sm:px-6 py-2 text-sm text-gray-500">
                        {{ t 'settings.views.emails.document_number' }}
                    </td>
                </tr>
                <tr>
                    <td class="px-2 sm:px-6 py-2 whitespace-nowrap text-sm font-medium text-gray-900">
                        {3}
                    </td>
                    <td class="px-2 sm:px-6 py-2 text-sm text-gray-500">
                        {{ t 'settings.views.emails.seller_name' }}
                    </td>
                </tr>
                <tr>
                    <td class="px-2 sm:px-6 py-2 whitespace-nowrap text-sm font-medium text-gray-900">
                        {4}
                    </td>
                    <td class="px-2 sm:px-6 py-2 text-sm text-gray-500">
                        {{ t 'settings.views.emails.contact_title' }}
                    </td>
                </tr>
                <tr>
                    <td class="px-2 sm:px-6 py-2 text-sm font-medium text-gray-900">
                        {5}
                    </td>
                    <td class="px-2 sm:px-6 py-2 text-sm text-gray-500">
                        {{ t 'settings.views.emails.contact_firstname' }}
                    </td>
                </tr>
                <tr>
                    <td class="px-2 sm:px-6 py-2 text-sm font-medium text-gray-900">
                        {6}
                    </td>
                    <td class="px-2 sm:px-6 py-2 text-sm text-gray-500">
                        {{ t 'settings.views.emails.contact_lastname' }}
                    </td>
                </tr>
                <tr>
                    <td class="px-2 sm:px-6 py-2 text-sm font-medium text-gray-900">
                        {7}
                    </td>
                    <td class="px-2 sm:px-6 py-2  text-sm text-gray-500">
                        {{ t 'settings.views.emails.invoice_date' }}
                    </td>
                </tr>
                <tr>
                    <td class="px-2 sm:px-6 py-2 whitespace-nowrap text-sm font-medium text-gray-900">
                        {8}
                    </td>
                    <td class="px-2 sm:px-6 py-2 whitespace-nowrap text-sm text-gray-500">
                        {{ t 'settings.views.emails.invoice_due_date' }}
                    </td>
                </tr>
                <tr>
                    <td class="px-2 sm:px-6 py-2 whitespace-nowrap text-sm font-medium text-gray-900">
                        {9}
                    </td>
                    <td class="px-2 sm:px-6 py-2 whitespace-nowrap text-sm text-gray-500">
                        {{ t 'settings.views.emails.total_amount' }}
                    </td>
                </tr>
            </tbody>
        </table>

        <div>
            <div class="flex flex-row items-end justify-between">
                <label for="language-select" class="block text-sm font-medium leading-6 text-gray-900">
                    {{t 'settings.views.emails.choose_language' }}
                </label>
                <select id="language-select" x-model="selectedLanguage"
                    class="block appearance-none bg-white border border-gray-300 text-gray-700 text-sm px-4 pr-8 py-1 rounded leading-tight focus:outline-none focus:bg-white focus:border-gray-500">
                    <template x-for="lang in i18n_languages" :key="lang">
                        <option :value="lang" x-text="all_languages[lang].name" :selected="selectedLanguage === lang">
                        </option>
                    </template>
                </select>

            </div>
        </div>
        <div>
            <label for="language-select" class="block text-sm font-medium leading-6 text-gray-900">
                {{t 'settings.views.emails.email_subject_label' }}
            </label>
            <input type="text" id="email-subject-template" x-model="email_subject_templates[selectedLanguage]"
                class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
        </div>
        <div class="">
            <div class="flex flex-row items-end">
                <label for="email-body" class="flex-none block text-sm font-medium leading-6 text-gray-900">{{t
                    'documents.views.index.email_modal.body' }}</label>
                <div class="flex-1 mb-1 justify-end text-right">
                    <button type="button" @click="document.execCommand('bold', false, null)" tabindex="-1"
                        class="border rounded-sm h-8 w-8 font-bold hover:bg-gray-100 hover:border-gray-300">
                        {{ t 'documents.views.index.email_modal.bold' }}
                    </button>
                    <button type="button" @click="document.execCommand('italic', false, null)" tabindex="-1"
                        class="border rounded-sm h-8 w-8 italic hover:bg-gray-100 hover:border-gray-300">
                        {{ t 'documents.views.index.email_modal.italic' }}
                    </button>
                    <button type="button" @click="document.execCommand('underline', false, null)" tabindex="-1"
                        class="border rounded-sm h-8 w-8 underline hover:bg-gray-100 hover:border-gray-300">
                        {{ t 'documents.views.index.email_modal.underline' }}
                    </button>
                    <button type="button" @click="document.execCommand('strikeThrough', false, null)" tabindex="-1"
                        class="border rounded-sm h-8 w-8 line-through hover:bg-gray-100 hover:border-gray-300">
                        {{ t 'documents.views.index.email_modal.strike' }}
                    </button>
                </div>
            </div>
            <div x-ref="editor" ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset
                focus:ring-indigo-600
                class="h-60 rounded-md border-0 shadow-sm ring-1 ring-inset ring-gray-300 p-2 text-gray-900 sm:text-sm overflow-y-auto focus:ring-2 focus:ring-inset focus:ring-indigo-600"
                contenteditable="true" x-init="$refs.editor.innerHTML = email_message_templates[selectedLanguage]"
                @input="email_message_templates[selectedLanguage] = $event.target.innerHTML"
                @keydown.enter.prevent="document.execCommand('insertLineBreak')"></div>
        </div>

        <button type="button"
            class="inline-flex items-center w-full sm:w-auto rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
            @click="fetchUrl('/company/update_email_templates', 'PATCH', { email_subject_templates: email_subject_templates, email_message_templates: email_message_templates }); current_company.settings.email_subject_templates = email_subject_templates; current_company.settings.email_message_templates = email_message_templates">
            {{t 'settings.views.emails.update_email_templates' }}
        </button>
    </div>
</div>