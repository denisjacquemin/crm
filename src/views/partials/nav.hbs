<div x-data="{ open: false }" @keydown.window.escape="open = false" class=" z-40">


  {{!-- Small screen menu --}}
  <div x-show="open" class="relative z-40 lg:hidden"
    x-description="Off-canvas menu for mobile, show/hide based on off-canvas menu state." x-ref="dialog"
    aria-modal="true">

    <div x-show="open" x-transition:enter="transition-opacity ease-linear duration-300"
      x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100"
      x-transition:leave="transition-opacity ease-linear duration-300" x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      x-description="Off-canvas menu backdrop, show/hide based on off-canvas menu state."
      class="fixed inset-0 bg-black bg-opacity-25"></div>

    <div class="fixed inset-0 z-40 flex">

      <div x-show="open" x-transition:enter="transition ease-in-out duration-300 transform"
        x-transition:enter-start="-translate-x-full" x-transition:enter-end="translate-x-0"
        x-transition:leave="transition ease-in-out duration-300 transform" x-transition:leave-start="translate-x-0"
        x-transition:leave-end="-translate-x-full"
        x-description="Off-canvas menu, show/hide based on off-canvas menu state."
        class="relative flex w-full max-w-xs flex-col overflow-y-auto bg-white pb-12 shadow-xl"
        @click.away="open = false">
        <div class="flex">
          <div class="w-1/3 px-4 pb-2 pt-5">
            <button type="button"
              class="rounded-md bg-gray-200  hover:text-gray-700 -m-2 inline-flex items-center justify-center p-2 text-gray-400"
              @click="open = false" spellcheck="false">
              <span class="sr-only ">Close menu</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="text-gray-400 hover:text-gray-500 lucide lucide-x">
                <path d="M18 6 6 18" />
                <path d="m6 6 12 12" />
              </svg>
            </button>
          </div>
          <div class="w-2/3 px-6 pb-2 pt-5 text-right">
            <template x-if="companies.length > 1">
              <div x-data="{
                          async changeCurrentCompany(company_slug) {
                            await fetchUrl('/companies/changeCurrentCompany', 'POST', { company_slug: company_slug });
                            open = false;
                            window.location.reload();
                          }
                        }">
                <select @change="changeCurrentCompany(event.target.value)" id="desktop-sellers" name="currency"
                  class="block  w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                  <template x-for="company in companies">
                    <option x-text="company.name" :value="company.slug" x-bind:selected="company.selected"></option>
                  </template>
                </select>
              </div>
            </template>
            <template x-if="companies.length === 1">
              <div x-text="companies[0].name" class="text-sm font-medium"></div>
            </template>
          </div>
        </div>



        <div class="space-y-6 border-t border-gray-200 px-4 py-6">
          <div class="flow-root">
            <a href="#" @click.prevent="loadModalContent('/products', {
                        title: '{{t 'nav.products_title' }}',
                        description: '{{t 'nav.products_description' }}'
                    })" class="-m-2 block p-2 font-medium text-gray-900" x-html="'{{t 'nav.products' }}'"></a>
          </div>
          <div class="flow-root">
            <a href="#" @click.prevent="loadModalContent('/buyers', {
                        title: '{{t 'nav.buyers_title' }}',
                        description: '{{t 'nav.buyers_description' }}'
                    })" class="-m-2 block p-2 font-medium text-gray-900">{{t 'nav.clients' }}</a>
          </div>
          <div class="flow-root">
            <a href="/documents" class="-m-2 block p-2 font-medium text-gray-900">{{t 'nav.documents' }}</a>
          </div>
        </div>
      </div>

    </div>

  </div>

  <header class="relative 2xl:container 2xl:m-auto">
    <nav aria-label="Top">
      {{> topbar }}


      <!-- Secondary navigation -->
      <div class="bg-white">
        <div class="2xl:mx-auto 2xl:container px-4 sm:px-6 lg:px-8">
          <div class="border-b border-gray-200">
            <div class="flex h-16 items-center justify-between">
              <!-- Logo (lg+) -->
              <div class="hidden lg:flex lg:items-center">
                <a href="#">
                  <span class="sr-only">Your Company</span>
                  <img class="h-8 w-auto" src="" alt="">
                </a>
              </div>

              <div class="hidden h-full lg:flex">
                <!-- Mega menus -->
                <div x-data="Components.popoverGroup()" x-init="init()">
                  <div class="flex h-full justify-center space-x-8">

                    <a href="#" @click.prevent="loadModalContent('/products', {
                        title: '{{t 'nav.products_title' }}',
                        description: '{{t 'nav.products_description' }}'
                    })" class="flex items-center text-sm font-medium text-gray-700 hover:text-gray-800"
                      x-html="'{{t 'nav.products' }}'"></a>
                    <a href="#" @click.prevent="loadModalContent('/buyers', {
                        title: '{{t 'nav.buyers_title' }}',
                        description: '{{t 'nav.buyers_description' }}'
                    })" class="flex items-center text-sm font-medium text-gray-700 hover:text-gray-800">{{t
                      'nav.clients' }}</a>
                    <a href="/documents" class="flex items-center text-sm font-medium text-gray-700 hover:text-gray-800"
                      style="background-color: #fff7ca; background-image: linear-gradient(to right, #fff2ac, #fff7ca)">{{t
                      'nav.documents' }}</a>

                  </div>
                </div>
              </div>

              <!-- Mobile menu and search (lg-) -->
              <div class="flex flex-1 items-center lg:hidden">
                <button type="button" x-description="Mobile menu toggle, controls the 'mobileMenuOpen' state."
                  class="-ml-2 rounded-md bg-white p-2 text-gray-400" @click="open = true" spellcheck="false" :class="{
                            'hidden sm:block': navState !== 'menu',
                            'block': navState === 'menu'
                          }">
                  <span class="sr-only">Open menu</span>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    class="text-gray-400 hover:text-gray-500 h-6 w-6 lucide lucide-menu">
                    <line x1="4" x2="20" y1="12" y2="12" />
                    <line x1="4" x2="20" y1="6" y2="6" />
                    <line x1="4" x2="20" y1="18" y2="18" />
                  </svg>
                </button>
                <button @click="navState = 'menu';" type="button" class="-ml-2 rounded-md bg-white p-2 text-gray-400"
                  aria-controls="mobile-menu" aria-expanded="false" :class="{
                            'hidden': navState !== 'back',
                            'block sm:hidden': navState === 'back'
                          }">
                  <span class="sr-only">back to previews screen</span>
                  <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    class="lucide lucide-arrow-left">
                    <path d="m12 19-7-7 7-7" />
                    <path d="M19 12H5" />
                  </svg>
                </button>

                <!-- Search -->
                <a href="#" class="ml-2 p-2 text-gray-400 hover:text-gray-500">
                  <span class="sr-only">Search</span>
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
                    aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round"
                      d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"></path>
                  </svg>
                </a>
              </div>

              <!-- Logo (lg-) -->
              <a href="#" class="lg:hidden">
                <span class="sr-only">Your Company</span>
                <img src="" alt="" class="h-8 w-auto">
              </a>

              <div class="flex flex-1 items-center justify-end">
                <div class="flex items-center lg:ml-8">

                  <div class="flex">
                    <div class="flex ">
                      <div class="flex">
                        <a x-on:click="loadModalContent('/settings', {
                            title: '{{t 'global.settings.settings_title' }}',
                            description: '{{t 'global.settings.settings_description' }}'
                          })"
                          class="cursor-pointer group -m-2 flex items-center p-2 text-gray-400 hover:text-gray-500">
                          <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-settings">
                            <path
                              d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" />
                            <circle cx="12" cy="12" r="3" />
                          </svg>
                        </a>
                      </div>
                      <span class="hidden sm:block mx-4 h-6 w-px bg-gray-200 " aria-hidden="true"></span>

                      <div class="hidden sm:flex">
                        <a alt="{{t 'nav.signout_alt' }}" href="/users/signout"
                          class="cursor-pointer group -m-2 flex items-center p-2 text-gray-400 hover:text-gray-500">
                          <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="lucide lucide-log-out">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <polyline points="16 17 21 12 16 7" />
                            <line x1="21" x2="9" y1="12" y2="12" />
                          </svg>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>
  </header>


</div>