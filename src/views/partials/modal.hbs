<div    x-show="openSettingsModal"
        style="display: none"
        x-on:keydown.escape.prevent.stop="closeModal()"
        role="dialog"
        aria-modal="true"
        x-id="['modal-title']"
        :aria-labelledby="$id('modal-title')"
        class="fixed inset-0 z-50"
    >
        <!-- Overlay -->
        <div x-show="openSettingsModal" 
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0"
        x-transition:enter-end="opacity-100"
        x-transition:leave="transition ease-in duration-300"
        x-transition:leave-start="opacity-100"
        x-transition:leave-end="opacity-0"
        class="fixed inset-0 bg-black bg-opacity-50"></div>
 
        <!-- Panel -->
        <div
          x-show="openSettingsModal" 
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 translate-y-full"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-300"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 translate-y-full"
          x-on:click="closeModal()"
          class="relative flex min-h-screen items-center justify-center sm:p-4"
          role="dialog"
          aria-modal="true"
          aria-label="Settings Dialog"
      >
          <div
              x-on:click.stop
              x-trap.noscroll.inert="openSettingsModal"
            class="h-screen w-full flex sm:h-[90vh] md:h-[80vh] sm:max-w-4xl flex-col sm:rounded-xl bg-white shadow-lg sm:p-8 xl:m-20"

              :class="{
                'h-screen w-full flex sm:h-[90vh] md:h-[80vh] sm:max-w-4xl flex-col sm:rounded-xl bg-white shadow-lg sm:p-8 xl:m-20': modalSize === 'large',
                'h-screen w-full flex sm:h-[90vh] sm:max-w-4xl md:h-[80vh] flex-col sm:rounded-xl bg-white shadow-lg sm:p-8 xl:m-20': modalSize === 'medium',
                'h-[50vh] w-full flex sm:max-w-2xl flex-col sm:rounded-xl bg-white shadow-lg sm:p-8 xl:m-20': modalSize === 'small',
               }"
          >
            <div class="flex border-b border-gray-200 p-4 pr-2 sm:px-0">
                <div class="flex-1">
                    <h2 class="text-xl font-semibold leading-6 text-gray-900" id="slide-over-title" x-text="modalSize">Settings</h2>
                    <p class="mt-2 mb-2 inline sm:block sm:mb-4 text-sm text-gray-700">Update any settings.</p>
                </div>
                <div class="relative right-0 top-0 -ml-8 flex mb-2 sm:-ml-10">
                    <button x-on:click="closeModal()" type="button" class="z-50 rounded-md bg-gray-200 p-2 text-gray-400 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-white w-[40px] h-[40px]" spellcheck="false">
                            <span class="sr-only">Close panel</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 hover:text-gray-500 lucide lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>
                </div>
            </div>
            <div x-ref="modalContent" class="flex flex-col flex-1 w-full overflow-hidden">
                
            </div>
          </div>
      </div>
    </div>