<div
  x-show="show"
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="opacity-0 translate-y-1"
  x-transition:enter-end="opacity-100 translate-y-0"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="opacity-100 translate-y-0"
  x-transition:leave-end="opacity-0 translate-y-1"
  :style="(() => {
    const tooltipWidth = 320; // max-w-xs is 20rem = 320px
    const screenWidth = window.innerWidth;
    const xPos = x + tooltipWidth > screenWidth ? screenWidth - tooltipWidth - 10 : x;
    return `z-index: 1000; position: absolute; left: ${xPos}px; top: ${y}px;`
  })()"
  class="max-w-xs px-2 py-1 text-sm text-white bg-gray-900 rounded-lg shadow-lg"
  @click.away="hideTooltip"
>
  <div x-text="text"></div>
</div>
