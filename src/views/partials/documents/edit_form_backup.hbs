                dueDatePicker.set('onOpen', () => { {{!-- Disable dueDatePicker from opening --}}
                    dueDatePicker.close();
                });
                dueDatePicker.setDate(selectedDocument.config.invoice_due_date.value);
            } else if (selectedDocument.config.invoice_due_date.terms_type === 'dueonreceipt') {
                if (dueDatePicker) {
