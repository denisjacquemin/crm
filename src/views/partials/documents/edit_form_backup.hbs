<div class="to-be-autosaved"
  x-data="{
        formatNumber: function(amount) {
            const formatter = new Intl.NumberFormat('fr-FR', {
                useGrouping: true,
                style: 'decimal',
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
            {{!-- replace non-breaking spaces by spaces --}}
            return formatter.format(amount).replace(',', '.').replaceAll('\u202F', ' '); 
        },
        {{!-- get amountvattotal() {
            let totalvat = selectedDocument.config.items.reduce((total, item) => { 
                    let amountvat = Number(item.amountvat);
                    return total + (isNaN(amountvat) ? 0 : amountvat);
            }, 0);
            this.selectedDocument.config.amounts.totalvat = totalvat;
            return this.formatNumber(totalvat);
        },
        get amountssubtotavatexcl() {
            let subtotal = this.selectedDocument.config.items.reduce((total, item) => { 
                let amountvatexcl = Number(item.amountvatexcl);
                return total + (isNaN(amountvatexcl) ? 0 : amountvatexcl);
            }, 0);
            this.selectedDocument.config.amounts.subtotal = subtotal
            return this.formatNumber(subtotal);
        },
        get amountssubtotavatincl() {
            let total = this.selectedDocument.config.items.reduce((total, item) => { 
                let amountvatincl = Number(item.amountvatincl);
                return total + (isNaN(amountvatincl) ? 0 : amountvatincl);
            }, 0);
            this.selectedDocument.config.amounts.total = total;
            return this.formatNumber(total);
        }, --}}
        createDueDatePicker: function() {
            this.dueDatePicker = flatpickr(this.$refs.dueDate, {
                defaultDate: this.selectedDocument.config.invoice_due_date.value,
                dateFormat: dateFormatFlatpickrConfig[this.user_language],
                onChange: (selectedDates, dateStr, instance) => {
                  let selectedDate = dayjs(selectedDates[0]).startOf('day');
                  this.selectedDocument.config.invoice_due_date.value = dayjs(selectedDate).format('YYYY-MM-DD');
                }
            });
        },
        invoiceDatePicker: null,
        dueDatePicker: null,
        handleTermsTypeChange: function(termsType, selectedDate) {
            console.log('=== handleTermsTypeChange', termsType, selectedDate);
            if (termsType.startsWith('+')) {
                if (!this.dueDatePicker) {
                    this.createDueDatePicker();
                }
                this.dueDatePicker.set('onOpen', () => { {{!-- Disable dueDatePicker from opening --}}
                    this.dueDatePicker.close();
                });
                let daysToAdd = parseInt(termsType.slice(1));
                let invoice_due_date_value = dayjs(selectedDate).add(daysToAdd, 'day');
                this.dueDatePicker.setDate(invoice_due_date_value.toDate());
                this.selectedDocument.config.invoice_due_date.value = dayjs(this.dueDatePicker.selectedDates[0]).format('YYYY-MM-DD');

            } else if (termsType === 'dueonreceipt') {
                console.log('=== dueonreceipt');
                if (this.dueDatePicker) {
                    this.dueDatePicker.destroy();
                    this.dueDatePicker = null;
                }            
                this.selectedDocument.config.invoice_due_date.value = '{{ t 'documents.views.edit_form.due_on_receipt' }}';
                this.$refs.dueDate.value = '{{ t 'documents.views.edit_form.due_on_receipt' }}';
            } else if (termsType === 'custom') {
                if (!this.dueDatePicker) {
                    this.createDueDatePicker();
                }
                this.dueDatePicker.setDate(new Date());

                // set dueDatePicker date to today and also set invoice_due_date.value to today
                {{!-- this.dueDatePicker.setDate(dayjs().toDate()); --}}
                this.selectedDocument.config.invoice_due_date.value = selectedDate; 
                this.dueDatePicker.set('onOpen', []);
                this.dueDatePicker.set('allowInput', true);
            }
        },
        handleDelete: async function() {
          try {
              console.log('handling delete for ', this.selectedDocument.slug);
              const csrfToken = document.querySelector('meta[name=csrf-token]').getAttribute('content');
              const response = await fetch('/document/deleteAjax/' + this.selectedDocument.slug, { 
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRF-Token': csrfToken
                }
              });
              if (response.ok) {
                  this.documents = this.documents.filter(document => document.slug !== this.selectedDocument.slug);
                  this.selectedDocumentIndex = 0;
                  this.selectedDocument = this.documents[0];
                  updateNewUrl(this.selectedDocument.slug);
              }
          } catch (error) { 
              console.error('Error deleting document', error);

          }
        },
        handleDuplicate: async function() {
          try {
              const newDocument = await fetchUrl('/document/duplicateAjax', 'POST', { slug: this.selectedDocument.slug });             
              console.log('newDocument.config.invoice_number', newDocument.config.invoice_number);
              this.documents.unshift(newDocument);
              this.selectedDocumentIndex = 0; 
              this.selectedDocument = newDocument;

              updateNewUrl(newDocument.slug);
              if (window.innerWidth < 640) $dispatch('updatenavbutton', {value: 'back'});
          } catch (error) { 
              console.error('Error creating new document', error); 
          }
        },
        handleChange: function(value) {      
          this.handleTermsTypeChange(value, dayjs(this.invoiceDatePicker.selectedDates[0]).toDate());
        }
  }" 
  x-init="
          console.log('BBBBB In init of edit_form.hbs');
          console.log('init in edit_form', selectedDocument.config.invoice_due_date.value); 

            $watch('selectedDocument.slug', () => { 
