                    dueDatePicker = null;
                }            
                selectedDocument.config.invoice_due_date.value = '{{ t 'documents.views.edit_form.due_on_receipt' }}';
                $refs.dueDate.value = '{{ t 'documents.views.edit_form.due_on_receipt' }}';
            } else if (selectedDocument.config.invoice_due_date.terms_type === 'custom') {
                if (!dueDatePicker) {
                    createDueDatePicker();
                }
                console.log('setting in init dueDatePicker to ', selectedDocument.config.invoice_due_date.value)
                dueDatePicker.setDate(selectedDocument.config.invoice_due_date.value);
                dueDatePicker.set('onOpen', []);
                dueDatePicker.set('allowInput', true);
                console.log('dueDatePicker.selectedDates[0]', dueDatePicker.selectedDates[0]);

            }
