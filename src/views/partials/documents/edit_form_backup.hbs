                onChange: (selectedDates, dateStr, instance) => {
                    let selectedDate = selectedDates[0]; {{!-- get the date selected by the user --}}

                    selectedDocument.config.invoice_date = dayjs(selectedDate).format('YYYY-MM-DD');

                    {{!-- $refs.invoiceDate.value = formatDate(selectedDate); --}}
