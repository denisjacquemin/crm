<div class="my-5 mx-3">
  <page size="A4" class="p-4">
    <p x-text="selectedDocument.config.seller.name" class="text-sm pl-3 mt-1 leading-4 text-gray-800"></p>
    <p x-text="`${selectedDocument.config.seller.address}, ${selectedDocument.config.seller.city} ${selectedDocument.config.seller.country}`" class="pl-3 mt-1 text-sm leading-4 text-gray-600"></p>
    <p x-text="selectedDocument.config.seller.vatNumber" class="text-sm pl-3 mt-1 leading-4 text-gray-600"></p>

  </page>

  
  <div class="py-2"><h3 class="text-lg font-medium leading-6 text-gray-900">Destinataire</h3></div>

  <div class="my-2">
    <label class="block text-sm font-medium text-gray-700">Client</label>
    <div class="mt-1">
        <p x-text="selectedDocument.config.buyer.name"></p>
    </div>
    
  </div>
</div>
