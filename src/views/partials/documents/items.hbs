<table class="min-w-full divide-y divide-gray-300 max-w-full">
    <thead>
        <tr >
            <th class="w-2/3 text-left text-sm font-semibold text-gray-900" width="auto">Description</th>
            <th class="hidden text-sm font-semibold text-gray-900 text-right" width="150px">Quantity</th>
            <th class="hidden text-sm font-semibold text-gray-900 text-right" width="150px">UP</th>
            <th class="hidden text-sm font-semibold text-gray-900 text-right" width="150px">Reduction</th>
            <th class="hidden text-sm font-semibold text-gray-900 text-right" width="150px">Reduction Unit</th>
            <th class="hidden sm:block md:hidden text-sm font-semibold text-gray-900 text-right" width="150px">VAT</th>
            <th class="hidden text-sm font-semibold text-gray-900 text-right" width="150px">Amount VAT Excl.</th>
            <th class="w-1/3 text-sm text-right font-semibold text-gray-900" width="150px">Amount VAT Incl.</th>

        </tr>
    </thead>
    <tbody>
        <template x-for="(item, index) in selectedDocument.config.items" :key="index">
        <tr class="hover:bg-gray-200">
            <input type="hidden" x-model="item.name" name="config.items[].name" />
            <td x-text="item.description" class="pl-1 py-2 pr-2 text-sm font-light text-gray-700 line-clamp-3"></td>
            <td x-text="item.quantity" class="hidden py-2 text-sm font-medium text-gray-500"></td>
            <td x-text="item.unit_price" class="hidden py-2 text-sm font-medium text-gray-500"></td>
            <td x-text="item.reduction" class="hidden py-2 text-sm font-medium text-gray-500"></td>
            <td x-text="item.reduction_unit" class="hidden py-2 text-sm font-medium text-gray-500"></td>
            <td x-text="`${item.vat} %`" class="hidden sm:block md:hidden text-right py-2 text-sm font-medium text-gray-500"></td>
            <td x-text="item.amountvatexcl" class="hidden py-2 text-sm font-medium text-gray-500"></td>
            <td x-text="`${item.amountvatincl} €`" class="text-right pr-1 py-2 text-sm text-gray-500 truncate"></td>
        </tr>
        </template>
    </tbody>
</table>

