<div class="flex h-full w-[200%]" 
      x-data="{
        {{!-- companyFiles: {{ stringify companyFiles }}, --}}
        isUploading: false,
        selectedFile: {},
        updateCompanyFiles: function(files) {
            console.log('In updateCompanyFiles');
            companyFiles = files;
        },
        showFileForm: function() {
            this.$refs.filesList.style.transform = 'translateX(-100%)';
            this.$refs.fileForm.style.transform = 'translateX(-100%)';
        },
        showFilesList: function() {
            this.$refs.filesList.style.transform = 'translateX(0)';
            this.$refs.fileForm.style.transform = 'translateX(0)';
        },
        newFile: async function(){
            try {
                this.resetFormFile();
                const data = await fetchUrl('/file/newAjaxForADocument', 'POST', { document_id: this.selectedDocument._id });
                this.selectedFile = data;
                this.showFileForm();
                this.selectedDocument.config.documentFiles.push(this.selectedFile);
            } catch (error) { 
                console.error('Error creating new file', error); 
            }
        },
        resetFormFile: function() {
            this.selectedFile = {};
        },
        addOrUpdateFile(file) {
            const existingFileIndex = this.selectedDocument.config.files.findIndex(f => f.slug === file.slug);
            if (existingFileIndex !== -1) {
                // Update the existing file
                this.selectedDocument.config.files[existingFileIndex] = file;
            } else {
                // Add the new file
                this.selectedDocument.config.files.push(file);
            }

        },
        removeFile(slug) {
            this.selectedDocument.config.files = this.selectedDocument.config.files.filter(f => f.slug !== slug);
        },
        isFileSelected(slug) {
            return this.selectedDocument.config.files.some(f => f.slug === slug);
        },  
        submitUploadForm: async function(event) {
            console.log('submitUploadForm', event);
            event.preventDefault();
            const fileInput = event.target;
            let file;
            if (event.type === 'drop') {
                file = event.dataTransfer.files[0];
            } else {
                file = event.target.files[0];
            }            
            var formData = new FormData();
            formData.append('file', file);

            if (this.selectedFile && this.selectedFile._id) {
                formData.append('file_id', this.selectedFile._id);
            }
            this.isUploading = true;
            const data = await fetchUrl('/file/uploadForDocument', 'POST', formData);
            this.isUploading = false;
            console.log('1. File uploaded', data);
            console.log('2. File uploaded', file);
            this.selectedFile.filename = file.name;
            this.selectedFile.size = file.size;
            this.selectedFile.type = file.type;
            this.selectedFile.key = data.data.key;

            document.getElementById(`input-${this.selectedFile.slug}`).checked = true;
            document.getElementById(`input-${this.selectedFile.slug}`).dispatchEvent(new Event('change'))
        },
        downloadFile: async function(slug) {
            try {
                const response = await fetch(`/file/download/${slug}`);
                
                if (!response.ok) {
                    const errorData = await response.json();
                    dispatch('notify', { content: errorData.notification.message, subcontent: errorData.notification.submessage, type: errorData.notification.type ? errorData.notification.type : 'info' });
                    return;
                }

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = url;
                a.download = slug; // You can set the filename here if needed
                document.body.appendChild(a);
                a.addEventListener('click', (event) => {
                    event.stopPropagation();
                });
                a.click();
                window.URL.revokeObjectURL(url);
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred while downloading the file.');
            }
        },
        cancelUpload: function() {
            this.isUploading = false;
        },
        editFile: async function(slug) {
            try {
                this.selectedFile = this.selectedDocument.config.documentFiles.find(f => f.slug === slug);
                
                this.showFileForm();
            } catch (error) { console.error('Error editing file', error); }
        },
        deleteFile: async function(slug) {
            try {
                this.removeFile(slug);
                const data = await fetchUrl(`/files/deleteAjax/${slug}`, 'DELETE');
                this.selectedDocument.config.documentFiles = this.selectedDocument.config.documentFiles.filter(f => f.slug !== slug);
                this.showFilesList();
            } catch (error) { 
                console.log('Error deleting document', error); 
            }
        },
        toggleFileSelection: function(file, isSelected) {
            console.log('toggleFileSelection', file, isSelected);
            if (!isSelected) {
                this.removeFile(file.slug);
                console.log('after removeFile', selectedDocument.config.files);
            } else {
                this.addOrUpdateFile(file);
            }            
        },
     }"
     x-init="
        console.log('Before loadcompanyfiles');
        $dispatch('loadcompanyfiles');
        $watch('selectedFile', (value, oldValue) => {
            var file = { ...value };
            if (file.slug) {
                file.autosave_updated_at = new Date();
                localStorage.setItem('autosave#file#' + value.slug, JSON.stringify(file));
            }
        });
