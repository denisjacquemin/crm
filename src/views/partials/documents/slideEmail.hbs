<div
  class="flex h-full w-full flex-col gap-y-4 overflow-y-auto px-4 py-5 sm:px-6"
  x-data="{
        form_email: { 
            recipients: '',
            bcc: '',
            cc: '',
            subject: '',
            body: '', 
            language: '',
        },
        replaceTemplateVariables: function(template, documentConfig) {
            const replacements = {
                '{1}': documentConfig.document_type === 'invoice' 
                    ? '{{t "documents.views.index.email_modal.invoice"}}'
                    : '{{t "documents.views.index.email_modal.credit_note"}}',
                '{2}': documentConfig.document_type === 'invoice' 
                    ? documentConfig.invoice_number 
                    : documentConfig.credit_note_number,
                '{3}': documentConfig.seller.name,
                '{4}': documentConfig.buyer?.contact_title === 'mr' 
                    ? '{{t "users.views.signup1.mr"}}'
                    : documentConfig.buyer?.contact_title === 'mrs'
                    ? '{{t "users.views.signup1.mrs"}}'
                    : documentConfig.buyer?.contact_title === 'ms'
                    ? '{{t "users.views.signup1.ms"}}'
                    : documentConfig.buyer?.contact_title === 'dr'
                    ? '{{t "users.views.signup1.dr"}}'
                    : '',
                '{5}': documentConfig.buyer?.contact_firstname || '',
                '{6}': documentConfig.buyer?.contact_lastname || '',
                '{7}': documentConfig.invoice_date || '',
                '{8}': documentConfig.invoice_due_date?.value || '',
                '{9}': documentConfig.amounts.total || ''
            };
            
            return Object.entries(replacements).reduce((text, [key, value]) => {
                return text.replaceAll(key, value || '');
            }, template);
        },
        getSubject: function() {
            const template = current_company.settings.email_subject_templates[this.form_email.language];
            return this.replaceTemplateVariables(template, this.selectedDocument.config);
        },
        getBody: function() {
            const template = current_company.settings.email_message_templates[this.form_email.language];
            return this.replaceTemplateVariables(template, this.selectedDocument.config);
        },
        getFileName: function() { 
            let fileName = '';
            if (this.selectedDocument.config.document_type === 'invoice') {
                fileName = `{{t "documents.views.index.email_modal.invoice"}} ${this.selectedDocument.config.invoice_number} ${this.selectedDocument.config.seller.name}`;
                if (this.selectedDocument.config.subject) {
                    fileName += ` (${this.selectedDocument.config.subject})`;
                } 
            } else if (this.selectedDocument.config.document_type === 'credit_note'){
                fileName = `{{t "documents.views.index.email_modal.credit_note"}} ${this.selectedDocument.config.credit_note_number} ${this.selectedDocument.config.seller.name}`;
                if (this.selectedDocument.config.subject) {
                    fileName += ` (${this.selectedDocument.config.subject})`;
                }
            }
            return fileName.replace(/\s+/g, '_');
        }
  }"
  x-intersect=" 
    updateButtonContent(`<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none'
        stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'
        class='lucide lucide-send'>
        <path 
            d='M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z' />
        <path d='m21.854 2.147-10.94 10.939' />
    </svg>{{t 'documents.views.index.email_modal.send_email'}}`);
    updateClickHandler(async () => {
    await fetchUrl('/document/sendbymail', 'POST', { data: form_email, slug: selectedDocument.slug });
    });
    form_email = {
    language: selectedDocument?.config?.language,
    recipients: selectedDocument?.config?.buyer?.email,
    bcc: current_company.settings.send_bcc_to,
    cc: current_company.settings.send_cc_to,
    }

    form_email.subject = getSubject();
    form_email.body = getBody();
    $refs.editor.innerHTML = form_email.body;
    form_email.recipientsValid = validateEmail(form_email.recipients);
    form_email.ccValid = validateEmail(form_email.cc);
    form_email.bccValid = validateEmail(form_email.bcc);
  "
  x-init="
    $watch('form_email.language', (newVal, oldVal) => {
      form_email.subject = getSubject();
      form_email.body = getBody();
      $refs.editor.innerHTML = form_email.body;
    });
  "
>
  <div class="w-full">
    <label for="email-recipient" class="block text-sm font-medium leading-6 text-gray-900">
      {{t "documents.views.index.email_modal.recipient"}}
    </label>
    <div class="relative">
      <input
        type="text"
        id="email-recipient"
        autocomplete="off"
        x-model="form_email.recipients"
        @input="form_email.recipientsValid = validateEmail(form_email.recipients)"
        placeholder="{{t 'documents.views.index.email_modal.recipient_placeholder'}}"
        class="block w-full rounded-md border-0 py-1.5 pr-10 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
      />
      <div
        class="absolute inset-y-0 right-0 flex items-center pr-3"
        x-show="form_email.recipients.length > 0"
      >
        <svg
          x-show="form_email.recipientsValid"
          class="h-5 w-5 text-green-500"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
            clip-rule="evenodd"
          />
        </svg>
        <svg
          x-show="!form_email.recipientsValid"
          class="h-5 w-5 text-red-500"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
            clip-rule="evenodd"
          />
        </svg>
      </div>
    </div>
  </div>

  <div class="w-full">
    <label for="email-subject" class="block text-sm font-medium leading-6 text-gray-900">
      {{t "documents.views.index.email_modal.subject"}}
    </label>
    <input
      type="text"
      id="email-subject"
      autocomplete="off"
      x-model="form_email.subject"
      placeholder="{{t 'documents.views.index.email_modal.subject_placeholder'}}"
      class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
    />
  </div>
  <div class="w-full">
    <div class="flex flex-row items-end">
      <label for="email-body" class="block flex-none text-sm font-medium leading-6 text-gray-900">
        {{t "documents.views.index.email_modal.body"}}
      </label>
      {{!--
      <textarea
        type="text"
        id="email-body"
        autocomplete="off"
        x-model="form_email.body"
        placeholder="{{t 'documents.views.index.email_modal.body_placeholder' }}"
        rows="10"
        class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
      ></textarea>
      --}}
      <div class="mb-1 flex-1 justify-end text-right">
        <button
          type="button"
          @click="document.execCommand('bold', false, null)"
          tabindex="-1"
          class="h-8 w-8 rounded-sm border font-bold hover:border-gray-300 hover:bg-gray-100"
        >
          {{t "documents.views.index.email_modal.bold"}}
        </button>
        <button
          type="button"
          @click="document.execCommand('italic', false, null)"
          tabindex="-1"
          class="h-8 w-8 rounded-sm border italic hover:border-gray-300 hover:bg-gray-100"
        >
          {{t "documents.views.index.email_modal.italic"}}
        </button>
        <button
          type="button"
          @click="document.execCommand('underline', false, null)"
          tabindex="-1"
          class="h-8 w-8 rounded-sm border underline hover:border-gray-300 hover:bg-gray-100"
        >
          {{t "documents.views.index.email_modal.underline"}}
        </button>
        <button
          type="button"
          @click="document.execCommand('strikeThrough', false, null)"
          tabindex="-1"
          class="h-8 w-8 rounded-sm border line-through hover:border-gray-300 hover:bg-gray-100"
        >
          {{t "documents.views.index.email_modal.strike"}}
        </button>
      </div>
    </div>
    <div
      x-ref="editor"
      class="block w-full rounded-md border-0 p-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
      contenteditable="true"
      @input="form_email.body = $event.target.innerHTML"
      @keydown.enter.prevent="document.execCommand('insertLineBreak')"
    ></div>
  </div>
  <div class="grid w-full grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2">
    <div class="col-span-1">
      <label for="email-body" class="block text-sm font-medium leading-6 text-gray-900">
        {{t "documents.views.index.email_modal.attached_file"}}
      </label>
      <div class="flex w-full">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="ucide lucide-paperclip mr-2 mt-1 h-4 w-4 flex-none"
        >
          <path
            d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"
          />
        </svg>
        <a
          x-bind:href="'/document/' + selectedDocument.slug + '.pdf'"
          class="block flex-1 cursor-pointer text-sm text-gray-700"
          x-text="getFileName() + '.pdf'"
          style="overflow-wrap: anywhere"
        ></a>
      </div>
    </div>
    <div class="col-span-1">
      <label for="email-body" class="block text-sm font-medium leading-6 text-gray-900">
        {{t "documents.views.index.email_modal.links_files"}}
      </label>
      <ul x-show="selectedDocument.config.files.length > 0">
        <template x-for="(file, index) in selectedDocument.config.files" :key="index">
          <li>
            <div class="flex w-full">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-link mr-2 mt-1 h-4 w-4 flex-none"
              >
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
              </svg>

              <a
                @click.prevent="downloadFile(selectedDocument.slug)"
                class="block flex-1 cursor-pointer text-sm text-gray-700"
                style="overflow-wrap: anywhere"
                x-text="file?.internal_name?.trim() ? `${file.name} (${file.internal_name})` : file?.name"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-cloud-download ml-4 h-5 w-5 text-indigo-600 hover:text-indigo-500"
                >
                  <path d="M12 13v8l-4-4" />
                  <path d="m12 21 4-4" />
                  <path d="M4.393 15.269A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.436 8.284" />
                </svg>
              </a>
            </div>
          </li>
        </template>
      </ul>
      <div x-show="selectedDocument.config.files.length === 0" class="block text-sm text-gray-700">
        {{t "documents.views.index.email_modal.no_file_linked"}}
      </div>
    </div>
  </div>

  <div x-data="{ showMoreOptions: false }" class="flex w-full flex-col gap-y-4">
    <span
      @click="showMoreOptions = !showMoreOptions"
      class="inline cursor-pointer text-sm font-medium leading-6 text-gray-900"
    >
      <template x-if="!showMoreOptions">
        <span>
          {{t "documents.views.index.email_modal.more_options"}}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-chevron-down inline h-3 w-3"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </span>
      </template>
      <template x-if="showMoreOptions">
        <span>
          {{t "documents.views.index.email_modal.less_options"}}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-chevron-up inline h-3 w-3"
          >
            <path d="m18 15-6-6-6 6" />
          </svg>
        </span>
      </template>
    </span>
    <div x-show="showMoreOptions" class="w-full">
      <label for="email-cc" class="block text-sm font-medium leading-6 text-gray-900">
        {{t "documents.views.index.email_modal.cc"}}
      </label>
      <div class="relative">
        <input
          type="text"
          id="email-cc"
          autocomplete="off"
          x-model="form_email.cc"
          @input="form_email.ccValid = validateEmail(form_email.cc)"
          placeholder="{{t 'documents.views.index.email_modal.cc_placeholder'}}"
          class="block w-full rounded-md border-0 py-1.5 pr-10 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
        />
        <div
          class="absolute inset-y-0 right-0 flex items-center pr-3"
          x-show="form_email.cc.length > 0"
        >
          <svg
            x-show="form_email.ccValid"
            class="h-5 w-5 text-green-500"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
              clip-rule="evenodd"
            />
          </svg>
          <svg
            x-show="!form_email.ccValid"
            class="h-5 w-5 text-red-500"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
              clip-rule="evenodd"
            />
          </svg>
        </div>
      </div>
    </div>
    <div x-show="showMoreOptions" class="w-full">
      <label for="email-bcc" class="block text-sm font-medium leading-6 text-gray-900">
        {{t "documents.views.index.email_modal.bcc"}}
      </label>
      <div class="relative">
        <input
          type="text"
          id="email-bcc"
          autocomplete="off"
          x-model="form_email.bcc"
          @input="form_email.bccValid = validateEmail(form_email.bcc)"
          placeholder="{{t 'documents.views.index.email_modal.bcc_placeholder'}}"
          class="block w-full rounded-md border-0 py-1.5 pr-10 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
        />
        <div
          class="absolute inset-y-0 right-0 flex items-center pr-3"
          x-show="form_email.bcc.length > 0"
        >
          <svg
            x-show="form_email.bccValid"
            class="h-5 w-5 text-green-500"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
              clip-rule="evenodd"
            />
          </svg>
          <svg
            x-show="!form_email.bccValid"
            class="h-5 w-5 text-red-500"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
              clip-rule="evenodd"
            />
          </svg>
        </div>
      </div>
    </div>
    <div x-show="showMoreOptions" class="w-full">
      <label for="email-language" class="block text-sm font-medium leading-6 text-gray-900">
        {{t "documents.views.index.email_modal.language"}}
      </label>
      <select
        id="email-language"
        x-model="form_email.language"
        class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
      >
        <template x-for="lang in i18n_languages" :key="lang">
          <option :value="lang" x-text="all_languages[lang].name"></option>
        </template>
      </select>
    </div>
  </div>
</div>
