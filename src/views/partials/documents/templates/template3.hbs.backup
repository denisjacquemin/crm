<div x-data="{
        items: rowBatch,
        currentPage: batchIndex,
    }">
    <style>
        .top-left {
            position: absolute;
            top: 0;
            left: 0;
        }

        .bottom-right {
            position: absolute;
            bottom: 0;
            right: 0;
        }

        #template3 header h1 {
            font: bold 100% sans-serif;
            letter-spacing: 0.5em;
            text-align: center;
            text-transform: uppercase;
            padding: 5px 0 5px 0;
            margin-bottom: 20px;
            background-color: #d0cfcf;
            margin: 10mm 10mm 0 10mm;
        }

        #template3 header #seller_address {
            position: absolute;
            top: 2cm;
            left: 10mm;
            width: 40%;
            word-wrap: break-word;
            font-size: 85%;
            font-style: normal;
            line-height: 1.25;
            margin: 0 1em 1em 0;
        }

        #template3 header #buyer_address {
            position: absolute;
            font-size: 100%;
            font-style: normal;
            line-height: 1.25;
            top: 5.5cm;
            left: 11cm;
            height: 3.3cm;
            width: 8.5cm;

                {
                    {
                    border: dashed 1px #d0cfcf;             
                }
            }
        }

        #template3 header #buyer_address::before,
        #template3 header #buyer_address::after {
            content: "";
            position: absolute;
            width: 5px;
            height: 5px;
            border: 1px dashed #000;
        }

        #template3 header #buyer_address::before {
            top: 0;
            left: 0;
            border-bottom: none;
            border-right: none;
        }

        #template3 header #buyer_address::after {
            top: 0;
            right: 0;
            border-bottom: none;
            border-left: none;
        }


        #template3 header #invoice_details {
            position: absolute;
            left: 10mm;
            top: 8cm;
            border-collapse: collapse;
            margin-top: 50px;
            font-size: 85%;
        }

        #template3 main {
            margin: 0 10mm;
            position: absolute;
            top: 12cm;
        }

        #template3 main .table {
            display: table;
            width: 100%;
            table-layout: fixed;
        }

        #template3 main .tr {
            display: table-row;
        }

        #template3 main .td {
            display: table-cell;
            padding: 5px;
            border: solid 1px #d0cfcf;
        }
        
        #template3 footer {
            position: absolute;
            top: 24cm;
            margin: 0 10mm;
        }
    </style>
    <div id="template3">
        <span class="top-left">top left - currentPage: <span x-text="currentPage"></span></span>
        <span class="bottom-right">bottom right</span>

        <footer class="grid grid-cols-3">
            <div class="font-medium, text-xs">
                <ul>
                    <li>FIDUCIAIRE DAVID ZOLLER SRL</li>
                    <li>Expert-Comptable Fiscaliste agréé</li>
                    <li>ITAA numéro 843787348743</li>
                    <li>ITAA numéro 843787348743</li>
                    <li>BE 017 564 567</li>
                </ul>
            </div>
            <div class="font-medium, text-xs">
                <ul>
                    <li>Rue des Grasses Oies 12, B-6760 VIRTON</li>
                    <li>Rue de la Commanderie 15, B-6900 MARCHE</li>
                    <li>Tél. 063/57.90.76</li>
                    <li>info@example.com</li>
                </ul>
            </div>
            <div>col3</div>
        </footer> 

        <template x-if="currentPage === 0">
            <header>        
                <h1>Invoice</h1>
                <div id="seller_address">
                    <p style="font-size: 150%; font-weight: 700;" x-text="selectedDocument.config.seller.name"></p>
                    <p style="margin-top:5px" x-text="`${selectedDocument.config.buyer.address}`"></p>
                    <p x-text="`${selectedDocument.config.buyer.postalcode} ${selectedDocument.config.buyer.city}`"></p>
                    <p x-text="selectedDocument.config.buyer.country"></p>
                    <p style="margin-top:10px"> TVA: <span x-text="selectedDocument.config.seller.vat_number"></span></p>
                    <p x-text="selectedDocument.config.seller.phone"></p>
                    <p x-text="selectedDocument.config.seller.email"></p>
                </div>
                <div id="buyer_address">
                    <p style="margin-top: -30px; font-weight: 400;">Billed To</p>
                    <p style="margin: 20px 10px 0 25px" x-text="selectedDocument.config.buyer.name"></p>
                    <p style="margin: 5px 10px 0 25px" x-text="`${selectedDocument.config.buyer.address}`"></p>
                    <p style="margin: 15px 10px 0 25px"
                        x-text="`${selectedDocument.config.buyer.postalcode} ${selectedDocument.config.buyer.city}`"></p>
                    <p style="margin: 0 10px 0 10px" x-text="selectedDocument.config.buyer.country"></p>

                    <p style="margin: 50px 10px 0 25px"> TVA: <span
                            x-text="selectedDocument.config.buyer.vat_number"></span></p>
                    <p style="margin: 0 10px 0 25px" x-text="selectedDocument.config.buyer.phone"></p>
                    <p style="margin: 0 10px 0 25px" x-text="selectedDocument.config.buyer.email"></p>
                </div>
                <div id="invoice_details" style="clear:both">
                    <table style="border-spacing: 0;">
                        <tr>
                            <td>Invoice Number:</td>
                            <td style="text-align: right; font-weight: 700;"
                                x-text="selectedDocument.config.invoice_number"></td>
                        </tr>
                        <tr>
                            <td>Invoice Date:</td>
                            <td style="text-align: right; font-weight: 700;" x-text="selectedDocument.config.invoice_date">
                            </td>
                        </tr>
                        <tr>
                            <td>Due Date:</td>
                            <td style="text-align: right; font-weight: 700;" x-text="selectedDocument.config.due_date"></td>
                        </tr>
                        <tr>
                            <td>Currency:</td>
                            <td style="text-align: right; font-weight: 700;" x-text="selectedDocument.config.currency"></td>
                        </tr>
                    </table>
                </div>
            </header>
            <main>
                <style>
                    
                    
                </style>
                <div id="products">
                    <div class="table">
                        <template x-for="(item, rowIndex) in items" :key="rowIndex">
                            <div class="tr">
                                <div class="td" style="width:350px" x-text="item.name"></div>
                                <div class="td" style="" x-text="item.quantity"></div>
                                <div class="td" style="" x-text="item.price"></div>
                                <div class="td" style="" x-text="item.tax_rate"></div>
                                <div class="td" style="" x-text="item.total_amount"></div>
                            </div>
                        </template>
                    </div>
                </div>
            </main>
        </template>
    </div>
</div>