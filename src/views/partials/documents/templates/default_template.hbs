        }

        #template3 header #seller_address {
            position: absolute;
            top: 5cm;
            left: 10mm;
            width: 40%;
            word-wrap: break-word;
            line-height: initial;
            text-align: left;
            {{!-- font-size: 85%; --}}
            {{!-- font-style: normal;
            line-height: 1.25; --}}
        }

        #template3 header #billed_to {
            position: absolute;
            top: 4cm;
            left: 11cm;
        }

        #template3 header #buyer_address {
            position: absolute;
            font-size: 100%;
            font-style: normal;
            text-align: left;
            line-height: 1.25;
            top: 5.5cm;
            left: 11cm;
            height: 3.3cm;
            width: 8.0cm;
            padding-left: 25px;
            padding-right: 25px;
            padding-top: 10px;
            word-wrap: break-word;
                {
                    {
                    border: dashed 1px #d0cfcf;             
                }
            }
        }

        #template3 header #buyer_address::before,
        #template3 header #buyer_address::after {
            content: "";
            position: absolute;
            width: 5px;
            height: 5px;
            border: 1px dashed #000;
        }

        #template3 header #buyer_address::before {
            top: 0;
            left: 0;
            border-bottom: none;
            border-right: none;
        }

        #template3 header #buyer_address::after {
            top: 0;
            right: 0;
            border-bottom: none;
            border-left: none;
        }

        #template3 header #invoice_details {
            position: absolute;
            left: 10mm;
            top: 8cm;
            border-collapse: collapse;
            margin-top: 50px;
            font-size: 85%;
        }
        
        #template3 main {
            position: relative;
        }


        #template3 main #products {
            position: absolute;
            left: 10mm;
            right: 10mm;
            width: calc(100% - 20mm); /* 100% width with 10mm left and right margins */
        }

        #template3 main #products.page1 {
            top: 14cm;
        }

        #template3 main #products.page2plus {
            top: 4cm;
        }

        /* Table container */
        #template3 main #products .table {
            display: table;
            width: 100%;
            border-collapse: collapse;
        }

        /* Table row */
        #template3 main #products .tr, #template3 main #products .thead {
            display: table-row;
            border-bottom: 1px solid #ccc; /* Optional: Add a border between rows */
        }

         #template3 main #products .thead .th {
            display: table-cell;
            padding: 8px 16px; /* Adjust padding as needed */
            border: 1px solid #ccc; /* Add cell borders */
            font-weight: 700;
         }

        /* Table cell */
        #template3 main #products .td {
            font-size: 80%;
            display: table-cell;
            padding: 2px 4px; /* Adjust padding as needed */
            border: 1px solid #ccc; /* Add cell borders */
        }

        /* Header row (optional) */
        #template3 main #products .tr:first-child {
            background-color: #f0f0f0; /* Add background color to header row */
            font-weight: bold; /* Make header text bold */
        }

        #template3 main #products .amounts{
            display: table;
            width: 100%;
            border-collapse: collapse;
        }

        #template3 footer {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            color: #fff;
            text-align: center;
            padding: 20px 0;
            display: flex;
            justify-content: space-between;
        }

        /* Footer column styles (no changes) */
        #template3 footer .left,
        #template3 footer .right {
            flex: 1;
            margin: 0 10mm 10mm 10mm;
            box-sizing: border-box;
        }

        /* Add styling to individual columns (no changes) */
        #template3 footer .left {
            background-color: #555;
        }

        #template3 footer .middle {
            background-color: #666;
        }

        #template3 footer .right {
            background-color: #777;
        } --}}
     </style>
    <div id="template3" class="flex-1"
>
{{!-- PAGE 1 - BEGIN --}}
      <div id="pageone"
        {{!-- style="transform: scale(0.3866498740554156); transform-origin: 0 0;" --}}
        class="page text-black sheet transform-origin-top-left xl:mx-auto">
      <span class="top-left">top left - currentPage: </span>
      <span class="bottom-right">Invoice - <span x-text="orEmpty(selectedDocument.config.invoice_number)"></span> - page 1/<span x-text="orEmpty(numberOfPages)"></span></span>


        <header>        
            <h1>Invoice</h1>
            <div id="seller_address">
                <span style="font-size: 150%; font-weight: 700;" x-text="orEmpty(selectedDocument.config.seller.name)"></span><br/>
                <span style="" x-text="`${orEmpty(selectedDocument.config.seller.address1)} ${orEmpty(selectedDocument.config.seller.address2)}`"></span><br/>
                <span x-text="`${orEmpty(selectedDocument.config.seller.zip)} ${orEmpty(selectedDocument.config.seller.city)}`"></span><br/>
                <span x-text="orEmpty(selectedDocument.config.seller.country)"></span><br/><br/>
                <span> TVA: <span x-text="orEmpty(selectedDocument.config.seller.vat_number)"></span></span><br/>
                <span x-text="orEmpty(selectedDocument.config.seller.phone)"></span><br/>
                <span x-text="orEmpty(selectedDocument.config.seller.email)"></span><br/><br/>
                <table style="border-spacing: 0;">
                    <tr>
                        <td>Invoice Number:</td>
                        <td style="text-align: right; font-weight: 700;"
                            x-text="orEmpty(selectedDocument.config.invoice_number)"></td>
                    </tr>
                    <tr>
                        <td>Invoice Date:</td>
                        <td style="text-align: right; font-weight: 700;" x-text="orEmpty(selectedDocument.config.invoice_date)">
                        </td>
                    </tr>
                    <tr>
                        <td>Due Date:</td>
                        <td style="text-align: right; font-weight: 700;" x-text="orEmpty(selectedDocument.config.invoice_due_date.value)"></td>
                    </tr>
                    <tr>
                        <td>Currency:</td>
                        <td style="text-align: right; font-weight: 700;" x-text="orEmpty(selectedDocument.config.currency)"></td>
                    </tr>
                </table>
            </div>
            <div id="billed_to"style="font-weight: 400;">Billed To</div>
            <div id="buyer_address">
                <span style="" x-text="selectedDocument.config.buyer.name"></span><br/>
                <span style="" x-text="`${orEmpty(selectedDocument.config.buyer.address1)} ${orEmpty(selectedDocument.config.buyer.address2)}`"></span><br/>
                <span style="" x-text="`${orEmpty(selectedDocument.config.buyer.zip)} ${orEmpty(selectedDocument.config.buyer.city)}`"></span>
                <span style="" x-text="orEmpty(selectedDocument.config.buyer.country)"></span><br/>
                <br/><br/><br/><br/>
                <span style=""> TVA: <span x-text="orEmpty(selectedDocument.config.buyer.vat_number)"></span></span><br/>
                <span style="" x-text="orEmpty(selectedDocument.config.buyer.phone)"></span><br/>
                <span style="" x-text="orEmpty(selectedDocument.config.buyer.email)"></span>
            </div>
            {{!-- <div id="invoice_details" style="clear:both">
                    <table style="border-spacing: 0;">
                        <tr>
                            <td>Invoice Number:</td>
                            <td style="text-align: right; font-weight: 700;"
                                x-text="orEmpty(selectedDocument.config.invoice_number)"></td>
                        </tr>
                        <tr>
                            <td>Invoice Date:</td>
                            <td style="text-align: right; font-weight: 700;" x-text="orEmpty(selectedDocument.config.invoice_date)">
                            </td>
                        </tr>
                        <tr>
                            <td>Due Date:</td>
                            <td style="text-align: right; font-weight: 700;" x-text="orEmpty(selectedDocument.config.invoice_due_date.value)"></td>
                        </tr>
                        <tr>
                            <td>Currency:</td>
                            <td style="text-align: right; font-weight: 700;" x-text="orEmpty(selectedDocument.config.currency)"></td>
                        </tr>
                    </table>
                </div> --}}
        </header> 
        <main>
            <div id="products" class="page1">
                <div class="table">
                    <div class="thead">
                        <div class="th" style="text-align:left;width:300px">Description</div>
                        <div class="th" style="text-align:right;width:30px">Q.</div>
                        <div class="th" style="text-align:right">UP</div>
                        <div class="th" style="text-align:right;width:30px">VAT</div>
                        <div class="th" style="text-align:right">Total</div>
                    </div>
                    <template x-for="(item, rowIndex) in selectedDocument.config.items.slice(0, 5)" :key="rowIndex">
                        <div class="tr">
                            <div class="td" style="text-align:left;width:300px" x-text="orEmpty(item.description)"></div>
                            <div class="td" style="text-align:right" x-text="orEmpty(item.quantity)"></div>
                            <div class="td" style="text-align:right" x-text="orEmpty(item.unit_price)"></div>
                            <div class="td" style="text-align:right" x-text="orEmpty(item.vat)"></div>
                            <div class="td" style="text-align:right" x-text="orEmpty(item.amountvatincl)"></div>
                        </div>
                    </template>
                </div>
                <template x-if="numberOfPages == 1">
                    <table class="amounts">
                        <tr>
                            <td width="50%"></td>
                            <td style="text-align: right;">Total excl. VAT</td>
                            <td style="text-align: right;" x-text="selectedDocument.config.amounts.subtotal"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: right;">VAT</td>
                            <td style="text-align: right;" x-text="selectedDocument.config.amounts.totalvat"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: right;">Total incl. VAT</td>
                            <td style="text-align: right;" x-text="selectedDocument.config.amounts.total"></td>
                        </tr>
                    </table>
                </template>
            </div>
            
        </main>
        <footer>
            <div class="left">Eventuellement un logo</div>
            <div class="right">Numero de compte etc</div>
        </footer>
    </div> 
{{!-- PAGE 1 - END --}}


{{!-- PAGE 2+ - BEGIN --}}
    {{!-- creating chunks of 15 items each from `selectedDocument.config.items` (ignoring the first 5 items), and then iterating over these chunks --}}
    <template x-for="(itemsChunk, chunkIndex) in selectedDocument.config.items.slice(5).reduce((acc, _, i) => (i % 15 ? acc : [...acc, selectedDocument.config.items.slice(i + 5, i + 20)]), [])" :key="chunkIndex">
      <div style="width: 21cm;
            {{!-- position: relative; --}}
            height: 29.7cm;
            box-sizing: border-box;"
        class="page sheet text-black transform-origin-top-left xl:mx-auto">
        <span class="top-left">top left - currentPage:</span>
        <span class="bottom-right">Invoice - <span x-text="selectedDocument.config.invoice_number"></span> - page <span x-text="chunkIndex + 2"></span>/<span x-text="numberOfPages"></span></span>
        <main>
            <div id="products" class="page2plus">
                <div class="table">
                    <div class="thead">
                        <div class="th" style="width:350px">Description</div>
                        <div class="th" style="text-align:right">Q.</div>
                        <div class="th" style="text-align:right">UP</div>
                        <div class="th" style="text-align:right">VAT</div>
                        <div class="th" style="text-align:right">Total</div>
                    </div>
                    <template x-for="(item, itemIndex) in itemsChunk" :key="itemIndex">
                        <div class="tr">
                            <div class="td" style="width:350px" x-text="item.description"></div>
                            <div class="td" style="" x-text="item.quantity"></div>
                            <div class="td" style="" x-text="item.unit_price"></div>
                            <div class="td" style="" x-text="item.vat"></div>
                            <div class="td" style="" x-text="item.amountvatincl"></div>
                        </div>
                    </template>
                </div>
                <template x-if="numberOfPages == chunkIndex + 2">
                    <table class="amounts" style="margin-top:15px;">
                        <tr>
                            <td width="50%"></td>
                            <td style="text-align: right;">Total excl. VAT</td>
                            <td style="text-align: right;" x-text="selectedDocument.config.amounts.subtotal"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: right;">VAT</td>
                            <td style="text-align: right;" x-text="selectedDocument.config.amounts.totalvat"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: right;">Total incl. VAT</td>
                            <td style="text-align: right;" x-text="selectedDocument.config.amounts.total"></td>
                        </tr>
                    </table>
                </template>
            </div>
        </main>
        <footer>
            <div class="left">Eventuellement un logo</div>
            <div class="right">Numero de compte etc</div>
        </footer>
      </div> 
    </template>
{{!-- PAGE 2+ - END --}}

    </div>
</div>