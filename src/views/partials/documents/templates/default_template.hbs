<div x-data="{
        // numberOfPages is the number of batch of 15 items starting at position 6 in selectedDocument.config.items
            numberOfPages: Math.ceil((selectedDocument.config.items.length - 5) / 15) + 1,
            orEmpty(value) {
                return value || '';
            }
        }"
    id="printme"
    class="flex-1 flex">
    <style>
        {{!-- #template3 #pageone {
            border: 1px solid black;
        } --}}

        @page {
            size: A4;
            margin: 0;
        }

        #template3 {
            background-color: #f3f4f6;
            font-family: Arial, sans-serif;
            font-size: 14px;
            color: #000;
            
        }
        #template3 .page {
            width: 21cm;
            height: 29.7cm;
            overflow: hidden;
            position: relative;
            box-sizing: border-box;
            border: none;
        }
        #template3 .page {
            background: white;
            {{!-- box-shadow: 0 .5mm 2mm rgba(0,0,0,.3); --}}
            {{!-- border: 1px solid #d3d3d3; --}}
        }
        {{!-- #template3 .page:last-child {
        background: red;
        } --}}
        {{!-- #template3 .page:not(:last-child) {
        page-break-after: always;
        background: yellow;
        } --}}

        #template3 .page {
            position: relative;
            margin-bottom: 20px;
        }
        #template3 .top-left {
            position: absolute;
            top: 10mm;
            left: 10mm;
        }

        #template3 .bottom-right {
            position: absolute;
            bottom: 10mm;
            right: 10mm;
        }

        #template3 header {
            position: relative;
        }

        #template3 header h1 {
            position: absolute;
            top: 30px; 
             /* Set the left margin to 10mm */
            right: 10mm; /* Set the right margin to 10mm */
            width: calc(100% - 20mm);     
            font: bold 150% sans-serif;
            letter-spacing: 0.3em;
            text-align: right;
            text-transform: uppercase;
            padding: 5px 0 5px 0;
        }

        #template3 header h1::after {
            content: '';
            margin-left: -0.3em; /* Adjust this value to match the letter-spacing */
        }

        #template3 header #document_number_dates {
            position: absolute;
            top: 75px;
            left: 10mm;
            width: calc(100% - 20mm);
            font-size: 90%;
            font-style: normal;
            line-height: 1.25;
            text-align: right;
        }

        #template3 header #document_number_dates .spacing {
            display: block;
            margin-bottom: 2px;
        }

        #template3 header #seller_address {
            position: absolute;
            top: 5cm;
            left: 10mm;
            width: 40%;
            word-wrap: break-word;
            line-height: initial;
            text-align: left;
            {{!-- font-size: 85%; --}}
            {{!-- font-style: normal;
            line-height: 1.25; --}}
        }

        #template3 #ref-purpose {
            position: absolute;
            top: 10cm;
            left: 10mm;
            width: 75%;
            word-wrap: break-word;
            line-height: initial;
            text-align: left;
        }

        #template3 header #billed_to {
            position: absolute;
            top: 4.5cm;
            left: 11cm;
        }

        #template3 header #buyer_address {
            position: absolute;
            font-size: 100%;
            font-style: normal;
            text-align: left;
            line-height: 1.25;
            top: 5.5cm; {{!--  dimension standard 5.5cm --}}
            left: 11cm; {{!-- dimension standard 11cm --}}
            height: 3.0cm; {{!-- dimension standard 3.3cm --}}
            width: 8.0cm;  {{!-- dimension standard 8.5cm --}}
            padding-top: 3px;
            padding-left: 3px;
            word-wrap: break-word;
                {
                    {
                    border: dashed 1px #d0cfcf;             
                }
            }
        }

        #template3 header #buyer_address::before,
        #template3 header #buyer_address::after {
            content: "";
            position: absolute;
            width: 5px;
            height: 5px;
            border: 1px dashed #000;
        }

        #template3 header #buyer_address::before {
            top: 0;
            left: 0;
            border-bottom: none;
            border-right: none;
        }

        #template3 header #buyer_address::after {
            top: 0;
            right: 0;
            border-bottom: none;
            border-left: none;
        }

        #template3 header #invoice_details {
            position: absolute;
            left: 10mm;
            top: 8cm;
            border-collapse: collapse;
            margin-top: 50px;
            font-size: 85%;
        }
        
        #template3 main {
            position: relative;
        }


        #template3 main #products {
            position: absolute;
            left: 10mm;
            right: 10mm;
            width: calc(100% - 20mm); /* 100% width with 10mm left and right margins */
        }

        #template3 main #products.page1 {
            top: 12cm;
        }

        #template3 main #products.page2plus {
            top: 4cm;
        }

        /* Table container */
        #template3 main #products .table {
            display: table;
            width: 100%;
            border-collapse: collapse;
        }

        /* Table row */
        #template3 main #products .tr, #template3 main #products .thead {
            display: table-row;
            border-bottom: 1px solid #ccc; /* Optional: Add a border between rows */
        }

         #template3 main #products .thead .th {
            display: table-cell;
            padding: 8px 16px; /* Adjust padding as needed */
            border: 1px solid #ccc; /* Add cell borders */
            font-weight: 700;
         }

        /* Table cell */
        #template3 main #products .td {
            font-size: 80%;
            display: table-cell;
            padding: 2px 4px; /* Adjust padding as needed */
            border: 1px solid #ccc; /* Add cell borders */
        }

        /* Header row (optional) */
        #template3 main #products .tr:first-child {
            background-color: #f0f0f0; /* Add background color to header row */
            font-weight: bold; /* Make header text bold */
        }

        #template3 main #products .amounts{
            display: table;
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        #template3 footer {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            color: #fff;
            text-align: center;
            padding: 20px 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        #template3 footer .notes {
            font-size: 90%;
            color: #000;
            text-align: left;
            margin: 0 10mm 5mm 10mm;
        }
        #template3 footer .row-container {
            display: flex;
            width: 100%;
        }
        #template3 footer .left,
        #template3 footer .right {
            flex: 1;
            margin: 0 10mm 10mm 10mm;
            box-sizing: border-box;
        }

        /* Add styling to individual columns (no changes) */
        #template3 footer .left {
            background-color: #555;
        }

        #template3 footer .middle {
            background-color: #666;
        }

        #template3 footer .right {
            background-color: #777;
        } --}}
     </style>
    <div id="template3" class="flex-1 zoomable-div" style="">
{{!-- PAGE 1 - BEGIN --}}
      <div id="pageone"
        {{!-- style="transform: scale(0.3866498740554156); transform-origin: 0 0;" --}}
        class="page text-black sheet transform-origin-top-left xl:mx-auto">
      <span class="top-left">
        <template x-if="selectedDocument.config?.seller?.logo?.slug">
            <img :src="`/file/serve/${selectedDocument.config.seller.logo.slug}`">
        </template> 
      </span>
      <span class="bottom-right">{{ t 'default_template.invoice_number_footer' }} <span x-text="orEmpty(selectedDocument.config.invoice_number)"></span> - {{ t 'default_template.page' }} 1/<span x-text="orEmpty(numberOfPages)"></span></span>


        <header> 
            <template x-if="selectedDocument.config.document_type === 'invoice'"><h1>{{ t 'default_template.invoice' }}</h1></template>       
            <template x-if="selectedDocument.config.document_type === 'credit_note'"><h1>{{ t 'default_template.credit_note' }}</h1></template>

            <div id="document_number_dates">
                <template x-if="selectedDocument.config.document_type === 'invoice'">
                    <div>
                        <span class="spacing">{{ t 'default_template.invoice_number' }}: <span x-text="orEmpty(selectedDocument.config.invoice_number)"></span></span>
                        <span class="spacing">{{ t 'default_template.invoice_date' }}: <span x-text="orEmpty(selectedDocument.config.invoice_date)"></span></span>
                        <span class="spacing">{{ t 'default_template.due_date' }}: <span x-text="orEmpty(selectedDocument.config.invoice_due_date?.value)"></span></span>
                        <span x-show="selectedDocument.config.show_delivery_date" class="spacing">{{ t 'default_template.delivery_date' }}: <span x-text="orEmpty(selectedDocument.config.invoice_delivery_date)"></span></span>
                    </div>
                </template>
                <template x-if="selectedDocument.config.document_type === 'credit_note'">
                    <div>
                        <span class="spacing">{{ t 'default_template.credit_note_number' }}: <span x-text="orEmpty(selectedDocument.config.credit_note_number)"></span></span>
                        <span x-show="selectedDocument.config.show_target_invoice" class="spacing">{{ t 'default_template.target_invoice_number' }}: <span x-text="orEmpty(selectedDocument.config.invoice_number)"></span></span>
                        <span class="spacing">{{ t 'default_template.credit_note_date' }}: <span x-text="orEmpty(selectedDocument.config.invoice_date)"></span></span>
                        <span class="spacing">{{ t 'default_template.due_date' }}: <span x-text="orEmpty(selectedDocument.config.invoice_due_date?.value)"></span></span>
                    </div>
                </template>
            </div>  

            <div id="seller_address">
                <span style="font-size: 150%; font-weight: 700;" x-text="orEmpty(selectedDocument.config.seller.name)"></span><br/>
                <span style="" x-text="`${orEmpty(selectedDocument.config.seller.address1)} ${orEmpty(selectedDocument.config.seller.address2)}`"></span><br/>
                <span x-text="`${orEmpty(selectedDocument.config.seller.zip)} ${orEmpty(selectedDocument.config.seller.city)}`"></span><br/>
                <span x-text="orEmpty(selectedDocument.config.seller.country)"></span><br/><br/>
                <span> {{t 'default_template.vat_number'}}: <span x-text="orEmpty(selectedDocument.config.seller.vat_number)"></span></span><br/>
                <span x-text="orEmpty(selectedDocument.config.seller.phone)"></span><br/>
                <span x-text="orEmpty(selectedDocument.config.seller.email)"></span><br/><br/>
            </div>
            <div id="ref-purpose">
                <table style="border-spacing: 0;">
                    <tr x-show="selectedDocument.config.reference">
                        <td>{{ t 'default_template.reference' }}:</td>
                        <td style="padding-left: 10px; font-weight: 700;"
                            x-text="orEmpty(selectedDocument.config.reference)"></td>
                    </tr>
                    <tr x-show="selectedDocument.config.subject">
                        <td>{{ t 'default_template.purpose' }}:</td>
                        <td style="padding-left: 10px;font-weight: 700;"
                            x-text="orEmpty(selectedDocument.config.subject)"></td>
                    </tr>
                </table>
            </div>
            
            <div id="billed_to"style="font-weight: 400;">{{ t 'default_template.billed_to' }}</div>
            <div id="buyer_address">
                <span style="" x-text="selectedDocument.config.buyer.name"></span><br/>
                <span style="" x-text="`${orEmpty(selectedDocument.config.buyer.address1)} ${orEmpty(selectedDocument.config.buyer.address2)}`"></span><br/>
                <span style="" x-text="`${orEmpty(selectedDocument.config.buyer.zip)} ${orEmpty(selectedDocument.config.buyer.city)}`"></span>
                <span style="" x-text="orEmpty(selectedDocument.config.buyer.country)"></span><br/>
                <br/><br/>
                <span style=""><span x-text="orEmpty(selectedDocument.config.buyer.vat_number)"></span></span><br/>
                <span style="" x-text="orEmpty(selectedDocument.config.buyer.phone)"></span><br/>
                <span style="" x-text="orEmpty(selectedDocument.config.buyer.email)"></span>
            </div>   
        </header> 
        <main>
            <div id="products" class="page1">
                <div class="table">
                    <div class="thead">
                        <div class="th" style="text-align:left;width:300px">{{t 'default_template.description'}}</div>
                        <div class="th" style="text-align:right;width:30px">{{t 'default_template.quantity_short'}}</div>
                        <div class="th" style="text-align:right">{{t 'default_template.unit_price_short'}}</div>
                        <div class="th" style="text-align:right;width:30px">{{t 'default_template.vat'}}</div>
                        <div class="th" style="text-align:right">{{t 'default_template.total'}}</div>
                    </div>
                    <template x-for="(item, rowIndex) in selectedDocument.config.items.slice(0, 5)" :key="rowIndex">
                        <div class="tr">
                            <div class="td" style="text-align:left;width:300px">
                                <span style="font-weight: 600;" x-text="orEmpty(item.name)"></span><br>
                                <span x-text="orEmpty(item.description)"></span>
                            </div>
                            <div class="td" style="text-align:right" x-text="orEmpty(item.quantity)"></div>
                            <div class="td" style="text-align:right" x-text="`${selectedDocument.config.currency.symbol} ${orEmpty(item.unit_price)}`"></div>
                            <div class="td" style="text-align:right" x-text="`${orEmpty(item.vat)}%`"></div>
                            <div class="td" style="text-align:right" x-text="`${selectedDocument.config.currency.symbol} ${orEmpty(item.amountvatincl)}`"></div>
                        </div>
                    </template>
                </div>
                <template x-if="numberOfPages == 1">
                    <table class="amounts">
                        <tr>
                            <td width="50%"></td>
                            <td style="text-align: right;">{{t 'default_template.total_vat_excl'}}</td>
                            <td style="text-align: right;" x-text="`${selectedDocument.config.currency.symbol} ${selectedDocument.config.amounts.subtotal}`"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: right;">{{t 'default_template.vat_total'}}</td>
                            <td style="text-align: right;" x-text="`${selectedDocument.config.currency.symbol} ${selectedDocument.config.amounts.totalvat}`"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: right;">{{t 'default_template.total_vat_incl'}}</td>
                            <td style="text-align: right;" x-text="`${selectedDocument.config.currency.symbol} ${selectedDocument.config.amounts.total}`"></td>
                        </tr>
                    </table>
                </template>
            </div>
            
        </main>
         

        <footer>
            <div class="notes" x-text="selectedDocument.config.notes_on_invoice"></div>
             <div class="row-container">
                <div class="left" >Eventuellement un logo</div>
                <div class="right">Numero de compte etc</div>
            </div>
        </footer>
    </div> 
{{!-- PAGE 1 - END --}}


{{!-- PAGE 2+ - BEGIN --}}
    {{!-- creating chunks of 15 items each from `selectedDocument.config.items` (ignoring the first 5 items), and then iterating over these chunks --}}
    <template x-for="(itemsChunk, chunkIndex) in selectedDocument.config.items.slice(5).reduce((acc, _, i) => (i % 15 ? acc : [...acc, selectedDocument.config.items.slice(i + 5, i + 20)]), [])" :key="chunkIndex">
      <div style="width: 21cm;
            {{!-- position: relative; --}}
            height: 29.7cm;
            box-sizing: border-box;"
        class="page sheet text-black transform-origin-top-left xl:mx-auto">
        <span class="top-left">top left - currentPage:</span>
        <span class="bottom-right">{{ t 'default_template.invoice_number_footer'}} - <span x-text="selectedDocument.config.invoice_number"></span> - page <span x-text="chunkIndex + 2"></span>/<span x-text="numberOfPages"></span></span>
        <main>
            <div id="products" class="page2plus">

                
                <div class="table">
                    <div class="thead">
                        <div class="th" style="text-align:left;width:300px">{{t 'default_template.description'}}</div>
                        <div class="th" style="text-align:right;width:30px">{{t 'default_template.quantity_short'}}</div>
                        <div class="th" style="text-align:right">{{t 'default_template.unit_price_short'}}</div>
                        <div class="th" style="text-align:right;width:30px">{{t 'default_template.vat'}}</div>
                        <div class="th" style="text-align:right">{{t 'default_template.total'}}</div>
                    </div>
                    <template x-for="(item, itemIndex) in itemsChunk" :key="itemIndex">
                        <div class="tr">
                            <div class="td" style="text-align:left;width:300px">
                                <span style="font-weight: 600;" x-text="orEmpty(item.name)"></span><br>
                                <span x-text="orEmpty(item.description)"></span>
                            </div>
                            <div class="td" style="text-align:right" x-text="orEmpty(item.quantity)"></div>
                            <div class="td" style="text-align:right" x-text="`${selectedDocument.config.currency.symbol} ${orEmpty(item.unit_price)}`"></div>
                            <div class="td" style="text-align:right" x-text="`${orEmpty(item.vat)}%`"></div>
                            <div class="td" style="text-align:right" x-text="`${selectedDocument.config.currency.symbol} ${orEmpty(item.amountvatincl)}`"></div>
                        </div>
                    </template>
                </div>


                <template x-if="numberOfPages == chunkIndex + 2">
                    <table class="amounts">
                        <tr>
                            <td width="50%"></td>
                            <td style="text-align: right;">{{t 'default_template.total_vat_excl'}}</td>
                            <td style="text-align: right;" x-text="`${selectedDocument.config.currency.symbol} ${selectedDocument.config.amounts.subtotal}`"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: right;">{{t 'default_template.vat_total'}}</td>
                            <td style="text-align: right;" x-text="`${selectedDocument.config.currency.symbol} ${selectedDocument.config.amounts.totalvat}`"></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align: right;">{{t 'default_template.total_vat_incl'}}</td>
                            <td style="text-align: right;" x-text="`${selectedDocument.config.currency.symbol} ${selectedDocument.config.amounts.total}`"></td>
                        </tr>
                    </table>
                </template>
            </div>
        </main>
        
        <footer>
            <div x-text="selectedDocument.config.notes_on_invoice" class="left">Eventuellement un logo</div>
            <div class="right">Numero de compte etc</div>
        </footer>
      </div> 
    </template>
{{!-- PAGE 2+ - END --}}

    </div>
</div>