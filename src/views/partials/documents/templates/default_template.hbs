                            <span class="spacing">{{ i18n 'default_template.invoice_date' doc_lang }}: <span
                                    x-text="orEmpty(selectedDocument.config.invoice_date)"></span></span>
                            <span class="spacing">{{ i18n 'default_template.due_date' doc_lang }}: <span
                                    x-text="orEmpty(selectedDocument.config.invoice_due_date?.value)"></span></span>
                            <span x-show="selectedDocument.config.show_delivery_date" class="spacing">{{ i18n
                                'default_template.delivery_date' doc_lang }}: <span
                                    x-text="orEmpty(selectedDocument.config.invoice_delivery_date)"></span></span>
                        </div>
                    </template>
                    <template x-if="selectedDocument.config.document_type === 'credit_note'">
                        <div>
                            <span class="spacing">{{ i18n 'default_template.credit_note_number' doc_lang }}: <span
                                    x-text="orEmpty(selectedDocument.config.credit_note_number)"></span></span>
                            <span x-show="selectedDocument.config.show_target_invoice" class="spacing">{{ i18n
                                'default_template.target_invoice_number' doc_lang }}: <span
                                    x-text="orEmpty(selectedDocument.config.invoice_number)"></span></span>
                            <span class="spacing">{{ i18n 'default_template.credit_note_date' doc_lang }}: <span
