            left: 10mm;
            width: 75%;
            word-wrap: break-word;
            line-height: initial;
            text-align: left;
        }

        #template3 header #buyer_address {
            position: absolute;
            font-size: 100%;
            font-style: normal;
            text-align: left;
            line-height: 1.25;
            top: 5.5cm;
            left: 11cm;
            height: 3.0cm;
            width: 8.0cm;
            padding-top: 3px;
            padding-left: 3px;
            word-wrap: break-word;
