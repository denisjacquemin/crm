                            <span
                                x-text="orEmpty(selectedDocument.config.seller.registration_number)"></span><br></span>
                    </template>

                    <template
                        x-if="selectedDocument.config.show_iban && selectedDocument.config.seller.bank_accounts && selectedDocument.config.seller.bank_accounts.some(acc => acc.iban || acc.bic)">
                        <template
