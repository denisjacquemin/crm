<div x-data="{
        // numberOfPages is the number of batch of 15 items starting at position 6 in selectedDocument.config.items
            itemsPerPageFirst: 15,
            itemsPerPageRest: 20,
            test: selectedDocument.config.items.length - this.itemsPerPageFirst,
            get numberOfPages() {
                const totalItems = selectedDocument.config.items.length;
                
                // If we have fewer items than first page capacity, just return 1
                if (totalItems <= this.itemsPerPageFirst) {
                    return 1;
                }
                
                const remainingItems = totalItems - this.itemsPerPageFirst;
                return Math.ceil(remainingItems / this.itemsPerPageRest) + 1;
            },
            orEmpty(value) {
                return value || '';
            },
            session: {{ stringify session }},
            get pagesNumber() {
                const totalItems = selectedDocument.config.items.length;
                const remainingItems = totalItems - this.itemsPerPageFirst;
                const result = Math.ceil(remainingItems / this.itemsPerPageRest) + 1;
                
                console.log('numberOfPages calculation:', {
                    totalItems,
                    itemsPerPageFirst: this.itemsPerPageFirst,
                remainingItems,
                    result
                });

                return result;
            }
            
        }" id="printme" class="flex-1 flex">
    <style>
        body {
            margin: 0;
            padding: 0;
        }

        @page {
            size: A4;
            margin: 0;
        }

        #template3 {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 14px;
            color: #000;
        }

        #template3 .page {
