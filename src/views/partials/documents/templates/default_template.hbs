                            <div><span x-text="account.iban"></span> <span x-text="account.bic"></span><br></div>
                        </template>
                    </template>

                    <template x-if="selectedDocument.config.show_contact_person">
                        <span>{{i18n 'default_template.contact_person' doc_lang}}: <span
                                x-text="orEmpty(selectedDocument.config.seller.contact_lastname) + ' ' + orEmpty(selectedDocument.config.seller.contact_firstname)"></span><br></span>
                    </template>

                    <template x-if="selectedDocument.config.show_seller_phone">
                        <span>{{i18n 'default_template.seller_phone' doc_lang}}: <span
                                x-text="orEmpty(selectedDocument.config.seller.phone)"></span><br /></span>
                    </template>

                    <template x-if="selectedDocument.config.show_seller_email">
                        <div><span x-text="orEmpty(selectedDocument.config.seller.email)"></span><br /></div>
                    </template>

                    <template x-if="selectedDocument.config.show_seller_website">
                        <div><span x-text="orEmpty(selectedDocument.config.seller.website)"></span><br /></div>
                    </template>

                </div>
                <div id="ref-purpose">
                    <table style="border-spacing: 0;">
                        <tr x-show="selectedDocument.config.reference">
                            <td>{{ i18n 'default_template.reference' doc_lang }}:</td>
                            <td style="padding-left: 10px; font-weight: 700;"
                                x-text="orEmpty(selectedDocument.config.reference)"></td>
                        </tr>
                        <tr x-show="selectedDocument.config.subject">
                            <td>{{ i18n 'default_template.purpose' doc_lang }}:</td>
                            <td style="padding-left: 10px;font-weight: 700;"
                                x-text="orEmpty(selectedDocument.config.subject)"></td>
                        </tr>
                    </table>
                </div>

                <div id="buyer_address">
                    <span style="" x-text="selectedDocument.config.buyer.name"></span><br />
                    <span style=""
                        x-text="`${orEmpty(selectedDocument.config.buyer.address1)} ${orEmpty(selectedDocument.config.buyer.address2)}`"></span><br />
                    <span style=""
                        x-text="`${orEmpty(selectedDocument.config.buyer.zip)} ${orEmpty(selectedDocument.config.buyer.city)}`"></span>
                    <span style="" x-text="orEmpty(selectedDocument.config.buyer.country)"></span><br />
                    <br /><br />
                    <span style=""><span x-text="orEmpty(selectedDocument.config.buyer.vat_number)"></span></span><br />
                    <span style="" x-text="orEmpty(selectedDocument.config.buyer.phone)"></span><br />
                    <span style="" x-text="orEmpty(selectedDocument.config.buyer.email)"></span>
                </div>
            </header>
            <main>
                <div id="products" class="page1">
                    <div class="table">
                        <div class="thead">
                            <div class="th" style="text-align:left;width:300px">{{i18n 'default_template.description'
                                doc_lang}}</div>
                            <div class="th" style="text-align:right;width:30px">{{i18n 'default_template.quantity_short'
                                doc_lang}}</div>
                            <div class="th" style="text-align:right">{{i18n 'default_template.unit_price_short'
                                doc_lang}}</div>
                            <div class="th" style="text-align:right;width:30px">{{i18n 'default_template.vat' doc_lang}}
                            </div>
                            <div class="th" style="text-align:right">{{i18n 'default_template.total' doc_lang}}</div>
                        </div>
                        <template x-for="(item, rowIndex) in selectedDocument.config.items.slice(0, itemsPerPageFirst)"
                            :key="rowIndex">
                            <div class="tr">
                                <div class="td" style="text-align:left;width:300px">
                                    <span style="font-weight: 600;" x-text="orEmpty(item.name)"></span><br>
