                    <span
                        x-text="selectedDocument.config.approval_label || '{{ i18n 'documents.controller.approval_label' doc_lang }}'"></span>
                </div>

                <template x-if=" selectedDocument.config.notes_on_document">
                    <div class="notes" x-text="selectedDocument.config.notes_on_document"></div>
                </template>
                <div class="row-container">
                    <div class="left"></div>
                    <div class="right"></div>
                </div>
            </footer>
        </div>
        {{!-- PAGE 1 - END --}}


        {{!-- PAGE 2+ - BEGIN --}}
        {{!-- creating chunks of 15 items each from `selectedDocument.config.items` (ignoring the first 5 items), and
        then iterating over these chunks --}}
        <template x-for="(itemsChunk, chunkIndex) in selectedDocument.config.items.slice(itemsPerPageFirst).reduce((acc, _, i) => 
                (i % itemsPerPageRest ? acc : [...acc, selectedDocument.config.items.slice(
                    i + itemsPerPageFirst, 
                    i + itemsPerPageFirst + itemsPerPageRest
                )]), 
            [])" :key="chunkIndex">
            <div style="width: 21cm;
            {{!-- position: relative; --}}
            height: 29.7cm;
            box-sizing: border-box;" class="page sheet text-black transform-origin-top-left xl:mx-auto">
                <span class="top-left">top left - currentPage:</span>
                <span class="bottom-right">{{ i18n 'default_template.invoice_number_footer' doc_lang}} - <span
                        x-text="selectedDocument.config.invoice_number"></span> - page <span
                        x-text="chunkIndex + 2"></span>/<span x-text="numberOfPages"></span></span>
                <main>
                    <div id="products" class="page2plus">


                        <div class="table">
                            <div class="thead">
                                <div class="th" style="text-align:left;width:300px">{{i18n
                                    'default_template.description' doc_lang}}</div>
                                <div class="th" style="text-align:right;width:30px">{{i18n
                                    'default_template.quantity_short' doc_lang}}</div>
                                <div class="th" style="text-align:right">{{i18n 'default_template.unit_price_short'
                                    doc_lang}}</div>
                                <div class="th" style="text-align:right;width:30px">{{i18n 'default_template.vat'
                                    doc_lang}}</div>
                                <div class="th" style="text-align:right">{{i18n 'default_template.total' doc_lang}}
                                </div>
                            </div>
                            <template x-for="(item, itemIndex) in itemsChunk" :key="itemIndex">
                                <div class="tr">
                                    <div class="td" style="text-align:left;width:300px">
                                        <span style="font-weight: 600;" x-text="orEmpty(item.name)"></span><br>
                                        <span x-text="orEmpty(item.description)"></span>
                                    </div>
                                    <div class="td" style="text-align:right" x-text="orEmpty(item.quantity)"></div>
                                    <div class="td" style="text-align:right"
                                        x-text="`${selectedDocument.config.currency.symbol} ${orEmpty(item.unit_price)}`">
                                    </div>
                                    <div class="td" style="text-align:right" x-text="`${orEmpty(item.vat)}%`"></div>
                                    <div class="td" style="text-align:right"
                                        x-text="`${selectedDocument.config.currency.symbol} ${orEmpty(item.amountvatincl)}`">
                                    </div>
                                </div>
                            </template>
                        </div>


                        <template x-if="numberOfPages == chunkIndex + 2">
                            <table class="amounts">
                                <tr>
                                    <td width="50%"></td>
                                    <td style="text-align: right;">{{i18n 'default_template.total_vat_excl' doc_lang}}
                                    </td>
                                    <td style="text-align: right;"
                                        x-text="`${selectedDocument.config.currency.symbol} ${selectedDocument.config.amounts.subtotal}`">
                                    </td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td style="text-align: right;">{{i18n 'default_template.vat_total' doc_lang}}</td>
                                    <td style="text-align: right;"
                                        x-text="`${selectedDocument.config.currency.symbol} ${selectedDocument.config.amounts.totalvat}`">
                                    </td>
                                </tr>
                                <tr>
                                    <td></td>
                                    <td style="text-align: right;">{{i18n 'default_template.total_vat_incl' doc_lang}}
                                    </td>
                                    <td style="text-align: right;"
                                        x-text="`${selectedDocument.config.currency.symbol} ${selectedDocument.config.amounts.total}`">
                                    </td>
                                </tr>
                            </table>
                        </template>
                    </div>
                </main>

                <footer>
                    <div x-text="selectedDocument.config.notes_on_document" class="left"></div>
                    <div class="right">Numero de compte etc</div>
                </footer>
            </div>
        </template>
        {{!-- PAGE 2+ - END --}}

    </div>
</div>