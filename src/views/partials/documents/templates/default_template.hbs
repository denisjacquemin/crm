        }

        #template3 main {
            position: relative;
        }


        #template3 main #products {
            position: absolute;
            left: 10mm;
            right: 10mm;
            width: calc(100% - 20mm);
            /* 100% width with 10mm left and right margins */
        }

        #template3 main #products.page1 {
            top: 12cm;
        }

        #template3 main #products.page2plus {
            top: 4cm;
        }

        /* Table container */
        #template3 main #products .table {
            display: table;
            width: 100%;
            border-collapse: collapse;
        }

        /* Table row */
        #template3 main #products .tr,
        #template3 main #products .thead {
            display: table-row;
            border-bottom: 1px solid #ccc;
            /* Optional: Add a border between rows */
        }

        #template3 main #products .thead .th {
            display: table-cell;
            padding: 8px 16px;
            /* Adjust padding as needed */
            border: 1px solid #ccc;
            /* Add cell borders */
            font-weight: 700;
        }

        /* Table cell */
        #template3 main #products .td {
            font-size: 80%;
            display: table-cell;
            padding: 2px 4px;
            /* Adjust padding as needed */
            border: 1px solid #ccc;
            /* Add cell borders */
