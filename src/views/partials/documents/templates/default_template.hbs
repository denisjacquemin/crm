                    ? '{{i18n  'default_template.quote' doc_lang}}'
                    : selectedDocument.config.document_type === 'proforma_invoice'
                    ? '{{i18n  'default_template.proforma_invoice' doc_lang}}'
                    : selectedDocument.config.document_type === 'order'
                    ? '{{i18n  'default_template.order' doc_lang}}'
                    : '{{i18n  'default_template.delivery_note' doc_lang}}'
