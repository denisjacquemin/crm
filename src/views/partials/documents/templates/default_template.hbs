            /* Make header text bold */
        }

        #template3 main #products .amounts {
            display: table;
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        #template3 footer {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            color: #fff;
            text-align: center;
            padding: 20px 10mm;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        #template3 footer #approval {
            background: #eee;
            height: 100px;
            width: 350px;
            text-align: left;
            padding: 3mm;
            margin-bottom: 5mm;
        }

        #template3 footer #approval span {
            font-weight: 500;
            font-size: 80%;
            color: #444;
        }

        #template3 footer .notes {
            font-size: 90%;
            color: #000;
            text-align: left;
        }

        #template3 footer .row-container {
            display: flex;
            width: 100%;
        }

        #template3 footer .left,
        #template3 footer .right {
            flex: 1;
            margin: 0 10mm 10mm 10mm;
            box-sizing: border-box;
        }

        /* Add styling to individual columns (no changes) */
        #template3 footer .left {
            text-align: left;
            color: #000;
        }

        #template3 footer .middle {
            background-color: #666;
        }

        #template3 footer .right {
            background-color: #777;
        }
    </style>
    <div id="template3" class="flex-1 zoomable-div" style="">
        {{!-- PAGE 1 - BEGIN --}}
        <div id="pageone" {{!-- style="transform: scale(0.3866498740554156); transform-origin: 0 0;" --}}
            class="page text-black sheet transform-origin-top-left xl:mx-auto">

            <template x-if="selectedDocument.config.ribbon.text">
