        #template3 header #buyer_address::before,
        #template3 header #buyer_address::after {
            content: "";
            position: absolute;
            width: 5px;
            height: 5px;
            border: 1px dashed #000;
        }

        #template3 header #buyer_address::before {
            top: 0;
            left: 0;
            border-bottom: none;
            border-right: none;
        }

        #template3 header #buyer_address::after {
            top: 0;
            right: 0;
            border-bottom: none;
            border-left: none;
        }

        #template3 header #invoice_details {
            position: absolute;
            left: 10mm;
            top: 8cm;
            border-collapse: collapse;
            margin-top: 50px;
