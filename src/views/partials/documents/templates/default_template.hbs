<div x-data="{
        // numberOfPages is the number of batch of 15 items starting at position 6 in selectedDocument.config.items
            numberOfPages: Math.ceil((selectedDocument.config.items.length - 5) / 15) + 1,
            orEmpty(value) {
                return value || '';
            }
        }"
    id="printme"
    class="flex-1 flex">
    <style>
        {{!-- #template3 #pageone {
            border: 1px solid black;
        } --}}

        @page {
            size: A4;
            margin: 0;
        }

        #template3 {
            background-color: #f0f0f0;
            font-family: Arial, sans-serif;
            font-size: 14px;
            color: #000;
            
        }
        #template3 .page {
            width: 21cm;
            height: 29.7cm;
            overflow: hidden;
            position: relative;
            box-sizing: border-box;
            padding: 10mm;
            border: none;
