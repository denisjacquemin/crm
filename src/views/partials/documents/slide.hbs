<div x-show="openSlide" class="min-h-[64rem] bg-gray-100">
    
    <div @keydown.window.escape="openSlide = false" x-show="openSlide" class="relative z-40" x-ref="dialog" aria-modal="true">
      
    <div x-show="openSlide" x-transition:enter="ease-in-out duration-500" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="ease-in-out duration-500" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" x-description="Background backdrop, show/hide based on slide-over state." class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>

    <div class="fixed inset-0 overflow-hidden">
      <div class="absolute inset-0 overflow-hidden">
        <div class="pointer-events-none fixed inset-y-0 right-0 flex max-w-full pl-10 sm:pl-16">
          
            <div class="overflow-hidden pointer-events-auto relative w-screen max-w-2xl" x-show="openSlide" x-transition:enter="transform transition ease-in-out duration-500 sm:duration-700" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transform transition ease-in-out duration-500 sm:duration-700" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full"  x-description="Slide-over panel, show/hide based on slide-over state." @click.away="openSlide = false">
              
              {{!-- <div x-show="openSlide" x-transition:enter="ease-in-out duration-500" x-transition:enter-start="opacity-0" x-transition:enter-end="opacity-100" x-transition:leave="ease-in-out duration-500" x-transition:leave-start="opacity-100" x-transition:leave-end="opacity-0" x-description="Close button, show/hide based on slide-over state." class="absolute right-0 top-0 -ml-8 flex pr-2 pt-4 sm:-ml-10 sm:pr-4">
                  <button type="button" class="z-50 rounded-md bg-gray-200 p-2 text-gray-400 hover:text-gray-700 focus:outline-none focus:ring-2 focus:ring-white" @click="openSlide = false" spellcheck="false">
                      <span class="sr-only">Close panel</span>
                      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
                      </svg>
                  </button>
              </div> --}}
              
              <div class="h-full bg-white" x-description="Slide-over panel, show/hide based on slide-over state.">
                <div class="flex flex-col h-full"
                x-data="{
                      buttonContent: `<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='lucide lucide-check'><path d='M20 6 9 17l-5-5'/></svg>{{t 'documents.views.index.buyer_modal.back_button' }}`,
                      clickHandler: () => { openSlide = false; },
                      updateButtonContent: function(newContent) {
                          this.buttonContent = newContent;
                      },
                      updateClickHandler(newHandler) {
                          this.clickHandler = newHandler;
                      }
                    }"
                >
                  <div class="flex-none col-span-full px-4 py-2 sm:px-6 sm:py-6 border-b border-gray-200">
                      <div>
                        <h2 class="text-base font-semibold leading-6 text-gray-900 flex justify-between items-center" id="slide-over-title">

                          <template  x-if="slideContentPartialName == 'slideBuyer'">
                            <span>{{t 'documents.views.index.buyer_modal.modal_title' }}</span>
                          </template>
                          <template  x-if="slideContentPartialName == 'slideItems'">
                            <span>{{t 'documents.views.index.items_modal.modal_title' }}</span>
                          </template>
                          <template x-if="slideContentPartialName == 'slideInvoiceSettings'">
                            <span>{{t 'documents.views.index.invoice_settings.modal_title' }}</span>
                          </template>
                          <template x-if="slideContentPartialName == 'slideFiles'">
                            <span>{{t 'documents.views.index.files_modal.modal_title' }}</span>
                          </template>
                          <template x-if="slideContentPartialName == 'slideEmail'">
                            <span>{{t 'documents.views.index.email_modal.modal_title' }}</span>
                          </template>
                          
                          <button x-html="buttonContent" @click.prevent="clickHandler" class="inline-flex items-center gap-x-2 rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                          </button>
                        </h2>
                        <p class="text-sm text-gray-700">
                          <template  x-if="slideContentPartialName == 'slideBuyer'">
                            <span>{{t 'documents.views.index.buyer_modal.modal_subtitle' }}</span>
                          </template>
                          {{!-- <template  x-if="slideContentPartialName == 'slideItems'">
                            <span>Add, update, delete, and rearrange invoice items easily.</span>
                          </template>      --}}
                        </p>
                      </div>
                  </div>
                  <div class="flex-grow overflow-hidden">
                    <template  x-if="slideContentPartialName == 'slideBuyer'">
                        {{> documents/slideBuyer }}
                    </template>

                    <template  x-if="slideContentPartialName == 'slideItems'">
                        {{> documents/slideItems }}
                    </template>

                    <template x-if="slideContentPartialName == 'slideInvoiceSettings'">
                        {{> documents/slideDocumentSettings }}
                    </template>

                    <template  x-if="slideContentPartialName == 'slideFiles'">
                        {{> documents/slideFiles }}
                    </template>

                    <template  x-if="slideContentPartialName == 'slideEmail'">
                        {{> documents/slideEmail }}
                    </template>
                  </div>
                </div>
          
              </div>
            </div>
        </div>
      </div>
    </div>  

    </div>
</div>