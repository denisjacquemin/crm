<div class="min-h-full">
    <div class=""
         x-data="{
            formItem: null,
            formEditIndex: null,
            decimalSymbol: ',',
            separatorSymbol: '.',
            automaticComputation: true,
            
            startEdit: function(index) {
                this.formEditIndex = index;
                this.formItem = selectedDocument.config.items[index];
            },
            resetFormItem: function() {
                this.formItem = {
                    description: '',
                    quantity: '',
                    unit_price: '',
                    reduction: '',
                    reduction_unit: '%',
                    vat: '0',
                    amountvatincl: '',
                    amountvatexcl: '',
                };
            },
            saveItem: function() {
                if (!this.formEditIndex) {
                    selectedDocument.config.items.push({
                        description: this.formItem.description || '',
                        quantity: String(this.parseNumber(this.formItem.quantity) || ''),
                        unit_price: String(this.parseNumber(this.formItem.unit_price) || ''),
                        reduction: String(this.parseNumber(this.formItem.reduction) || ''),
                        reduction_unit: this.formItem.reduction_unit || '%',
                        vat: String(this.parseNumber(this.formItem.vat) || '0'), 
                        order: selectedDocument.config.items.length + 1,
                        amountvatincl: String(this.parseNumber(this.itemAmountvatincl) || ''),
                        amountvatexcl: String(this.parseNumber(this.itemAmountvatexcl) || ''),
                    });
                } else {
                    selectedDocument.config.items[this.formEditIndex] = this.formItem;
                }
                this.resetFormItem(); // Clear the form item after saving
            },
            parseNumber: function(str) {
                return parseFloat(str.replaceAll(' ', '').replace(new RegExp('\\' + this.separatorSymbol, 'g'), '').replace(this.decimalSymbol, '.'));
            },
            formatAmountToString: function(num) {
                return num.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            },
            unitpriceMask: null,
            quantityMask: null,
            reductionMask: null,
            amountMask: null,
            initMask: function() {
                if (this.automaticComputation) {
                    this.quantityMask = IMask(document.getElementById('new-item-quantity'), {
                        mask: Number,
                        scale: 4,
                        thousandsSeparator: ' ',
                        normalizeZeros: true,
                    });        
                    this.unitpriceMask = IMask(document.getElementById('new-item-unit-price'), {
                        mask: Number,
                        thousandsSeparator: ' ',
                        scale: 2,
                        normalizeZeros: true,
                    });
                    this.reductionMask = IMask(document.getElementById('new-item-reduction'), {
                        mask: Number,
                        thousandsSeparator: ' ',
                        scale: 2,
                        normalizeZeros: true,
                    });
                    this.amountMask = IMask(document.getElementById('amount'), {
                        mask: Number,
                        thousandsSeparator: ' ',
                        scale: 2,
                        normalizeZeros: true,
                    });
                } else {
                    this.quantityMask.destroy();
                    this.quantityMask = null;
                    this.unitpriceMask.destroy();
                    this.unitpriceMask = null;
                    this.reductionMask.destroy();
                    this.reductionMask = null;
                }
            },
            get itemAmountvatexcl() { 
                if (this.automaticComputation) {
                    let unitPrice = this.parseNumber(this.formItem.unit_price) || 0;
                    let quantity = this.parseNumber(this.formItem.quantity) || 1;
                    let reduction = this.parseNumber(this.formItem.reduction) || 0;

                    let amount = unitPrice * quantity;
                    if (this.formItem.reduction_unit === 'EUR') {
                    amount -= reduction;
                    } else if (this.formItem.reduction_unit === '%') {
                    amount -= amount * (reduction / 100);
                    }
                    
                    return this.formatAmountToString(amount);
                } else {
                    return this.formItem.amountvatexcl;
                }   
            },
            get itemAmountvatincl() {
                if (this.automaticComputation) {

                    let unitPrice = this.parseNumber(this.formItem.unit_price) || 0;
                    let quantity = this.parseNumber(this.formItem.quantity) || 1;
                    let reduction = this.parseNumber(this.formItem.reduction) || 0;
                    let vat = this.parseNumber(this.formItem.vat);
                    vat = (vat < 0 || isNaN(vat)) ? 0 : vat;

                    let amount = unitPrice * quantity;
                    if (this.formItem.reduction_unit === 'EUR') {
                    amount -= reduction;
                    } else if (this.formItem.reduction_unit === '%') {
                    amount -= amount * (reduction / 100);
                    }

                    amount += amount * (vat / 100);
                    return this.formatAmountToString(amount);
                } else {
                    return this.formItem.amountvatincl;
                }
            },

            moveUp(index) {
            if (index > 0) {
                let item = this.selectedDocument.config.items.splice(index, 1)[0];
                this.selectedDocument.config.items.splice(index - 1, 0, item);
                this.selectedDocument.config.items[index].order = index;
                this.selectedDocument.config.items[index - 1].order = index - 1;
                }
            },
            moveDown(index) {
                if (index < this.selectedDocument.config.items.length - 1) {
                let item = this.selectedDocument.config.items.splice(index, 1)[0];
                this.selectedDocument.config.items.splice(index + 1, 0, item);
                this.selectedDocument.config.items[index].order = index;
                this.selectedDocument.config.items[index + 1].order = index + 1;
                }
            }
        }"
        x-init="
            resetFormItem(),
            {{!-- initSortable(), --}}
            initMask(),
            
            $watch('formItem.unit_price', () => { {{!-- Element value was changed outside of mask. Syncronize mask using `mask.updateValue()` to work properly --}}
                if (automaticComputation) {    
                    unitpriceMask.updateValue(); 
                }
            }),
            $watch('formItem.quantity', () => { {{!-- Element value was changed outside of mask. Syncronize mask using `mask.updateValue()` to work properly --}}
                if (automaticComputation) {
                    quantityMask.updateValue();
                } 
            }),
            $watch('formItem.reduction', () => { {{!-- Element value was changed outside of mask. Syncronize mask using `mask.updateValue()` to work properly --}}
                if (automaticComputation) {
                    reductionMask.updateValue(); 
                }
            }), 
            $watch('automaticComputation', () => { 
                initMask(); 
            })
        ">
        

        <div class="px-3 mb-6 grid grid-cols-2">
            <div class="col-span-full">
                <div class="p-6 bg-gray-100 border-t border-b border-solid border-gray-300 ">
                    <div class="flex items-start justify-between">
                        <div class="space-y-1">
                            <h2 class="text-base font-semibold leading-6 text-gray-900" id="slide-over-title">Add / Edit Item</h2>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-5 grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-6">
                <div class="col-span-full">
                    <label for="new-item-description" class="block text-sm font-medium leading-6 text-gray-900">Item Description</label>
                    <div class="mt-2">
                        <input type="text" x-model="formItem.description" id="new-item-description" autocomplete="off"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>
                <div class="col-span-1 sm:col-span-3">
                    <label for="new-item-quantity"
                        class="text-right block text-sm font-medium leading-6 text-gray-900">Quantity</label>
                    <div class="mt-2">
                        <input type="text" x-model="formItem.quantity" id="new-item-quantity" autocomplete="off" x-bind:placeholder="automaticComputation ? '0' : ''"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 text-right shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>

                <div class="col-span-1 sm:col-span-3">
                    <label for="new-item-unit-price" class="text-right block text-sm font-medium leading-6 text-gray-900">Unit Price</label>
                    <div class="mt-2">
                        <input type="text" x-model="formItem.unit_price" id="new-item-unit-price" autocomplete="off", x-bind:placeholder="automaticComputation ? `0${decimalSymbol}00` : ''"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 text-right shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                </div>  

                <div class="col-span-full">
                    <label for="new-item-reduction"
                        class="block text-sm font-medium leading-6 text-gray-900">Reduction</label>
                    <div class="mt-2 flex items-center">
                        <input type="text" x-model="formItem.reduction" id="new-item-reduction" autocomplete="off"
                            x-bind:placeholder="automaticComputation ? (formItem.reduction_unit === '%' ? '0' : `0${decimalSymbol}00`) : ''"
                            class="block w-full rounded-md border-0 py-1.5 text-right text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                        <select x-model="formItem.reduction_unit"
                            class="block ml-2 w-24 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                            <option value="%">%</option>
                            <option value="EUR">EUR</option>
                        </select>
                    </div>
                </div>
                <div class="col-span-full grid grid-cols-3 sm:grid-cols-5 gap-x-2">
                    <div class="col-span-1">
                        <label for="new-item-vat" class="block w-full text-sm font-medium leading-6 text-gray-900">VAT</label>
                        <select x-model="formItem.vat" id="new-item-vat"
                            class="block  w-full rounded-md border-0 py-1.5 mt-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                            <option value="-1">Not applicable</option>
                            <option value="0">0%</option>
                            <option value="6">6%</option>
                            <option value="20">20%</option>
                            <option value="21">21%</option>
                        </select>
                    </div>
                    <div class="col-span-2">
                        <label for="new-item-amount-vatexcl" class="text-right block w-full text-sm font-medium leading-6 text-gray-900">Amount excluding VAT</label>
                        
                        <p x-text="itemAmountvatexcl"
                           x-show="automaticComputation"
                           class="animate__animated animate__pulse block w-full py-1.5 mt-2 text-right text-gray-900 sm:text-sm sm:leading-6"></p>
                        <input x-show="!automaticComputation" type="text" 
                               x-model="formItem.itemAmountvatexcl" id="new-item-amount-vatexcl" autocomplete="off"
                               class="block w-full rounded-md border-0 py-1.5 mt-2 text-right text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                    </div>
                    <div class="col-span-full mt-2 sm:col-span-2 sm:mt-0">
                        <label for="new-item-amountvatincl" class="text-right block w-full text-sm font-medium leading-6 text-gray-900">Amount Inclusive of VAT</label>
                        <p x-text="itemAmountvatincl"
                           x-show="automaticComputation"
                           class="block w-full py-1.5 mt-2 text-right text-gray-900 sm:text-sm sm:leading-6"></p>
                        <input x-show="!automaticComputation" type="text" 
                               x-model="formItem.itemAmountvatincl" id="new-item-amount-vatincl" autocomplete="off"
                               class="block w-full rounded-md border-0 py-1.5 mt-2 text-right text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">

                    </div>
                    <div class="col-span-full border-t border-gray-200 px-2 pt-5 mt-4 sm:px-3">
                        <div class="grid grid-cols-2">
                            <div class="col-span-1">
                                <input type="checkbox" id="automatic-computation" class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" 
                                    x-bind:checked="automaticComputation"
                                    x-on:change="automaticComputation = !automaticComputation"
                                />
                                <label for="automatic-computation" class="text-sm font-light text-gray-500">Automatic Computation and Validation</label>
                            </div>
                            <div class="col-span-1 text-right">
                                <button @click.prevent="saveItem();" type="button" class="ml-3 inline-flex justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Add Item</button>
                            </div>
                        </div>
                    </div>
                </div>  
            </div>
        </div>
        
        <div class="px-3 mt-3 bg-red-500">
            <div class="col-span-full">
                <div class="p-6 bg-gray-100 border-t border-b border-solid border-gray-300 ">
                    <div class="flex items-start justify-between">
                        <h2 class="text-base font-semibold leading-6 text-gray-900" id="slide-over-title">Items</h2>
                    </div>
                </div>
            </div>
            <div x-show="selectedDocument.config.items.length == 0" class="relative block w-full rounded-lg border-2 border-dashed border-gray-300 p-12 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto h-12 w-12 text-gray-400">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                </svg>
                <span class="mt-2 block text-sm font-semibold text-gray-500">No item yet</span>
            </div>
            <table class="min-w-full divide-y divide-gray-300 max-w-full" x-show="selectedDocument.config.items.length > 0"
                   x-data="{ dragged: null, items: selectedDocument.config.items, dragElement: null, dropIndex: null }"
            >
                <thead>
                    <tr>
                        <th></th>
                        <th></th>
                        <th class="w-2/3 py-3.5 text-left text-sm font-semibold text-gray-900" width="auto">Description</th>
                        <th class="hidden text-sm font-semibold text-gray-900 text-right" width="150px">Quantity</th>
                        <th class="hidden text-sm font-semibold text-gray-900 text-right" width="150px">UP</th>
                        <th class="hidden text-sm font-semibold text-gray-900 text-right" width="150px">Reduction</th>                        
                        <th class="hidden sm:block py-3.5 text-sm font-semibold text-gray-900 text-right" width="150px">VAT</th>
                        <th class="hidden text-sm font-semibold text-gray-900 text-right" width="150px">Amount VAT Excl.</th>
                        <th class="hidden w-1/3 py-3.5 text-sm text-right font-semibold text-gray-900" width="150px">Amount VAT Incl.</th>
                        <th></th>
                        <th></th>
                    </tr>
                </thead>
                <tbody x-ref="itemsBody" class="divide-y divide-gray-200">
                    <template x-for="(item, index) in selectedDocument.config.items" :key="index">
                        <tr class="item even:bg-gray-50" style="transition: transform 0.3s ease">
                            <td class="py-2 align-top">
                                <button @click="moveUp(index)" type="button" class="inline-block hover:bg-gray-200 ">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 p-1 text-gray-500 hover:text-gray-700 cursor-pointer">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" />
                                    </svg>
                                </button>
                            </td>
                            <td class="py-2 align-top">
                                <button @click="moveDown(index)" type="button" class="inline-block mr-2 hover:bg-gray-200 ">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 p-1 text-gray-500 hover:text-gray-700 cursor-pointer">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
                                    </svg>

                                </button>
                            </td>
                            <td class="max-w-0 py-2 pr-2 text-sm sm:pl-0">
                                <div class="font-medium text-gray-900 truncate" x-text="item.description"></div>
                                <div>
                                    <div class="mt-1 truncate text-gray-500" x-text="`${item.amountvatincl} €`" id="amount" contenteditable="true"></div>
                                    <div class="mt-1 truncate text-gray-500" x-text="`${item.amountvatincl} €`"></div>
                                </div>
                            </td>
                            {{!-- <td class="align-top py-2 pr-2 text-sm font-light text-gray-700 whitespace-nowrap overflow-hidden overflow-ellipsis truncate" x-text="item.description"></td> --}}
                            <td class="hidden py-2 text-sm font-medium text-gray-500 whitespace-nowrap overflow-hidden overflow-ellipsis" x-text="item.quantity"></td>
                            <td class="hidden py-2 text-sm font-medium text-gray-500" x-text="item.unit_price"></td>
                            <td class="hidden py-2 text-sm align-top font-medium text-gray-500" x-text="`${item.reduction} ${item.reduction_unit}`"></td>
                            <td class="hidden sm:block align-top text-right py-2 text-sm font-medium text-gray-500" x-text="item.vat === '-1' ? 'NA' : `${item.vat} %`"></td>
                            <td class="hidden py-2 text-sm font-medium text-gray-500" x-text="item.amountvatexcl"></td>
                            <td class="hidden text-right align-top py-2 text-sm text-gray-500 truncate" x-text="`${item.amountvatincl} €`"></td>
                            <td class="py-2 pl-3 align-top">
                                <button @click.prevent="startEdit(index);" type="button" class="inline-block hover:bg-gray-200 ">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 p-1 text-gray-500 hover:text-gray-700 cursor-pointer">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                                    </svg>
                                </button>
                            </td>
                            <td class="py-2 pl-1 align-top">
                                <button @click="selectedDocument.config.items.splice(index, 1)" type="button" class="inline-block hover:bg-gray-200 " >
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 p-1 text-gray-500 hover:text-gray-700 cursor-pointer">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>
    </div>    

</div>    

