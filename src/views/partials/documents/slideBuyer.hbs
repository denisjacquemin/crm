                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
        </div>
    </div>
    <div class="col-span-full">
      <label for="buyer-city" class="block text-sm font-medium leading-6 text-gray-900">City</label>
        <div class="mt-2">
            <input type="text" x-model="selectedDocument.config.buyer.city" autocomplete="off"
                placeholder="City" id="buyer-city"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
        </div>
    </div>
    <div class="col-span-full">
      <label for="buyer-country" class="block text-sm font-medium leading-6 text-gray-900">Country</label>
        <div class="mt-2">
            <input type="text" x-model="selectedDocument.config.buyer.country" autocomplete="off"
                placeholder="Country" id="buyer-country"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
        </div>
    </div>
    <div class="col-span-full">
      <label for="buyer-vat" class="block text-sm font-medium leading-6 text-gray-900">VAT Number</label>
        <div class="mt-2">
            <input type="text" x-model="selectedDocument.config.buyer.vat_number" autocomplete="off"
                placeholder="VAT number" id="buyer-vat"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
        </div>
    </div>
    <div class="col-span-full">
      <label for="buyer-contact-name" class="block text-sm font-medium leading-6 text-gray-900">Contact Name</label>
        <div class="mt-2">
            <input type="text" x-model="selectedDocument.config.buyer.contact_name" autocomplete="off"
                placeholder="Contact Name" id="buyer-contact-name"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
        </div>
    <div class="col-span-full">
      <label for="buyer-phone" class="block text-sm font-medium leading-6 text-gray-900">Contact Phone</label>
        <div class="mt-2">
            <input type="text" x-model="selectedDocument.config.buyer.phone" autocomplete="off"
                placeholder="Phone number" id="buyer-phone"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
        </div>
    </div>
    <div class="col-span-full">
      <label for="buyer-email" class="block text-sm font-medium leading-6 text-gray-900">Contact Email</label>
        <div class="mt-2">
            <input type="text" x-model="selectedDocument.config.buyer.email" autocomplete="off"
                placeholder="buyer-email" id="buyer-email"
