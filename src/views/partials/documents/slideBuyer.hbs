
<div class="px-3 mt-5 grid grid-cols-2 gap-x-6 gap-y-2 sm:grid-cols-6">   
    <div class="col-span-full mb-6">
      <label for="buyer-name" class="block text-sm font-medium leading-6 text-gray-900">Find a Buyer (by name, address, city or VAT number)</label>
        <div class="mt-2"
            x-init="
            $watch('openSlide', value => { {{!-- not fired the first time the partial is called, but fired after when openSlide change   --}}
                if (value && slideContentPartialName == 'slideBuyer') {
                    console.log('openSlide in SlideBuyer');
                    init();
                }
            });"
            x-data="{
              choices: null,
              searchResults: [],
              searchAndUpdateChoices: null,
              init() {
                searchResults = [];
                if (!this.choices) {
                  console.log('init this.choices');
                  this.choices = new Choices(this.$refs.buyerSelect, {
                    choices: [],
                    allowHTML: false,
                    searchResultLimit: 20, // Limit the number of search results
                    searchFields: ['label', 'value'] // Define the fields to search
                  });
                  this.searchAndUpdateChoices = (searchTerm) => {
                    fetchUrl('/buyers/search?q=' + encodeURIComponent(searchTerm.trim() || '*'), 'GET' )
                      .then(data => {
                        this.searchResults = data;

                        // Clear previous choices
                        this.choices.clearChoices();
                        this.choices.setChoices(this.searchResults.map(result => ({
                          value: result._id, 
                          label: result.name, 
                          selected: false, 
                          disabled: false
                        })), 'value', 'label', false);
                        
                      })
                      .catch(error => {
                        console.error('Error searching for buyers', error);
                      });
                  }
                  // Add an event listener for the search event
                  this.$refs.buyerSelect.addEventListener('search', (event) => {
                    console.log('search event', event.detail.value);
                    // Call the search function with the current search value
                    this.searchAndUpdateChoices(event.detail.value);
                  });
                

                  // when a choice is selected, update the selectedDocument.config.buyer
                  this.$refs.buyerSelect.addEventListener('choice', (event) => {
                    // no need to search again, we already have the buyer details inm the search results
                    const selectedBuyer = this.searchResults.find(result => result._id === event.detail.choice.value);
                    selectedDocument.config.buyer.name = selectedBuyer.name;
                    selectedDocument.config.buyer.address1 = selectedBuyer.address1;
                    selectedDocument.config.buyer.address2 = selectedBuyer.address2;
                    selectedDocument.config.buyer.city = selectedBuyer.city;
                    selectedDocument.config.buyer.zip = selectedBuyer.zip;
                    selectedDocument.config.buyer.country = selectedBuyer.country;
                    selectedDocument.config.buyer.vat_number = selectedBuyer.vat_number;
                    selectedDocument.config.buyer.email = selectedBuyer.email;
                    selectedDocument.config.buyer.phone = selectedBuyer.phone;

                    // Clear the search results
                    // choices.clearChoices();

                    
                  });
                } 
              }
            }">
            <select x-ref="buyerSelect"></select>
        </div>
    </div>
    
    <div class="col-span-full">
      <label for="buyer-name" class="block text-sm font-medium leading-6 text-gray-900">Name</label>
      <div class="mt-2">
        <input type="text" x-model="selectedDocument.config.buyer.name" autocomplete="off"
              placeholder="Buyer's name" id="buyer-name"
              class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
      </div>
    </div>
    <div class="col-span-full">
      <label for="buyer-address" class="block text-sm font-medium leading-6 text-gray-900">Address</label>
        <div class="mt-2">
