<div
  class="flex h-full w-[200%]"
  x-data="{ 
    formBuyer: {},
    buyers: [],
    selectedBuyerIndex: null,
    searchTerm: '',
    translateDocument: false,
    showDeliveryAddress: false,

    resetForm() {
        this.formBuyer = {
            name: '',
            vat_number: '',
            address1: '',
            address2: '',
            city: '',
            zip: '',
            country: '',
            email: '',
            phone: '',
            language: '',
            contact_title: '',
            contact_firstname: '',
            contact_lastname: ''
        };
    },

    searchBuyers: async function() {
        await fetchUrl('/buyers/search?q=' + encodeURIComponent(this.searchTerm.trim() || '*'), 'GET')
            .then(data => {
                this.buyers = data;
            })
            .catch(error => {
                console.error('Error searching for buyers', error);
            });
    },

    chooseBuyer() {
        if (this.selectedBuyerIndex === null) {
            dispatch('notify', { 
                content: '{{ t 'documents.views.index.buyer_modal.no_buyer_selected' }}', 
                subcontent: '{{ t 'documents.views.index.buyer_modal.no_buyer_selected_sub' }}', 
                type: 'info' 
            });
            return;
        }
        const buyer = this.buyers[this.selectedBuyerIndex];
        selectedDocument.config.buyer = { ...buyer };
        if (this.translateDocument) {
            selectedDocument.config.language = buyer.language;
            dispatch('previewrefresh');
        }
        this.showBuyerForm();
    },

    showBuyerForm() {
        this.$refs.buyerForm.style.transform = 'translateX(0)';
        this.$refs.buyerSearch.style.transform = 'translateX(0)';
        this.updateButtonContent(`<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='lucide lucide-check'><path d='M20 6 9 17l-5-5'/></svg>{{ t 'documents.views.index.buyer_modal.back_button' }}`);
        this.updateClickHandler(() => {
            this.openSlide = false;
        });
    },

    showBuyerSearch() {
        this.$refs.buyerForm.style.transform = 'translateX(-100%)';
        this.$refs.buyerSearch.style.transform = 'translateX(-100%)';
        this.updateButtonContent(`<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='lucide lucide-check'><path d='M20 6 9 17l-5-5'/></svg>{{ t 'documents.views.index.buyer_modal.choose_and_back' }}`);
        this.updateClickHandler(() => {
            this.chooseBuyer();
        });
    },

    showBuyersList() {
        this.$refs.buyerForm.style.transform = 'translateX(0)';
        this.$refs.buyerSearch.style.transform = 'translateX(0)';
    }
}"
  x-init="
    resetForm();
    showBuyersList();
    $watch('searchTerm', () => { searchBuyers() });
"
  x-intersect="
    {{!-- Make sure buyerForm is shown when the slide opens --}}
    $refs.buyerForm.style.transitionDuration = '0s'
    $refs.buyerForm.style.transform = 'translateX(0)';
    $refs.buyerSearch.style.transitionDuration = '0s'
    $refs.buyerSearch.style.transform = 'translateX(0)';

    {{!-- Force reflow to apply the changes immediately --}}
    $refs.buyerForm.offsetHeight;
    $refs.buyerSearch.offsetHeight;

    {{!-- Restore the original transition duration after the reflow --}}
    $refs.buyerForm.style.transitionDuration = '500ms'
    $refs.buyerSearch.style.transitionDuration = '500ms'


    {{!-- Ensure the initial button is configured to close the slide when clicked --}}
    updateButtonContent(`<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='lucide lucide-check'><path d='M20 6 9 17l-5-5'/></svg>{{t 'documents.views.index.buyer_modal.back_button' }}`);
    updateClickHandler(() => {
        openSlide = false;
    });
"
>
  {{!-- Form Screen --}}
  <div
    x-ref="buyerForm"
    class="relative px-4 sm:px-6 w-1/2 h-full transition-transform duration-500 ease-in-out overflow-y-auto"
  >
    <div class="flex justify-end items-center">
      <button
        @click.prevent="showBuyerSearch"
        class="inline-flex items-center gap-x-2 my-2 rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.3-4.3" />
        </svg>
        {{t 'documents.views.index.buyer_modal.search_buyers' }}
      </button>
    </div>

    <div class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-6">
      {{!-- First Row: Country and VAT Number --}}
      <div class="grid grid-cols-2 gap-x-2 sm:col-span-6 sm:gap-x-5">
        <div class="col-span-1">
          <label for="buyer-country" class="block text-sm font-medium leading-6 text-gray-900">
            {{t 'documents.views.index.buyer_modal.form.country' }}
          </label>
          <select
            x-model="selectedDocument.config.buyer.country"
            id="buyer-country"
            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
          >
            <optgroup label="{{t 'users.views.signup2.frequently_selected_countries' }}">
              <template x-for="(countryCode, index) in frequentlySelectedCountries" :key="index">
                <option :value="countryCode" x-text="countries[countryCode].name"></option>
              </template>
            </optgroup>
            <optgroup label="{{t 'users.views.signup2.all_countries' }}">
              <template x-for="(country, index) in countries" :key="index">
                <option :value="country.value" x-text="country.name"></option>
              </template>
            </optgroup>
          </select>
        </div>

        <div class="col-span-1">
          <label for="buyer-vat" class="block text-sm font-medium leading-6 text-gray-900">
            {{t 'documents.views.index.buyer_modal.form.vat_number' }}
          </label>
          <input
            type="text"
            id="buyer-vat"
            x-model="selectedDocument.config.buyer.vat_number"
            placeholder="{{t 'documents.views.index.buyer_modal.form.vat_number_placeholder' }}"
            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
          />
        </div>
      </div>

      {{!-- Registration Number (conditional on country) --}}
      <template
        x-if="company_form_settings[selectedDocument.config.buyer.country]?.registration_number?.display"
      >
        <div class="sm:col-span-3">
          <label
            for="buyer-registration-number"
            class="block text-sm font-medium leading-6 text-gray-900"
            x-text="company_form_settings[selectedDocument.config.buyer.country]?.registration_number?.label"
          ></label>
          <div class="mt-2">
            <input
              type="text"
              id="buyer-registration-number"
              x-model="selectedDocument.config.buyer.registration_number"
              :placeholder="company_form_settings[selectedDocument.config.buyer.country]?.registration_number?.label"
              class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
            />
          </div>
        </div>
      </template>

      {{!-- Second Row: Name (full width) --}}
      <div class="sm:col-span-6">
        <div>
          <label for="buyer-name" class="block text-sm font-medium leading-6 text-gray-900">
            {{t 'documents.views.index.buyer_modal.form.name' }}
          </label>
          <input
            type="text"
            id="buyer-name"
            x-model="selectedDocument.config.buyer.name"
            placeholder="{{t 'documents.views.index.buyer_modal.form.name_placeholder' }}"
            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
          />
        </div>
      </div>

      {{!-- Third Row: Address1 and Address2 --}}
      <div class="sm:col-span-6">
        <div>
          <label for="buyer-address1" class="block text-sm font-medium leading-6 text-gray-900">
            {{t 'documents.views.index.buyer_modal.form.address1' }}
          </label>
          <input
            type="text"
            id="buyer-address1"
            x-model="selectedDocument.config.buyer.address1"
            placeholder="{{t 'documents.views.index.buyer_modal.form.address1_placeholder' }}"
            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
          />
          <input
            type="text"
            id="buyer-address2"
            x-model="selectedDocument.config.buyer.address2"
            placeholder="{{t 'documents.views.index.buyer_modal.form.address2_placeholder' }}"
            class="mt-2 block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
          />
        </div>
      </div>

      {{!-- Zip and City on same row --}}
      <div class="grid grid-cols-5 gap-x-2 sm:col-span-6 sm:gap-x-5">
        <div class="col-span-2">
          <label for="buyer-zip" class="block text-sm font-medium leading-6 text-gray-900">
            {{t 'documents.views.index.buyer_modal.form.zip' }}
          </label>
          <input
            type="text"
            id="buyer-zip"
            x-model="selectedDocument.config.buyer.zip"
            placeholder="{{t 'documents.views.index.buyer_modal.form.zip_placeholder' }}"
            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
          />
        </div>

        <div class="col-span-3">
          <label for="buyer-city" class="block text-sm font-medium leading-6 text-gray-900">
            {{t 'documents.views.index.buyer_modal.form.city' }}
          </label>
          <input
            type="text"
            id="buyer-city"
            x-model="selectedDocument.config.buyer.city"
            placeholder="{{t 'documents.views.index.buyer_modal.form.city_placeholder' }}"
            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
          />
        </div>
      </div>

      {{!-- Delivery Address Toggle --}}
      <div class="col-span-full bg-gray-50 p-4 rounded-lg">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-medium text-gray-900">
            {{t 'documents.views.index.buyer_modal.form.delivery_address' }}
          </h3>
          <button
            type="button"
            class="bg-gray-200 relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2"
            :class="{ 'bg-indigo-600': showDeliveryAddress, 'bg-gray-200': !showDeliveryAddress }"
            role="switch"
            @click="showDeliveryAddress = !showDeliveryAddress"
          >
            <span class="sr-only">Use delivery address</span>
            <span
              class="translate-x-0 pointer-events-none relative inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"
              :class="{ 'translate-x-5': showDeliveryAddress, 'translate-x-0': !showDeliveryAddress }"
            ></span>
          </button>
        </div>

        <div
          x-show="showDeliveryAddress"
          x-transition:enter="transition ease-out duration-300"
          x-transition:enter-start="opacity-0 transform scale-95"
          x-transition:enter-end="opacity-100 transform scale-100"
          x-transition:leave="transition ease-in duration-200"
          x-transition:leave-start="opacity-100 transform scale-100"
          x-transition:leave-end="opacity-0 transform scale-95"
          class="mt-4 space-y-4"
        >
          <div class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-6">
            <div class="col-span-full">
              <label for="delivery-name" class="block text-sm font-medium leading-6 text-gray-900">
                {{t 'documents.views.index.buyer_modal.form.delivery_name' }}
              </label>
              <input
                type="text"
                id="delivery-name"
                x-model="selectedDocument.config.buyer.delivery_name"
                placeholder="{{t 'documents.views.index.buyer_modal.form.delivery_name_placeholder' }}"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
              />
            </div>

            <div class="col-span-full">
              <label
                for="delivery-attention"
                class="block text-sm font-medium leading-6 text-gray-900"
              >
                {{t 'documents.views.index.buyer_modal.form.delivery_attention' }}
              </label>
              <input
                type="text"
                id="delivery-attention"
                x-model="selectedDocument.config.buyer.delivery_attention"
                placeholder="{{t 'documents.views.index.buyer_modal.form.delivery_attention_placeholder' }}"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
              />
            </div>

            <div class="col-span-full">
              <label
                for="delivery-address1"
                class="block text-sm font-medium leading-6 text-gray-900"
              >
                {{t 'documents.views.index.buyer_modal.form.delivery_address1' }}
              </label>
              <input
                type="text"
                id="delivery-address1"
                x-model="selectedDocument.config.buyer.delivery_address1"
                placeholder="{{t 'documents.views.index.buyer_modal.form.delivery_address1_placeholder' }}"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
              />
            </div>

            <div class="col-span-full">
              <label
                for="delivery-address2"
                class="block text-sm font-medium leading-6 text-gray-900"
              >
                {{t 'documents.views.index.buyer_modal.form.delivery_address2' }}
              </label>
              <input
                type="text"
                id="delivery-address2"
                x-model="selectedDocument.config.buyer.delivery_address2"
                placeholder="{{t 'documents.views.index.buyer_modal.form.delivery_address2_placeholder' }}"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
              />
            </div>

            <div class="sm:col-span-2">
              <label for="delivery-zip" class="block text-sm font-medium leading-6 text-gray-900">
                {{t 'documents.views.index.buyer_modal.form.delivery_zip' }}
              </label>
              <input
                type="text"
                id="delivery-zip"
                x-model="selectedDocument.config.buyer.delivery_zip"
                placeholder="{{t 'documents.views.index.buyer_modal.form.delivery_zip_placeholder' }}"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
              />
            </div>

            <div class="sm:col-span-2">
              <label for="delivery-city" class="block text-sm font-medium leading-6 text-gray-900">
                {{t 'documents.views.index.buyer_modal.form.delivery_city' }}
              </label>
              <input
                type="text"
                id="delivery-city"
                x-model="selectedDocument.config.buyer.delivery_city"
                placeholder="{{t 'documents.views.index.buyer_modal.form.delivery_city_placeholder' }}"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
              />
            </div>

            <div class="sm:col-span-2">
              <label
                for="delivery-country"
                class="block text-sm font-medium leading-6 text-gray-900"
              >
                {{t 'documents.views.index.buyer_modal.form.delivery_country' }}
              </label>
              <input
                type="text"
                id="delivery-country"
                x-model="selectedDocument.config.buyer.delivery_country"
                placeholder="{{t 'documents.views.index.buyer_modal.form.delivery_country_placeholder' }}"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
              />
            </div>

            <div class="sm:col-span-3">
              <label for="delivery-phone" class="block text-sm font-medium leading-6 text-gray-900">
                {{t 'documents.views.index.buyer_modal.form.delivery_phone' }}
              </label>
              <input
                type="text"
                id="delivery-phone"
                x-model="selectedDocument.config.buyer.delivery_phone"
                placeholder="{{t 'documents.views.index.buyer_modal.form.delivery_phone_placeholder' }}"
                class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
              />
            </div>
          </div>
        </div>
      </div>

      {{!-- Contact Info --}}
      <div class="grid grid-cols-5 gap-x-2 sm:col-span-6 sm:gap-x-5">
        <div class="col-span-1">
          <label
            for="buyer-contact-title"
            class="block text-sm font-medium leading-6 text-gray-900"
          >
            {{t 'documents.views.index.buyer_modal.form.contact_title' }}
          </label>
          <select
            x-model="selectedDocument.config.buyer.contact_title"
            id="buyer-contact-title"
            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
          >
            <option value="">{{t 'users.views.signup1.no_title' }}</option>
            <option value="mr">{{t "users.views.signup1.mr"}}</option>
            <option value="mrs">{{t "users.views.signup1.mrs"}}</option>
            <option value="ms">{{t "users.views.signup1.ms"}}</option>
            <option value="dr">{{t "users.views.signup1.dr"}}</option>
          </select>
        </div>

        <div class="col-span-2">
          <label
            for="buyer-contact-firstname"
            class="block text-sm font-medium leading-6 text-gray-900"
          >
            {{t 'documents.views.index.buyer_modal.form.contact_firstname' }}
          </label>
          <input
            type="text"
            id="buyer-contact-firstname"
            x-model="selectedDocument.config.buyer.contact_firstname"
            placeholder="{{t 'documents.views.index.buyer_modal.form.contact_firstname_placeholder' }}"
            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
          />
        </div>

        <div class="col-span-2">
          <label
            for="buyer-contact-lastname"
            class="block text-sm font-medium leading-6 text-gray-900"
          >
            {{t 'documents.views.index.buyer_modal.form.contact_lastname' }}
          </label>
          <input
            type="text"
            id="buyer-contact-lastname"
            x-model="selectedDocument.config.buyer.contact_lastname"
            placeholder="{{t 'documents.views.index.buyer_modal.form.contact_lastname_placeholder' }}"
            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
          />
        </div>
      </div>

      <div class="sm:col-span-3">
        <label for="buyer-email" class="block text-sm font-medium leading-6 text-gray-900">
          {{t 'documents.views.index.buyer_modal.form.email' }}
        </label>
        <input
          type="email"
          id="buyer-email"
          x-model="selectedDocument.config.buyer.email"
          placeholder="{{t 'documents.views.index.buyer_modal.form.email_placeholder' }}"
          class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
        />
      </div>

      <div class="sm:col-span-3">
        <label for="buyer-phone" class="block text-sm font-medium leading-6 text-gray-900">
          {{t 'documents.views.index.buyer_modal.form.phone' }}
        </label>
        <input
          type="text"
          id="buyer-phone"
          x-model="selectedDocument.config.buyer.phone"
          placeholder="{{t 'documents.views.index.buyer_modal.form.phone_placeholder' }}"
          class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
        />
      </div>

      <div class="sm:col-span-3">
        <label for="buyer-language" class="block text-sm font-medium leading-6 text-gray-900">
          {{t 'documents.views.index.buyer_modal.form.language' }}
        </label>
        <div class="mt-2">
          {{> language_dropdown id="buyer-language" value=selectedDocument.config.buyer.language
          onchange="selectedDocument.config.buyer.language = $event.target.value"}}
        </div>
      </div>
    </div>
  </div>

  {{!-- Search Screen --}}
  <div
    x-ref="buyerSearch"
    class="relative px-4 sm:px-6 w-1/2 h-full transition-transform duration-500 ease-in-out overflow-y-auto"
  >
    <div class="flex justify-between items-center">
      <div class="text-left">
        <button
          @click.prevent="showBuyerForm"
          class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-arrow-left"
          >
            <path d="m12 19-7-7 7-7" />
            <path d="M19 12H5" />
          </svg>
          {{t 'documents.views.index.buyer_modal.cancel' }}
        </button>
      </div>
      <div class="w-1/2 text-right text-sm">
        <span
          class="cursor-pointer text-indigo-500 text-sm inline-flex items-center"
          @click="loadModalContent('/buyers', {
                        title: '{{t 'nav.buyers_title' }}',
                        description: '{{t 'nav.buyers_description' }}'
                    })"
        >
          {{t 'documents.views.index.buyer_modal.manage_buyers' }}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-external-link ml-1"
          >
            <path d="M15 3h6v6" />
            <path d="M10 14 21 3" />
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          </svg>
        </span>
      </div>
    </div>

    <div
      x-intersect="searchBuyers(); selectedBuyerIndex = null; searchTerm = ''; setTimeout(() => document.getElementById('search-buyer').focus(), 500);"
    >
      <div class="flex items-center py-2">
        <input
          x-model.debounce.200ms="searchTerm"
          x-on:keydown.enter.prevent="searchBuyers()"
          type="text"
          id="search-buyer"
          class="block w-full rounded-md border-0 py-1.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm leading-6"
          placeholder="{{t 'documents.views.index.buyer_modal.search_placeholder' }}"
          autocomplete="off"
        />
        <svg
          @click="searchBuyers()"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="ml-2 sm:mx-2 h-5 w-5 cursor-pointer text-indigo-500 lucide lucide-rotate-cw"
        >
          <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" />
          <path d="M21 3v5h-5" />
        </svg>
      </div>

      <template x-if="buyers.length > 0">
        <div>
          <template x-for="(buyer, index) in buyers" :key="index">
            <label
              class="flex flex-1 items-center border-b sm:border-x p-4 -mx-4 sm:mx-0 focus:outline-none hover:bg-gray-100 hover:text-indigo-900 cursor-pointer"
              :class="{
                                'border-t sm:rounded-tl-md sm:rounded-tr-md': index === 0,
                                'sm:rounded-bl-md sm:rounded-br-md': index === buyers.length - 1,
                                'border-indigo-200 bg-indigo-50': selectedBuyerIndex === index,
                                'border-gray-900/10': selectedBuyerIndex !== index   
                            }"
            >
              <input
                @change="selectedBuyerIndex = index"
                name="chooseme"
                :checked="selectedBuyerIndex === index"
                type="radio"
                class="h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-600"
              />
              <div class="ml-4 flex flex-col min-w-0 flex-1">
                <div class="grid grid-cols-[1fr,auto] gap-x-2">
                  <div class="flex min-w-0 items-center">
                    <div
                      class="truncate text-sm font-semibold text-gray-900"
                      x-text="buyer.name"
                    ></div>
                    <div
                      class="flex-none text-xs text-indigo-600 ml-2"
                      x-text="buyer.vat_number"
                    ></div>
                  </div>
                  <div class="text-sm text-gray-600" x-text="buyer.city"></div>
                </div>
                <div class="flex gap-x-1 text-sm text-gray-600 overflow-hidden">
                  <span class="truncate" x-text="buyer.address1"></span>
                  <span class="truncate" x-text="buyer.address2"></span>
                  <span class="truncate" x-text="buyer.zip"></span>
                </div>
              </div>
            </label>
          </template>
        </div>
      </template>

      <template x-if="buyers.length === 0">
        <div
          class="relative block w-full h-full text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
        >
          <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="mx-auto h-12 w-12 text-gray-400"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"
              />
            </svg>
            <span class="mt-2 block text-md font-semibold text-gray-500">
              {{t 'documents.views.index.buyer_modal.no_buyer_selected' }}
            </span>
          </div>
        </div>
      </template>

      <div
        x-show="selectedBuyerIndex !== null && buyers[selectedBuyerIndex].language"
        class="mt-4 pt-4 border-t"
      >
        <label class="flex items-center">
          <input
            type="checkbox"
            x-model="translateDocument"
            @change="if($event.target.checked) {
                            selectedDocument.config.language = buyers[selectedBuyerIndex].language;
                            dispatch('previewrefresh');
                        }"
            class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
          />
          <span class="ml-2 text-sm text-gray-600">
            toto {{!-- {{t 'documents.views.index.buyer_modal.translate_document'
            selectedDocument.config.document_type buyers[selectedBuyerIndex].language}} --}}
          </span>
        </label>
      </div>
    </div>
  </div>
</div>
