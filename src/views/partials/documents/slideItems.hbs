
<div class="flex w-[200%] h-full overflow-hidden"
    x-data="{ 
        itemIndexEdited: -1,  
        formItem: {
            form_automatic_computation: true,
            reduction_unit: '%',
            vat: '21',
        },
        createNewItem: function() {

            this.resetFormItem();
            this.showItemForm();
        },
        startEdit: function(index) {
            this.resetFormItem();
            this.itemIndexEdited = index;
            const item = this.selectedDocument.config.items[index];
            this.formItem = {
                name: item.name,
                reference: item.reference,
                form_automatic_computation: item.form_automatic_computation,
                reduction_unit: item.reduction_unit,
                vat: item.vat,
            }
            document.getElementById('item-quantity').value = item.quantity;
            document.getElementById('item-unit-price').value = item.unit_price;
            document.getElementById('item-reduction').value = item.reduction;
            this.description = item.description;
            this.name = item.name;
            this.reference = item.reference;
            this.amountvatexcl = this.formatNumber(parseFloat(item.amountvatexcl));
            this.amountvat = this.formatNumber(parseFloat(item.amountvat));
            this.amountvatincl = this.formatNumber(parseFloat(item.amountvatincl));
            this.showItemForm();
        },
        resetFormItem: function() {
            // reset input elem item-quantity to empty value
            document.getElementById('item-quantity').value = '';
            document.getElementById('item-unit-price').value = '';
            document.getElementById('item-reduction').value = '';
            this.formItem = {
                name: '',
                reference: '',
                description: '',
                quantity: '1',
                unit_price: '0.0',
                reduction: '0',
                reduction_unit: '%',
                vat: '21',
                amountvatexcl: this.formatNumber(0.0),
                amountvat: this.formatNumber(0.0),
                amountvatincl: this.formatNumber(0.0),
                form_automatic_computation: true,
            }
            this.itemIndexEdited = -1;
            this.description = '';
            this.name = '';
            this.reference = '';
            this.amountvatexcl = this.formatNumber(0.0);
            this.amountvat = this.formatNumber(0.0);
            this.amountvatincl = this.formatNumber(0.0);
        },
        saveItem: function() {
            const newItem = {
                name: this.formItem.name,
                reference: this.formItem.reference,
                description: this.description,
                quantity: String(this.formItem.quantity || '1'),
                unit_price: String(this.formItem.unit_price || '0.0'),
                reduction: String(this.formItem.reduction || '0'),
                reduction_unit: this.formItem.reduction_unit,
                vat: String(this.formItem.vat),
                amountvatexcl: this.amountvatexcl,
                amountvat: this.amountvat,
                amountvatincl: this.amountvatincl,
                form_automatic_computation: this.formItem.form_automatic_computation,
            }
            if (this.itemIndexEdited===-1) {
                this.selectedDocument.config.items.push(newItem);
            } else {
                this.selectedDocument.config.items[this.itemIndexEdited] = newItem;
            }
            this.computeInvoiceAmounts();
            this.showItemsList();
        },
        computeInvoiceAmounts: function() {
            let totalAmountVatExcl = 0.0;
            let totalAmountVat = 0.0;
            let totalAmountVatIncl = 0.0;
            this.selectedDocument.config.items.forEach(item => {
                totalAmountVatExcl += this.stringToFloat(item.amountvatexcl);
                totalAmountVat += this.stringToFloat(item.amountvat);
                totalAmountVatIncl += this.stringToFloat(item.amountvatincl);
            });
            this.selectedDocument.config.amounts.subtotal = this.formatNumber(totalAmountVatExcl);
            this.selectedDocument.config.amounts.totalvat = this.formatNumber(totalAmountVat);
            this.selectedDocument.config.amounts.total = this.formatNumber(totalAmountVatIncl);
            console.log('in computeInvoiceAmounts', this.selectedDocument.config.amounts.subtotal, this.selectedDocument.config.amounts.totalvat, this.selectedDocument.config.amounts.total);
        },
        deleteItem: function(index) {
            console.log('before deleteItem in ', index);
            this.selectedDocument.config.items.splice(index, 1);
            this.selectedDocument.config.items.forEach((item, idx) => {
                console.log('set order ', idx);

                item.order = idx;
            });
            this.computeInvoiceAmounts();
        },
        moveUp(index) {
            if (index > 0) {
                let item = this.selectedDocument.config.items.splice(index, 1)[0];
                this.selectedDocument.config.items.splice(index - 1, 0, item);
                this.selectedDocument.config.items[index].order = index;
                this.selectedDocument.config.items[index - 1].order = index - 1;
            }
        },
        moveDown(index) {
            if (index < this.selectedDocument.config.items.length - 1) {
                let item = this.selectedDocument.config.items.splice(index, 1)[0];
                this.selectedDocument.config.items.splice(index + 1, 0, item);
                this.selectedDocument.config.items[index].order = index;
                this.selectedDocument.config.items[index + 1].order = index + 1;
            }
        },
        showItemForm: function() {
            this.$refs.itemsList.style.transform = 'translateX(-100%)';
            this.$refs.itemForm.style.transform = 'translateX(-100%)';
        },
        showItemsList: function() {
            this.$refs.itemsList.style.transform = 'translateX(0)';
            this.$refs.itemForm.style.transform = 'translateX(0)';
        },
        description: '',
        amountvatexcl: function() {
            return this.formatNumber(0.0);
        },
        amountvat: function() {
            return this.formatNumber(0.0);
        },
        amountvatincl: function() {
            return this.formatNumber(0.0);
        },
        stringToFloat: function(value) {
            if (!value) {
                return null;
            }
            return parseFloat(value.replace(',', '.').replaceAll(' ', '').replaceAll('\u202F', ''));
        },
        formatNumber: function(amount) {
            const formatter = new Intl.NumberFormat('fr-FR', {
                useGrouping: true,
                style: 'decimal',
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
            {{!-- replace non-breaking spaces by spaces --}}
            return formatter.format(amount).replace(',', '.').replaceAll('\u202F', ' '); 
        },
        computeAmounts: function() {
            const quantity = this.stringToFloat(this.formItem.quantity) || 1;
            const unitPrice = this.stringToFloat(this.formItem.unit_price)  || 0;
            const reduction = this.stringToFloat(this.formItem.reduction) || 0;
            const reductionUnit = this.formItem.reduction_unit;

            const vat = this.stringToFloat(this.formItem.vat) || 0;
            const vatRate = vat === -1 ? 0 : vat;
            let vatExcl = 0.0;
            if (reductionUnit === '%') {
                vatExcl = quantity * unitPrice * (1 - reduction / 100);
            } else {
                vatExcl = quantity * unitPrice - reduction;
            }
            const vatAmount = vatExcl * vatRate / 100;
            const vatIncl = vatExcl + vatAmount;
            this.amountvatexcl = this.formatNumber(vatExcl.toFixed(2));
            this.amountvat = this.formatNumber(vatAmount.toFixed(2));
            this.amountvatincl = this.formatNumber(vatIncl.toFixed(2));
        },



        searchProductTerm: '',
        selectedIndex: -1,
        products: [],
        eventListenersAdded: false,
        selectNextProduct: function() {
        if (this.products.length === 0) return;
            this.selectedIndex = (this.selectedIndex + 1) % this.products.length;
        },
        selectPreviousProduct: function() {
            if (this.products.length === 0) return;
            this.selectedIndex = (this.selectedIndex - 1 + this.products.length) % this.products.length;
        },
        clearSelection: function() {
            this.selectedIndex = -1;
        },
        select() {
            if (this.selectedIndex >= 0 && this.selectedIndex < this.products.length) {
                const selectedProduct = this.products[this.selectedIndex];
                this.description = selectedProduct.description;
                this.formItem.name = selectedProduct.name;
                this.formItem.reference = selectedProduct.reference;
                document.getElementById('item-unit-price').value = selectedProduct.unit_price;
                document.getElementById('item-quantity').value   = 1;
                this.formItem.vat = selectedProduct.vat;
                {{!-- this.computeAmounts(); --}}
                this.clearSelection();
                this.products = [];
            }
        },
        searchProducts: async function() {
            this.clearSelection();
            if (this.searchProductTerm.trim().length > 0) {
                try {
                    this.products = await fetchUrl('/products/search?q=' + encodeURIComponent(this.searchProductTerm.trim() || '*'), 'GET')
                } catch (error) {
                    console.error('Error fetching products', error);
                }
            } else {
                this.products = [];
            }
        },
        handleKeydown: function(event) {

            if (this.products.length === 0) return;
            switch (event.key) {
                case 'ArrowDown':
                    event.preventDefault();
                    event.stopPropagation();
                    this.selectNextProduct();
                    break;
                case 'ArrowUp':
                    event.preventDefault();
                    event.stopPropagation();
                    this.selectPreviousProduct();
                    break;
                case 'Escape':
                    event.preventDefault();
                    event.stopPropagation();
                    this.products = [];
                    this.clearSelection();
                    break;
                case 'Enter':
                    event.preventDefault();
                    event.stopPropagation();
                    this.select();
                    break;
            }
        },
    }"
    x-init="
        $watch('formItem', value => computeAmounts());

        handleKeydown = handleKeydown.bind($data);

        $watch('searchProductTerm', () => { searchProducts() });
        $watch('products', () => { 
            if (products.length > 0 && !eventListenersAdded) {
                {{!-- handle keyboard navigation/interactions when suggestions are availables --}}
                document.addEventListener('keydown', handleKeydown); 
                eventListenersAdded = true;
            } else if (products.length === 0 && eventListenersAdded) {
                document.removeEventListener('keydown', handleKeydown);
                eventListenersAdded = false;
            }
        });
    "
>
    <div x-ref="itemsList" class="px-3 w-[50%] h-full transition-transform duration-500 ease-in-out">
        
        <div class="grid gap-x-6 gap-y-2">
            <div class="text-right">
                <button @click.prevent="createNewItem" class="inline-flex items-center gap-x-2 my-2 w-full sm:w-auto rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    {{t 'documents.views.index.items_modal.new_item' }}
                </button>
            </div>
            <template x-if="selectedDocument.config.items.length === 0">
                <div class="relative block w-full h-full text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
                        <svg xmlns="http://www.w3.org/2000/svg"  viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mx-auto h-12 w-12 text-gray-400 lucide lucide-list-minus"><path d="M11 12H3"/><path d="M16 6H3"/><path d="M16 18H3"/><path d="M21 12h-6"/></svg>
                        <span class="mt-2 block text-md font-semibold text-gray-500">{{t 'documents.views.index.items_modal.no_items' }}</span>
                    </div>
                </div>
            </template>
            <template x-if="selectedDocument.config.items.length > 0">
                <div>
                    <table class="divide-y divide-gray-300">
                        <thead >
                            <tr>
                                <th></th>
                                <th></th>
                                <th scope="col" class="py-3.5 pl-4 pr-3 w-2/3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide" width="auto">
                                    <div>Description</div>
                                    <div>Amount VAT Incl.</div>
                                </th>
                                <th scope="col" class="hidden sm:block py-3.5 pl-4 pr-3 w-1/3 text-xs font-medium text-right text-gray-500 uppercase tracking-wide w-auto">Amount VAT Incl.</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-300">
                            <template x-for="(item, index) in selectedDocument.config.items" :key="index">
                            <tr class="even:bg-gray-50 cursor-pointer">
                                <td class="align-middle" width="24px">
                                    <template x-if="index !== 0">
                                        <button @click="moveUp(index)" type="button" class="inline-block hover:bg-gray-200 ">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 p-1 text-gray-500 hover:text-gray-700 cursor-pointer">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" />
                                            </svg>
                                        </button>
                                    </template>
                                </td>
                                <td class="align-middle" width="24px">
                                    <template x-if="index !== selectedDocument.config.items.length -1 && selectedDocument.config.items.length > 1">
                                        <button @click="moveDown(index)" type="button" class="inline-block sm:mr-2 hover:bg-gray-200 ">
                                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 p-1 text-gray-500 hover:text-gray-700 cursor-pointer">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
                                            </svg>
                                        </button>
                                    </template>
                                </td>
                                <td @click.prevent="startEdit(index);" class="pl-1 pr-1 py-3     sm:pl-4 sm:pr-3 sm:hover:underline sm:hover:cursor-pointer text-sm font-light text-gray-700 align-top" width="100%">
                                    <span class="text-sm font-semibold leading-6 text-gray-900" x-text="item.name"></span>
                                    <span class="text-xs text-indigo-600" x-text="item.reference"></span>
                                    <p class="text-sm font-semibold leading-6 text-gray-900">
                                        <div x-text="item.description" class="line-clamp-2"></div>
                                    </p>
                                    <p x-text="`${item.amountvatincl} €`" class="sm:hidden mt-1 flex text-xs leading-5 truncate text-gray-500"></p>
                                    
                                    <div class="hidden line-clamp-3" x-text="item.description"></div>
                                </td>
                                <td x-text="`${item.amountvatincl} €`" class="hidden sm:block text-right text-sm text-gray-500 truncate align-top"></td>
                                <td class="align-middle" width="24px">
                                    <button @click="deleteItem(index)" type="button" class="inline-block hover:bg-gray-200 sm:mr-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 p-1 text-gray-500 hover:text-gray-700 cursor-pointer">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                            </template>
                        </tbody>
                    </table>
                    {{> documents/amounts }}
                </div>
            </template>
        </div>
    </div>
    <div x-ref="itemForm" class="relative px-3 w-[50%] h-full transition-transform duration-500 ease-in-out">
        <div class="flex justify-between items-center">
            <div class="text-left">
                <button @click.prevent="showItemsList" class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                     <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
                     {{t 'documents.views.index.items_modal.cancel' }}
                </button>
            </div>
            <div class="text-right">
                <button x-html="'{{t 'documents.views.index.items_modal.save_new_item' }}'" @click.prevent="saveItem" class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check"><path d="M20 6 9 17l-5-5"/></svg>
                </button>
            </div>
        </div>
        <div class=" grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-6">
            <div class="flex items-center py-2 sm:col-span-6">
                <input type="checkbox" id="automatic-computation" class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" 
                    x-model="formItem.form_automatic_computation"
                />&nbsp;<label for="automatic-computation" class="text-sm font-light text-gray-500">{{t 'documents.views.index.items_modal.automatic_validation' }}</label>

            </div>

            <div class="grid grid-cols-5 gap-x-2 sm:col-span-6 sm:gap-x-5">
                <div class="col-span-3">
                    <label for="item-name" class="block text-sm font-medium leading-6 text-gray-900">{{t 'documents.views.index.items_modal.name_label' }}</label>
                    <input type="text" id="item-name" autocomplete="off"
                            x-model="formItem.name"
                            placeholder="{{t 'documents.views.index.items_modal.name_placeholder' }}"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                            @input.debounce.200ms="searchProductTerm = $event.target.value"
                            @blur="products = []; clearSelection();"
                            @keydown.arrow-down.prevent="if (products.length === 0) {searchProducts(); selectNextProduct();}"
                            @keydown.enter.prevent="if (products.length === 0) {searchProducts(); selectNextProduct();}"
                            >

                </div>
                <div class="col-span-2">
                    <label for="item-reference" class="block text-sm font-medium leading-6 text-gray-900">{{t 'documents.views.index.items_modal.reference_label' }}</label>
                    <input  type="text" id="item-reference" autocomplete="off"
                            x-model="formItem.reference"
                            placeholder="{{t 'documents.views.index.items_modal.reference_placeholder' }}"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
                            @input.debounce.200ms="searchProductTerm = $event.target.value"
                            @blur="products = []; clearSelection();"
                            @keydown.arrow-down.prevent="if (products.length === 0) {searchProducts(); selectNextProduct();}"
                            @keydown.enter.prevent="if (products.length === 0) {searchProducts(); selectNextProduct();}"
                            >
                </div> 
                
            </div>
            
            <div class="sm:col-span-6">
                <label for="item-description" class="block text-sm font-medium leading-6 text-gray-900">{{t 'documents.views.index.items_modal.description_label' }}</label>
                <input type="text" x-model="description" id="item-description" autocomplete="off"
                    placeholder="{{t 'documents.views.index.items_modal.description_placeholder' }}"
                    @input.debounce.200ms="searchProductTerm = $event.target.value"
                    @blur="products = []; clearSelection();"
                    @keydown.arrow-down.prevent="if (products.length === 0) {searchProducts(); selectNextProduct();}"
                    @keydown.enter.prevent="if (products.length === 0) {searchProducts(); selectNextProduct();}"
                    class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
