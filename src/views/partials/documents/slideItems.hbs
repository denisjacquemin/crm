<div class="flex h-full w-[300%]" x-data="{ 
        itemIndexEdited: -1,  
        formItem: { vat: JSON.stringify({ value: '', label: ''}) },
        createNewItem: function() {
            this.resetFormItem();
            this.showItemForm();
            console.log('createNewItem', this.formItem);
        },
        startEdit: function(index) {
            this.resetFormItem();
            this.itemIndexEdited = index;
            const item = this.selectedDocument.config.items[index];
            this.formItem = {
                name: item.name,
                reference: item.reference,
                description: item.description,
                quantity: item.quantity,
                unit_price: item.unit_price,
                reduction: item.reduction,
                reduction_unit: item.reduction_unit,
                vat: typeof item.vat === 'object' ? JSON.stringify(item.vat) : item.vat,
                custom_vat_rate: item.custom_vat_rate,
                form_automatic_computation: item.form_automatic_computation,
                amountvatexcl: item.amountvatexcl,
                amountvat: item.amountvat,
                amountvatincl: item.amountvatincl,
            }
            document.getElementById('item-quantity').value = item.quantity;
            document.getElementById('item-unit-price').value = item.unit_price;
            document.getElementById('item-reduction').value = item.reduction;
            this.description = item.description;
            this.name = item.name;
            this.reference = item.reference;
            this.amountvatexcl = this.formatNumber(parseFloat(item.amountvatexcl));
            this.amountvat = this.formatNumber(parseFloat(item.amountvat));
            this.amountvatincl = this.formatNumber(parseFloat(item.amountvatincl));
            this.showItemForm();
        },
        resetFormItem: function() {
            // reset input elem item-quantity to empty value
            document.getElementById('item-quantity').value = '';
            document.getElementById('item-unit-price').value = '';
            document.getElementById('item-reduction').value = '';
            const taxrates = this.countries[this.current_company.country].taxrates.concat(this.custom_taxrates);
            const default_vat = taxrates.find(rate => rate._id === this.default_taxrate);
            this.formItem = {
                name: '',
                reference: '',
                description: '',
                quantity: '1',
                unit_price: '0.0',
                reduction: '0',
                reduction_unit: '%',
                vat: JSON.stringify(default_vat),
                custom_vat_rate: false,
                form_automatic_computation: true,
                amountvatexcl: this.formatNumber(0.0),
                amountvat: this.formatNumber(0.0),
                amountvatincl: this.formatNumber(0.0),
            }
            this.itemIndexEdited = -1;
            this.description = '';
            this.name = '';
            this.reference = '';
            this.amountvatexcl = this.formatNumber(0.0);
            this.amountvat = this.formatNumber(0.0);
            this.amountvatincl = this.formatNumber(0.0);
        },
        saveItem: function() {
            const newItem = {
                name: this.formItem.name,
                reference: this.formItem.reference,
                description: this.formItem.description,
                quantity: String(this.formItem.quantity || '1'),
                unit_price: String(this.formItem.unit_price || '0.0'),
                reduction: String(this.formItem.reduction || '0'),
                reduction_unit: this.formItem.reduction_unit,
                vat: this.formItem.vat,
                custom_vat_rate: this.formItem.custom_vat_rate,
                form_automatic_computation: this.formItem.form_automatic_computation,
                amountvatexcl: this.formItem.amountvatexcl,
                amountvat: this.formItem.amountvat,
                amountvatincl: this.formItem.amountvatincl,
            }
            if (this.itemIndexEdited===-1) {
                this.selectedDocument.config.items.unshift(newItem);
            } else {
                this.selectedDocument.config.items[this.itemIndexEdited] = newItem;
            }
            this.computeInvoiceAmounts();
            this.showItemsList();
        },
        chooseProduct: async function(){
            if (this.selectedProductIndex === null) {
                dispatch('notify', { 
                    content: '{{ t 'documents.views.index.items_modal.no_product_selected' }}', 
                    subcontent: '{{ t 'documents.views.index.items_modal.no_product_selected_sub' }}', 
                    type: 'info' 
                });
                return;
            }
            this.resetFormItem();
            {{!-- const data = await fetchUrl(`/products/editAjax/${this.products[this.selectedProductIndex].slug}`, 'GET');
            console.log('data.product', data.product); --}}
            console.log('this.products[this.selectedProductIndex]', this.products[this.selectedProductIndex]);
            const taxrates = this.countries[this.current_company.country].taxrates.concat(this.custom_taxrates);
            let full_vat = { value: '', label: '' };
            if (this.products[this.selectedProductIndex].custom_vat_rate.is_custom) {
                full_vat = {
                    value: this.products[this.selectedProductIndex].custom_vat_rate.value,
                    label: this.products[this.selectedProductIndex].custom_vat_rate.label
                }
            } else {
                full_vat = taxrates.find(rate => rate._id === this.products[this.selectedProductIndex].vat);
                if (!full_vat) {
                    full_vat = { value: '', label: '' };
                }
            }
            Object.assign(this.formItem, { 
                name: this.products[this.selectedProductIndex].name, 
                description: this.products[this.selectedProductIndex].description, 
                reference: this.products[this.selectedProductIndex].reference, 
                unit_price: this.products[this.selectedProductIndex].unit_price, 
                vat: JSON.stringify(full_vat),
                custom_vat_rate: !this.countries[this.current_company.country].taxrates.includes(this.products[this.selectedProductIndex].vat)

            });
            document.getElementById('item-quantity').value = this.formItem.quantity;
            document.getElementById('item-unit-price').value = this.formItem.unit_price;
            document.getElementById('item-reduction').value = this.formItem.reduction;
            this.description = this.formItem.description;
            this.name = this.formItem.name;
            this.reference = this.formItem.reference;
            this.amountvatexcl = this.formatNumber(parseFloat(this.formItem.amountvatexcl));
            this.amountvat = this.formatNumber(parseFloat(this.formItem.amountvat));
            this.amountvatincl = this.formatNumber(parseFloat(this.formItem.amountvatincl)); 
            this.computeAmounts();
            this.showItemForm();
        },
        computeInvoiceAmounts: function() {
            {{!-- dispatch('notify', { 
                content: 'computeInvoiceAmounts', 
                type: 'info' 
            }); --}}
            let totalAmountVatExcl = 0.0;
            let totalAmountVat = 0.0;
            let totalAmountVatIncl = 0.0;
            this.selectedDocument.config.items.forEach(item => {
                totalAmountVatExcl += this.stringToFloat(item.amountvatexcl);
                totalAmountVat += this.stringToFloat(item.amountvat);
                totalAmountVatIncl += this.stringToFloat(item.amountvatincl);
            });
            this.selectedDocument.config.amounts.subtotal = this.formatNumber(totalAmountVatExcl);
            this.selectedDocument.config.amounts.totalvat = this.formatNumber(totalAmountVat);
            this.selectedDocument.config.amounts.total = this.formatNumber(totalAmountVatIncl);
            console.log('in computeInvoiceAmounts', this.selectedDocument.config.amounts.subtotal, this.selectedDocument.config.amounts.totalvat, this.selectedDocument.config.amounts.total);
        },
        deleteItem: function(index) {
            this.selectedDocument.config.items.splice(index, 1);
            this.selectedDocument.config.items.forEach((item, idx) => {
                item.order = idx;
            });
            this.computeInvoiceAmounts();
            dispatch('notify', { 
                content: '{{ t 'documents.views.index.items_modal.item_deleted' }}', 
                type: 'success' 
            });
        },
        moveUp(index) {
            if (index > 0) {
                let item = this.selectedDocument.config.items.splice(index, 1)[0];
                this.selectedDocument.config.items.splice(index - 1, 0, item);
                this.selectedDocument.config.items[index].order = index;
                this.selectedDocument.config.items[index - 1].order = index - 1;
            }
        },
        moveDown(index) {
            if (index < this.selectedDocument.config.items.length - 1) {
                let item = this.selectedDocument.config.items.splice(index, 1)[0];
                this.selectedDocument.config.items.splice(index + 1, 0, item);
                this.selectedDocument.config.items[index].order = index;
                this.selectedDocument.config.items[index + 1].order = index + 1;
            }
        },
        showItemForm: function() {
            this.$refs.itemsList.style.transform = 'translateX(-100%)';
            this.$refs.itemForm.style.transform = 'translateX(-100%)';
            this.$refs.itemSearch.style.transform = 'translateX(-100%)';
            this.updateButtonContent(`{{t 'documents.views.index.items_modal.save_new_item' }}`);
            this.updateClickHandler(() => {
                this.saveItem();
            });
        },
        showItemsList: function() {
            this.$refs.itemsList.style.transform = 'translateX(0)';
            this.$refs.itemForm.style.transform = 'translateX(0)';
            this.$refs.itemSearch.style.transform = 'translateX(0)';
            this.updateButtonContent(`<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='lucide lucide-check'><path d='M20 6 9 17l-5-5'/></svg>{{t 'documents.views.index.items_modal.back_button' }}`);
            this.updateClickHandler(() => {
                this.openSlide = false;
            });
        },
        showSearchProducts: function() {
            this.$refs.itemsList.style.transform = 'translateX(-200%)';
            this.$refs.itemForm.style.transform = 'translateX(-200%)';
            this.$refs.itemSearch.style.transform = 'translateX(-200%)';
            this.updateButtonContent(`<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='lucide lucide-check'><path d='M20 6 9 17l-5-5'/></svg>{{t 'documents.views.index.items_modal.choose_and_back' }}`);
            this.updateClickHandler(() => {
                this.chooseProduct();
            });
        },
        description: '',
        amountvatexcl: function() {
            return this.formatNumber(0.0);
        },
        amountvat: function() {
            return this.formatNumber(0.0);
        },
        amountvatincl: function() {
            return this.formatNumber(0.0);
        },
        stringToFloat: function(value) {
            if (!value) {
                return null;
            }
            return parseFloat(String(value).replace(',', '.').replaceAll(' ', '').replaceAll('\u202F', ''));
        },
        formatNumber: function(amount) {
            const formatter = new Intl.NumberFormat('fr-FR', {
                useGrouping: true,
                style: 'decimal',
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
            {{!-- replace non-breaking spaces by spaces --}}
            return formatter.format(amount).replace(',', '.').replaceAll('\u202F', ' '); 
        },
        computeAmounts: function() {
            {{!-- dispatch('notify', { 
                content: 'computeAmounts', 
                type: 'info' 
            }); --}}
            const quantity = this.stringToFloat(this.formItem.quantity) || 1;
            const unitPrice = this.stringToFloat(this.formItem.unit_price)  || 0;
            const reduction = this.stringToFloat(this.formItem.reduction) || 0;
            console.log('quantity', quantity, 'unitPrice', unitPrice, 'reduction', reduction);
            const reductionUnit = this.formItem.reduction_unit;
            const vat = this.stringToFloat(JSON.parse(this.formItem.vat).value) || 0;
            console.log('vat', vat);
            const vatRate = vat === -1 ? 0 : vat;
            let vatExcl = 0.0;
            if (reductionUnit === '%') {
                vatExcl = quantity * unitPrice * (1 - reduction / 100);
            } else {
                vatExcl = quantity * unitPrice - reduction;
            }
            const vatAmount = vatExcl * vatRate / 100;
            const vatIncl = vatExcl + vatAmount;
            this.formItem.amountvatexcl = this.formatNumber(vatExcl.toFixed(2));
            this.formItem.amountvat = this.formatNumber(vatAmount.toFixed(2));
            this.formItem.amountvatincl = this.formatNumber(vatIncl.toFixed(2));
        },
        searchProductTerm: '',
        selectedIndex: -1,
        products: [],
        eventListenersAdded: false,
        selectNextProduct: function() {
        if (this.products.length === 0) return;
            this.selectedIndex = (this.selectedIndex + 1) % this.products.length;
        },
        selectPreviousProduct: function() {
            if (this.products.length === 0) return;
            this.selectedIndex = (this.selectedIndex - 1 + this.products.length) % this.products.length;
        },
        clearSelection: function() {
            this.selectedIndex = -1;
        },
        select() {
            if (this.selectedIndex >= 0 && this.selectedIndex < this.products.length) {
                console.log('selected product', this.selectedIndex, this.products[this.selectedIndex]);
                const selectedProduct = this.products[this.selectedIndex];
                this.description = selectedProduct.description;
                this.formItem.name = selectedProduct.name;
                this.formItem.reference = selectedProduct.reference;
                document.getElementById('item-unit-price').value = selectedProduct.unit_price;
                document.getElementById('item-quantity').value   = 1;
                this.formItem.vat = selectedProduct.vat;
                {{!-- this.computeAmounts(); --}}
                this.clearSelection();
                this.products = [];
            }
        },
        searchProductTerm: '',
        selectedProductIndex: null,
        sortBy: 'createdAtdesc',
        searchProduct: async function() {
            selectedProductIndex = null;
            const sortByParam = this.sortBy ? '&sort=' + encodeURIComponent(this.sortBy) : '';
            await fetchUrl('/products/search?q=' + encodeURIComponent(this.searchProductTerm.trim() || '*') + sortByParam, 'GET')
                .then(data => {
                    this.products = data;
                })
                .catch(error => {
                    console.error('Error searching for products', error);
                });
        }
    }" x-init="
        {{!-- $watch(['formItem.quantity', 'formItem.reduction'], value => computeAmounts()); --}}
        {{!-- $watch('formItem.quantity', value => amountsTobeComputed = true);
        $watch('formItem.reduction', value => amountsTobeComputed = true);
        $watch('formItem.reduction_unit', value => amountsTobeComputed = true);
        $watch('formItem.unit_price', value => amountsTobeComputed = true);
        $watch('formItem.vat', value => amountsTobeComputed = true); --}}

        $watch('searchProductTerm', () => { searchProduct() });
    " x-intersect="
       {{!-- Make sure itemsList is shown when the items slide open  --}}
       $refs.itemsList.style.transitionDuration = '0s'
       $refs.itemsList.style.transform = 'translateX(0)';
       $refs.itemForm.style.transitionDuration = '0s'
       $refs.itemForm.style.transform = 'translateX(0)';
       $refs.itemSearch.style.transitionDuration = '0s'
       $refs.itemSearch.style.transform = 'translateX(0)';

       {{!-- Force reflow to apply the changes immediately --}}
       $refs.itemsList.offsetHeight;
       $refs.itemForm.offsetHeight;
       $refs.itemSearch.offsetHeight;

       {{!-- Restore the original transition duration after the reflow --}}
       $refs.itemsList.style.transitionDuration = '500ms'
       $refs.itemForm.style.transitionDuration = '500ms'
       $refs.itemSearch.style.transitionDuration = '500ms'

       {{!-- Ensure the initial button is configured to close the slide when clicked --}}
       updateButtonContent(`<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' class='lucide lucide-check'><path d='M20 6 9 17l-5-5'/></svg>{{t 'documents.views.index.items_modal.back_button' }}`);
       updateClickHandler(() => {
          openSlide = false;
       });
    "
    @searchproducts.window="searchProduct()"
    >
    <div x-ref="itemsList"
        class="px-4 sm:px-6 w-1/3 h-full transition-transform duration-500 ease-in-out overflow-y-auto">

        <div class="grid">
            <div class="text-right">
                <button @click.prevent="createNewItem"
                    class="inline-flex items-center gap-x-2 my-2 w-full sm:w-auto rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="lucide lucide-plus">
                        <path d="M5 12h14" />
                        <path d="M12 5v14" />
                    </svg>
                    {{t 'documents.views.index.items_modal.new_item' }}
                </button>
            </div>
            <template x-if="selectedDocument.config.items.length === 0">
                <div
                    class="relative block w-full h-full text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            class="mx-auto h-12 w-12 text-gray-400 lucide lucide-list-minus">
                            <path d="M11 12H3" />
                            <path d="M16 6H3" />
                            <path d="M16 18H3" />
                            <path d="M21 12h-6" />
                        </svg>
                        <span class="mt-2 block text-md font-semibold text-gray-500">{{t
                            'documents.views.index.items_modal.no_items' }}</span>
                    </div>
                </div>
            </template>
            <template x-if="selectedDocument.config.items.length > 0">
                <div x-data="{ isScrollable: false }" 
                     x-init="() => {
                            const updateScrollable = () => {
                                const container = $refs.scrollContainer;
                                isScrollable = container.scrollHeight > container.clientHeight;
                            };
                            setTimeout(() => {
                                const container = $refs.scrollContainer;
                                updateScrollable();

                                const resizeObserver = new ResizeObserver(updateScrollable);
                                resizeObserver.observe(container);

                                // Observe changes in the content as well
                                const contentObserver = new MutationObserver(updateScrollable);
                                contentObserver.observe(container, { childList: true, subtree: true });
                            }, 0);
                        }"
                    class="relative -mx-4 sm:mx-0">
                    <div x-ref="scrollContainer" class="max-h-[400px] h-auto overflow-y-auto">
                        <template x-for="(item, index) in selectedDocument.config.items" :key="index">
                            <div class="items-center border-b sm:border-x border-gray-900/10 grid grid-cols-[auto,1fr,auto]  hover:bg-gray-100 hover:text-indigo-900 cursor-pointer p-2 sm:pr-5"
                                :class="{
                                        'border-t sm:rounded-tl-md sm:rounded-tr-md': index === 0,
                                        'sm:rounded-bl-md sm:rounded-br-md': index === selectedDocument.config.items.length - 1,
                                    }">
                                <div class="">
                                    <button @click.prevent.stop="moveUp(index)" type="button"
                                        class="inline-block p-1 hover:bg-gray-200"
                                        :class="{'invisible': index === 0 || selectedDocument.config.items.length <= 1}">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                            stroke-width="1.5" stroke="currentColor"
                                            class="h-4 w-4 text-gray-500 hover:text-gray-700 cursor-pointer">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" />
                                        </svg>
                                    </button>
                                    <button @click.prevent.stop="moveDown(index)" type="button"
                                        class="inline-block p-1 mr-1 sm:mr-2 hover:bg-gray-200 cursor-pointer"
                                        :class="{'invisible': index === selectedDocument.config.items.length - 1 || selectedDocument.config.items.length <= 1}">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                            stroke-width="1.5" stroke="currentColor"
                                            class="h-4 w-4 text-gray-500 hover:text-gray-700 cursor-pointer">
                                            <path stroke-linecap="round" stroke-linejoin="round"
                                                d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
                                        </svg>
                                    </button>
                                </div>

                                <div @click.prevent="startEdit(index);" class="grid">
                                    <div class="flex min-w-0 items-center">
                                        <div x-text="item.name"
                                            class="flex-initial pr-2 truncate text-sm font-semibold leading-6 text-gray-900">
                                        </div>
                                        <div x-text="item.reference"
                                            class="flex-none max-w-[100px] truncate text-xs text-indigo-600 pr-1"></div>
                                    </div>
                                    <div x-text="item.description" class="truncate text-sm leading-6 text-gray-900 "></div>
                                    <div class="mt-2 flex text-sm">
                                        <a @click.prevent="startEdit(index)" href="#"
                                            class="pr-2 text-indigo-600 hover:text-indigo-500 hover:underline">{{t
                                            'documents.views.index.files_modal.edit' }}</a>
                                        <div class="border-l"></div>
                                        <a @click.prevent.stop="if (confirm('{{t 'documents.views.index.items_modal.confirm_item_delete' }}')) deleteItem(index)"
                                            href="#" class="px-2 text-indigo-600 hover:text-indigo-500 hover:underline">{{t
                                            'documents.views.index.files_modal.delete' }}</a>
                                    </div>
                                </div>
                                <div class="pl-2 flex flex-col text-right">
                                    <div class="text-xs" x-text="`${selectedDocument.config.currency.symbol} ${item.amountvatexcl}`"></div>
                                    <div class="text-sm font-semibold leading-9" x-text="`${selectedDocument.config.currency.symbol} ${item.amountvatincl}`"></div>
                                </div>
                            </div>
                            {{!-- <div class="flex flex-1 items-center border-y sm:border p-4 -mx-4 sm:mx-0 focus:outline-none"
                                :class="{
                                                    'sm:rounded-tl-md sm:rounded-tr-md': index === 0,
                                                    'sm:rounded-bl-md sm:rounded-br-md': index === selectedDocument.config.items.length - 1                                          
                                        }">
                                <input name="chooseme" type="radio"
                                    class="h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-600" />
                                <div class="ml-4 flex flex-col min-w-0 flex-1">
                                    <div class="flex-1 truncate text-sm font-semibold text-gray-900" x-text="item.name">
                                    </div>
                                    <div class="flex-1 flex min-w-0 gap-2">
                                        <span class="truncate text-sm font-semibold text-gray-600"
                                            x-text="item.description"></span>
                                    </div>
                                </div>
                            </div> --}}
                        </template>

                    </div>
                    
                    <div x-show="isScrollable" class="absolute bottom-0 left-0 right-0 h-3 bg-gradient-to-t from-gray-200 to-transparent pointer-events-none sm:mr-4"></div>
                </div>
            </template>
             <template x-if="selectedDocument.config.items.length > 0">
                <div class="-mx-4 sm:mx-0 mt-5 flex flex-col space-y-2 text-sm  leading-6">
                    <div class="flex">
                        <div class="flex-1 flex-grow text-right font-semibold">{{t 'documents.views.index.files_modal.total_base_amount'}}</div>
                        <div class="flex-1 flex-grow text-right pr-2" x-text="`${selectedDocument.config.currency.symbol} ${selectedDocument.config.amounts.subtotal}`"></div>
                    </div>
                    <div class="flex">
                        <div class="flex-1 flex-grow text-right font-semibold">{{t 'documents.views.index.files_modal.total_vat_amount'}}</div>
                        <div class="flex-1 flex-grow text-right pr-2" x-text="`${selectedDocument.config.currency.symbol} ${selectedDocument.config.amounts.totalvat}`"></div>
                    </div>
                    <div class="flex">
                        <div class="flex-1 flex-grow text-right font-semibold">{{t 'documents.views.index.files_modal.total_amount'}}</div>
                        <div class="flex-1 flex-grow text-right pr-2" x-text="`${selectedDocument.config.currency.symbol} ${selectedDocument.config.amounts.total}`"></div>
                    </div>
                </div>
                <div
                    class="mt-4 mb-5 pt-4 col-span-full grid grid-cols-4 text-sm font-light text-gray-700 gap-y-2 border-t border-gray-200">
                    <div class="font-semibold text-gray-900 col-start-1 col-span-2 text-right">Total Base Amount
                    </div>
                    <div class="col-span-2 sm:col-start-4 sm:col-span-1 text-right"
                        x-text="selectedDocument.config.amounts.subtotal"></div>
                    <div class="font-semibold text-gray-900 col-start-1 col-span-2  text-right">Total Vat Amount
                    </div>
                    <div class="col-span-2 sm:col-start-4 sm:col-span-1 text-right"
                        x-text="selectedDocument.config.amounts.totalvat"></div>
                    <div class="font-semibold text-gray-900 col-start-1 col-span-2  text-right">Total Amount</div>
                    <div class="col-span-2 sm:col-start-4 sm:col-span-1 text-right font-normal"
                        x-text="selectedDocument.config.amounts.total"></div>
                </div>
             </template>
        </div>
    </div>
    <div x-ref="itemForm"
        class="relative px-4 sm:px-6 w-1/3 h-full transition-transform duration-500 ease-in-out overflow-y-auto">
        <div class="flex justify-between items-center">
            <div class="text-left">
                <button @click.prevent="showItemsList"
                    class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="lucide lucide-arrow-left">
                        <path d="m12 19-7-7 7-7" />
                        <path d="M19 12H5" />
                    </svg>
                    {{t 'documents.views.index.items_modal.cancel' }}
                </button>
            </div>
            <div class="text-right">
                <button x-html="'{{t 'documents.views.index.items_modal.search_products' }}'"
                    @click.prevent="showSearchProducts"
                    class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="lucide lucide-check">
                        <path d="M20 6 9 17l-5-5" />
                    </svg>
                </button>
            </div>
        </div>
        <div class=" grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-6">
            <div class="flex items-center py-2 sm:col-span-6">
                <input type="checkbox" id="automatic-computation"
                    class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
                    x-model="formItem.form_automatic_computation" />&nbsp;<label for="automatic-computation"
                    class="text-sm font-light text-gray-500">{{t
                    'documents.views.index.items_modal.automatic_validation' }}</label>

            </div>

            <div class="grid grid-cols-5 gap-x-2 sm:col-span-6 sm:gap-x-5">
                <div class="col-span-3">
                    <label for="item-name" class="block text-sm font-medium leading-6 text-gray-900">{{t
                        'documents.views.index.items_modal.name_label' }}</label>
                    <input type="text" id="item-name" autocomplete="off" x-model="formItem.name"
                        placeholder="{{t 'documents.views.index.items_modal.name_placeholder' }}"
                        class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">

                </div>
                <div class="col-span-2">
                    <label for="item-reference" class="block text-sm font-medium leading-6 text-gray-900">{{t
                        'documents.views.index.items_modal.reference_label' }}</label>
                    <input type="text" id="item-reference" autocomplete="off" x-model="formItem.reference"
                        placeholder="{{t 'documents.views.index.items_modal.reference_placeholder' }}"
                        class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                </div>
            </div>

            <div class="sm:col-span-6">
                <div>
                    <label for="item-description" class="block text-sm font-medium leading-6 text-gray-900">{{t
                        'documents.views.index.items_modal.description_label' }}</label>
                    <input type="text" id="item-description" autocomplete="off" x-model="formItem.description"
                        placeholder="{{t 'documents.views.index.items_modal.description_placeholder' }}"
                        class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-x-2 sm:col-span-6 sm:gap-x-5">
                <div class="col-span-1">
                    <label for="item-quantity" class="text-right block text-sm font-medium leading-6 text-gray-900">{{t
                        'documents.views.index.items_modal.quantity' }}</label>
                    <input type="text" id="item-quantity" autocomplete="off"
                        x-mask:dynamic="formItem.form_automatic_computation ? $money($input.replace(',', '.'), '.', ' ', 2) : $input"
                        x-on:input="formItem.quantity = $event.target.value; computeAmounts()"
                        x-bind:placeholder="formItem.form_automatic_computation ? '0' : ''"
                        class="block w-full rounded-md border-0 py-1.5 text-gray-900 text-right shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                </div>
                <div class="col-span-1">
                    <label for="item-unit-price"
                        class="text-right block text-sm font-medium leading-6 text-gray-900">{{t
                        'documents.views.index.items_modal.unit_price' }}</label>
                    <input type="text" id="item-unit-price" autocomplete="off"
                        x-mask:dynamic="formItem.form_automatic_computation ? $money($input.replace(',', '.'), '.', ' ', 2) : $input"
                        x-on:input="formItem.unit_price = $event.target.value; computeAmounts()"
                        x-bind:placeholder="formItem.form_automatic_computation ? '0.00' : ''"
                        class="block w-full rounded-md border-0 py-1.5 text-gray-900 text-right shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                </div>

            </div>

            <div class="grid grid-cols-1 gap-y-4 sm:grid-cols-2 sm:col-span-6 sm:gap-x-5">
                <div>
                    <label for="item-reduction" class="block text-sm font-medium leading-6 text-gray-900">{{t
                        'documents.views.index.items_modal.reduction' }}</label>
                    <div class="flex items-center">
                        <input type="text" id="item-reduction" autocomplete="off"
                            x-mask:dynamic="formItem.form_automatic_computation ? $money($input.replace(',', '.'), '.', ' ', 2) : $input"
                            x-on:input="formItem.reduction = $event.target.value; computeAmounts()"
                            x-bind:placeholder="formItem.form_automatic_computation ? (formItem.reduction_unit === '%' ? '0' : `0.00`) : ''"
                            class="block w-full rounded-md border-0 py-1.5 text-right text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                        <select x-model="formItem.reduction_unit"
                            x-on:change="computeAmounts()"
                            class="block ml-2 w-24 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                            <option value="%">%</option>
                            <option value="EUR" x-text="selectedDocument.config.currency.label"></option>
                        </select>
                    </div>
                </div>
                {{> documents/rates_select}}
            </div>

            <div class="grid grid-cols-1 gap-y-4 sm:col-span-3 sm:col-start-4">
                <div>
                    <label for="item-amount-vatexcl"
                        class="text-right block text-sm font-medium leading-6 text-gray-900">Base Amount</label>
                    <input type="text" autocomplete="off" id="item-amount-vatexcl"
                        x-model="formItem.amountvatexcl"
                        x-bind:readonly="formItem.form_automatic_computation" placeholder="0.00"
                        class="placeholder:text-gray-300"
                        x-bind:class="!formItem.form_automatic_computation ? 'block w-full rounded-md py-1.5 border-0 text-right text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300  focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6' : 'block w-full text-right text-gray-900 truncate pl-2 sm:text-sm sm:leading-6 md:text-lg bg-transparent border-0 focus:ring-0'">
                </div>
                <div>
                    <label for="item-amount-vat"
                        class="text-right block text-sm font-medium leading-6 text-gray-900">VAT Amount</label>
                    <input type="text" autocomplete="off" id="item-amount-vat" placeholder="0.00"
                        class="placeholder:text-gray-300" x-model="formItem.amountvat"
                        x-bind:class="!formItem.form_automatic_computation ? 'block w-full rounded-md py-1.5 border-0 text-right text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6' : 'block w-full text-right text-gray-900 truncate pl-2 sm:text-sm sm:leading-6 md:text-lg bg-transparent border-0 focus:ring-0'">
                </div>
                <div>
                    <label for="item-amountvatincl"
                        class="text-right block text-sm font-medium leading-6 text-gray-900">Total Amount</label>
                    <input type="text" autocomplete="off" id="item-amountvatincl" placeholder="0.00"
                        class="placeholder:text-gray-300" x-model="formItem.amountvatincl"
                        x-bind:readonly="formItem.form_automatic_computation"
                        x-bind:class="!formItem.form_automatic_computation ? 'block w-full rounded-md py-1.5 border-0 text-right text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6' : 'block w-full text-right text-gray-900 truncate pl-2 sm:text-sm sm:leading-6 md:text-lg bg-transparent border-0 focus:ring-0'">
                </div>
            </div>
        </div>
    </div>
    <div x-ref="itemSearch"
        class="relative px-4 sm:px-6 w-1/3 h-full transition-transform duration-500 ease-in-out overflow-y-auto">
        <div class="flex justify-between items-center">
            <div class="text-left">
                <button @click.prevent="showItemForm"
                    class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="lucide lucide-arrow-left">
                        <path d="m12 19-7-7 7-7" />
                        <path d="M19 12H5" />
                    </svg>
                    {{t 'documents.views.index.items_modal.cancel' }}
                </button>
            </div>
            <div class="w-1/2 text-right text-sm ">
                <span class="cursor-pointer text-indigo-500 text-sm inline-flex items-center "
                    @click="loadModalContent('/products', {
                        title: '{{t 'nav.products_title' }}',
                        description: '{{t 'nav.products_description' }}'
                    })">
                    {{t 'documents.views.index.items_modal.manage_products' }}
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="lucide lucide-external-link ml-1">
                        <path d="M15 3h6v6" />
                        <path d="M10 14 21 3" />
                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    </svg>
                </span>
            </div>
        </div>
        <div
            x-intersect="searchProduct(); selectedProductIndex = null; searchProductTerm = ''; setTimeout(() => document.getElementById('search-product').focus(), 500);">
            <div class="flex items-center py-2">
                <input x-model.debounce.200ms="searchProductTerm" x-on:keydown.enter.prevent="searchProduct()"
                    type="text" id="search-product"
                    class="block w-full rounded-md border-0 py-1.5 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 text-sm leading-6"
                    placeholder="{{t 'documents.views.index.items_modal.search_placeholder' }}" autocomplete="off">
                <svg @click="searchProduct()" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" 
                     class="ml-2 sm:mx-2 h-5 w-5 cursor-pointer text-indigo-500  lucide lucide-rotate-cw"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
            </div>
            <template x-if="products.length > 0">
                <div>
                    <template x-for="(product, index) in products" :key="index">
                        <label
                            class="flex flex-1 items-center border-b sm:border-x p-4 -mx-4 sm:mx-0 focus:outline-none hover:bg-gray-100 hover:text-indigo-900 cursor-pointer"
                            :class="{
                                        'border-t sm:rounded-tl-md sm:rounded-tr-md': index === 0,
                                        'sm:rounded-bl-md sm:rounded-br-md': index === products.length - 1,
                                        'border-indigo-200 bg-indigo-50': selectedProductIndex === index,
                                        'border-gray-900/10': selectedProductIndex !== index   
                            }">
                            <input @change="selectedProductIndex = index" name="chooseme"
                                :checked="selectedProductIndex === index" type="radio"
                                class="h-4 w-4 border-gray-300 text-indigo-600 focus:ring-indigo-600" />
                            <div class="ml-4 flex flex-col min-w-0 flex-1">
                                <div :class="{'text-indigo-700': selectedProductIndex === index, 'text-gray-900': selectedProductIndex !== index}"
                                    class="flex-1 truncate text-sm font-semibold text-gray-900" x-text="product.name">
                                </div>
                                <div class="flex-1 flex min-w-0 gap-2">
                                    <span class="truncate text-sm font-semibold text-gray-600"
                                        x-text="product.description"></span>
                                </div>
                            </div>
                        </label>
                    </template>
                </div>
            </template>
            <template x-if="products.length === 0">
                <div
                    class="relative block w-full h-full text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
                            stroke="currentColor" class="mx-auto h-12 w-12 text-gray-400">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                        </svg>
                        <span class="mt-2 block text-md font-semibold text-gray-500">
                            {{t 'products.views.index.no_product_found' }}
                            <a @click.prevent="loadModalContent('/products', {
                                title: '{{t 'nav.products_title' }}',
                                description: '{{t 'nav.products_description' }}'
                            })" class="cursor-pointer text-indigo-500 text-sm inline-flex items-center ">{{t 'products.views.index.create_new_product_now' }}</a>
                        </span>
                    </div>
                </div>
            </template>
        </div>
    </div>
</div>