<div class="flex w-[200%] h-full overflow-hidden"
    x-data="{ 
        itemIndexEdited: -1,  
        formItem: {
            form_automatic_computation: true,
            reduction_unit: '%',
            vat: '21',
        },
        createNewItem: function() {
            this.resetFormItem();
            this.showItemForm();
        },
        startEdit: function(index) {
            this.resetFormItem();
            this.itemIndexEdited = index;
            const item = selectedDocument.config.items[index];
            this.formItem = {
                form_automatic_computation: item.form_automatic_computation,
                reduction_unit: item.reduction_unit,
                vat: item.vat,
            }
            document.getElementById('item-quantity').value = item.quantity;
            document.getElementById('item-unit-price').value = item.unit_price;
            document.getElementById('item-reduction').value = item.reduction;
            this.description = item.description;
            this.amountvatexcl = this.formatNumber(parseFloat(item.amountvatexcl));
            this.amountvat = this.formatNumber(parseFloat(item.amountvat));
            this.amountvatincl = this.formatNumber(parseFloat(item.amountvatincl));
            this.showItemForm();
        },
        resetFormItem: function() {
            // reset input elem item-quantity to empty value
            document.getElementById('item-quantity').value = '';
            document.getElementById('item-unit-price').value = '';
            document.getElementById('item-reduction').value = '';
            this.formItem = {
                description: '',
                quantity: '1',
                unit_price: '0.0',
                reduction: '0',
                reduction_unit: '%',
                vat: '21',
                amountvatexcl: this.formatNumber(0.0),
                amountvat: this.formatNumber(0.0),
                amountvatincl: this.formatNumber(0.0),
                form_automatic_computation: true,
            }
            this.itemIndexEdited = -1;
            this.description = '';
            this.amountvatexcl = this.formatNumber(0.0);
            this.amountvat = this.formatNumber(0.0);
            this.amountvatincl = this.formatNumber(0.0);
        },
        saveItem: function() {
            const newItem = {
                description: this.description,
                quantity: String(this.formItem.quantity || '1'),
                unit_price: String(this.formItem.unit_price || '0.0'),
                reduction: String(this.formItem.reduction || '0'),
                reduction_unit: this.formItem.reduction_unit,
                vat: String(this.formItem.vat),
                amountvatexcl: this.amountvatexcl,
                amountvat: this.amountvat,
                amountvatincl: this.amountvatincl,
                form_automatic_computation: this.formItem.form_automatic_computation,
            }
            if (this.itemIndexEdited===-1) {
                selectedDocument.config.items.push(newItem);
            } else {
                selectedDocument.config.items[this.itemIndexEdited] = newItem;
            }
            this.computeInvoiceAmounts();
            this.showItemsList();
        },
        computeInvoiceAmounts: function() {
            let totalAmountVatExcl = 0.0;
            let totalAmountVat = 0.0;
            let totalAmountVatIncl = 0.0;
            selectedDocument.config.items.forEach(item => {
                totalAmountVatExcl += this.stringToFloat(item.amountvatexcl);
                totalAmountVat += this.stringToFloat(item.amountvat);
                totalAmountVatIncl += this.stringToFloat(item.amountvatincl);
                console.log('in computeInvoiceAmounts', totalAmountVatExcl, totalAmountVat, totalAmountVatIncl);
            });
            selectedDocument.config.amounts.subtotal = this.formatNumber(totalAmountVatExcl);
            selectedDocument.config.amounts.totalvat = this.formatNumber(totalAmountVat);
            selectedDocument.config.amounts.total = this.formatNumber(totalAmountVatIncl);
            console.log('in computeInvoiceAmounts', selectedDocument.config.amountvatexcl, selectedDocument.config.amountvat, selectedDocument.config.amountvatincl);
        },
        deleteItem: function(index) {
            this.selectedDocument.config.items.splice(index, 1);
            this.selectedDocument.config.items.forEach((item, index) => {
                item.order = index;
            });
            this.computeInvoiceAmounts();
        },
        moveUp(index) {
            if (index > 0) {
                let item = this.selectedDocument.config.items.splice(index, 1)[0];
                this.selectedDocument.config.items.splice(index - 1, 0, item);
                this.selectedDocument.config.items[index].order = index;
                this.selectedDocument.config.items[index - 1].order = index - 1;
            }
        },
        moveDown(index) {
            if (index < this.selectedDocument.config.items.length - 1) {
                let item = this.selectedDocument.config.items.splice(index, 1)[0];
                this.selectedDocument.config.items.splice(index + 1, 0, item);
                this.selectedDocument.config.items[index].order = index;
                this.selectedDocument.config.items[index + 1].order = index + 1;
            }
        },
        showItemForm: function() {
            this.$refs.itemsList.style.transform = 'translateX(-100%)';
            this.$refs.itemForm.style.transform = 'translateX(-100%)';
        },
        showItemsList: function() {
            this.$refs.itemsList.style.transform = 'translateX(0)';
            this.$refs.itemForm.style.transform = 'translateX(0)';
        },
        description: '',
        amountvatexcl: function() {
            return this.formatNumber(0.0);
        },
        amountvat: function() {
            return this.formatNumber(0.0);
        },
        amountvatincl: function() {
            return this.formatNumber(0.0);
        },
        stringToFloat: function(value) {
            if (!value) {
                return null;
            }
            return parseFloat(value.replace(',', '.').replaceAll(' ', '').replaceAll('\u202F', ''));
        },
        formatNumber: function(amount) {
            const formatter = new Intl.NumberFormat('fr-FR', {
                useGrouping: true,
                style: 'decimal',
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
            {{!-- replace non-breaking spaces by spaces --}}
            return formatter.format(amount).replace(',', '.').replaceAll('\u202F', ' '); 
        },
        computeAmounts: function() {
            const quantity = this.stringToFloat(this.formItem.quantity) || 1;
            const unitPrice = this.stringToFloat(this.formItem.unit_price)  || 0;
            const reduction = this.stringToFloat(this.formItem.reduction) || 0;
            const reductionUnit = this.formItem.reduction_unit;

            const vat = this.stringToFloat(this.formItem.vat) || 0;
            const vatRate = vat === -1 ? 0 : vat;
            let vatExcl = 0.0;
            if (reductionUnit === '%') {
                vatExcl = quantity * unitPrice * (1 - reduction / 100);
            } else {
                vatExcl = quantity * unitPrice - reduction;
            }
            const vatAmount = vatExcl * vatRate / 100;
            const vatIncl = vatExcl + vatAmount;
            this.amountvatexcl = this.formatNumber(vatExcl.toFixed(2));
            this.amountvat = this.formatNumber(vatAmount.toFixed(2));
            this.amountvatincl = this.formatNumber(vatIncl.toFixed(2));
        },
    }"
    x-init="$watch('formItem', value => computeAmounts());"
>
    <div x-ref="itemsList" class="px-3 w-[50%] h-full transition-transform duration-500 ease-in-out">
        <div class="flex justify-between items-center">
            <div class="text-left">
                <button @click.prevent="openSlide = false" class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                    </svg> Close
                </button>
            </div>
            <div class="text-right">
                <button @click.prevent="createNewItem" class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                    <svg class="-ml-0.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M9 9V6a1 1 0 012 0v3h3a1 1 0 010 2h-3v3a1 1 0 01-2 0V11H6a1 1 0 010-2h3z" clip-rule="evenodd" />
                    </svg> Create New Item
                </button>
            </div>
        </div>
        
        <div class="mt-5 grid gap-x-6 gap-y-2">
            <template x-if="selectedDocument.config.items.length === 0">
                <div class="relative block w-full h-full p-2 text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="mx-auto h-12 w-12 text-gray-400">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                        </svg>
                        <span class="mt-2 block text-md font-semibold text-gray-500">No item yet</span>
                    </div>
                </div>
            </template>
            <template x-if="selectedDocument.config.items.length > 0">
            <div>
            <table class="divide-y divide-gray-300">
                <thead >
                    <tr>
                        <th></th>
                        <th></th>
                        <th class="hidden sm:block"></th>
                        <th scope="col" class="py-3.5 pl-4 pr-3 w-2/3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide" width="auto">
                            <div>Description</div>
                            <div>Amount VAT Incl.</div>
                        </th>
                        <th scope="col" class="hidden sm:block py-3.5 pl-4 pr-3 w-1/3 text-xs font-medium text-right text-gray-500 uppercase tracking-wide w-auto">Amount VAT Incl.</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-300">
                    <template x-for="(item, index) in selectedDocument.config.items" :key="index">
                    <tr class="even:bg-gray-50 cursor-pointer">
                        <td class="py-4 align-top" width="24px">
                            <template x-if="index !== 0">
                                <button @click="moveUp(index)" type="button" class="inline-block hover:bg-gray-200 ">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 p-1 text-gray-500 hover:text-gray-700 cursor-pointer">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" />
                                    </svg>
                                </button>
                            </template>
                        </td>
                        <td class="py-4 align-top" width="24px">
                            <template x-if="index !== selectedDocument.config.items.length -1 && selectedDocument.config.items.length > 1">
                            <button @click="moveDown(index)" type="button" class="inline-block sm:mr-2 hover:bg-gray-200 ">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 p-1 text-gray-500 hover:text-gray-700 cursor-pointer">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
                                </svg>
                            </button>
                            </template>
                        </td>
                        <td class="hidden sm:block py-4 align-top" width="24px">
                            <button @click.prevent="startEdit(index);" type="button" class="inline-block hover:bg-gray-200 ">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 p-1 text-gray-500 hover:text-gray-700 cursor-pointer">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                                </svg>
                            </button>
                        </td>
                        <td @click.prevent="startEdit(index);" class="pl-1 pr-1 py-4 sm:pl-4 sm:pr-3 sm:hover:underline sm:hover:cursor-pointer text-sm font-light text-gray-700 align-top" width="100%">
                            <p class="text-sm font-semibold leading-6 text-gray-900">
                                <div x-text="item.description" class="line-clamp-2"></div>
                            </p>
                            <p x-text="`${item.amountvatincl} €`" class="sm:hidden mt-1 flex text-xs leading-5 truncate text-gray-500"></p>
                            
                            <div class="hidden line-clamp-3" x-text="item.description"></div>
                        </td>
                        <td x-text="`${item.amountvatincl} €`" class="hidden sm:block text-right my-4 py-4pl-4 pr-3 text-sm text-gray-500 truncate align-top"></td>
                        <td class="py-4 pl-1 align-top" width="24px">
                            <button @click="deleteItem(index)" type="button" class="inline-block hover:bg-gray-200 sm:mr-2">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-6 w-6 p-1 text-gray-500 hover:text-gray-700 cursor-pointer">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                                </svg>
                            </button>
                        </td>
                    </tr>
                    </template>
                </tbody>
            </table>
            {{> documents/amounts }}
            </div>
            </template>
        </div>
    </div>
    <div x-ref="itemForm" class="px-3 w-[50%] h-full transition-transform duration-500 ease-in-out">
        <div class="flex justify-between items-center">
            <div class="text-left">
                <button @click.prevent="showItemsList" class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
                    </svg> Cancel
                </button>
            </div>
            <div class="text-right">
                <button @click.prevent="saveItem" class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                    </svg> Save and back to the list
                </button>
            </div>
        </div>
        <div class=" grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-6">
            <div class="flex items-center py-2 sm:col-span-6">
                <input type="checkbox" id="automatic-computation" class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600" 
                    x-model="formItem.form_automatic_computation"
                />&nbsp;<label for="automatic-computation" class="text-sm font-light text-gray-500">Automatic validations and computations</label>

            </div>
            
            <div class="sm:col-span-6">
                <label for="item-description" class="block text-sm font-medium leading-6 text-gray-900">Item Description</label>
                <input id="x" type="hidden" name="content">
                {{!-- <trix-editor input="x"></trix-editor> --}}
                <input type="text" x-model="description" id="item-description" autocomplete="off"
                    class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
            </div>
            <div class="grid grid-cols-2 gap-x-2 sm:col-span-6 sm:gap-x-5">
                <div class="col-span-1">
                    <label for="item-quantity" class="text-right block text-sm font-medium leading-6 text-gray-900">Quantity</label>
                    <input type="text" id="item-quantity" autocomplete="off"
                            x-mask:dynamic="formItem.form_automatic_computation ? $money($input.replace(',', '.'), '.', ' ', 2) : $input"
                            x-on:input="formItem.quantity = $event.target.value"
                            x-bind:placeholder="formItem.form_automatic_computation ? '0' : ''"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 text-right shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                </div>
                <div class="col-span-1">
                    <label for="item-unit-price" class="text-right block text-sm font-medium leading-6 text-gray-900">Unit Price</label>
                    <input  type="text" id="item-unit-price" autocomplete="off"
                            x-mask:dynamic="formItem.form_automatic_computation ? $money($input.replace(',', '.'), '.', ' ', 2) : $input"
                            x-on:input="formItem.unit_price = $event.target.value"
                            x-bind:placeholder="formItem.form_automatic_computation ? '0.00' : ''"
                            class="block w-full rounded-md border-0 py-1.5 text-gray-900 text-right shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                </div> 
                
            </div>

            <div class="grid grid-cols-1 gap-y-4 sm:grid-cols-2 sm:col-span-6 sm:gap-x-5">
                <div>
                    <label for="item-reduction"
                        class="block text-sm font-medium leading-6 text-gray-900">Reduction</label>
                    <div class="flex items-center">
                        <input  type="text" id="item-reduction" autocomplete="off"
                                x-mask:dynamic="formItem.form_automatic_computation ? $money($input.replace(',', '.'), '.', ' ', 2) : $input"
                                x-on:input="formItem.reduction = $event.target.value"
                                x-bind:placeholder="formItem.form_automatic_computation ? (formItem.reduction_unit === '%' ? '0' : `0.00`) : ''"     
                                class="block w-full rounded-md border-0 py-1.5 text-right text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                        <select x-model="formItem.reduction_unit"
                            class="block ml-2 w-24 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                            <option value="%">%</option>
                            <option value="EUR">EUR</option>
                        </select>
                    </div>
                </div>
                <div>
                    <div class="col-span-1 md:col-span-2">
                        <label for="item-vat" class="text-right block w-full text-sm font-medium leading-6 text-gray-900">VAT Rate</label>
                        <select x-model="formItem.vat" id="item-vat"
                            class="block  w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                            <option value="-1">Not applicable</option>
                            <option value="0">0%</option>
                            <option value="6">6%</option>
                            <option value="20">20%</option>
                            <option value="21">21%</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-y-4 sm:col-span-3 sm:col-start-4">
                <div>
                    <label for="item-amount-vatexcl" class="text-right block text-sm font-medium leading-6 text-gray-900">Base Amount</label>
                    <input type="text" autocomplete="off" id="item-amount-vatexcl"
                        x-model="selectedDocument.config.amountvatexcl"
                        x-bind:readonly="formItem.form_automatic_computation"
                        placeholder="0.00" class="placeholder:text-gray-300"
                        x-bind:class="!formItem.form_automatic_computation ? 'block w-full rounded-md py-1.5 border-0 text-right text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300  focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6' : 'block w-full text-right text-gray-900 truncate pl-2 sm:text-sm sm:leading-6 md:text-lg bg-transparent border-0 focus:ring-0'">                           
                </div>
                <div>
                    <label for="item-amount-vat" class="text-right block text-sm font-medium leading-6 text-gray-900">VAT Amount</label>
                    <input type="text" autocomplete="off" id="item-amount-vat"
                           placeholder="0.00" class="placeholder:text-gray-300"
                           x-model="selectedDocument.config.amountvat"
                           x-bind:class="!formItem.form_automatic_computation ? 'block w-full rounded-md py-1.5 border-0 text-right text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6' : 'block w-full text-right text-gray-900 truncate pl-2 sm:text-sm sm:leading-6 md:text-lg bg-transparent border-0 focus:ring-0'">                           
                </div>
                <div>
                    <label for="item-amountvatincl" class="text-right block text-sm font-medium leading-6 text-gray-900">Total Amount</label>
                    <input type="text" autocomplete="off" id="item-amountvatincl"
                        placeholder="0.00" class="placeholder:text-gray-300"
                        x-model="selectedDocument.config.amountvatincl"
                        x-bind:readonly="formItem.form_automatic_computation"
                        x-bind:class="!formItem.form_automatic_computation ? 'block w-full rounded-md py-1.5 border-0 text-right text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6' : 'block w-full text-right text-gray-900 truncate pl-2 sm:text-sm sm:leading-6 md:text-lg bg-transparent border-0 focus:ring-0'">
                </div>
            </div>            
            {{!-- <div class="col-span-1 grid grid-cols-3 gap-x-2 md:grid-cols-5">
                <div class="col-span-1 md:col-span-2">
                    <label for="item-vat" class="block w-full text-sm font-medium leading-6 text-gray-900">VAT Rate</label>
                    <select x-model="formItem.vat" id="item-vat"
                        class="block  w-full rounded-md border-0 py-1.5 mt-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
                        <option value="-1">Not applicable</option>
                        <option value="0">0%</option>
