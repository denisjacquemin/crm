                    </div>
                </div>
            </div> --}}
        </div>
        <div x-show="products.length > 0" 
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="transform translate-y-full"
            x-transition:enter-end="transform translate-y-0"
            x-transition:leave="transition ease-in duration-300"
            x-transition:leave-start="transform translate-y-0"
            x-transition:leave-end="transform translate-y-full"
            style="box-shadow: 0 -6px 10px -1px rgba(0, 0, 0, 0.1), 0 -4px 8px -1px rgba(0, 0, 0, 0.06)"
            class="absolute bottom-0 left-0 right-0 w-full  h-[50%] bg-white z-10 divide-y divide-gray-200 overflow-y-auto">
            <template x-for="(product, index) in products" :key="index">
                <div :class="{'bg-gray-100 text-indigo-700': selectedIndex === index}"
                    @click="selectedIndex = index; select()"
                    class="p-2 cursor-pointer hover:bg-gray-100"
                >
                    <span class="text-sm font-semibold leading-6 text-gray-900 line-clamp-2" x-text="product.name"></span>
                    <span class="text-xs text-indigo-600" x-text="product.reference"></span>
                    <div class="mt-1 flex text-xs leading-5 text-gray-500">
                        <div x-text="product?.description" class="relative truncate w-full text-left h-5"></div>
                    </div>
                </div>
            </template>
        </div>
    </div>
</div>