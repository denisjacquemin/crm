        <textarea placeholder="{{ t 'documents.views.edit_form.notes_on_invoice_placeholder' }}" type="text"
          x-model="selectedDocument.config.notes_on_invoice" id="notes_on_invoice" autocomplete="off" rows="2"
          class="block flex-1 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"></textarea>
      </div>
    </div>
    <div class="col-span-full flex flex-col">
      <label for="notes_internal" class="block w-full text-sm font-medium leading-6 text-gray-900">{{ t
        'documents.views.edit_form.notes_on_internal_label' }}</label>
      <div class="mb-6 w-full flex items-center justify-center">
        <textarea placeholder="{{ t 'documents.views.edit_form.notes_on_internal_placeholder' }}" type="text"
          x-model="selectedDocument.config.notes_internal" id="notes_internal" autocomplete="off" rows="2"
          class="block flex-1 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"></textarea>
      </div>
    </div>

    <div class="col-span-full flex flex-col">
      <label for="files" class="block w-full text-sm font-medium leading-6 text-gray-900">{{ t
        'documents.views.edit_form.files' }}</label>
      <div x-show="selectedDocument.config.files.length === 0" 
          class="bg-gray-100 border border-y-gray-300 px-4 -mx-4 sm:px-6 sm:-mx-6 py-4">
        <div class="relative block w-full h-full text-center focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
          <div class="rounded-lg border-2 border-dashed border-gray-300 p-10 h-full w-full">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="mx-auto h-12 w-12 text-gray-300 lucide lucide-paperclip">
              <path
                d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
            </svg>
            <span class="my-4 block font-normal text-gray-400">{{t 'documents.views.edit_form.no_files_yet'
              }}</span>
            <button type="button"
              class="w-full my-2 relative inline-flex items-center rounded-md  px-3.5 py-2.5 text-sm font-semibold bg-indigo-600 text-white ring-inset  focus:z-10 hover:bg-indigo-500 focus-visible:bg-indigo-500 focus-visible:outline-none"
              @click.prevent="openSlide = true; slideContentPartialName='slideFiles'">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="mr-2 lucide lucide-paperclip">
                <path
                  d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
              </svg>
              {{ t 'documents.views.edit_form.add_files' }}
            </button>
          </div>
        </div>
      </div>

      <div x-show="selectedDocument.config.files.length > 0" class="flex flex-col gap-y-4">
        <div class="text-center relative block w-full h-full focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
          <button type="button"
            class="w-full my-2 relative inline-flex items-center rounded-md  px-3.5 py-2.5 text-sm font-semibold bg-indigo-600 text-white ring-inset  focus:z-10 hover:bg-indigo-500 focus-visible:bg-indigo-500 focus-visible:outline-none"
            @click.prevent="openSlide = true; slideContentPartialName='slideFiles'">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="mr-2 lucide lucide-paperclip">
              <path
                d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48" />
            </svg>
            {{ t 'documents.views.edit_form.add_files' }}
          </button>
        </div>
        <template x-for="(file, index) in selectedDocument.config.files" :key="index">
          <div class="flex flex-1 items-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 lucide lucide-paperclip"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
            <div class="ml-4 flex flex-col min-w-0 flex-1">
              <div class="flex-1 truncate text-sm font-semibold text-gray-900"
                x-text="file?.internal_name?.trim() ? `${file.name} (${file.internal_name})` : file?.name">
              </div>
              <div class="flex-1 flex min-w-0 gap-2">
                <span class="truncate text-sm font-semibold text-gray-600" x-text="file.filename"></span>
                <span class="flex-shrink-0 text-sm text-gray-400" x-text="formatBytes(file.size, sizes)"></span>
              </div>
            </div>
          </div>
        </template>
      </div>
    </div>
  </div>
</div>