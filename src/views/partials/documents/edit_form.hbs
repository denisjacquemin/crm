<div class="to-be-autosaved"
  x-data="{
        invoiceDatePicker: null,
        dueDatePicker: null,
        createDueDatePicker: function() {
            this.dueDatePicker = flatpickr(this.$refs.dueDate, {
                defaultDate: new Date(this.selectedDocument.config.invoice_due_date.value),
                dateFormat: dateFormatFlatpickrConfig[this.user_language],
                onChange: (selectedDates, dateStr, instance) => {
                  this.selectedDocument.config.invoice_due_date.value = dayjs(selectedDates[0]).format('YYYY-MM-DD');
                }
            });
        },
        handleTermsTypeChange: function(termsType, selectedDate) {
            if (termsType.startsWith('+')) {
                if (!this.dueDatePicker) {
                    this.createDueDatePicker();
                }
                this.dueDatePicker.set('onOpen', () => { {{!-- Disable dueDatePicker from opening --}}
                    this.dueDatePicker.close();
                });
                let daysToAdd = parseInt(termsType.slice(1));
                let invoice_due_date_value = dayjs(selectedDate).add(daysToAdd, 'day');
                this.dueDatePicker.setDate(new Date(invoice_due_date_value));
                this.selectedDocument.config.invoice_due_date.value = dayjs(this.dueDatePicker.selectedDates[0]).format('YYYY-MM-DD');

            } else if (termsType === 'dueonreceipt') {
                if (this.dueDatePicker) {
                    this.dueDatePicker.destroy();
                    this.dueDatePicker = null;
                }            
                this.selectedDocument.config.invoice_due_date.value = '{{ t 'documents.views.edit_form.due_on_receipt' }}';
                this.$refs.dueDate.value = '{{ t 'documents.views.edit_form.due_on_receipt' }}';
            } else if (termsType === 'custom') {
                if (!this.dueDatePicker) {
                    this.createDueDatePicker();
                }
                this.dueDatePicker.setDate(new Date());

                // set dueDatePicker date to today and also set invoice_due_date.value to today
                {{!-- this.dueDatePicker.setDate(dayjs().toDate()); --}}
                this.selectedDocument.config.invoice_due_date.value = selectedDate; 
                this.dueDatePicker.set('onOpen', []);
                this.dueDatePicker.set('allowInput', true);
            }
        },
        handleDelete: async function() {
          try {
              const csrfToken = document.querySelector('meta[name=csrf-token]').getAttribute('content');
              const data = await fetchUrl('/document/deleteAjax/' + this.selectedDocument.slug, 'DELETE');
              this.documents = this.documents.filter(document => document.slug !== this.selectedDocument.slug);
              this.selectedDocumentIndex = 0;
              this.selectedDocument = this.documents[0];
              updateNewUrl(this.selectedDocument.slug);
          } catch (error) { 
              console.error('Error deleting document', error);

          }
        },
        handleDuplicate: async function() {
          try {
              const newDocument = await fetchUrl('/document/duplicateAjax', 'POST', { slug: this.selectedDocument.slug });             
              this.documents.unshift(newDocument);
              this.selectedDocumentIndex = 0; 
              this.selectedDocument = newDocument;

              updateNewUrl(newDocument.slug);
              if (window.innerWidth < 640) $dispatch('updatenavbutton', {value: 'back'});
          } catch (error) { 
              console.error('Error creating new document', error); 
          }
        },
        handleChange: function(value) {      
          this.handleTermsTypeChange(value, dayjs(this.invoiceDatePicker.selectedDates[0]).toDate());
        }
  }" 
  x-init="
            $watch('selectedDocument.slug', () => { 

              if (invoiceDatePicker) {
                invoiceDatePicker.setDate(new Date(selectedDocument.config.invoice_date), false);
                deliveryDatePicker.setDate(new Date(selectedDocument.config.invoice_delivery_date), false);
                dueDatePicker.setDate(new Date(selectedDocument.config.invoice_due_date.value), false);
              }
            });

            flatpickr.localize(locales[user_language]);
                invoiceDatePicker = flatpickr($refs.invoiceDate, {
                defaultDate: new Date(selectedDocument.config.invoice_date),
                dateFormat: dateFormatFlatpickrConfig[user_language],
                onChange: (selectedDates, dateStr, instance) => {
                    let selectedDate = selectedDates[0]; {{!-- get the date selected by the user --}}

                    selectedDocument.config.invoice_date = dayjs(selectedDate).format('YYYY-MM-DD');
                    handleTermsTypeChange(selectedDocument.config.invoice_due_date.terms_type, selectedDate);
                },
            });
            deliveryDatePicker = flatpickr($refs.deliveryDate, {
                defaultDate: new Date(selectedDocument.config.invoice_delivery_date),
                dateFormat: dateFormatFlatpickrConfig[user_language],
                onChange: (selectedDates, dateStr, instance) => {
                    selectedDocument.config.invoice_delivery_date = dayjs(selectedDates[0]).format('YYYY-MM-DD');
                }
            });
            if (selectedDocument.config.invoice_due_date.terms_type.startsWith('+')) {
                if (!dueDatePicker) {
                    createDueDatePicker();
                }
                dueDatePicker.set('onOpen', () => { {{!-- Disable dueDatePicker from opening --}}
                    dueDatePicker.close();
                });
                dueDatePicker.setDate(new Date(selectedDocument.config.invoice_due_date.value));
            } else if (selectedDocument.config.invoice_due_date.terms_type === 'dueonreceipt') {
                if (dueDatePicker) {
                    dueDatePicker.destroy();
                    dueDatePicker = null;
                }            
                selectedDocument.config.invoice_due_date.value = '{{ t 'documents.views.edit_form.due_on_receipt' }}';
                $refs.dueDate.value = '{{ t 'documents.views.edit_form.due_on_receipt' }}';
            } else if (selectedDocument.config.invoice_due_date.terms_type === 'custom') {
                if (!dueDatePicker) {
                    createDueDatePicker();
                }
                dueDatePicker.setDate(new Date(selectedDocument.config.invoice_due_date.value));
                dueDatePicker.set('onOpen', []);
                dueDatePicker.set('allowInput', true);
            }
          ">
  <input type="hidden" x-model="selectedDocument.slug" id="slug" />
  <div class="grid grid-cols-1 mt-5 sm:mt-0 gap-y-5 gap-x-6">
    <div x-data="Components.menu({ open: false })" x-init="init()" @keydown.escape.stop="open = false;" @click.away="onClickAway($event)" 
         class="relative inline-block text-right">

      <button type="button" class="text-indigo-500 cursor-pointer inline-flex items-center justify-center rounded-md"
              id="contextual_invoice_due_date" x-ref="contextual_invoice_due_date" @click="onButtonClick()" @keyup.space.prevent="onButtonEnter()"
              @keydown.enter.prevent="onButtonEnter()" aria-expanded="true" aria-haspopup="true"
              x-bind:aria-expanded="open.toString()" @keydown.arrow-up.prevent="onArrowUp()"
              @keydown.arrow-down.prevent="onArrowDown()">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 lucide lucide-ellipsis"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
      </button>
      <div x-show="open" 
              x-transition:enter="transition ease-out duration-100"
              x-transition:enter-start="transform opacity-0 scale-95"
              x-transition:enter-end="transform opacity-100 scale-100" x-transition:leave="transition ease-in duration-75"
              x-transition:leave-start="transform opacity-100 scale-100"
              x-transition:leave-end="transform opacity-0 scale-95" 
              class="absolute right-0 z-10 w-56 origin-top-right rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none" x-ref="menu-items" x-description="Dropdown menu, show/hide based on menu state." x-bind:aria-activedescendant="activeDescendant" role="menu" aria-orientation="vertical" aria-labelledby="menu-button" tabindex="-1" @keydown.arrow-up.prevent="onArrowUp()" @keydown.arrow-down.prevent="onArrowDown()" @keydown.tab="open = false" @keydown.enter.prevent="open = false;" @keyup.space.prevent="open = false;" style="display: none;">
          <ul class="py-1" role="none">
            <li>
              <a href="#" class="text-gray-700 block px-4 py-2 text-sm" role="menuitem" tabindex="-1"
                @mouseenter="onMouseEnter($event)" @mousemove="onMouseMove($event)"
                @mouseleave="onMouseLeave($event)"
                @click.prevent="if (confirm('{{t 'documents.views.edit_form.delete_confirm' }}')) { handleDelete(); } open = false;">
                {{ t 'documents.views.edit_form.delete_document' }}
              </a>
            </li>
            <li>
              <a href="#" class="text-gray-700 block px-4 py-2 text-sm" role="menuitem" tabindex="-1"
                @mouseenter="onMouseEnter($event)" @mousemove="onMouseMove($event)"
                @mouseleave="onMouseLeave($event)"
                @click.prevent="handleDuplicate(); open = false;">
                {{ t 'documents.views.edit_form.duplicate_document' }}
              </a>
            </li>
          </ul>
        </div>
    </div>
    <div class="flex flex-row">
      <label for="invoiceDate" @click="invoiceDatePicker.open()" class=" flex-grow block text-sm font-medium leading-6 text-gray-900">{{ t 'documents.views.edit_form.invoice_date' }}</label>
      <input x-ref="invoiceDate" type="text" class="flex-1 text-indigo-500 text-right cursor-pointer sm:text-sm sm:leading-6 border-none mr-2 p-0 m-0 focus:ring-0 focus:border-none" readonly>
      <div>
        <svg @click="invoiceDatePicker.open()" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500 cursor-pointer lucide lucide-calendar-days">
          <path d="M8 2v4"/>
          <path d="M16 2v4"/>
          <rect width="18" height="18" x="3" y="4" rx="2"/>
          <path d="M3 10h18"/>
          <path d="M8 14h.01"/>
          <path d="M12 14h.01"/>
          <path d="M16 14h.01"/>
          <path d="M8 18h.01"/>
          <path d="M12 18h.01"/>
          <path d="M16 18h.01"/>
        </svg>
      </div>
    </div>
    
    <div class="flex flex-row">
      <label for="invoiceDueDate" @click="dueDatePicker.open()" class="flex-grow block text-sm font-medium leading-6 text-gray-900">{{ t 'documents.views.edit_form.due_date' }}</label>
      <div class="flex items-center justify-center">
        {{!-- <input placeholder="YYYY#00000"
               type="text" x-model="selectedDocument.config.invoice_number" id="invoiceNumber" 
               autocomplete="off" 
               class="block flex-1 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
          --}}
        <input x-ref="dueDate" type="text" id="invoiceDueDate"
               class="flex-1 text-indigo-500 text-right cursor-pointer sm:text-sm sm:leading-6 border-none mr-2 p-0 m-0 focus:ring-0 focus:border-none">
        <div x-data="Components.menu({ open: false })" x-init="init()" @keydown.escape.stop="open = false;" @click.away="onClickAway($event)" class="relative inline-block text-left">
          <button type="button" class="text-indigo-500 cursor-pointer inline-flex items-center justify-center rounded-md"
              id="contextual_invoice_due_date" x-ref="contextual_invoice_due_date" @click="onButtonClick()" @keyup.space.prevent="onButtonEnter()"
              @keydown.enter.prevent="onButtonEnter()" aria-expanded="true" aria-haspopup="true"
              x-bind:aria-expanded="open.toString()" @keydown.arrow-up.prevent="onArrowUp()"
              @keydown.arrow-down.prevent="onArrowDown()">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 pt-1 lucide lucide-chevron-down"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div x-show="open" 
               x-transition:enter="transition ease-out duration-100"
               x-transition:enter-start="transform opacity-0 scale-95"
               x-transition:enter-end="transform opacity-100 scale-100" x-transition:leave="transition ease-in duration-75"
               x-transition:leave-start="transform opacity-100 scale-100"
               x-transition:leave-end="transform opacity-0 scale-95" 
               class="absolute right-0 z-10 w-56 origin-top-right rounded-md bg-white shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none" x-ref="menu-items" x-description="Dropdown menu, show/hide based on menu state." x-bind:aria-activedescendant="activeDescendant" role="menu" aria-orientation="vertical" aria-labelledby="menu-button" tabindex="-1" @keydown.arrow-up.prevent="onArrowUp()" @keydown.arrow-down.prevent="onArrowDown()" @keydown.tab="open = false" @keydown.enter.prevent="open = false; " @keyup.space.prevent="open = false; " style="display: none;">
            <ul class="py-1" role="none" x-data="{ menuItems: [
                                { label: '{{t 'documents.views.edit_form.custom' }}', value: 'custom' },
                                { label: '{{t 'documents.views.edit_form.15' }}', value: '+15' },
                                { label: '{{t 'documents.views.edit_form.30' }}', value: '+30' },
                                { label: '{{t 'documents.views.edit_form.due_on_receipt' }}', value: 'dueonreceipt' }
                            ] }">
                            <!-- Template for each menu item -->
              <template x-for="(item, index) in menuItems" :key="index">
                <li class="relative">
                  <a x-text="item.label" href="#" class="text-gray-700 block px-4 py-2 text-sm" :class="{
                                            'bg-indigo-600 text-white': selectedDocument.config.invoice_due_date.terms_type === item.value,
                                            'text-gray-700': selectedDocument.config.invoice_due_date.terms_type !== item.value
                                        }" role="menuitem" tabindex="-1" :id="`menu-item-${index}`"
                    @mouseenter="onMouseEnter($event)" @mousemove="onMouseMove($event, index)"
                    @mouseleave="onMouseLeave($event)"
                    @click.prevent="selectedDocument.config.invoice_due_date.terms_type = item.value; handleChange(item.value); open = false; ">
                  </a>
                  <span x-show="selectedDocument.config.invoice_due_date.terms_type === item.value" class="absolute inset-y-0 right-0 flex items-center pr-4 text-white">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 lucide lucide-check"><path d="M20 6 9 17l-5-5"/></svg>
                  </span>
                </li>
              </template>
            </ul>
          </div>
        </div>
      </div> 
    </div>
    <div class="flex flex-row">
      <label for="deliveryDate" @click="deliveryDatePicker.open()" class=" flex-grow block text-sm font-medium leading-6 text-gray-900">{{ t 'documents.views.edit_form.delivery_date' }}</label>
      <input x-ref="deliveryDate" type="text" class="flex-1 text-indigo-500 text-right cursor-pointer sm:text-sm sm:leading-6 border-none mr-2 p-0 m-0 focus:ring-0 focus:border-none" readonly>
      <div>
        <svg @click="deliveryDatePicker.open()" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500 cursor-pointer lucide lucide-calendar-days">
          <path d="M8 2v4"/>
          <path d="M16 2v4"/>
          <rect width="18" height="18" x="3" y="4" rx="2"/>
          <path d="M3 10h18"/>
          <path d="M8 14h.01"/>
          <path d="M12 14h.01"/>
          <path d="M16 14h.01"/>
          <path d="M8 18h.01"/>
          <path d="M12 18h.01"/>
          <path d="M16 18h.01"/>
        </svg>
      </div>
    </div>
    

    <div class="flex flex-row">
      <label for="buyer-name" class="flex-grow min-w-[100px] block text-sm font-medium leading-6 text-gray-900">Buyer</label>
      <div class="    " @click.prevent="openSlide = true; slideContentPartialName='slideBuyer'"
            x-data="() => ({
                get address1() { return selectedDocument.config.buyer.address1 },
                get address2() { return selectedDocument.config.buyer.address2 },
                get city() { return selectedDocument.config.buyer.city },
                get country() { return selectedDocument.config.buyer.country },
                get zip() { return selectedDocument.config.buyer.zip },
            })"
      >
        <p x-text="selectedDocument.config.buyer.name"
           class="text-indigo-500 text-sm leading-4 text-right"></p>
        <p x-text="window.formatAddress(address1, address2, zip, city, country)" 
           class="text-indigo-500 text-sm leading-4 text-right"></p>
        <p x-text="selectedDocument.config.buyer.vat_number" 
           class="text-indigo-500 text-sm leading-4 text-right"></p>
      </div>
    </div>

    <div class="col-span-full flex flex-col">
      <label for="invoiceNumber" class="block w-full text-sm font-medium leading-6 text-gray-900">{{ t 'documents.views.edit_form.invoice_number' }}</label>
      <div class="w-full flex items-center justify-center">
        <input placeholder="YYYY#00000"
               type="text" x-model="selectedDocument.config.invoice_number" id="invoiceNumber" 
               autocomplete="off" 
               class="block flex-1 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6">
        {{> dots_contextual_menu }}
      </div>     
    </div>
    
    <div class="col-span-full flex flex-col">
      <label for="subject" class="block w-full text-sm font-medium leading-6 text-gray-900">{{ t 'documents.views.edit_form.subject_label' }}</label>
      <div class="w-full flex items-center justify-center">
        <input placeholder="{{ t 'documents.views.edit_form.subject_placeholder' }}"
               type="text" x-model="selectedDocument.config.subject" id="subject" 
               autocomplete="off" 
               class="block flex-1 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"/>
      </div>     
    </div>
    <div class="col-span-full flex flex-col">
      <label for="reference" class="block w-full text-sm font-medium leading-6 text-gray-900">{{ t 'documents.views.edit_form.reference_label' }}</label>
      <div class="w-full flex items-center justify-center">
        <input placeholder="{{ t 'documents.views.edit_form.reference_placeholder' }}"
               type="text" x-model="selectedDocument.config.reference" id="reference" 
               autocomplete="off" 
               class="block flex-1 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"/>
      </div>     
    </div>

    <div class="col-span-full bg-gray-100 border border-y-gray-200 -mx-4 px-4 py-2">
        <button type="button"
              class="inline-flex items-center gap-x-2 my-2 w-full rounded-md bg-indigo-600 px-3.5 py-1 text-md font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
              @click.prevent="openSlide = true; slideContentPartialName='slideItems'">
              <svg class="-ml-0.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M9 9V6a1 1 0 012 0v3h3a1 1 0 010 2h-3v3a1 1 0 01-2 0V11H6a1 1 0 010-2h3z"
                clip-rule="evenodd" />
              </svg>
            Manage Items
        </button>
        {{> documents/items }}
        {{> documents/amounts }}
    </div>
    

    <div class="col-span-full flex flex-col">
      <label for="notes_on_invoice" class="block w-full text-sm font-medium leading-6 text-gray-900">{{ t 'documents.views.edit_form.notes_on_invoice_label' }}</label>
      <div class="mb-6 w-full flex items-center justify-center">
        <textarea placeholder="{{ t 'documents.views.edit_form.notes_on_invoice_placeholder' }}"
               type="text" x-model="selectedDocument.config.notes_on_invoice" id="notes_on_invoice" 
               autocomplete="off" 
               rows="2" 
               class="block flex-1 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"></textarea>
      </div>     
    </div>
    <div class="col-span-full flex flex-col">
      <label for="notes_internal" class="block w-full text-sm font-medium leading-6 text-gray-900">{{ t 'documents.views.edit_form.notes_on_internal_label' }}</label>
      <div class="mb-6 w-full flex items-center justify-center">
        <textarea placeholder="{{ t 'documents.views.edit_form.notes_on_internal_placeholder' }}"
               type="text" x-model="selectedDocument.config.notes_internal" id="notes_internal" 
               autocomplete="off"
               rows="2" 
               class="block flex-1 rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"></textarea>
      </div>     
    </div>
    
    
  </div>


  
</div>