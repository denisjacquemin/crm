# Starting mongodb locally in Docker

docker run --name mongodb -p 27017:27017 -v $(pwd)/mongodb-data:/data/db -v $(pwd)/mongo-init.js:/docker-entrypoint-initdb.d/mongo-init.js:ro -d mongo --replSet myReplicaSet --bind_ip_all

docker rename mongodbbackup mongodb // rename container

docker exec -it mongodb mongosh //using mongosh

use crm-dev // to create a new db

db.createUser(
  {
    user: "crm-dev",
    pwd: "crm-dev",
    roles: [ { role: "readWrite", db: "crm-dev" } ]
  }
) // to create a new user


