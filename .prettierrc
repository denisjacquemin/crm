{
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "semi": true,
  "htmlWhitespaceSensitivity": "ignore",
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.hbs", "*.handlebars"],
      "options": {
        "parser": "html",
        "printWidth": 100,
        "singleQuote": false,
        "embeddedLanguageFormatting": "auto",
        "vueIndentScriptAndStyle": true
      }
    }
  ]
}
